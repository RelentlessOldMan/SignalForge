{
  "schema": 1,
  "suite": "sheldon_evenness",
  "description": "Sheldon's evenness (conventions: Sheldon's evenness; ADR 0538).",
  "cases": [
    {"id": "sheldon_evenness.equal", "op": "sheldon_evenness", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "four equal shares: exp(ln 4)/4 = 1"},
    {"id": "sheldon_evenness.single", "op": "sheldon_evenness", "args": {"samples": [5.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "one value: 1/1 = 1"},
    {"id": "sheldon_evenness.one_holds_all", "op": "sheldon_evenness", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 0.25, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "one share of 1: 1/4"},
    {"id": "sheldon_evenness.halves", "op": "sheldon_evenness", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.8408964152537145, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "shares 1/4, 1/8, 1/8, 1/2: 2^(7/4)/4"},
    {"id": "sheldon_evenness.one_zero", "op": "sheldon_evenness", "args": {"samples": [0.0, 2.0, 2.0, 2.0, 2.0]}, "expected": 0.8, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "four equal shares of five: 4/5"},
    {"id": "sheldon_evenness.two", "op": "sheldon_evenness", "args": {"samples": [3.0, 1.0]}, "expected": 0.8773826753016616, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "shares 3/4, 1/4: (4/3^(3/4))/2 = 2/3^(3/4)"},
    {"id": "sheldon_evenness.ramp", "op": "sheldon_evenness", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.8990288666560805, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "shares 4, 1, 3, 2 tenths"},
    {"id": "sheldon_evenness.three", "op": "sheldon_evenness", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.5849217835344411, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "shares 3/4, 0, 1/4 over 3"},
    {"id": "sheldon_evenness.random", "op": "sheldon_evenness", "args": {"samples": [4.25, 4.625, 0.75, 6.375, 0.625, 2.625, 4.0, 5.125, 1.5, 2.75, 2.125, 6.125, 0.25, 7.25, 6.375, 6.625, 2.25, 4.625, 7.25, 4.0, 7.125, 7.5, 7.25, 7.75, 2.5, 4.625, 1.5, 2.875, 2.375, 4.625]}, "expected": 0.8486353372604376, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "30 values k/8, k from random.Random(538).randint(0, 64)"},
    {"id": "sheldon_evenness.huge", "op": "sheldon_evenness", "args": {"samples": [1e+308, 9e+307, 1e+300]}, "expected": 0.6657435864775645, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "values whose sum overflows a double: the result is that of the values scaled down"},
    {"id": "sheldon_evenness.empty", "op": "sheldon_evenness", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "sheldon_evenness.negative", "op": "sheldon_evenness", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "sheldon_evenness.all_zero", "op": "sheldon_evenness", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
