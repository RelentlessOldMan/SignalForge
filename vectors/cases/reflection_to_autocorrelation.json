{
  "schema": 1,
  "suite": "reflection_to_autocorrelation",
  "description": "Autocorrelation of an AR model (conventions: Autocorrelation of an AR model; ADR 0214).",
  "cases": [
    {"id": "reflection_to_autocorrelation.ar1", "op": "reflection_to_autocorrelation", "args": {"reflection": [-0.5], "power": 2.0, "lags": 4}, "expected": [2.0, 1.0, 0.5, 0.25, 0.125], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "AR(1): r[m] = P (-k)^m = 2 (1/2)^m"},
    {"id": "reflection_to_autocorrelation.lags_zero", "op": "reflection_to_autocorrelation", "args": {"reflection": [0.3333333333333333], "power": 5.0, "lags": 0}, "expected": [5.0], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "lags = 0: just r[0] = power"},
    {"id": "reflection_to_autocorrelation.order_two", "op": "reflection_to_autocorrelation", "args": {"reflection": [0.5, -0.3], "power": 1.0, "lags": 2}, "expected": [1.0, -0.5, 0.475], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "r1 = -k1 = -1/2; r2 = -k2 (1 - k1^2) + k1^2 = 9/40 + 1/4 = 19/40"},
    {"id": "reflection_to_autocorrelation.order_two_extended", "op": "reflection_to_autocorrelation", "args": {"reflection": [0.5, -0.3], "power": 1.0, "lags": 6}, "expected": [1.0, -0.5, 0.475, -0.31625, 0.2531875, -0.183490625, 0.14017796875], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "past p, r[m] = -(a1 r[m-1] + a2 r[m-2]) with a = [1, 7/20, -3/10]"},
    {"id": "reflection_to_autocorrelation.burg_three_samples", "op": "reflection_to_autocorrelation", "args": {"reflection": [-0.8888888888888888, 0.9058823529411765], "power": 4.666666666666667, "lags": 3}, "expected": [4.666666666666667, 4.148148148148148, 2.8, 0.9857952069716776], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "ADR 0205's x = [1, 2, 3] model, with power 14/3"},
    {"id": "reflection_to_autocorrelation.order_three", "op": "reflection_to_autocorrelation", "args": {"reflection": [0.5, -0.3333333333333333, 0.25], "power": 3.0, "lags": 5}, "expected": [3.0, -1.5, 1.5, -1.5, 1.125, -1.03125], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "order 3 in exact fractions"},
    {"id": "reflection_to_autocorrelation.order_more_than_lags", "op": "reflection_to_autocorrelation", "args": {"reflection": [0.5, -0.3333333333333333, 0.25], "power": 1.0, "lags": 1}, "expected": [1.0, -0.5], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "lags < p: only k1 is used, r1 = -1/2"},
    {"id": "reflection_to_autocorrelation.complex", "op": "reflection_to_autocorrelation", "args": {"reflection": {"re": [0.3, -0.2], "im": [0.4, 0.1]}, "power": 2.0, "lags": 4}, "expected": {"re": [2.0, -0.6, 0.15999999999999998, -0.07650000000000004, -0.053320000000000006], "im": [0.0, -0.8, 0.32999999999999996, -0.274, 0.16573500000000002]}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "complex k: the step-up uses conj"},
    {"id": "reflection_to_autocorrelation.unit_k", "op": "reflection_to_autocorrelation", "args": {"reflection": [0.5, 1.0], "power": 1.0, "lags": 3}, "error": "invalid_argument", "source": "every |k| < 1"},
    {"id": "reflection_to_autocorrelation.empty", "op": "reflection_to_autocorrelation", "args": {"reflection": [], "power": 1.0, "lags": 3}, "error": "invalid_argument", "source": "reflection must not be empty"},
    {"id": "reflection_to_autocorrelation.nan", "op": "reflection_to_autocorrelation", "args": {"reflection": ["nan"], "power": 1.0, "lags": 3}, "error": "invalid_argument", "source": "reflection must be finite"},
    {"id": "reflection_to_autocorrelation.zero_power", "op": "reflection_to_autocorrelation", "args": {"reflection": [0.5], "power": 0.0, "lags": 3}, "error": "invalid_argument", "source": "power must be positive"},
    {"id": "reflection_to_autocorrelation.inf_power", "op": "reflection_to_autocorrelation", "args": {"reflection": [0.5], "power": "inf", "lags": 3}, "error": "invalid_argument", "source": "power must be finite"},
    {"id": "reflection_to_autocorrelation.negative_lags", "op": "reflection_to_autocorrelation", "args": {"reflection": [0.5], "power": 1.0, "lags": -1}, "error": "invalid_argument", "source": "lags must be at least 0"}
  ]
}
