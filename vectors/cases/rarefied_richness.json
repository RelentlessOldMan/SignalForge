{
  "schema": 1,
  "suite": "rarefied_richness",
  "description": "The rarefied richness (conventions: the rarefied richness; ADR 0552).",
  "cases": [
    {"id": "rarefied_richness.one_drawn", "op": "rarefied_richness", "args": {"samples": [3.0, 1.0, 2.0], "size": 1}, "expected": 1.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "one individual is one kind"},
    {"id": "rarefied_richness.all_drawn", "op": "rarefied_richness", "args": {"samples": [3.0, 0.0, 1.0, 2.0], "size": 6}, "expected": 3.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "every individual: every kind"},
    {"id": "rarefied_richness.two_of_four", "op": "rarefied_richness", "args": {"samples": [3.0, 1.0], "size": 2}, "expected": 1.5, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "miss 1: C(3,2)/C(4,2) = 1/2; miss 3: 0"},
    {"id": "rarefied_richness.ramp", "op": "rarefied_richness", "args": {"samples": [1.0, 2.0, 3.0], "size": 2}, "expected": 1.7333333333333334, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "misses 10/15, 6/15, 3/15: 3 - 19/15"},
    {"id": "rarefied_richness.even", "op": "rarefied_richness", "args": {"samples": [2.0, 2.0, 2.0], "size": 3}, "expected": 2.4, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "each missed with C(4,3)/C(6,3) = 1/5: 12/5"},
    {"id": "rarefied_richness.mixed", "op": "rarefied_richness", "args": {"samples": [5.0, 1.0, 1.0, 0.0, 2.0], "size": 4}, "expected": 2.6031746031746033, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "N = 9, n = 4: C(4,4), C(8,4), C(8,4), C(7,4) over C(9,4)"},
    {"id": "rarefied_richness.larger", "op": "rarefied_richness", "args": {"samples": [40.0, 25.0, 0.0, 10.0, 25.0, 1.0], "size": 30}, "expected": 4.272934705204624, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "N = 101, n = 30"},
    {"id": "rarefied_richness.random", "op": "rarefied_richness", "args": {"samples": [0.0, 2.0, 16.0, 12.0, 1.0, 7.0, 12.0, 18.0, 17.0, 15.0, 18.0, 3.0, 7.0, 16.0, 6.0, 19.0, 11.0, 10.0, 10.0, 4.0, 3.0, 3.0, 12.0, 18.0, 0.0, 4.0, 15.0, 10.0, 2.0, 6.0], "size": 50}, "expected": 21.153500447922237, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "30 whole values from random.Random(552).randint(0, 20), n = 50"},
    {"id": "rarefied_richness.empty", "op": "rarefied_richness", "args": {"samples": [], "size": 2}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "rarefied_richness.negative", "op": "rarefied_richness", "args": {"samples": [1.0, -0.5, 2.0], "size": 2}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "rarefied_richness.all_zero", "op": "rarefied_richness", "args": {"samples": [0.0, 0.0, 0.0], "size": 2}, "error": "invalid_argument", "source": "the total must be positive"},
    {"id": "rarefied_richness.fraction", "op": "rarefied_richness", "args": {"samples": [1.5, 2.0], "size": 2}, "error": "invalid_argument", "source": "values must be whole numbers"},
    {"id": "rarefied_richness.too_large", "op": "rarefied_richness", "args": {"samples": [10000000.0, 1.0], "size": 2}, "error": "invalid_argument", "source": "the total must be at most 10 000 000"},
    {"id": "rarefied_richness.size_zero", "op": "rarefied_richness", "args": {"samples": [1.0, 2.0, 3.0], "size": 0}, "error": "invalid_argument", "source": "size must be at least 1"},
    {"id": "rarefied_richness.size_negative", "op": "rarefied_richness", "args": {"samples": [1.0, 2.0, 3.0], "size": -1}, "error": "invalid_argument", "source": "size must be at least 1"},
    {"id": "rarefied_richness.size_above_total", "op": "rarefied_richness", "args": {"samples": [1.0, 2.0, 3.0], "size": 7}, "error": "invalid_argument", "source": "size must be at most the total"}
  ]
}
