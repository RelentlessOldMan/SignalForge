{
  "schema": 1,
  "suite": "smith_wilson_evenness",
  "description": "The Smith-Wilson evenness (conventions: the Smith-Wilson evenness; ADR 0534).",
  "cases": [
    {"id": "smith_wilson_evenness.equal", "op": "smith_wilson_evenness", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "four equal values, no spread: 1"},
    {"id": "smith_wilson_evenness.single", "op": "smith_wilson_evenness", "args": {"samples": [5.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "one value, no spread: 1"},
    {"id": "smith_wilson_evenness.two", "op": "smith_wilson_evenness", "args": {"samples": [1.0, 4.0]}, "expected": 0.7148655833305205, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "logs 0, 2 ln 2, variance (ln 2)^2: 1 - (2/pi) atan((ln 2)^2)"},
    {"id": "smith_wilson_evenness.powers", "op": "smith_wilson_evenness", "args": {"samples": [1.0, 2.0, 4.0, 8.0]}, "expected": 0.655693255635049, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "logs k ln 2, k 0..3, variance (5/4)(ln 2)^2: 1 - (2/pi) atan(5/4 (ln 2)^2)"},
    {"id": "smith_wilson_evenness.ramp", "op": "smith_wilson_evenness", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.8314918540431749, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "logs of 4, 1, 3, 2"},
    {"id": "smith_wilson_evenness.wide", "op": "smith_wilson_evenness", "args": {"samples": [0.001, 1.0, 1000.0]}, "expected": 0.02000573460284084, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "logs of 1/1000 (as its double), 1, 1000"},
    {"id": "smith_wilson_evenness.random", "op": "smith_wilson_evenness", "args": {"samples": [6.875, 3.25, 7.375, 2.5, 4.125, 5.75, 6.875, 0.25, 2.25, 1.0, 2.875, 4.5, 6.5, 2.375, 2.875, 4.875, 4.125, 1.375, 6.875, 4.0, 2.0, 5.25, 0.375, 0.125, 5.875, 2.75, 5.75, 0.75, 1.875, 4.375]}, "expected": 0.4964147318216211, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "30 values k/8, k from random.Random(534).randint(1, 64)"},
    {"id": "smith_wilson_evenness.huge", "op": "smith_wilson_evenness", "args": {"samples": [1e+308, 9e+307, 1e+300]}, "expected": 0.008490483158234268, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "values whose sum overflows a double: the result is that of the values scaled down"},
    {"id": "smith_wilson_evenness.empty", "op": "smith_wilson_evenness", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "smith_wilson_evenness.zero", "op": "smith_wilson_evenness", "args": {"samples": [1.0, 0.0, 2.0]}, "error": "invalid_argument", "source": "values must be above 0"},
    {"id": "smith_wilson_evenness.negative", "op": "smith_wilson_evenness", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be above 0"}
  ]
}
