    {"id": "butterworth.lowpass_2_quarter", "op": "butterworth_lowpass", "args": {"order": 2, "cutoff": 2000.0, "sample_rate": 8000.0}, "expected": [[0.2928932188134524, 0.5857864376269049, 0.2928932188134524, 1.0, 0.0, 0.1715728752538097]], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: K = tan(pi/4) = 1, 1/Q = sqrt 2, D = 2 + sqrt 2; b = [1, 2, 1]/D = (1 - sqrt 2/2)[1, 2, 1], a1 = 0, a2 = (2 - sqrt 2)/(2 + sqrt 2) = 3 - 2 sqrt 2"},
