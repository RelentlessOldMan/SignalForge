{
  "schema": 1,
  "suite": "cepstrum_to_lpc",
  "description": "Cepstrum to prediction filter (conventions: Cepstrum to prediction filter; ADR 0222).",
  "cases": [
    {"id": "cepstrum_to_lpc.order_one", "op": "cepstrum_to_lpc", "args": {"cepstrum": [0.3333333333333333, -0.5], "order": 1}, "expected": [1.0, 0.5], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "a1 = 1/2: c1 = -1/2, a = [1, 1/2]"},
    {"id": "cepstrum_to_lpc.two_real_roots", "op": "cepstrum_to_lpc", "args": {"cepstrum": [0.0, 0.16666666666666666, 0.18055555555555555], "order": 2}, "expected": [1.0, -0.16666666666666666, -0.16666666666666666], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "roots 1/2, -1/3: c = [0, 1/6, 13/72], a = [1, -1/6, -1/6]"},
    {"id": "cepstrum_to_lpc.extra_values", "op": "cepstrum_to_lpc", "args": {"cepstrum": [-2.0, 0.16666666666666666, 0.18055555555555555, 0.029320987654320986, 0.01871141975308642, 0.005426954732510288, 0.0028327903520804754, 0.0010507503755960545], "order": 2}, "expected": [1.0, -0.16666666666666666, -0.16666666666666666], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "cepstrum longer than order + 1"},
    {"id": "cepstrum_to_lpc.truncated", "op": "cepstrum_to_lpc", "args": {"cepstrum": [0.0, 0.16666666666666666, 0.18055555555555555], "order": 1}, "expected": [1.0, -0.16666666666666666], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "order 1 of an order-2 cepstrum: a1 = -c1"},
    {"id": "cepstrum_to_lpc.order_four", "op": "cepstrum_to_lpc", "args": {"cepstrum": [0.5, 1.1166666666666667, 0.6484722222222222, 0.20039043209876542, 0.14450927854938272], "order": 4}, "expected": [1.0, -1.1166666666666667, -0.025, 0.2916666666666667, -0.05], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "roots 3/4, -1/2, 1/5, 2/3"},
    {"id": "cepstrum_to_lpc.conjugate_pair", "op": "cepstrum_to_lpc", "args": {"cepstrum": [0.0, 0.6, -0.07000000000000003], "order": 2}, "expected": [1.0, -0.6, 0.25], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "roots 0.3 +- 0.4j: a = [1, -0.6, 0.25]"},
    {"id": "cepstrum_to_lpc.complex", "op": "cepstrum_to_lpc", "args": {"cepstrum": {"re": [0.0, -0.25, -0.125, 0.010416666666666666], "im": [0.0, 0.75, -0.0625, -0.03125]}, "order": 2}, "expected": {"re": [1.0, 0.25, -0.125], "im": [0.0, -0.75, -0.125]}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "complex roots 0.5j, -0.25 + 0.25j"},
    {"id": "cepstrum_to_lpc.too_short", "op": "cepstrum_to_lpc", "args": {"cepstrum": [0.0, 0.5], "order": 2}, "error": "invalid_argument", "source": "cepstrum must have order + 1 values"},
    {"id": "cepstrum_to_lpc.order_zero", "op": "cepstrum_to_lpc", "args": {"cepstrum": [0.0, 0.5], "order": 0}, "error": "invalid_argument", "source": "order must be at least 1"},
    {"id": "cepstrum_to_lpc.empty", "op": "cepstrum_to_lpc", "args": {"cepstrum": [], "order": 1}, "error": "invalid_argument", "source": "cepstrum must not be empty"},
    {"id": "cepstrum_to_lpc.nan", "op": "cepstrum_to_lpc", "args": {"cepstrum": [0.0, "nan"], "order": 1}, "error": "invalid_argument", "source": "cepstrum must be finite"}
  ]
}
