    {"id": "burg_psd.three_samples", "op": "burg_psd", "args": {"samples": [1.0, 2.0, 3.0], "sample_rate": 1.0, "order": 2, "nfft": 8}, "expected": {"frequencies": [0.0, 0.125, 0.25, 0.375, 0.5], "psd": [3.917695473251021, 2.8231686125451123, 0.12205128205128213, 0.03795809341725701, 0.013556039699830557], "sample_rate": 1.0, "nperseg": 3, "num_segments": 1, "one_sided": true, "bin_width": 0.125, "enbw_hz": 0.3333333333333333, "nfft": 8}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "x = [1, 2, 3]: k1 = -8/9, k2 = 77/85, a = [1, -144/85, 77/85], sigma^2 = (14/3)(17/81)(1296/7225); M = 8"},
    {"id": "burg_psd.order_one", "op": "burg_psd", "args": {"samples": [0.5, -1.0, 2.0, 1.5], "sample_rate": 2.0, "order": 1}, "expected": {"frequencies": [0.0, 0.5, 1.0], "psd": [1.1005434782608694, 1.8511526232114464, 0.798611111111111], "sample_rate": 2.0, "nperseg": 4, "num_segments": 1, "one_sided": true, "bin_width": 0.5, "enbw_hz": 0.5, "nfft": 4}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "order 1: k = -2 sum x[n] x[n-1] / sum (x[n]^2 + x[n-1]^2), sigma^2 = mean x^2 (1 - k^2)"},
    {"id": "burg_psd.order_three", "op": "burg_psd", "args": {"samples": [3.0, 1.0, -2.0, 0.0, 1.0, 2.5, -1.5], "sample_rate": 1.0, "order": 3, "nfft": 9}, "expected": {"frequencies": [0.0, 0.1111111111111111, 0.2222222222222222, 0.3333333333333333, 0.4444444444444444], "psd": [0.21970294271980617, 0.9190981021053545, 52.46891982822274, 2.7000694838976362, 3.1522150374406666], "sample_rate": 1.0, "nperseg": 7, "num_segments": 1, "one_sided": true, "bin_width": 0.1111111111111111, "enbw_hz": 0.14285714285714285, "nfft": 9}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "order 3 by the error recursion; M = 9 (odd), interior doubled"},
    {"id": "burg_psd.two_sided_real", "op": "burg_psd", "args": {"samples": [1.0, 2.0, 3.0], "sample_rate": 3.0, "order": 1, "nfft": 6, "one_sided": false}, "expected": {"frequencies": [-1.5, -1.0, -0.5, 0.0, 0.5, 1.0], "psd": [0.09150326797385624, 0.12186379928315412, 0.3622526636225268, 26.44444444444443, 0.3622526636225268, 0.1218637992831542], "sample_rate": 3.0, "nperseg": 3, "num_segments": 1, "one_sided": false, "bin_width": 0.5, "enbw_hz": 1.0, "nfft": 6}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "real input, one_sided = false: shifted bins"},
    {"id": "burg_psd.complex_ar1", "op": "burg_psd", "args": {"samples": {"re": [1.0, 0.0, -0.5], "im": [0.0, 1.0, 0.5]}, "sample_rate": 4.0, "order": 1, "nfft": 4}, "expected": {"frequencies": [-2.0, -1.0, 0.0, 1.0], "psd": [0.016025641025641035, 0.010838150289017346, 0.030737704918032807, 0.37500000000000033], "sample_rate": 4.0, "nperseg": 3, "num_segments": 1, "one_sided": false, "bin_width": 1.0, "enbw_hz": 1.3333333333333333, "nfft": 4}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "complex order 1; M = 4, shifted"},
    {"id": "burg_psd.complex_ar2", "op": "burg_psd", "args": {"samples": {"re": [1.0, -0.5, 1.5, 0.0, -1.0], "im": [1.0, 2.0, -1.0, 0.25, 0.0]}, "sample_rate": 1.0, "order": 2}, "expected": {"frequencies": [-0.4, -0.2, 0.0, 0.2, 0.4], "psd": [0.6163743606484416, 4.103718928050001, 0.6031703540324649, 0.612900699155507, 6.020187461712449], "sample_rate": 1.0, "nperseg": 5, "num_segments": 1, "one_sided": false, "bin_width": 0.2, "enbw_hz": 0.2, "nfft": 5}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "complex order 2 by the error recursion with conj(k) in the backward update; M = 5, shifted"},
