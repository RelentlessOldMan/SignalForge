    {"id": "kendall_tau.constant_y", "op": "kendall_tau", "args": {"x": [0.0, 1.0, 0.5], "y": [1.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "y must not be constant"},
    {"id": "kendall_tau.nan", "op": "kendall_tau", "args": {"x": [0.0, "nan", 1.0], "y": [2.0, 1.0, 3.0]}, "error": "invalid_argument", "source": "samples must be finite"}
