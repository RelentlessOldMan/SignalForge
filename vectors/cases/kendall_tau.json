    {"id": "kendall_tau.reversed", "op": "kendall_tau", "args": {"x": [0.5, 1.5, 2.5], "y": [9.0, 4.0, -1.0]}, "expected": -1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "all discordant: -1"},
    {"id": "kendall_tau.ties", "op": "kendall_tau", "args": {"x": [1.0, 2.0, 2.0, 3.0], "y": [1.0, 1.0, 2.0, 3.0]}, "expected": 0.8, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "pairs: (0,1) +0, (0,2) +1, (0,3) +1, (1,2) 0, (1,3) +1, (2,3) +1: 4; one tie in each: 4/sqrt(5*5) = 4/5"},
