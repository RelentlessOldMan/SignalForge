{
  "schema": 1,
  "suite": "miller_madow_entropy",
  "description": "The Miller-Madow entropy (conventions: the Miller-Madow entropy; ADR 0555).",
  "cases": [
    {"id": "miller_madow_entropy.one_kind", "op": "miller_madow_entropy", "args": {"samples": [0.0, 4.0]}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "one kind: 0 + 0"},
    {"id": "miller_madow_entropy.two_twos", "op": "miller_madow_entropy", "args": {"samples": [2.0, 2.0]}, "expected": 0.8181471805599453, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "ln 2 + 1/8"},
    {"id": "miller_madow_entropy.halves_quarters", "op": "miller_madow_entropy", "args": {"samples": [1.0, 1.0, 2.0]}, "expected": 1.2897207708399179, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "(3/2) ln 2 + 2/8"},
    {"id": "miller_madow_entropy.four_ones", "op": "miller_madow_entropy", "args": {"samples": [1.0, 1.0, 1.0, 1.0]}, "expected": 1.7612943611198906, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "ln 4 + 3/8"},
    {"id": "miller_madow_entropy.ramp", "op": "miller_madow_entropy", "args": {"samples": [1.0, 2.0, 3.0]}, "expected": 1.1780709313740183, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "N = 6, k = 3"},
    {"id": "miller_madow_entropy.mixed", "op": "miller_madow_entropy", "args": {"samples": [5.0, 1.0, 1.0, 0.0, 2.0]}, "expected": 1.315726363637287, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "N = 9, k = 4"},
    {"id": "miller_madow_entropy.large", "op": "miller_madow_entropy", "args": {"samples": [1000.0, 2000.0, 3000.0, 4000.0]}, "expected": 1.2800042258336675, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "N = 10000: the bias term is 3/20000"},
    {"id": "miller_madow_entropy.random", "op": "miller_madow_entropy", "args": {"samples": [3.0, 4.0, 2.0, 2.0, 8.0, 1.0, 2.0, 4.0, 6.0, 3.0, 8.0, 4.0, 9.0, 7.0, 0.0, 2.0, 9.0, 0.0, 7.0, 7.0, 0.0, 1.0, 1.0, 1.0, 5.0, 9.0, 9.0, 6.0, 9.0, 4.0, 5.0, 2.0, 1.0, 8.0, 0.0, 8.0, 3.0, 4.0, 4.0, 5.0]}, "expected": 3.50870154922735, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "40 whole values from random.Random(555).randint(0, 9)"},
    {"id": "miller_madow_entropy.empty", "op": "miller_madow_entropy", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "miller_madow_entropy.negative", "op": "miller_madow_entropy", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "miller_madow_entropy.all_zero", "op": "miller_madow_entropy", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"},
    {"id": "miller_madow_entropy.fraction", "op": "miller_madow_entropy", "args": {"samples": [1.5, 2.0]}, "error": "invalid_argument", "source": "values must be whole numbers"},
    {"id": "miller_madow_entropy.too_large", "op": "miller_madow_entropy", "args": {"samples": [10000000.0, 1.0]}, "error": "invalid_argument", "source": "the total must be at most 10 000 000"}
  ]
}
