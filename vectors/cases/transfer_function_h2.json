{
  "schema": 1,
  "suite": "transfer_function_h2",
  "description": "Transfer function H2 (conventions: Transfer function (H2); ADR 0195).",
  "cases": [
    {"id": "transfer_function_h2.fir_impulse", "op": "transfer_function_h2", "args": {"x": [1.0, 0.0, 0.0, 0.0], "y": [0.5, 0.25, 0.0, 0.0], "sample_rate": 4.0, "nperseg": 4, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [0.0, 1.0, 2.0], "response": {"re": [0.75, 0.5, 0.25], "im": [0.0, -0.25, 0.0]}, "num_segments": 1}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x = delta, y = h = [0.5, 0.25]: X = 1, so H2 = |Y|^2 / conj Y = Y = DFT(h): 0.75, 0.5 - 0.25j, 0.25 (= H1, no noise)"},
    {"id": "transfer_function_h2.scaled", "op": "transfer_function_h2", "args": {"x": [1.0, 2.0, 3.0, 4.0], "y": [-2.0, -4.0, -6.0, -8.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [0.0, 1.0], "response": {"re": [-2.0, -2.0], "im": [0.0, 0.0]}, "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "y = -2x: Syy = 4 Sxx, Syx = -2 Sxx, so H2 = -2 (X = [3, -1], [7, -1], all non-zero)"},
    {"id": "transfer_function_h2.zero_bin", "op": "transfer_function_h2", "args": {"x": [1.0, 1.0], "y": [1.0, 0.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [0.0, 1.0], "response": {"re": [0.5, "nan"], "im": [0.0, "nan"]}, "num_segments": 1}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "X = [2, 0], Y = [1, 1]: bin 0: 1 / (1 * 2) = 0.5; bin 1: Syx = 1 * 0 = 0, NaN"},
    {"id": "transfer_function_h2.inconsistent", "op": "transfer_function_h2", "args": {"x": [1.0, 0.0, 1.0, 0.0, 1.0, 0.0], "y": [1.0, 0.0, 1.0, 0.0, 0.0, 1.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [0.0, 1.0], "response": {"re": [1.0, 3.0], "im": [0.0, 0.0]}, "num_segments": 3}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "X = [1, 1] thrice; Y = [1, 1], [1, 1], [1, -1]. Bin 0: 3 / 3 = 1; bin 1: Syy = 3, Syx = 1 + 1 - 1 = 1, H2 = 3 (H1 = 1/3, coherence 1/9)"},
    {"id": "transfer_function_h2.cancelling", "op": "transfer_function_h2", "args": {"x": [1.0, 0.0, 0.0, 1.0], "y": [1.0, 0.0, 1.0, 0.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [0.0, 1.0], "response": {"re": [1.0, "nan"], "im": [0.0, "nan"]}, "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "X = [1, 1], [1, -1]; Y = [1, 1] twice. Bin 0: 2 / 2 = 1; bin 1: Syx = 1 - 1 = 0, NaN (H1 is 0)"},
    {"id": "transfer_function_h2.lengths", "op": "transfer_function_h2", "args": {"x": [1.0, 2.0], "y": [1.0], "sample_rate": 1.0}, "error": "invalid_argument", "source": "x and y differ in length"},
    {"id": "transfer_function_h2.nan", "op": "transfer_function_h2", "args": {"x": [1.0, 2.0], "y": ["nan", 2.0], "sample_rate": 1.0}, "error": "invalid_argument", "source": "not finite"},
    {"id": "transfer_function_h2.zero_rate", "op": "transfer_function_h2", "args": {"x": [1.0, 2.0], "y": [1.0, 2.0], "sample_rate": 0.0}, "error": "invalid_argument", "source": "sample_rate must be positive"}
  ]
}
