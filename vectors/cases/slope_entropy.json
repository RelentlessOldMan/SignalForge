{
  "schema": 1,
  "suite": "slope_entropy",
  "description": "Slope entropy (conventions: Slope entropy; ADR 0347).",
  "cases": [
    {"id": "slope_entropy.ramp", "op": "slope_entropy", "args": {"samples": [0.0, 0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5], "m": 3}, "expected": -0.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "steps of 0.5: every symbol +1, so 0"},
    {"id": "slope_entropy.on_the_thresholds", "op": "slope_entropy", "args": {"samples": [0.0, 1.0, 1.25, 1.25, 1.0, 0.0, 2.0, -0.5], "m": 2, "delta": 0.25}, "expected": 1.4750763110546947, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "steps 1 (= gamma: +1), 0.25 (= delta: 0), 0, -0.25 (0), -1 (-1), 2 (+2), -2.5 (-2)"},
    {"id": "slope_entropy.mixed", "op": "slope_entropy", "args": {"samples": [0.25, -1.5, 3.0, 2.75, -0.5, 0.125, 1.0, -2.25, 0.375, 2.5, -1.25, 0.75, 0.0, 1.5, -0.75, 2.0, 0.5, -1.0], "m": 3, "delta": 0.125}, "expected": 2.133381930264545, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "eighteen arbitrary dyadic samples"},
    {"id": "slope_entropy.noise", "op": "slope_entropy", "args": {"samples": [-0.25, 1.75, 0.75, 2.875, -0.875, 0.875, -1.5, 2.875, -1.125, -0.375, -1.0, -1.75, 0.375, -2.625, -2.75, -3.0, 0.375, -2.875, 2.75, -0.375, 0.75, -1.25, 1.25, -2.0, -2.0, 1.125, 0.375, 2.25, 2.125, 2.25, 0.375, 2.5, 1.25, 0.375, 0.125, 2.875, -0.75, 1.75, -0.625, -0.125, -0.75, 0.75, 2.25, 1.75, 1.5, 1.125, -1.375, 0.625, -1.125, 0.375, -2.375, 2.25, -2.125, 1.875, -2.625, 0.375, 2.875, -1.375, -1.5, 0.125, 1.5, -2.75, -2.75, -1.5, -1.625, 0.25, -1.25, 0.375, 2.625, 1.125, 2.875, 2.0, 2.125, 0.25, -2.875, 2.875, 0.625, -0.625, 0.25, -2.5, -2.5, -1.25, 0.5, -0.625, 0.875, 2.375, 2.375, -0.625, -1.125, -0.375, -0.125, -1.25, 1.5, -2.0, 1.125, -1.25, -3.0, 0.625, 0.25, 1.375, 1.5, 2.75, 0.75, 0.5, 0.5, 2.5, 0.5, 0.625, -0.375, 2.5, 1.375, 1.5, 2.625, -2.625, -1.125, -0.75, 2.25, 2.0, 0.5, -1.75, -2.5, 2.125, -0.75, 2.0, -1.25, 1.625, -0.375, -1.75, -0.125, 1.0, -0.875, -1.75, 2.0, -1.5, -0.125, -2.875, -0.875, -0.5, -2.25, -2.125, 3.0, -1.125, -0.5, 2.75, -1.25, 2.75, -0.5, 0.125, 2.0, -1.875, -1.125, -2.875, 0.25, -0.625, 0.875, -1.25, -2.375, 1.75, -1.5, -0.875, -0.125, -0.5, 0.25, 0.75, 0.875, 2.875, 1.625, -2.625, -1.25, -2.125, 0.75, 1.125, -1.75, -2.875, 2.125, -2.375, 2.375, 0.875, 2.75, 2.25, 1.25, -0.5, -0.5, 1.5, -0.375, -0.375, -2.875, 1.5, 2.125, 2.5, 2.25, -1.0, -0.5, -1.25, -0.875, -1.0, -3.0, -2.25, 3.0, 0.0], "m": 4, "gamma": 1.5, "delta": 0.25}, "expected": 4.132359156988954, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "200 random eighths from random.Random(347), m = 4, gamma 1.5, delta 0.25"},
    {"id": "slope_entropy.defaults", "op": "slope_entropy", "args": {"samples": [0.0, 0.0, 2.0, 1.5, 1.5, -1.0, 0.0], "m": 2}, "expected": 1.5607104090414063, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "the default thresholds"},
    {"id": "slope_entropy.m_one", "op": "slope_entropy", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 1}, "error": "invalid_argument", "source": "m must be at least 2"},
    {"id": "slope_entropy.m_17", "op": "slope_entropy", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 17}, "error": "invalid_argument", "source": "m must be at most 16"},
    {"id": "slope_entropy.delta_negative", "op": "slope_entropy", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 2, "delta": -0.5}, "error": "invalid_argument", "source": "delta must be at least 0"},
    {"id": "slope_entropy.delta_equal_gamma", "op": "slope_entropy", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 2, "gamma": 0.5, "delta": 0.5}, "error": "invalid_argument", "source": "delta must be below gamma"},
    {"id": "slope_entropy.too_short", "op": "slope_entropy", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 6}, "error": "invalid_argument", "source": "samples must be at least m long"},
    {"id": "slope_entropy.nan", "op": "slope_entropy", "args": {"samples": [0.0, "nan", 1.0], "m": 2}, "error": "invalid_argument", "source": "samples must be finite"}
  ]
}
