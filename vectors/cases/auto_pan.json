    {"id": "auto_pan.depth_negative", "op": "auto_pan", "args": {"samples": [1.0], "rate": 1.0, "depth": -0.1, "sample_rate": 8.0}, "error": "invalid_argument", "source": "depth must be at least 0"},
    {"id": "auto_pan.rate_nan", "op": "auto_pan", "args": {"samples": [1.0], "rate": "nan", "depth": 0.5, "sample_rate": 8.0}, "error": "invalid_argument", "source": "rate must be finite"},
