    {"id": "auto_pan.zero_depth", "op": "auto_pan", "args": {"samples": [0.5, -0.25, 1.0], "rate": 3.0, "depth": 0.0, "sample_rate": 48.0}, "expected": {"left": [0.3535533905932738, -0.1767766952966369, 0.7071067811865476], "right": [0.3535533905932738, -0.1767766952966369, 0.7071067811865476]}, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "depth 0: stays at centre"},
