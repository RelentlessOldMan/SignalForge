    {"id": "auto_pan.bad_law", "op": "auto_pan", "args": {"samples": [1.0], "rate": 1.0, "depth": 0.5, "sample_rate": 8.0, "law": "square"}, "error": "invalid_argument", "source": "law must be constant_power or linear"},
    {"id": "auto_pan.empty", "op": "auto_pan", "args": {"samples": [], "rate": 1.0, "depth": 0.5, "sample_rate": 8.0}, "error": "invalid_argument", "source": "samples must not be empty"}
