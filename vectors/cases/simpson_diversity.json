{
  "schema": 1,
  "suite": "simpson_diversity",
  "description": "The Gini-Simpson index (conventions: the Gini-Simpson index; ADR 0529).",
  "cases": [
    {"id": "simpson_diversity.equal", "op": "simpson_diversity", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 0.75, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "four equal shares: 1 - 4/16 = 3/4"},
    {"id": "simpson_diversity.single", "op": "simpson_diversity", "args": {"samples": [5.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "one value: 0"},
    {"id": "simpson_diversity.one_holds_all", "op": "simpson_diversity", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "one share of 1: 0"},
    {"id": "simpson_diversity.two", "op": "simpson_diversity", "args": {"samples": [3.0, 1.0]}, "expected": 0.375, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 3/4, 1/4: 1 - 10/16 = 3/8"},
    {"id": "simpson_diversity.ramp", "op": "simpson_diversity", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.7, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 4, 1, 3, 2 tenths: 1 - 30/100 = 7/10"},
    {"id": "simpson_diversity.three", "op": "simpson_diversity", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.375, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 3/4, 0, 1/4: 1 - 10/16 = 3/8"},
    {"id": "simpson_diversity.halves", "op": "simpson_diversity", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.65625, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 1/4, 1/8, 1/8, 1/2: 1 - 22/64 = 21/32"},
    {"id": "simpson_diversity.random", "op": "simpson_diversity", "args": {"samples": [2.375, 3.75, 7.25, 3.25, 6.75, 3.5, 6.75, 6.125, 1.75, 2.25, 6.625, 2.5, 5.75, 6.5, 6.5, 5.125, 5.5, 3.375, 3.0, 7.625, 1.875, 2.0, 6.625, 7.375, 2.625, 5.375, 6.875, 2.0, 4.875, 2.375]}, "expected": 0.9604017540360159, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "30 values k/8, k from random.Random(529).randint(0, 64)"},
    {"id": "simpson_diversity.empty", "op": "simpson_diversity", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "simpson_diversity.negative", "op": "simpson_diversity", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "simpson_diversity.all_zero", "op": "simpson_diversity", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
