{
  "schema": 1,
  "suite": "npz",
  "description": "Writing NumPy .npz archives, and reading them as numpy.savez, numpy.savez_compressed and other ZIP writers lay them out, from vectors/files, 1-D and 2-D members (conventions: Signal files, NumPy .npz).",
  "cases": [
    {"id": "write_npz.two_arrays", "op": "write_npz", "args": {"arrays": [{"name": "iq", "x": {"re": [1.0, -0.0, "inf"], "im": [2.0, -0.5, 0.25]}}, {"name": "taps", "x": [0.5, -0.25, 0.125]}]}, "expected": "", "tol": {"abs": 0, "rel": 0}, "source": "two stored members in order, then the central directory and the end record"},
    {"id": "write_npz.empty_archive", "op": "write_npz", "args": {"arrays": []}, "expected": "504b0506000000000000000000000000000000000000", "tol": {"abs": 0, "rel": 0}, "source": "no members: the end record alone, 22 bytes"},
    {"id": "write_npz.empty_array", "op": "write_npz", "args": {"arrays": [{"name": "e", "x": []}]}, "expected": "", "tol": {"abs": 0, "rel": 0}, "source": "a member of shape (0,)"},
    {"id": "write_npz.long_name", "op": "write_npz", "args": {"arrays": [{"name": "nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn", "x": [1.0]}]}, "expected": "", "tol": {"abs": 0, "rel": 0}, "source": "a 250-character name"},
    {"id": "write_npz.printable", "op": "write_npz", "args": {"arrays": [{"name": "a b~!.x", "x": [2.0]}]}, "expected": "", "tol": {"abs": 0, "rel": 0}, "source": "spaces and punctuation are allowed"},
    {"id": "write_npz.bad_name_0", "op": "write_npz", "args": {"arrays": [{"name": "", "x": [1.0]}]}, "error": "invalid_argument", "source": "an empty name"},
    {"id": "write_npz.bad_name_1", "op": "write_npz", "args": {"arrays": [{"name": "a/b", "x": [1.0]}]}, "error": "invalid_argument", "source": "no /"},
    {"id": "write_npz.bad_name_2", "op": "write_npz", "args": {"arrays": [{"name": "a\\b", "x": [1.0]}]}, "error": "invalid_argument", "source": "no backslash"},
    {"id": "write_npz.bad_name_3", "op": "write_npz", "args": {"arrays": [{"name": "\u00e9", "x": [1.0]}]}, "error": "invalid_argument", "source": "not ASCII"},
    {"id": "write_npz.bad_name_4", "op": "write_npz", "args": {"arrays": [{"name": "nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn", "x": [1.0]}]}, "error": "invalid_argument", "source": "over 250 characters"},
    {"id": "write_npz.bad_name_5", "op": "write_npz", "args": {"arrays": [{"name": "tab\there", "x": [1.0]}]}, "error": "invalid_argument", "source": "a control character"},
    {"id": "write_npz.matrix_member", "op": "write_npz", "args": {"arrays": [{"name": "bank", "shape": [2, 3], "x": [0.5, -0.25, 0.125, 1.0, 0.0, -1.0]}]}, "expected": "", "tol": {"abs": 0, "rel": 0}, "source": "a (2, 3) member in C order, numpy.savez's layout"},
    {"id": "write_npz.mixed_members", "op": "write_npz", "args": {"arrays": [{"name": "taps", "x": [0.5, -0.25, 0.125]}, {"name": "bank", "shape": [2, 2], "x": {"re": [1.0, -2.0, 0.0, "inf"], "im": [1.0, 0.0, 0.5, -1.0]}}]}, "expected": "", "tol": {"abs": 0, "rel": 0}, "source": "a 1-D member, then a complex (2, 2) member, in order"},
    {"id": "write_npz.empty_matrix", "op": "write_npz", "args": {"arrays": [{"name": "e", "shape": [0, 3], "x": []}, {"name": "f", "shape": [2, 0], "x": []}]}, "expected": "", "tol": {"abs": 0, "rel": 0}, "source": "members of shape (0, 3) and (2, 0)"},
    {"id": "read_npz.stored", "op": "read_npz", "args": {"file": "stored.npz"}, "expected": [{"name": "taps", "x": [0.5, -0.25, 0.125]}, {"name": "iq", "x": {"re": [1.0, -0.0, "inf"], "im": [2.0, -0.5, 0.25]}}], "tol": {"abs": 0, "rel": 0}, "source": "the layout write_npz writes; member order is kept"},
    {"id": "read_npz.savez_like", "op": "read_npz", "args": {"file": "savez_like.npz"}, "expected": [{"name": "taps", "x": [0.5, -0.25, 0.125]}], "tol": {"abs": 0, "rel": 0}, "source": "as numpy.savez writes: version 45, a timestamp, 0xFFFFFFFF sizes and a ZIP64 extra field in the local header, real sizes in the central one"},
    {"id": "read_npz.deflated", "op": "read_npz", "args": {"file": "deflated.npz"}, "expected": [{"name": "taps", "x": [0.5, -0.25, 0.125]}, {"name": "iq", "x": {"re": [1.0, -0.0, "inf"], "im": [2.0, -0.5, 0.25]}}], "tol": {"abs": 0, "rel": 0}, "source": "deflate at levels 9 and 1 from zlib, as numpy.savez_compressed"},
    {"id": "read_npz.central_zip64", "op": "read_npz", "args": {"file": "central_zip64.npz"}, "expected": [{"name": "taps", "x": [0.5, -0.25, 0.125]}], "tol": {"abs": 0, "rel": 0}, "source": "every size and the offset from the central ZIP64 extra field, in order"},
    {"id": "read_npz.data_descriptor", "op": "read_npz", "args": {"file": "data_descriptor.npz"}, "expected": [{"name": "iq", "x": {"re": [1.0, -0.0, "inf"], "im": [2.0, -0.5, 0.25]}}], "tol": {"abs": 0, "rel": 0}, "source": "flag bit 3: the local header has no sizes; the central directory has them"},
    {"id": "read_npz.utf8_name", "op": "read_npz", "args": {"file": "utf8_name.npz"}, "expected": [{"name": "\u00e9t\u00e9", "x": [0.5, -0.25, 0.125]}], "tol": {"abs": 0, "rel": 0}, "source": "flag bit 11: the name is UTF-8"},
    {"id": "read_npz.comment", "op": "read_npz", "args": {"file": "comment.npz"}, "expected": [{"name": "taps", "x": [0.5, -0.25, 0.125]}], "tol": {"abs": 0, "rel": 0}, "source": "an archive comment after the end record"},
    {"id": "read_npz.other_extra", "op": "read_npz", "args": {"file": "other_extra.npz"}, "expected": [{"name": "taps", "x": [0.5, -0.25, 0.125]}], "tol": {"abs": 0, "rel": 0}, "source": "an extended-timestamp extra field, skipped by its lengths"},
    {"id": "read_npz.narrow_dtypes", "op": "read_npz", "args": {"file": "narrow_dtypes.npz"}, "expected": [{"name": "f", "x": [0.5, -1.5, 1.401298464324817e-45]}, {"name": "z", "x": {"re": [0.25], "im": [-1.401298464324817e-45]}}], "tol": {"abs": 0, "rel": 0}, "source": "members of '<f4' and '>c8', as read_npy reads them"},
    {"id": "read_npz.empty", "op": "read_npz", "args": {"file": "empty.npz"}, "expected": [], "tol": {"abs": 0, "rel": 0}, "source": "the end record alone: no arrays"},
    {"id": "read_npz.not_zip", "op": "read_npz", "args": {"file": "not_zip.npz"}, "error": "invalid_argument", "source": "a .npy file is not an archive: no end record"},
    {"id": "read_npz.truncated", "op": "read_npz", "args": {"file": "truncated.npz"}, "error": "invalid_argument", "source": "the end record is cut short"},
    {"id": "read_npz.encrypted", "op": "read_npz", "args": {"file": "encrypted.npz"}, "error": "invalid_argument", "source": "flag bit 0: encrypted"},
    {"id": "read_npz.bzip2", "op": "read_npz", "args": {"file": "bzip2.npz"}, "error": "invalid_argument", "source": "method 12 (bzip2) is not read"},
    {"id": "read_npz.deflate64", "op": "read_npz", "args": {"file": "deflate64.npz"}, "error": "invalid_argument", "source": "method 9 (Deflate64) is not read"},
    {"id": "read_npz.multi_disk", "op": "read_npz", "args": {"file": "multi_disk.npz"}, "error": "invalid_argument", "source": "disk number 1"},
    {"id": "read_npz.counts_differ", "op": "read_npz", "args": {"file": "counts_differ.npz"}, "error": "invalid_argument", "source": "counts 0 and 1"},
    {"id": "read_npz.zip64_end", "op": "read_npz", "args": {"file": "zip64_end.npz"}, "error": "invalid_argument", "source": "a count of 0xFFFF needs the ZIP64 end record"},
    {"id": "read_npz.cd_past_end", "op": "read_npz", "args": {"file": "cd_past_end.npz"}, "error": "invalid_argument", "source": "the central directory runs into the end record"},
    {"id": "read_npz.bad_crc", "op": "read_npz", "args": {"file": "bad_crc.npz"}, "error": "invalid_argument", "source": "the CRC-32 is off by one bit"},
    {"id": "read_npz.stored_size", "op": "read_npz", "args": {"file": "stored_size.npz"}, "error": "invalid_argument", "source": "a stored member whose sizes differ"},
    {"id": "read_npz.deflate_short", "op": "read_npz", "args": {"file": "deflate_short.npz"}, "error": "invalid_argument", "source": "inflates to one byte fewer than its size"},
    {"id": "read_npz.deflate_long", "op": "read_npz", "args": {"file": "deflate_long.npz"}, "error": "invalid_argument", "source": "inflates to one byte more than its size"},
    {"id": "read_npz.invalid_deflate", "op": "read_npz", "args": {"file": "invalid_deflate.npz"}, "error": "invalid_argument", "source": "block type 3 is reserved: not valid deflate data"},
    {"id": "read_npz.not_npy", "op": "read_npz", "args": {"file": "not_npy.npz"}, "error": "invalid_argument", "source": "a member that is not a .npy array"},
    {"id": "read_npz.empty_key", "op": "read_npz", "args": {"file": "empty_key.npz"}, "error": "invalid_argument", "source": "a member named just .npy"},
    {"id": "read_npz.duplicate", "op": "read_npz", "args": {"file": "duplicate.npz"}, "error": "invalid_argument", "source": "taps twice"},
    {"id": "read_npz.latin1_name", "op": "read_npz", "args": {"file": "latin1_name.npz"}, "error": "invalid_argument", "source": "a non-ASCII name without flag bit 11"},
    {"id": "read_npz.bad_utf8", "op": "read_npz", "args": {"file": "bad_utf8.npz"}, "error": "invalid_argument", "source": "flag bit 11 with invalid UTF-8"},
    {"id": "read_npz.bad_member", "op": "read_npz", "args": {"file": "bad_member.npz"}, "error": "invalid_argument", "source": "a boolean member: read_npy rejects it"},
    {"id": "read_npz.zip64_no_extra", "op": "read_npz", "args": {"file": "zip64_no_extra.npz"}, "error": "invalid_argument", "source": "a 0xFFFFFFFF size with no ZIP64 extra field"},
    {"id": "read_npz.no_local_header", "op": "read_npz", "args": {"file": "no_local_header.npz"}, "error": "invalid_argument", "source": "the offset does not point at a local header"},
    {"id": "read_npz.matrix", "op": "read_npz", "args": {"file": "matrix.npz"}, "expected": [{"name": "bank", "shape": [2, 3], "x": [0.5, -0.25, 0.125, 1.0, 0.0, -1.0]}], "tol": {"abs": 0, "rel": 0}, "source": "a stored (2, 3) float64 member"},
    {"id": "read_npz.mixed_fortran", "op": "read_npz", "args": {"file": "mixed_fortran.npz"}, "expected": [{"name": "taps", "x": [0.5, -0.25, 0.125]}, {"name": "bank", "shape": [2, 2], "x": {"re": [1.0, -2.0, 0.0, "inf"], "im": [1.0, 0.0, 0.5, -1.0]}}], "tol": {"abs": 0, "rel": 0}, "source": "a 1-D member next to a deflated big-endian complex64 member in Fortran order"},
    {"id": "read_npz.savez_like_matrix", "op": "read_npz", "args": {"file": "savez_like_matrix.npz"}, "expected": [{"name": "m", "shape": [3, 2], "x": [1.0, -2.0, 32767.0, -32768.0, 0.0, 5.0]}], "tol": {"abs": 0, "rel": 0}, "source": "an int16 (3, 2) member with numpy.savez's ZIP64 central extra field"},
    {"id": "read_npz.zero_rows_member", "op": "read_npz", "args": {"file": "zero_rows_member.npz"}, "expected": [{"name": "z", "shape": [0, 4], "x": []}], "tol": {"abs": 0, "rel": 0}, "source": "a member of shape (0, 4): no data"},
    {"id": "read_npz.three_dim_member", "op": "read_npz", "args": {"file": "three_dim_member.npz"}, "error": "invalid_argument", "source": "a (1, 2, 2) member: only 1-D and 2-D members are read"},
    {"id": "read_npz.zero_dim_member", "op": "read_npz", "args": {"file": "zero_dim_member.npz"}, "error": "invalid_argument", "source": "a 0-D member"},
    {"id": "read_npz.member_dimension_too_big", "op": "read_npz", "args": {"file": "member_dimension_too_big.npz"}, "error": "invalid_argument", "source": "a dimension one beyond 2147483591"},
    {"id": "read_npz.matrix_data_short", "op": "read_npz", "args": {"file": "matrix_data_short.npz"}, "error": "invalid_argument", "source": "40 data bytes for shape (2, 3)"}
  ]
}
