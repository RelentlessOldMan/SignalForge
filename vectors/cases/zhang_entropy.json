{
  "schema": 1,
  "suite": "zhang_entropy",
  "description": "Zhang's entropy (conventions: Zhang's entropy; ADR 0561).",
  "cases": [
    {"id": "zhang_entropy.two_ones", "op": "zhang_entropy", "args": {"samples": [1.0, 1.0]}, "expected": 1.0, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "N = 2: 2 (1/2)(1) = 1"},
    {"id": "zhang_entropy.two_twos", "op": "zhang_entropy", "args": {"samples": [2.0, 2.0]}, "expected": 0.8333333333333334, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "N = 4: 2 (1/2)(2/3 + (1/3)/2) = 5/6"},
    {"id": "zhang_entropy.one_kind", "op": "zhang_entropy", "args": {"samples": [0.0, 4.0]}, "expected": 0.0, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "every product meets a 0 factor: 0"},
    {"id": "zhang_entropy.ramp", "op": "zhang_entropy", "args": {"samples": [1.0, 2.0, 3.0]}, "expected": 1.2, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "N = 6"},
    {"id": "zhang_entropy.mixed", "op": "zhang_entropy", "args": {"samples": [5.0, 1.0, 1.0, 0.0, 2.0]}, "expected": 1.3382275132275132, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "N = 9"},
    {"id": "zhang_entropy.repeats", "op": "zhang_entropy", "args": {"samples": [3.0, 3.0, 3.0, 1.0, 1.0]}, "expected": 1.7016955266955267, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "N = 11, repeated values"},
    {"id": "zhang_entropy.large", "op": "zhang_entropy", "args": {"samples": [10.0, 20.0, 30.0, 40.0]}, "expected": 1.2950194059633908, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "N = 100"},
    {"id": "zhang_entropy.random", "op": "zhang_entropy", "args": {"samples": [4.0, 4.0, 1.0, 1.0, 4.0, 2.0, 1.0, 1.0, 1.0, 4.0, 2.0, 6.0, 4.0, 6.0, 5.0, 4.0, 3.0, 4.0, 5.0, 1.0, 5.0, 3.0, 4.0, 0.0, 0.0]}, "expected": 3.1504667416641583, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "25 whole values from random.Random(561).randint(0, 6)"},
    {"id": "zhang_entropy.empty", "op": "zhang_entropy", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "zhang_entropy.negative", "op": "zhang_entropy", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "zhang_entropy.all_zero", "op": "zhang_entropy", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"},
    {"id": "zhang_entropy.fraction", "op": "zhang_entropy", "args": {"samples": [1.5, 2.0]}, "error": "invalid_argument", "source": "values must be whole numbers"},
    {"id": "zhang_entropy.too_large", "op": "zhang_entropy", "args": {"samples": [10000.0, 1.0]}, "error": "invalid_argument", "source": "the total must be at most 10 000"},
    {"id": "zhang_entropy.total_one", "op": "zhang_entropy", "args": {"samples": [0.0, 1.0]}, "error": "invalid_argument", "source": "the total must be above 1"}
  ]
}
