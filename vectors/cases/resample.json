{
  "schema": 1,
  "suite": "resample",
  "description": "Rational resampling, interpolation and decimation with the delay removed, and the default anti-aliasing taps (conventions: Resampling).",
  "cases": [
    {"id": "interpolate.linear", "op": "interpolate", "args": {"x": [1, 2, 3], "factor": 2, "taps": [0.25, 0.5, 0.25]}, "expected": [1, 1.5, 2, 2.5, 3, 1.5], "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: 2*[0.25 0.5 0.25] is linear interpolation; the last sample meets the zero after the input, (3 + 0)/2"},
    {"id": "decimate.smooth", "op": "decimate", "args": {"x": [1, 2, 3, 4, 5, 6], "factor": 2, "taps": [0.25, 0.5, 0.25]}, "expected": [1, 3, 5], "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: y[m] = 0.25 x[2m-1] + 0.5 x[2m] + 0.25 x[2m+1], x[-1] = 0: 0.5 + 0.5, 0.5 + 1.5 + 1, 1 + 2.5 + 1.5"},
    {"id": "resample.gcd", "op": "resample", "args": {"x": [1, 2, 3], "up": 4, "down": 2, "taps": [0.25, 0.5, 0.25]}, "expected": [1, 1.5, 2, 2.5, 3, 1.5], "tol": {"abs": 1e-12, "rel": 0}, "source": "4/2 reduces to 2/1, so this is interpolate.linear"},
    {"id": "resample.single_tap_gain", "op": "resample", "args": {"x": [1, -2], "up": 2, "down": 1, "taps": [1]}, "expected": [2, 0, -4, 0], "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: with h = [1] the output is up times the zero-stuffed input"},
    {"id": "resample.identity_default", "op": "resample", "args": {"x": [1, 2, 3], "up": 3, "down": 3}, "expected": [1, 2, 3], "tol": {"abs": 1e-12, "rel": 0}, "source": "3/3 reduces to 1/1, which with no taps returns x"},
    {"id": "resample.identity_delay_taps", "op": "resample", "args": {"x": [4, 5, 6], "up": 1, "down": 1, "taps": [0, 1, 0]}, "expected": [4, 5, 6], "tol": {"abs": 1e-12, "rel": 0}, "source": "a centered unit impulse with its delay removed is the identity"},
    {"id": "decimate.complex", "op": "decimate", "args": {"x": {"re": [1, 0, 1, 0], "im": [0, 1, 0, 1]}, "factor": 2, "taps": [0.25, 0.5, 0.25]}, "expected": {"re": [0.5, 0.5], "im": [0.25, 0.5]}, "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand, x = [1, j, 1, j]: y0 = 0.5*1 + 0.25j, y1 = 0.25j + 0.5*1 + 0.25j"},
