{
  "schema": 1,
  "suite": "pettitt",
  "description": "Pettitt change-point test (conventions: Pettitt change-point test; ADR 0366).",
  "cases": [
    {"id": "pettitt.step_by_hand", "op": "pettitt", "args": {"samples": [0.0, 0.0, 1.0, 1.0]}, "expected": {"statistic": 4, "index": 1, "p_value": 0.6023884238244043}, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "U_0 = 2, U_1 = 4, U_2 = 2: K = 4 at index 1; p = 2 exp(-96/80) = 2 exp(-6/5)"},
    {"id": "pettitt.constant", "op": "pettitt", "args": {"samples": [3.0, 3.0, 3.0]}, "expected": {"statistic": 0, "index": 0, "p_value": 1.0}, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "every U_t is 0: K = 0, index 0, p = 1"},
    {"id": "pettitt.drop", "op": "pettitt", "args": {"samples": [5.0, 6.0, 4.0, 1.0, 2.0, 0.0]}, "expected": {"statistic": 9, "index": 2, "p_value": 0.2907114024676932}, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "a fall after index 2: U_2 = -9, the largest in size"},
