    {"id": "ofdm_modulate.one_subcarrier", "op": "ofdm_modulate", "args": {"symbols": {"re": [1.0], "im": [0.0]}, "nfft": 4, "cp_len": 1, "subcarriers": [1]}, "expected": {"re": [-0.0, 0.5, 0.0, -0.5, -0.0], "im": [-0.5, 0.0, 0.5, 0.0, -0.5]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: e^{j2pi n/4}/2 = [1/2, j/2, -1/2, -j/2], the last sample copied in front"},
