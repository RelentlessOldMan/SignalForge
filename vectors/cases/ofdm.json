    {"id": "ofdm_modulate.order_reversed", "op": "ofdm_modulate", "args": {"symbols": {"re": [0.0, 2.0], "im": [0.0, 0.0]}, "nfft": 4, "cp_len": 0, "subcarriers": [1, 0]}, "expected": {"re": [1.0, 1.0, 1.0, 1.0], "im": [0.0, 0.0, 0.0, 0.0]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: listing the subcarriers the other way swaps which symbol is DC"},
