    {"id": "ofdm_modulate.nyquist", "op": "ofdm_modulate", "args": {"symbols": {"re": [0.0], "im": [1.0]}, "nfft": 4, "cp_len": 0, "subcarriers": [-2]}, "expected": {"re": [0.0, -0.0, 0.0, -0.0], "im": [0.5, -0.5, 0.5, -0.5]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: subcarrier -2 of 4 is bin 2, (-1)^n j/2"},
