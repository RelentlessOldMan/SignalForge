{
  "schema": 1,
  "suite": "coherence",
  "description": "Magnitude-squared coherence (conventions: Coherence; ADR 0192).",
  "cases": [
    {"id": "coherence.two_segments", "op": "coherence", "args": {"x": [1.0, 0.0, 1.0, 0.0], "y": [1.0, 0.0, 0.0, 1.0], "sample_rate": 2.0, "window": "rectangular", "nperseg": 2, "noverlap": 0}, "expected": {"frequencies": [0.0, 1.0], "values": [1.0, 0.0], "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "rectangular, 2-sample segments: X = [1, 1] twice; Y = [1, 1] then [1, -1]. Bin 0: |1 + 1|^2 / (2 * 2) = 1; bin 1: |1 - 1|^2 / 4 = 0"},
    {"id": "coherence.three_segments", "op": "coherence", "args": {"x": [1.0, 0.0, 1.0, 0.0, 1.0, 0.0], "y": [1.0, 0.0, 1.0, 0.0, 0.0, 1.0], "sample_rate": 2.0, "window": "rectangular", "nperseg": 2, "noverlap": 0}, "expected": {"frequencies": [0.0, 1.0], "values": [1.0, 0.1111111111111111], "num_segments": 3}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "X = [1, 1] thrice; Y = [1, 1], [1, 1], [1, -1]. Bin 0: 9 / 9 = 1; bin 1: |1 + 1 - 1|^2 / (3 * 3) = 1/9"},
    {"id": "coherence.zero_bin", "op": "coherence", "args": {"x": [1.0, 1.0, 1.0, 1.0], "y": [1.0, 0.0, 0.0, 1.0], "sample_rate": 2.0, "window": "rectangular", "nperseg": 2, "noverlap": 0}, "expected": {"frequencies": [0.0, 1.0], "values": [1.0, "nan"], "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "X = [2, 0] twice, so Sxx = 0 at bin 1: NaN. Bin 0: |2 + 2|^2 / (8 * 2) = 1"},
    {"id": "coherence.single_segment", "op": "coherence", "args": {"x": [1.0, 0.0], "y": [0.0, 1.0], "sample_rate": 2.0, "window": "rectangular"}, "expected": {"frequencies": [0.0, 1.0], "values": [1.0, 1.0], "num_segments": 1}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "defaults: one segment of the whole input, so C = |X conj Y|^2 / (|X|^2 |Y|^2) = 1 wherever both are non-zero: X = [1, 1], Y = [1, -1]"},
    {"id": "coherence.scaled_hann", "op": "coherence", "args": {"x": [0.0, 1.0, 2.0, 0.0, -1.0, 0.0, 3.0, 1.0], "y": [-0.0, -3.0, -6.0, -0.0, 3.0, -0.0, -9.0, -3.0], "sample_rate": 8.0, "window": "hann", "nperseg": 4, "noverlap": 2}, "expected": {"frequencies": [0.0, 2.0, 4.0], "values": [1.0, 1.0, 1.0], "num_segments": 3}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "y = -3x, Hann, nperseg 4, overlap 2: Sxy = -3 Sxx, Syy = 9 Sxx, so C = 9 Sxx^2 / (9 Sxx^2) = 1 at every bin with Sxx > 0 (segment 0 windowed is [0, 0.5, 2, 0], X = [2.5, -2 - 0.5j, 1.5], all non-zero)"},
    {"id": "coherence.constant_y", "op": "coherence", "args": {"x": [1.0, 2.0, 1.0, 2.0], "y": [5.0, 5.0, 5.0, 5.0], "sample_rate": 2.0, "window": "rectangular", "nperseg": 2, "noverlap": 0, "detrend": "constant"}, "expected": {"frequencies": [0.0, 1.0], "values": ["nan", "nan"], "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "detrend constant: each y segment becomes [0, 0], so Syy = 0 at every bin: NaN"},
    {"id": "coherence.lengths", "op": "coherence", "args": {"x": [1.0, 2.0], "y": [1.0], "sample_rate": 1.0}, "error": "invalid_argument", "source": "x and y differ in length"},
    {"id": "coherence.nan", "op": "coherence", "args": {"x": [1.0, "nan"], "y": [1.0, 2.0], "sample_rate": 1.0}, "error": "invalid_argument", "source": "not finite"},
    {"id": "coherence.zero_rate", "op": "coherence", "args": {"x": [1.0, 2.0], "y": [1.0, 2.0], "sample_rate": 0.0}, "error": "invalid_argument", "source": "sample_rate must be positive"},
    {"id": "coherence.long_segment", "op": "coherence", "args": {"x": [1.0, 2.0], "y": [1.0, 2.0], "sample_rate": 1.0, "nperseg": 3}, "error": "invalid_argument", "source": "fewer samples than nperseg"}
  ]
}
