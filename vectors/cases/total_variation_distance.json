{
  "schema": 1,
  "suite": "total_variation_distance",
  "description": "The total variation distance (conventions: total variation distance; ADR 0411).",
  "cases": [
    {"id": "total_variation_distance.same", "op": "total_variation_distance", "args": {"p": [1.0, 2.0, 3.0], "q": [2.0, 4.0, 6.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "the same distribution after scaling: 0"},
    {"id": "total_variation_distance.disjoint", "op": "total_variation_distance", "args": {"p": [1.0, 0.0], "q": [0.0, 3.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "no common support: 1"},
    {"id": "total_variation_distance.half", "op": "total_variation_distance", "args": {"p": [1.0, 0.0], "q": [1.0, 1.0]}, "expected": 0.5, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "P = (1, 0), Q = (1/2, 1/2): (1/2 + 1/2)/2 = 1/2"},
    {"id": "total_variation_distance.event", "op": "total_variation_distance", "args": {"p": [3.0, 1.0, 1.0, 5.0], "q": [1.0, 1.0, 3.0, 5.0]}, "expected": 0.2, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "P = (3, 1, 1, 5)/10, Q = (1, 1, 3, 5)/10: the event {0} differs most, by 2/10"},
    {"id": "total_variation_distance.counts", "op": "total_variation_distance", "args": {"p": [1.0, 0.0, 2.0, 1.0, 4.0, 1.0, 1.0, 3.0, 3.0, 1.0, 6.0, 0.0, 5.0, 5.0, 4.0, 6.0], "q": [4.0, 6.0, 0.0, 5.0, 1.0, 0.0, 2.0, 4.0, 4.0, 5.0, 6.0, 5.0, 2.0, 5.0, 2.0, 4.0]}, "expected": 0.40380549682875266, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "16 counts each from random.Random(411), 0 to 6, with zeros"},
    {"id": "total_variation_distance.huge_p", "op": "total_variation_distance", "args": {"p": [1e+308, 9e+307, 1e+300], "q": [1.0, 2.0, 3.0]}, "expected": 0.49999999473684215, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "p sums past the largest double: the result is that of p scaled down"},
    {"id": "total_variation_distance.huge_q", "op": "total_variation_distance", "args": {"p": [1.0, 2.0, 3.0], "q": [1.5e+308, 1e+308, 2e+307]}, "expected": 0.42592592592592593, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "q sums past the largest double: the result is that of q scaled down"},
    {"id": "total_variation_distance.empty", "op": "total_variation_distance", "args": {"p": [], "q": []}, "error": "invalid_argument", "source": "p needs a value"},
    {"id": "total_variation_distance.lengths", "op": "total_variation_distance", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, 1.0]}, "error": "invalid_argument", "source": "p and q must match"},
    {"id": "total_variation_distance.negative", "op": "total_variation_distance", "args": {"p": [1.0, -0.5, 3.0], "q": [2.0, 1.0, 0.0]}, "error": "invalid_argument", "source": "values must be non-negative"},
    {"id": "total_variation_distance.not_finite", "op": "total_variation_distance", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, "-inf", 1.0]}, "error": "invalid_argument", "source": "values must be finite"},
    {"id": "total_variation_distance.zero_sum", "op": "total_variation_distance", "args": {"p": [1.0, 2.0, 3.0], "q": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "q must have a positive sum"}
  ]
}
