{
  "schema": 1,
  "suite": "autocorrelation",
  "description": "Autocorrelation (conventions: Pulse shaping, Autocorrelation; ADR 0148).",
  "cases": [
    {"id": "autocorrelation.biased", "op": "autocorrelation", "args": {"samples": [1.0, 2.0, 3.0]}, "expected": [4.666666666666667, 2.6666666666666665, 1.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x = 1, 2, 3: r0 = 1 + 4 + 9 = 14, r1 = 2\u00b71 + 3\u00b72 = 8, r2 = 3\u00b71 = 3; over N = 3 (the default scaling)"},
    {"id": "autocorrelation.unbiased", "op": "autocorrelation", "args": {"samples": [1.0, 2.0, 3.0], "scaling": "unbiased"}, "expected": [4.666666666666667, 4.0, 3.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x = 1, 2, 3: r0 = 1 + 4 + 9 = 14, r1 = 2\u00b71 + 3\u00b72 = 8, r2 = 3\u00b71 = 3; over 3, 2, 1"},
    {"id": "autocorrelation.none", "op": "autocorrelation", "args": {"samples": [1.0, 2.0, 3.0], "scaling": "none"}, "expected": [14.0, 8.0, 3.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x = 1, 2, 3: r0 = 1 + 4 + 9 = 14, r1 = 2\u00b71 + 3\u00b72 = 8, r2 = 3\u00b71 = 3; not scaled"},
    {"id": "autocorrelation.complex", "op": "autocorrelation", "args": {"samples": {"re": [1.0, 2.0, 0.0], "im": [1.0, 0.0, -1.0]}, "scaling": "none"}, "expected": {"re": [7.0, 2.0, -1.0], "im": [0.0, -4.0, -1.0]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x = 1+i, 2, -i: r0 = 2 + 4 + 1 = 7; r1 = 2(1-i) + (-i)(2) = 2 - 4i; r2 = (-i)(1-i) = -1 - i; not scaled"},
    {"id": "autocorrelation.complex_biased", "op": "autocorrelation", "args": {"samples": {"re": [1.0, 2.0, 0.0], "im": [1.0, 0.0, -1.0]}}, "expected": {"re": [2.3333333333333335, 0.6666666666666666, -0.3333333333333333], "im": [0.0, -1.3333333333333333, -0.3333333333333333]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "the complex case over N = 3"},
    {"id": "autocorrelation.max_lag", "op": "autocorrelation", "args": {"samples": [1.0, -1.0, 1.0, -1.0], "max_lag": 1, "scaling": "none"}, "expected": [4.0, -3.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x = 1, -1, 1, -1 to lag 1: r0 = 4, r1 = -1 - 1 - 1 = -3; not scaled"},
    {"id": "autocorrelation.single", "op": "autocorrelation", "args": {"samples": [5.0]}, "expected": [25.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "one sample: r0 = 25 over N = 1"},
    {"id": "autocorrelation.empty", "op": "autocorrelation", "args": {"samples": []}, "error": "invalid_argument", "source": "needs at least one sample"},
    {"id": "autocorrelation.max_lag_too_big", "op": "autocorrelation", "args": {"samples": [1.0, 2.0, 3.0], "max_lag": 3}, "error": "invalid_argument", "source": "max_lag must be at most N - 1 = 2"},
    {"id": "autocorrelation.negative_max_lag", "op": "autocorrelation", "args": {"samples": [1.0, 2.0, 3.0], "max_lag": -1}, "error": "invalid_argument", "source": "max_lag must be non-negative"},
    {"id": "autocorrelation.bad_scaling", "op": "autocorrelation", "args": {"samples": [1.0, 2.0, 3.0], "scaling": "coeff"}, "error": "invalid_argument", "source": "scaling must be biased, unbiased or none"},
    {"id": "autocorrelation.nan", "op": "autocorrelation", "args": {"samples": [1.0, "nan"]}, "error": "invalid_argument", "source": "samples must be finite"}
  ]
}
