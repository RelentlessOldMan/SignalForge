    {"id": "somers_d.nan", "op": "somers_d", "args": {"x": [0.0, 1.0, 0.5, 2.0, 3.0], "y": [0.0, "nan", 1.0, 2.0, 3.0]}, "error": "invalid_argument", "source": "samples must be finite"}
