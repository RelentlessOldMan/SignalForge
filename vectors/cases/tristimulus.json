{
  "schema": 1,
  "suite": "tristimulus",
  "description": "Tristimulus (conventions: Spectra, Tristimulus; ADR 0142).",
  "cases": [
    {"id": "tristimulus.all_bands", "op": "tristimulus", "args": {"heights": [16.0, 4.0, 1.0, 1.0, 4.0, 9.0], "orders": [1, 2, 3, 4, 5, 6]}, "expected": {"first": 0.3076923076923077, "second": 0.3076923076923077, "third": 0.38461538461538464}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "amplitudes 4 | 2 + 1 + 1 | 2 + 3 of 13: 4/13, 4/13, 5/13"},
    {"id": "tristimulus.fundamental_only", "op": "tristimulus", "args": {"heights": [9.0], "orders": [1]}, "expected": {"first": 1.0, "second": 0.0, "third": 0.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "all of it in the fundamental: 1, 0, 0"},
    {"id": "tristimulus.missing_fundamental", "op": "tristimulus", "args": {"heights": [4.0, 1.0], "orders": [2, 7]}, "expected": {"first": 0.0, "second": 0.6666666666666666, "third": 0.3333333333333333}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "amplitudes 2 | 1 of 3: 0, 2/3, 1/3"},
    {"id": "tristimulus.unmatched", "op": "tristimulus", "args": {"heights": [25.0, 100.0, 9.0], "orders": [1, 0, 3]}, "expected": {"first": 0.625, "second": 0.375, "third": 0.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "order 0 left out: amplitudes 5 | 3 of 8: 5/8, 3/8, 0"},
    {"id": "tristimulus.nothing", "op": "tristimulus", "args": {"heights": [1.0, 4.0], "orders": [0, 0]}, "error": "invalid_argument", "source": "no harmonic tones"},
    {"id": "tristimulus.all_silent", "op": "tristimulus", "args": {"heights": [0.0, 0.0], "orders": [1, 2]}, "error": "invalid_argument", "source": "the harmonics have no power"},
    {"id": "tristimulus.length_mismatch", "op": "tristimulus", "args": {"heights": [1.0, 4.0], "orders": [1]}, "error": "invalid_argument", "source": "orders is shorter than heights"},
    {"id": "tristimulus.negative_height", "op": "tristimulus", "args": {"heights": [1.0, -4.0], "orders": [1, 2]}, "error": "invalid_argument", "source": "heights must be non-negative"},
    {"id": "tristimulus.negative_order", "op": "tristimulus", "args": {"heights": [1.0, 4.0], "orders": [1, -2]}, "error": "invalid_argument", "source": "orders must be >= 0"}
  ]
}
