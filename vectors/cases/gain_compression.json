{
  "schema": 1,
  "suite": "gain_compression",
  "description": "Gain compression and the 1 dB point from a drive sweep (conventions: Gain compression; ADR 0112).",
  "cases": [
    {"id": "gain_compression.p1db", "op": "gain_compression", "args": {"input_db": [-30.0, -25.0, -20.0, -15.0, -10.0, -5.0, 0.0], "output_db": [-20.0, -15.0, -10.0, -5.5, -1.0, 2.0, 4.0]}, "expected": {"small_signal_gain_db": 10.0, "gain_db": [10.0, 10.0, 10.0, 9.5, 9.0, 7.0, 4.0], "compression": [0.0, 0.0, 0.0, 0.5, 1.0, 3.0, 6.0], "input_point_db": -10.0, "output_point_db": -1.0, "saturated_output_db": 4.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: compression first reaches 1 dB at -10 dBm in, exactly a step; output -10 + 10 - 1 = -1; the largest output is 4"},
    {"id": "gain_compression.p2db_between_steps", "op": "gain_compression", "args": {"input_db": [-30.0, -25.0, -20.0, -15.0, -10.0, -5.0, 0.0], "output_db": [-20.0, -15.0, -10.0, -5.5, -1.0, 2.0, 4.0], "compression_db": 2.0}, "expected": {"small_signal_gain_db": 10.0, "gain_db": [10.0, 10.0, 10.0, 9.5, 9.0, 7.0, 4.0], "compression": [0.0, 0.0, 0.0, 0.5, 1.0, 3.0, 6.0], "input_point_db": -7.5, "output_point_db": 0.5, "saturated_output_db": 4.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: 2 dB lies between 1 at -10 and 3 at -5, halfway: -7.5 in, output -7.5 + 10 - 2 = 0.5"},
    {"id": "gain_compression.p05db_from_the_first_rise", "op": "gain_compression", "args": {"input_db": [-30.0, -25.0, -20.0, -15.0, -10.0, -5.0, 0.0], "output_db": [-20.0, -15.0, -10.0, -5.5, -1.0, 2.0, 4.0], "compression_db": 0.25}, "expected": {"small_signal_gain_db": 10.0, "gain_db": [10.0, 10.0, 10.0, 9.5, 9.0, 7.0, 4.0], "compression": [0.0, 0.0, 0.0, 0.5, 1.0, 3.0, 6.0], "input_point_db": -17.5, "output_point_db": -7.75, "saturated_output_db": 4.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: 0.25 dB lies halfway between 0 at -20 and 0.5 at -15: -17.5 in, output -17.5 + 10 - 0.25 = -7.75"},
    {"id": "gain_compression.not_reached", "op": "gain_compression", "args": {"input_db": [-30.0, -25.0, -20.0, -15.0, -10.0, -5.0, 0.0], "output_db": [-20.0, -15.0, -10.0, -5.5, -1.0, 2.0, 4.0], "compression_db": 7.0}, "expected": {"small_signal_gain_db": 10.0, "gain_db": [10.0, 10.0, 10.0, 9.5, 9.0, 7.0, 4.0], "compression": [0.0, 0.0, 0.0, 0.5, 1.0, 3.0, 6.0], "input_point_db": "nan", "output_point_db": "nan", "saturated_output_db": 4.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: the compression never reaches 7 dB (6 at most), so both points are NaN"},
    {"id": "gain_compression.averaged_small_signal", "op": "gain_compression", "args": {"input_db": [-30.0, -20.0, -10.0, 0.0], "output_db": [-19.75, -10.25, 0.0, 8.0], "linear_points": 3}, "expected": {"small_signal_gain_db": 10.0, "gain_db": [10.25, 9.75, 10.0, 8.0], "compression": [-0.25, 0.25, 0.0, 2.0], "input_point_db": -5.0, "output_point_db": 4.0, "saturated_output_db": 8.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: the first three gains 10.25, 9.75, 10 average to 10, so the compressions are -0.25, 0.25, 0, 2; 1 dB lies halfway between 0 at -10 and 2 at 0: -5 in, output -5 + 10 - 1 = 4"},
    {"id": "gain_compression.reached_at_the_first_step", "op": "gain_compression", "args": {"input_db": [-20.0, -10.0, 0.0], "output_db": [-11.0, 1.0, 10.0], "linear_points": 2}, "expected": {"small_signal_gain_db": 10.0, "gain_db": [9.0, 11.0, 10.0], "compression": [1.0, -1.0, 0.0], "input_point_db": -20.0, "output_point_db": -11.0, "saturated_output_db": 10.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: gains 9 and 11 average to 10, so the first step is already 1 dB down: the point is the first input, -20, output -20 + 10 - 1 = -11"},
    {"id": "gain_compression.cubic", "op": "gain_compression", "args": {"input_db": [-20.0, -18.0, -16.0, -14.0, -12.0, -10.0, -8.0, -6.0, -4.0, -2.0, 0.0, 2.0, 4.0], "output_db": [-0.006516861357150441, 1.9896692033109984, 3.98362109067056, 5.9740268431936965, 7.958799244280242, 9.934610308703055, 11.896134907996721, 13.83480423132714, 15.736705796513581, 17.578924541024183, 19.322834654780653, 20.900829437126077, 22.186931924033516]}, "expected": {"small_signal_gain_db": 19.99348313864285, "gain_db": [19.99348313864285, 19.989669203311, 19.98362109067056, 19.9740268431937, 19.958799244280243, 19.934610308703057, 19.89613490799672, 19.83480423132714, 19.736705796513583, 19.578924541024183, 19.322834654780653, 18.900829437126077, 18.186931924033516], "compression": [0.0, 0.0038139353318520364, 0.009862047972291066, 0.01945629544915306, 0.034683894362608214, 0.05887282993979426, 0.09734823064612996, 0.15867890731571066, 0.2567773421292685, 0.41455859761866876, 0.6706484838621982, 1.0926537015167739, 1.8065512146093354], "input_point_db": 1.5608883604248998, "output_point_db": 20.554371499067752, "saturated_output_db": 22.186931924033516}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: levels from a1 A + (3/4) a3 A^3 with a1 = 10, a3 = -1, A = 10^(d/20); the point interpolates linearly in dB between the steps either side of 1 dB"},
    {"id": "gain_compression.lengths_differ", "op": "gain_compression", "args": {"input_db": [-30.0, -25.0, -20.0, -15.0, -10.0, -5.0, 0.0], "output_db": [-20.0, -15.0, -10.0, -5.5, -1.0, 2.0]}, "error": "invalid_argument", "source": "input_db and output_db need the same length"},
    {"id": "gain_compression.one_step", "op": "gain_compression", "args": {"input_db": [0.0], "output_db": [10.0]}, "error": "invalid_argument", "source": "at least two steps required"},
    {"id": "gain_compression.not_ascending", "op": "gain_compression", "args": {"input_db": [-10.0, -10.0, 0.0], "output_db": [0.0, 0.0, 9.0]}, "error": "invalid_argument", "source": "input_db must be strictly ascending"},
    {"id": "gain_compression.nan_output", "op": "gain_compression", "args": {"input_db": [-10.0, 0.0], "output_db": [0.0, "nan"]}, "error": "invalid_argument", "source": "levels must be finite"},
    {"id": "gain_compression.compression_zero", "op": "gain_compression", "args": {"input_db": [-30.0, -25.0, -20.0, -15.0, -10.0, -5.0, 0.0], "output_db": [-20.0, -15.0, -10.0, -5.5, -1.0, 2.0, 4.0], "compression_db": 0.0}, "error": "invalid_argument", "source": "compression_db > 0 required"},
    {"id": "gain_compression.linear_points_zero", "op": "gain_compression", "args": {"input_db": [-30.0, -25.0, -20.0, -15.0, -10.0, -5.0, 0.0], "output_db": [-20.0, -15.0, -10.0, -5.5, -1.0, 2.0, 4.0], "linear_points": 0}, "error": "invalid_argument", "source": "linear_points must be at least 1"},
    {"id": "gain_compression.linear_points_too_many", "op": "gain_compression", "args": {"input_db": [-30.0, -25.0, -20.0, -15.0, -10.0, -5.0, 0.0], "output_db": [-20.0, -15.0, -10.0, -5.5, -1.0, 2.0, 4.0], "linear_points": 8}, "error": "invalid_argument", "source": "linear_points must not exceed the number of steps (7)"}
  ]
}
