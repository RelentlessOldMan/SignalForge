{
  "schema": 1,
  "suite": "cross_correlation",
  "description": "Cross-correlation (conventions: Cross-correlation; ADR 0190).",
  "cases": [
    {"id": "cross_correlation.longer_x", "op": "cross_correlation", "args": {"x": [1.0, 2.0, 3.0], "y": [1.0, 0.5]}, "expected": [0.5, 2.0, 3.5, 3.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "lags -1..2: k=-1: x0 y1 = 0.5; k=0: x0 y0 + x1 y1 = 1 + 1 = 2; k=1: x1 y0 + x2 y1 = 2 + 1.5 = 3.5; k=2: x2 y0 = 3"},
    {"id": "cross_correlation.longer_y", "op": "cross_correlation", "args": {"x": [2.0, -1.0], "y": [1.0, 3.0, 4.0]}, "expected": [8.0, 2.0, -1.0, -1.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "lags -2..1: k=-2: x0 y2 = 8; k=-1: x0 y1 + x1 y2 = 6 - 4 = 2; k=0: x0 y0 + x1 y1 = 2 - 3 = -1; k=1: x1 y0 = -1"},
    {"id": "cross_correlation.single", "op": "cross_correlation", "args": {"x": [3.0], "y": [-2.0]}, "expected": [-6.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "1 x 1: lag 0 only, 3 * -2"},
    {"id": "cross_correlation.delayed", "op": "cross_correlation", "args": {"x": [0.0, 0.0, 1.0, 0.5, 0.0], "y": [1.0, 0.5, 0.0]}, "expected": [0.0, 0.0, 0.0, 0.5, 1.25, 0.5, 0.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x[n] = y[n - 2], lags -2..4: k = 1: x1 y0 + x2 y1 = 0.5; k = 2: x2 y0 + x3 y1 = 1.25; k = 3: x3 y0 + x4 y1 = 0.5; every other lag 0. The peak is at lag 2, index 4"},
    {"id": "cross_correlation.complex", "op": "cross_correlation", "args": {"x": {"re": [0.0, 2.0], "im": [1.0, 0.0]}, "y": {"re": [1.0, 0.0], "im": [0.0, 1.0]}}, "expected": {"re": [1.0, -0.0, 2.0], "im": [0.0, -1.0, 0.0]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "lags -1..1: k=-1: x0 conj y1 = j(-j) = 1; k=0: x0 conj y0 + x1 conj y1 = j + 2(-j) = -j; k=1: x1 conj y0 = 2"},
    {"id": "cross_correlation.mixed", "op": "cross_correlation", "args": {"x": [1.0, 2.0], "y": {"re": [0.0, 1.0], "im": [1.0, 0.0]}}, "expected": {"re": [1.0, 2.0, -0.0], "im": [0.0, -1.0, -2.0]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "real x, complex y: k=-1: x0 conj y1 = 1; k=0: x0 conj y0 + x1 conj y1 = -j + 2; k=1: x1 conj y0 = 2(-j) = -2j"},
    {"id": "cross_correlation.empty_x", "op": "cross_correlation", "args": {"x": [], "y": [1.0]}, "error": "invalid_argument", "source": "x empty"},
    {"id": "cross_correlation.empty_y", "op": "cross_correlation", "args": {"x": [1.0], "y": []}, "error": "invalid_argument", "source": "y empty"},
    {"id": "cross_correlation.nan", "op": "cross_correlation", "args": {"x": [1.0, "nan"], "y": [1.0]}, "error": "invalid_argument", "source": "not finite"}
  ]
}
