{
  "schema": 1,
  "suite": "zenga_index",
  "description": "The Zenga index (conventions: the Zenga index; ADR 0521).",
  "cases": [
    {"id": "zenga_index.equal", "op": "zenga_index", "args": {"samples": [2.0, 2.0, 2.0]}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "every value equal: 0"},
    {"id": "zenga_index.one_holds_all", "op": "zenga_index", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "one of four holds the total: 1"},
    {"id": "zenga_index.two", "op": "zenga_index", "args": {"samples": [3.0, 1.0]}, "expected": 0.6666666666666666, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "1 against 3: 2/3"},
    {"id": "zenga_index.ramp", "op": "zenga_index", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.5793650793650794, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "ratios 1/3, 3/2 over 7/2, 2/4: 1 - (53/42)/3 = 73/126"},
    {"id": "zenga_index.three", "op": "zenga_index", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.9166666666666666, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "ratios 0, (1/2)/3: 1 - (1/6)/2 = 11/12"},
    {"id": "zenga_index.halves", "op": "zenga_index", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.6349206349206349, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "ratios (1/4)/(7/12), (1/4)/(3/4), (1/3)/1: 1 - (23/21)/3 = 40/63"},
    {"id": "zenga_index.random", "op": "zenga_index", "args": {"samples": [1.5, 0.0, 4.875, 4.0, 6.5, 2.75, 5.625, 5.625, 1.5, 5.125, 4.25, 4.875, 2.0, 0.5, 6.625, 2.75, 5.375, 2.0, 1.25, 6.125, 5.0, 4.375, 7.625, 0.0, 2.75, 1.25, 8.0, 5.375, 0.875, 0.625]}, "expected": 0.7345723045084617, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "30 values k/8, k from random.Random(521).randint(0, 64)"},
    {"id": "zenga_index.huge", "op": "zenga_index", "args": {"samples": [1e+308, 9e+307, 1e+300]}, "expected": 0.7749999922368421, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "values whose sum overflows a double: the result is that of the values scaled down"},
    {"id": "zenga_index.empty", "op": "zenga_index", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs at least 2 values"},
    {"id": "zenga_index.single", "op": "zenga_index", "args": {"samples": [5.0]}, "error": "invalid_argument", "source": "the record needs at least 2 values"},
    {"id": "zenga_index.negative", "op": "zenga_index", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "zenga_index.all_zero", "op": "zenga_index", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
