{
  "schema": 1,
  "suite": "camargo_evenness",
  "description": "Camargo's evenness (conventions: Camargo's evenness; ADR 0533).",
  "cases": [
    {"id": "camargo_evenness.equal", "op": "camargo_evenness", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "four equal shares, no gaps: 1"},
    {"id": "camargo_evenness.single", "op": "camargo_evenness", "args": {"samples": [5.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "one value, no pairs: 1"},
    {"id": "camargo_evenness.one_holds_all", "op": "camargo_evenness", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 0.25, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "three gaps of 1: 1 - 3/4 = 1/4"},
    {"id": "camargo_evenness.two", "op": "camargo_evenness", "args": {"samples": [3.0, 1.0]}, "expected": 0.75, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "shares 3/4, 1/4: 1 - (1/2)/2 = 3/4"},
    {"id": "camargo_evenness.ramp", "op": "camargo_evenness", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.75, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "shares 4, 1, 3, 2 tenths, gaps summing to 1: 1 - 1/4 = 3/4"},
    {"id": "camargo_evenness.three", "op": "camargo_evenness", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.5, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "gaps 3/4, 1/2, 1/4: 1 - (3/2)/3 = 1/2"},
    {"id": "camargo_evenness.halves", "op": "camargo_evenness", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.6875, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "shares 1/4, 1/8, 1/8, 1/2, gaps summing to 5/4: 1 - 5/16 = 11/16"},
    {"id": "camargo_evenness.random", "op": "camargo_evenness", "args": {"samples": [6.0, 2.625, 5.875, 4.125, 6.5, 0.75, 7.75, 5.625, 4.5, 2.875, 6.0, 2.125, 1.75, 5.625, 0.375, 4.75, 1.875, 3.25, 8.0, 2.25, 4.125, 1.5, 0.0, 2.125, 0.0, 3.75, 7.875, 1.875, 0.125, 0.25]}, "expected": 0.5976818545163869, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "30 values k/8, k from random.Random(533).randint(0, 64)"},
    {"id": "camargo_evenness.huge", "op": "camargo_evenness", "args": {"samples": [1e+308, 9e+307, 1e+300]}, "expected": 0.6491228123730378, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "values whose sum overflows a double: the result is that of the values scaled down"},
    {"id": "camargo_evenness.empty", "op": "camargo_evenness", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "camargo_evenness.negative", "op": "camargo_evenness", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "camargo_evenness.all_zero", "op": "camargo_evenness", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
