{
  "schema": 1,
  "suite": "morisita_horn_overlap",
  "description": "The Morisita-Horn overlap (conventions: Morisita-Horn overlap; ADR 0573).",
  "cases": [
    {"id": "morisita_horn_overlap.same", "op": "morisita_horn_overlap", "args": {"x": [1.0, 2.0, 3.0], "y": [1.0, 2.0, 3.0]}, "expected": 1.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "identical records: 1"},
    {"id": "morisita_horn_overlap.proportional", "op": "morisita_horn_overlap", "args": {"x": [1.0, 2.0, 3.0], "y": [2.0, 4.0, 6.0]}, "expected": 1.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "proportional records: 1"},
    {"id": "morisita_horn_overlap.disjoint", "op": "morisita_horn_overlap", "args": {"x": [1.0, 0.0], "y": [0.0, 1.0]}, "expected": 0.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "no shared resource: 0"},
    {"id": "morisita_horn_overlap.half", "op": "morisita_horn_overlap", "args": {"x": [1.0, 1.0], "y": [1.0, 0.0]}, "expected": 0.6666666666666666, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "2(1/2)/(1/2 + 1) = 2/3"},
    {"id": "morisita_horn_overlap.reversed", "op": "morisita_horn_overlap", "args": {"x": [1.0, 2.0, 3.0], "y": [3.0, 2.0, 1.0]}, "expected": 0.7142857142857143, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "2(10/36)/(28/36) = 5/7"},
    {"id": "morisita_horn_overlap.shifted", "op": "morisita_horn_overlap", "args": {"x": [1.0, 1.0, 2.0], "y": [2.0, 1.0, 1.0]}, "expected": 0.8333333333333334, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "2(5/16)/(12/16) = 5/6"},
    {"id": "morisita_horn_overlap.huge", "op": "morisita_horn_overlap", "args": {"x": [1e+300, 2e+300], "y": [1.0, 3.0]}, "expected": 0.9882352941176471, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "2(7/12)/(5/9 + 5/8) = 84/85: totals would overflow"},
    {"id": "morisita_horn_overlap.tiny", "op": "morisita_horn_overlap", "args": {"x": [1e-300, 3e-301, 0.0], "y": [2.0, 5.0, 1.0]}, "expected": 0.6043499916984891, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "values near the bottom of the range"},
    {"id": "morisita_horn_overlap.random", "op": "morisita_horn_overlap", "args": {"x": [3.481, 3.255, 4.199, 4.714, 0.326, 2.743, 2.517, 4.732, 4.62, 4.889, 3.118, 0.601, 2.361, 3.629, 1.93, 1.841, 3.478, 1.76, 3.077, 2.222, 2.268, 1.719, 2.82, 0.296, 3.781], "y": [3.861, 4.894, 1.708, 3.455, 4.509, 3.422, 4.221, 2.631, 3.773, 1.228, 1.806, 3.461, 0.329, 3.885, 2.907, 2.315, 1.432, 3.541, 4.758, 0.765, 2.167, 1.584, 0.7, 0.926, 1.088]}, "expected": 0.8047461492846928, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x then y, 25 values each from random.Random(573).uniform(0, 5), 3 places"},
    {"id": "morisita_horn_overlap.empty", "op": "morisita_horn_overlap", "args": {"x": [], "y": []}, "error": "invalid_argument", "source": "a record needs a value"},
    {"id": "morisita_horn_overlap.negative", "op": "morisita_horn_overlap", "args": {"x": [1.0, 2.0, 3.0], "y": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "morisita_horn_overlap.all_zero", "op": "morisita_horn_overlap", "args": {"x": [0.0, 0.0, 0.0], "y": [3.0, 1.0, 2.0]}, "error": "invalid_argument", "source": "each record needs a value above 0"},
    {"id": "morisita_horn_overlap.lengths", "op": "morisita_horn_overlap", "args": {"x": [1.0, 2.0, 3.0], "y": [1.0, 2.0]}, "error": "invalid_argument", "source": "the records must have the same length"}
  ]
}
