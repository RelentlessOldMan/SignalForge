{
  "schema": 1,
  "suite": "yule_walker_psd",
  "description": "Yule-Walker AR PSD (conventions: Yule-Walker AR PSD; ADR 0203).",
  "cases": [
    {"id": "yule_walker_psd.ar1_two_samples", "op": "yule_walker_psd", "args": {"samples": [1.0, 2.0], "sample_rate": 1.0, "order": 1}, "expected": {"frequencies": [0.0, 0.5], "psd": [5.833333333333334, 1.0714285714285716], "sample_rate": 1.0, "nperseg": 2, "num_segments": 1, "one_sided": true, "bin_width": 0.5, "enbw_hz": 0.5, "nfft": 2}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "x = [1, 2]: r0 = 5/2, r1 = 1, a1 = -2/5, sigma^2 = 21/10; |A|^2 = 9/25 at DC, 49/25 at fs/2"},
    {"id": "yule_walker_psd.ar1_padded", "op": "yule_walker_psd", "args": {"samples": [1.0, 2.0], "sample_rate": 10.0, "order": 1, "nfft": 8}, "expected": {"frequencies": [0.0, 1.25, 2.5, 3.75, 5.0], "psd": [0.5833333333333334, 0.706696449374688, 0.36206896551724127, 0.24338155374543693, 0.10714285714285716], "sample_rate": 10.0, "nperseg": 2, "num_segments": 1, "one_sided": true, "bin_width": 1.25, "enbw_hz": 5.0, "nfft": 8}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "x = [1, 2], M = 8: sigma^2 / (fs (1 + a^2 + 2 a cos(2 pi k/8))), interior doubled"},
    {"id": "yule_walker_psd.ar1_two_sided", "op": "yule_walker_psd", "args": {"samples": [1.0, 2.0], "sample_rate": 4.0, "order": 1, "nfft": 4, "one_sided": false}, "expected": {"frequencies": [-2.0, -1.0, 0.0, 1.0], "psd": [0.2678571428571429, 0.4525862068965516, 1.4583333333333335, 0.4525862068965516], "sample_rate": 4.0, "nperseg": 2, "num_segments": 1, "one_sided": false, "bin_width": 1.0, "enbw_hz": 2.0, "nfft": 4}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "real input, one_sided = false: all 4 bins, shifted"},
    {"id": "yule_walker_psd.ar2", "op": "yule_walker_psd", "args": {"samples": [3.0, 1.0, -2.0, 0.0, 1.0], "sample_rate": 2.0, "order": 2, "nfft": 6}, "expected": {"frequencies": [0.0, 0.3333333333333333, 0.6666666666666666, 1.0], "psd": [0.5118012422360249, 3.501870854918005, 2.298356324577172, 0.39184782608695656], "sample_rate": 2.0, "nperseg": 5, "num_segments": 1, "one_sided": true, "bin_width": 0.3333333333333333, "enbw_hz": 0.4, "nfft": 6}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "order 2 by Cramer's rule on the biased r0, r1, r2; M = 6, interior doubled"},
    {"id": "yule_walker_psd.ar2_odd_bins", "op": "yule_walker_psd", "args": {"samples": [0.5, -1.0, 2.0, 1.5, -0.5, 0.25], "sample_rate": 1.0, "order": 2, "nfft": 7}, "expected": {"frequencies": [0.0, 0.14285714285714285, 0.2857142857142857, 0.42857142857142855], "psd": [0.8802742264097226, 2.4493011134541107, 3.4720998093388404, 2.32454955559765], "sample_rate": 1.0, "nperseg": 6, "num_segments": 1, "one_sided": true, "bin_width": 0.14285714285714285, "enbw_hz": 0.16666666666666666, "nfft": 7}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "order 2, M = 7 (odd): bins 0 .. 3, all but DC doubled"},
    {"id": "yule_walker_psd.complex_ar1", "op": "yule_walker_psd", "args": {"samples": {"re": [1.0, 0.0], "im": [0.0, 1.0]}, "sample_rate": 4.0, "order": 1, "nfft": 4}, "expected": {"frequencies": [-2.0, -1.0, 0.0, 1.0], "psd": [0.15000000000000005, 0.08333333333333333, 0.14999999999999997, 0.75], "sample_rate": 4.0, "nperseg": 2, "num_segments": 1, "one_sided": false, "bin_width": 1.0, "enbw_hz": 2.0, "nfft": 4}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "x = [1, i]: r0 = 1, r1 = i/2, a1 = -i/2, sigma^2 = 3/4; two-sided, shifted, M = 4"},
    {"id": "yule_walker_psd.complex_ar2", "op": "yule_walker_psd", "args": {"samples": {"re": [1.0, -0.5, 1.5, 0.0, -1.0], "im": [1.0, 2.0, -1.0, 0.25, 0.0]}, "sample_rate": 1.0, "order": 2}, "expected": {"frequencies": [-0.4, -0.2, 0.0, 0.2, 0.4], "psd": [1.1806759023712825, 2.806483330459941, 1.1841404746074757, 1.157471620905403, 5.084023317519823], "sample_rate": 1.0, "nperseg": 5, "num_segments": 1, "one_sided": false, "bin_width": 0.2, "enbw_hz": 0.2, "nfft": 5}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "complex order 2 by Cramer's rule with r[-1] = conj r1; M = 5, shifted"},
    {"id": "yule_walker_psd.order_zero", "op": "yule_walker_psd", "args": {"samples": [1.0, 2.0], "sample_rate": 1.0, "order": 0}, "error": "invalid_argument", "source": "order must be at least 1"},
    {"id": "yule_walker_psd.order_too_big", "op": "yule_walker_psd", "args": {"samples": [1.0, 2.0], "sample_rate": 1.0, "order": 2}, "error": "invalid_argument", "source": "order must be below the input length"},
    {"id": "yule_walker_psd.nfft_too_small", "op": "yule_walker_psd", "args": {"samples": [1.0, 2.0, 3.0, 4.0], "sample_rate": 1.0, "order": 2, "nfft": 2}, "error": "invalid_argument", "source": "nfft must be at least order + 1"},
    {"id": "yule_walker_psd.zero_rate", "op": "yule_walker_psd", "args": {"samples": [1.0, 2.0], "sample_rate": 0.0, "order": 1}, "error": "invalid_argument", "source": "sample_rate must be positive"},
    {"id": "yule_walker_psd.all_zero", "op": "yule_walker_psd", "args": {"samples": [0.0, 0.0, 0.0], "sample_rate": 1.0, "order": 1}, "error": "invalid_argument", "source": "r[0] = 0: Levinson needs r[0] > 0"},
    {"id": "yule_walker_psd.nan_sample", "op": "yule_walker_psd", "args": {"samples": [1.0, "nan", 2.0], "sample_rate": 1.0, "order": 1}, "error": "invalid_argument", "source": "samples must be finite"}
  ]
}
