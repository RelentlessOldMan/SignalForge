{
  "schema": 1,
  "suite": "strong_dominance",
  "description": "Strong's dominance (conventions: Strong's dominance; ADR 0549).",
  "cases": [
    {"id": "strong_dominance.equal", "op": "strong_dominance", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "every share 1/4: 0"},
    {"id": "strong_dominance.one_holds_all", "op": "strong_dominance", "args": {"samples": [0.0, 4.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "k = 1: 1 - 1 = 0"},
    {"id": "strong_dominance.two", "op": "strong_dominance", "args": {"samples": [3.0, 1.0]}, "expected": 0.25, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "3/4 - 1/2 = 1/4"},
    {"id": "strong_dominance.ramp3", "op": "strong_dominance", "args": {"samples": [1.0, 2.0, 3.0]}, "expected": 0.16666666666666666, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "1/2 - 1/3 = 5/6 - 2/3 = 1/6"},
    {"id": "strong_dominance.mixed", "op": "strong_dominance", "args": {"samples": [5.0, 1.0, 1.0, 0.0, 2.0]}, "expected": 0.3055555555555556, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "5/9 - 1/4 = 11/36"},
    {"id": "strong_dominance.dominant", "op": "strong_dominance", "args": {"samples": [10.0, 1.0, 1.0, 1.0, 1.0]}, "expected": 0.5142857142857142, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "10/14 - 1/5 = 18/35"},
    {"id": "strong_dominance.ramp", "op": "strong_dominance", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.2, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "7/10 - 2/4 = 1/5"},
    {"id": "strong_dominance.halves", "op": "strong_dominance", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.25, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "1/2 - 1/4 = 3/4 - 2/4 = 1/4"},
    {"id": "strong_dominance.random", "op": "strong_dominance", "args": {"samples": [3.125, 7.5, 2.5, 7.75, 2.875, 4.5, 6.125, 1.0, 5.125, 5.5, 1.375, 1.125, 3.25, 3.125, 2.75, 8.0, 0.875, 1.375, 6.625, 3.5, 4.25, 3.75, 4.75, 7.625, 7.375, 7.25, 5.5, 2.125, 0.75, 0.5]}, "expected": 0.25435897435897437, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "30 values k/8, k from random.Random(549).randint(0, 64)"},
    {"id": "strong_dominance.empty", "op": "strong_dominance", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "strong_dominance.negative", "op": "strong_dominance", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "strong_dominance.all_zero", "op": "strong_dominance", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
