{
  "schema": 1,
  "suite": "iacc",
  "description": "Interaural cross-correlation (conventions: Interaural cross-correlation; ADR 0174).",
  "cases": [
    {"id": "iacc.delayed_in_range", "op": "iacc", "args": {"left": [1.0, 0.5, -0.25, 0.0, 0.0, 0.0], "right": [0.0, 0.0, 1.0, 0.5, -0.25, 0.0], "sample_rate": 2000.0}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "right = left delayed 2 samples, L = 2: exactly 1"},
    {"id": "iacc.delayed_out_of_range", "op": "iacc", "args": {"left": [1.0, 0.5, -0.25, 0.0, 0.0, 0.0], "right": [0.0, 0.0, 1.0, 0.5, -0.25, 0.0], "sample_rate": 1000.0}, "expected": 0.2857142857142857, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "the same pair, L = 1: best is lag 1, |0.5 - 0.125| = 0.375 over E = 1.3125"},
    {"id": "iacc.inverted", "op": "iacc", "args": {"left": [1.0, -2.0, 3.0], "right": [-1.0, 2.0, -3.0], "sample_rate": 48000.0}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "right = -left: |R(0)| / E = 1"},
    {"id": "iacc.orthogonal", "op": "iacc", "args": {"left": [1.0, 0.0, 0.0, 0.0], "right": [0.0, 0.0, 0.0, 1.0], "sample_rate": 1000.0}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "impulses 3 samples apart, L = 1: no overlap, 0"},
    {"id": "iacc.lag_zero_only", "op": "iacc", "args": {"left": [1.0, 1.0], "right": [1.0, -1.0], "sample_rate": 1000.0, "max_lag": 0.0}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "max_lag 0: R(0) = 0"},
    {"id": "iacc.rounding", "op": "iacc", "args": {"left": [1.0, 0.0, 0.0, 0.0], "right": [0.0, 0.0, 0.0, 2.0], "sample_rate": 1000.0, "max_lag": 0.0026}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "max_lag 0.0026 s at 1 kHz: L = floor(3.1) = 3, the impulse pair aligns: 1"},
    {"id": "iacc.mixed", "op": "iacc", "args": {"left": [3.0, 1.0, -2.0, 0.5], "right": [1.0, 2.0, 0.0, -1.0], "sample_rate": 1000.0}, "expected": 0.8651809126974002, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "a hand pair, L = 1: R(-1) = -3, R(0) = 4.5, R(1) = 8; E = 14.25 * 6: 8/sqrt(85.5)"},
    {"id": "iacc.long_lag_clipped", "op": "iacc", "args": {"left": [1.0, 2.0], "right": [2.0, 1.0], "sample_rate": 100000.0}, "expected": 0.8, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "L = 100 clipped to 1: R(1) = 1, R(0) = 4, R(-1) = 4; 4/5"},
    {"id": "iacc.empty", "op": "iacc", "args": {"left": [], "right": [], "sample_rate": 1000.0}, "error": "invalid_argument", "source": "left and right must not be empty"},
    {"id": "iacc.unequal", "op": "iacc", "args": {"left": [1.0, 0.5], "right": [1.0], "sample_rate": 1000.0}, "error": "invalid_argument", "source": "left and right must have equal length"},
    {"id": "iacc.zero_left", "op": "iacc", "args": {"left": [0.0, 0.0], "right": [0.5, 1.0], "sample_rate": 1000.0}, "error": "invalid_argument", "source": "left must not be all zero"},
    {"id": "iacc.zero_right", "op": "iacc", "args": {"left": [1.0, 0.5], "right": [0.0, 0.0], "sample_rate": 1000.0}, "error": "invalid_argument", "source": "right must not be all zero"},
    {"id": "iacc.nan", "op": "iacc", "args": {"left": [1.0, "nan"], "right": [0.5, 1.0], "sample_rate": 1000.0}, "error": "invalid_argument", "source": "left must be finite"},
    {"id": "iacc.negative_lag", "op": "iacc", "args": {"left": [1.0, 0.5], "right": [0.5, 1.0], "sample_rate": 1000.0, "max_lag": -0.001}, "error": "invalid_argument", "source": "max_lag must be non-negative"},
    {"id": "iacc.zero_rate", "op": "iacc", "args": {"left": [1.0, 0.5], "right": [0.5, 1.0], "sample_rate": 0.0}, "error": "invalid_argument", "source": "sample_rate must be positive"},
    {"id": "iacc.huge", "op": "iacc", "args": {"left": [3.214525821558802e+301, 1.0715086071862673e+301, -2.1430172143725346e+301, 5.357543035931337e+300], "right": [1.0715086071862673e+301, 2.1430172143725346e+301, 0.0, -1.0715086071862673e+301], "sample_rate": 1000.0}, "expected": 0.8651809126974002, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "case mixed times 2^1000: squares of the samples overflow a double, but a normalized correlation is unchanged by a scale, so the same value"},
    {"id": "iacc.tiny", "op": "iacc", "args": {"left": [2.7997908555096566e-301, 9.332636185032189e-302, -1.8665272370064378e-301, 4.6663180925160944e-302], "right": [9.332636185032189e-302, 1.8665272370064378e-301, 0.0, -9.332636185032189e-302], "sample_rate": 1000.0}, "expected": 0.8651809126974002, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "case mixed times 2^-1000: squares of the samples underflow to 0, but a normalized correlation is unchanged by a scale, so the same value"}
  ]
}
