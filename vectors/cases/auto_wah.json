{
  "schema": 1,
  "suite": "auto_wah",
  "description": "Auto-wah (conventions: Auto-wah; ADR 0280).",
  "cases": [
    {"id": "auto_wah.fixed", "op": "auto_wah", "args": {"samples": [0.3, -0.7, 1.1, 0.4, -0.9, 0.2, 0.8, -0.6, 0.5, 1.3, -0.1, 0.05], "low": 0.1, "high": 0.1, "q": 2.0, "attack": 0.5, "release": 0.5, "sample_rate": 1.0, "mix": 1.0}, "expected": [0.038435882673372446, -0.03546099249326427, 0.023882624315156142, 0.20099805023451553, 0.009552225727793462, -0.16164275731421412, -0.017335863321732134, -0.006728402504547162, -0.03503412085083095, 0.19900781971944814, 0.22993196058378962, 0.016208676406403277], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "low = high = 0.1 fs, q 2, wet: k times the fixed band-pass"},
    {"id": "auto_wah.swept", "op": "auto_wah", "args": {"samples": [0.3, -0.7, 1.1, 0.4, -0.9, 0.2, 0.8, -0.6, 0.5, 1.3, -0.1, 0.05], "low": 0.02, "high": 0.3, "q": 4.0, "attack": 0.25, "release": 0.75, "sample_rate": 1.0, "mix": 0.7}, "expected": [0.10231073115312117, -0.24725272505096646, 0.3981145780671375, 0.19413770032708821, -0.5006736573279426, -0.02405351466205735, 0.5628716303747895, -0.10250224419123723, -0.12897106494957172, 0.4299300572299789, 0.08257928879639831, -0.18049757505732134], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "0.02 to 0.3 fs, q 4, attack 1/4, release 3/4, mix 0.7"},
    {"id": "auto_wah.loud", "op": "auto_wah", "args": {"samples": [2.0, -3.0, 2.5, -2.0, 4.0, -1.5, 3.0, -2.5], "low": 100.0, "high": 2000.0, "q": 1.5, "attack": 0.0, "release": 0.9, "sample_rate": 8000.0, "mix": 0.5}, "expected": [1.25, -1.875, 1.1875, -0.6875, 2.21875, -0.8437500000000001, 1.2656249999999998, -1.328125], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "envelope above 1 from the start: the cutoff sits at high, 2 kHz at 8 kHz"},
    {"id": "auto_wah.dry", "op": "auto_wah", "args": {"samples": [0.5, -1.0, 2.0], "low": 0.1, "high": 0.2, "q": 1.0, "attack": 0.5, "release": 0.5, "sample_rate": 1.0, "mix": 0.0}, "expected": [0.5, -1.0, 2.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "mix 0: the dry signal"},
    {"id": "auto_wah.complex", "op": "auto_wah", "args": {"samples": {"re": [1.0, 0.0, -0.5, 0.25, 0.75, -0.25], "im": [0.0, 1.0, 0.5, -1.0, 0.0, 0.5]}, "low": 0.05, "high": 0.25, "q": 3.0, "attack": 0.5, "release": 0.5, "sample_rate": 1.0, "mix": 0.5}, "expected": {"re": [0.5594077673064476, 0.04227632059331381, -0.3533651254184613, 0.06768432587032867, 0.5092319195507293, -0.05135253093918704], "im": [0.0, 0.5684109325010968, 0.3223580763096366, -0.6523823812143051, -0.14031283368141947, 0.4154620887937248]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "complex: envelope of |x|, filter part by part"},
    {"id": "auto_wah.low_zero", "op": "auto_wah", "args": {"samples": [1.0, 2.0], "low": 0.0, "high": 3.0, "q": 2.0, "attack": 0.5, "release": 0.5, "sample_rate": 8.0, "mix": 0.5}, "error": "invalid_argument", "source": "low must be positive"},
    {"id": "auto_wah.high_nyquist", "op": "auto_wah", "args": {"samples": [1.0, 2.0], "low": 1.0, "high": 4.0, "q": 2.0, "attack": 0.5, "release": 0.5, "sample_rate": 8.0, "mix": 0.5}, "error": "invalid_argument", "source": "high must be below fs/2"},
    {"id": "auto_wah.q_zero", "op": "auto_wah", "args": {"samples": [1.0, 2.0], "low": 1.0, "high": 3.0, "q": 0.0, "attack": 0.5, "release": 0.5, "sample_rate": 8.0, "mix": 0.5}, "error": "invalid_argument", "source": "q must be positive"},
    {"id": "auto_wah.release_one", "op": "auto_wah", "args": {"samples": [1.0, 2.0], "low": 1.0, "high": 3.0, "q": 2.0, "attack": 0.5, "release": 1.0, "sample_rate": 8.0, "mix": 0.5}, "error": "invalid_argument", "source": "release must be below 1"},
    {"id": "auto_wah.mix_high", "op": "auto_wah", "args": {"samples": [1.0, 2.0], "low": 1.0, "high": 3.0, "q": 2.0, "attack": 0.5, "release": 0.5, "sample_rate": 8.0, "mix": 2.0}, "error": "invalid_argument", "source": "mix must be at most 1"},
    {"id": "auto_wah.empty", "op": "auto_wah", "args": {"samples": [], "low": 1.0, "high": 3.0, "q": 2.0, "attack": 0.5, "release": 0.5, "sample_rate": 8.0, "mix": 0.5}, "error": "invalid_argument", "source": "samples must not be empty"}
  ]
}
