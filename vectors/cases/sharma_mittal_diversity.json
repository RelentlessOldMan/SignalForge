{
  "schema": 1,
  "suite": "sharma_mittal_diversity",
  "description": "The Sharma-Mittal diversity of counts (conventions: the Sharma-Mittal diversity of counts; ADR 0570).",
  "cases": [
    {"id": "sharma_mittal_diversity.hill", "op": "sharma_mittal_diversity", "args": {"samples": [1.0, 1.0, 2.0], "order": 2.0, "degree": 0.0}, "expected": 1.6666666666666667, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "r = 0: D_2 - 1 = 8/3 - 1 = 5/3"},
    {"id": "sharma_mittal_diversity.tsallis", "op": "sharma_mittal_diversity", "args": {"samples": [1.0, 1.0, 2.0], "order": 2.0, "degree": 2.0}, "expected": 0.625, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "r = q = 2: 1 - 3/8 = 5/8"},
    {"id": "sharma_mittal_diversity.renyi", "op": "sharma_mittal_diversity", "args": {"samples": [1.0, 1.0], "order": 2.0, "degree": 1.0}, "expected": 0.6931471805599453, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "r = 1: ln 2"},
    {"id": "sharma_mittal_diversity.shannon_exp", "op": "sharma_mittal_diversity", "args": {"samples": [1.0, 1.0, 2.0], "order": 1.0, "degree": 0.0}, "expected": 1.82842712474619, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "q = 1, r = 0: 2^1.5 - 1"},
    {"id": "sharma_mittal_diversity.richness", "op": "sharma_mittal_diversity", "args": {"samples": [0.0, 3.0, 5.0], "order": 0.0, "degree": 0.0}, "expected": 1.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "q = 0, r = 0: K - 1 = 1"},
    {"id": "sharma_mittal_diversity.cube", "op": "sharma_mittal_diversity", "args": {"samples": [1.0, 1.0, 2.0], "order": 2.0, "degree": 3.0}, "expected": 0.4296875, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "((3/8)^2 - 1)/(-2) = 55/128"},
    {"id": "sharma_mittal_diversity.one_kind", "op": "sharma_mittal_diversity", "args": {"samples": [0.0, 4.0], "order": 2.0, "degree": 0.5}, "expected": 0.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "one kind: 0"},
    {"id": "sharma_mittal_diversity.near_one_degree", "op": "sharma_mittal_diversity", "args": {"samples": [2.0, 0.5, 3.25, 1.0], "order": 1.5, "degree": 1.0000001}, "expected": 1.1152737641659165, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "r just above 1: the expm1 form"},
    {"id": "sharma_mittal_diversity.near_one_order", "op": "sharma_mittal_diversity", "args": {"samples": [2.0, 0.5, 3.25, 1.0], "order": 1.000001, "degree": 2.5}, "expected": 0.5544673896807433, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "q just above 1"},
    {"id": "sharma_mittal_diversity.negative_degree", "op": "sharma_mittal_diversity", "args": {"samples": [2.0, 0.5, 3.25, 1.0, 0.0], "order": 0.5, "degree": -3.0}, "expected": 41.37334654047502, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "r = -3"},
    {"id": "sharma_mittal_diversity.random", "op": "sharma_mittal_diversity", "args": {"samples": [0.381, 0.073, 0.249, 4.965, 1.306, 2.734, 1.154, 1.857, 4.362, 1.985, 0.364, 1.64, 3.437, 3.562, 3.836, 2.236, 4.754, 3.455, 2.656, 2.13, 2.934, 0.958, 3.588, 0.055, 2.149, 4.665, 4.901, 0.857, 2.177, 4.413], "order": 1.75, "degree": 0.25}, "expected": 12.211322867857502, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "30 values from random.Random(570).uniform(0, 5), 3 places, q = 1.75, r = 0.25"},
    {"id": "sharma_mittal_diversity.empty", "op": "sharma_mittal_diversity", "args": {"samples": [], "order": 2.0, "degree": 0.5}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "sharma_mittal_diversity.negative", "op": "sharma_mittal_diversity", "args": {"samples": [1.0, -0.5, 2.0], "order": 2.0, "degree": 0.5}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "sharma_mittal_diversity.all_zero", "op": "sharma_mittal_diversity", "args": {"samples": [0.0, 0.0, 0.0], "order": 2.0, "degree": 0.5}, "error": "invalid_argument", "source": "the total must be positive"},
    {"id": "sharma_mittal_diversity.negative_order", "op": "sharma_mittal_diversity", "args": {"samples": [1.0, 2.0, 3.0], "order": -0.5, "degree": 0.5}, "error": "invalid_argument", "source": "the order must be at least 0"}
  ]
}
