{
  "schema": 1,
  "suite": "fisher_information",
  "description": "Fisher information (conventions: Fisher information; ADR 0351).",
  "cases": [
    {"id": "fisher_information.orthogonal", "op": "fisher_information", "args": {"samples": [1.0, 0.0, -1.0, 0.0, 1.0], "order": 2}, "expected": 0.0, "tol": {"abs": 1e-12, "rel": 1e-11}, "source": "rows (1,0), (0,-1), (-1,0), (0,1): A^T A = 2I, a flat spectrum, so 0"},
    {"id": "fisher_information.ramp", "op": "fisher_information", "args": {"samples": [1.0, 2.0, 3.0, 4.0], "order": 2}, "expected": 0.8409057982572898, "tol": {"abs": 1e-12, "rel": 1e-11}, "source": "rows (1,2), (2,3), (3,4): A^T A = [[14, 20], [20, 29]], closed form; with p = s/sum, (p2 - p1)^2 / p1"},
    {"id": "fisher_information.mixed_order_3", "op": "fisher_information", "args": {"samples": [0.25, -1.5, 3.0, 2.75, -0.5, 0.125, 1.0, -2.25, 0.375, 2.5, -1.25, 0.75], "order": 3}, "expected": 0.021659219176217145, "tol": {"abs": 1e-12, "rel": 1e-11}, "source": "twelve arbitrary samples, Jacobi on the exact Gram matrix"},
