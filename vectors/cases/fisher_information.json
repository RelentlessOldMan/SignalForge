    {"id": "fisher_information.square", "op": "fisher_information", "args": {"samples": [0.5, -1.0, 2.0, 0.75, 1.5], "order": 3}, "expected": 0.06904461910412232, "tol": {"abs": 1e-12, "rel": 1e-11}, "source": "the shortest record for order 3: a 3 x 3 embedding"},
    {"id": "fisher_information.order_one", "op": "fisher_information", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5, 3.0], "order": 1}, "error": "invalid_argument", "source": "order must be at least 2"},
    {"id": "fisher_information.order_33", "op": "fisher_information", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5, 3.0], "order": 33}, "error": "invalid_argument", "source": "order must be at most 32"},
    {"id": "fisher_information.delay_zero", "op": "fisher_information", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5, 3.0], "order": 2, "delay": 0}, "error": "invalid_argument", "source": "delay must be at least 1"},
    {"id": "fisher_information.too_short", "op": "fisher_information", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5, 3.0], "order": 5}, "error": "invalid_argument", "source": "five samples give four rows, fewer than order 5"},
    {"id": "fisher_information.all_zero", "op": "fisher_information", "args": {"samples": [0.0, 0.0, 0.0, 0.0], "order": 2}, "error": "invalid_argument", "source": "samples must not all be 0"},
    {"id": "fisher_information.nan", "op": "fisher_information", "args": {"samples": [0.0, "nan", 1.0, 2.0], "order": 2}, "error": "invalid_argument", "source": "samples must be finite"}
