{
  "schema": 1,
  "suite": "quantize",
  "description": "Uniform quantizer (conventions: Uniform quantizer; ADR 0247).",
  "cases": [
    {"id": "quantize.ties", "op": "quantize", "args": {"samples": [0.5, 1.5, 2.5, -0.5, -1.5, -2.5, 0.25, 0.75, -0.75], "step": 1.0}, "expected": [0.0, 2.0, 2.0, 0.0, -2.0, -2.0, 0.0, 1.0, -1.0], "tol": {"abs": 0.0, "rel": 0.0}, "source": "step 1: halves round to even, quarters to nearest"},
    {"id": "quantize.fine_step", "op": "quantize", "args": {"samples": [0.1875, -0.3125, 0.0625, 1.0, -0.125, 0.4375], "step": 0.125}, "expected": [0.25, -0.25, 0.0, 1.0, -0.125, 0.5], "tol": {"abs": 0.0, "rel": 0.0}, "source": "step 1/8"},
    {"id": "quantize.saturate", "op": "quantize", "args": {"samples": [3.0, 2.0, 1.25, -1.75, -6.0, 0.5], "step": 0.5, "levels": 7}, "expected": [1.5, 1.5, 1.0, -1.5, -1.5, 0.5], "tol": {"abs": 0.0, "rel": 0.0}, "source": "step 1/2, 7 levels: k in [-3, 3]"},
    {"id": "quantize.one_level", "op": "quantize", "args": {"samples": [0.75, -3.0], "step": 0.5, "levels": 1}, "expected": [0.0, 0.0], "tol": {"abs": 0.0, "rel": 0.0}, "source": "1 level: all zero"},
    {"id": "quantize.complex", "op": "quantize", "args": {"samples": {"re": [0.5, 1.25, -2.5], "im": [-1.5, 0.75, 3.5]}, "step": 1.0, "levels": 5}, "expected": {"re": [0.0, 1.0, -2.0], "im": [-2.0, 1.0, 2.0]}, "tol": {"abs": 0.0, "rel": 0.0}, "source": "complex: each part separately"},
    {"id": "quantize.step_zero", "op": "quantize", "args": {"samples": [1.0], "step": 0.0}, "error": "invalid_argument", "source": "step must be positive"},
    {"id": "quantize.levels_even", "op": "quantize", "args": {"samples": [1.0], "step": 1.0, "levels": 4}, "error": "invalid_argument", "source": "levels must be odd"},
    {"id": "quantize.levels_zero", "op": "quantize", "args": {"samples": [1.0], "step": 1.0, "levels": 0}, "error": "invalid_argument", "source": "levels must be at least 1"},
    {"id": "quantize.empty", "op": "quantize", "args": {"samples": [], "step": 1.0}, "error": "invalid_argument", "source": "samples must not be empty"},
    {"id": "quantize.nan_sample", "op": "quantize", "args": {"samples": [1.0, "nan"], "step": 1.0}, "error": "invalid_argument", "source": "samples must be finite"}
  ]
}
