{
  "schema": 1,
  "suite": "spectral_shape",
  "description": "Spectral skewness and kurtosis (conventions: Spectra, Spectral skewness and kurtosis; ADR 0126).",
  "cases": [
    {"id": "spectral_shape.flat", "op": "spectral_shape", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0]}, "expected": {"skewness": 0.0, "kurtosis": 1.8}, "tol": {"abs": 1e-12, "rel": 1e-11}, "source": "flat over [-0.5, 3.5] is uniform: skewness 0, kurtosis 9/5"},
    {"id": "spectral_shape.single_bin", "op": "spectral_shape", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 3.0, 0.0, 0.0]}, "expected": {"skewness": 0.0, "kurtosis": 1.8}, "tol": {"abs": 1e-12, "rel": 1e-11}, "source": "one bin is uniform over its width: skewness 0, kurtosis 9/5"},
    {"id": "spectral_shape.two_ends", "op": "spectral_shape", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 0.0, 0.0, 1.0]}, "expected": {"skewness": 0.0, "kurtosis": 1.1387755102040817}, "tol": {"abs": 1e-12, "rel": 1e-11}, "source": "bins at 0 and 3 cover offsets 1 to 2 either side of the centroid 1.5: skewness 0; m2 = (2^3 - 1)/3 = 7/3, m4 = (2^5 - 1)/5 = 31/5, kurtosis (31/5) / (49/9) = 279/245"},
    {"id": "spectral_shape.leaning_low", "op": "spectral_shape", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [4.0, 2.0, 1.0, 1.0]}, "expected": {"skewness": 0.8007001605680295, "kurtosis": 2.5372857115615646}, "tol": {"abs": 1e-12, "rel": 1e-11}, "source": "power falls with frequency, so the tail is high: skewness positive"},
    {"id": "spectral_shape.leaning_high", "op": "spectral_shape", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 2.0, 4.0]}, "expected": {"skewness": -0.8007001605680295, "kurtosis": 2.5372857115615646}, "tol": {"abs": 1e-12, "rel": 1e-11}, "source": "the mirror of leaning_low: the same kurtosis, the skewness negated"},
    {"id": "spectral_shape.cut_band", "op": "spectral_shape", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [0.0, 2.0]}, "expected": {"skewness": 0.0, "kurtosis": 1.8}, "tol": {"abs": 1e-12, "rel": 1e-11}, "source": "flat, band [0, 2] is uniform: skewness 0, kurtosis 9/5"},
    {"id": "spectral_shape.span_clipped", "op": "spectral_shape", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 1.0, 1.0, 3.0], "span": [0.0, 3.0]}, "expected": {"skewness": -0.2722380817528008, "kurtosis": 1.3778812470367776}, "tol": {"abs": 1e-12, "rel": 1e-11}, "source": "span (0, 3) halves bins 0 and 3 at doubled density; uneven ends"},
    {"id": "spectral_shape.offset_axis", "op": "spectral_shape", "args": {"frequencies": [1000.0, 1001.0, 1002.0], "psd": [1.0, 4.0, 2.0]}, "expected": {"skewness": -0.1015327971870215, "kurtosis": 2.544818668358856}, "tol": {"abs": 1e-12, "rel": 1e-11}, "source": "an uneven three-bin PSD far from zero"},
    {"id": "spectral_shape.band_reversed", "op": "spectral_shape", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [2.0, 1.0]}, "error": "invalid_argument", "source": "band low must be below band high"},
    {"id": "spectral_shape.no_power", "op": "spectral_shape", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 0.0, 1.0, 0.0], "band": [-0.5, 1.5]}, "error": "invalid_argument", "source": "the band has no power"},
    {"id": "spectral_shape.one_bin", "op": "spectral_shape", "args": {"frequencies": [0.0], "psd": [1.0]}, "error": "invalid_argument", "source": "need at least two bins"}
  ]
}
