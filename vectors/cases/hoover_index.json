{
  "schema": 1,
  "suite": "hoover_index",
  "description": "The Hoover index (conventions: the Hoover index; ADR 0512).",
  "cases": [
    {"id": "hoover_index.equal", "op": "hoover_index", "args": {"samples": [2.0, 2.0, 2.0]}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "every value equal: 0"},
    {"id": "hoover_index.single", "op": "hoover_index", "args": {"samples": [5.0]}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "one value: 1 - 1/1 = 0"},
    {"id": "hoover_index.one_holds_all", "op": "hoover_index", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 0.75, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "mean 1: (1 + 1 + 1 + 3)/8 = 3/4"},
    {"id": "hoover_index.two", "op": "hoover_index", "args": {"samples": [1.0, 3.0]}, "expected": 0.25, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "mean 2: (1 + 1)/8 = 1/4"},
    {"id": "hoover_index.ramp", "op": "hoover_index", "args": {"samples": [1.0, 2.0, 3.0, 4.0]}, "expected": 0.2, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "mean 5/2: (3/2 + 1/2 + 1/2 + 3/2)/20 = 1/5"},
    {"id": "hoover_index.unsorted", "op": "hoover_index", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.4166666666666667, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "mean 4/3: (5/3 + 4/3 + 1/3)/8 = 5/12"},
    {"id": "hoover_index.halves", "op": "hoover_index", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.25, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "mean 1/2: (0 + 1/4 + 1/4 + 1/2)/4 = 1/4"},
    {"id": "hoover_index.random", "op": "hoover_index", "args": {"samples": [0.25, 7.0, 2.25, 5.25, 6.5, 5.75, 6.375, 2.625, 3.5, 3.75, 3.75, 0.0, 1.5, 7.875, 6.5, 1.875, 5.625, 0.25, 4.125, 1.5, 4.25, 0.25, 3.875, 1.0, 3.25, 5.75, 2.75, 7.125, 7.875, 0.25]}, "expected": 0.2780614132445431, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "30 values k/8, k from random.Random(512).randint(0, 64)"},
    {"id": "hoover_index.huge", "op": "hoover_index", "args": {"samples": [1e+308, 9e+307, 1e+300]}, "expected": 0.33333332807017546, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "values whose sum overflows a double: the result is that of the values scaled down"},
    {"id": "hoover_index.empty", "op": "hoover_index", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "hoover_index.negative", "op": "hoover_index", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "hoover_index.all_zero", "op": "hoover_index", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
