{
  "schema": 1,
  "suite": "hill_ratio_evenness",
  "description": "The Hill ratio evenness (conventions: the Hill ratio evenness; ADR 0536).",
  "cases": [
    {"id": "hill_ratio_evenness.equal", "op": "hill_ratio_evenness", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "four equal shares: 4/4 = 1"},
    {"id": "hill_ratio_evenness.single", "op": "hill_ratio_evenness", "args": {"samples": [5.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "one value: 1/1 = 1"},
    {"id": "hill_ratio_evenness.one_holds_all", "op": "hill_ratio_evenness", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "one share of 1: 1"},
    {"id": "hill_ratio_evenness.equal_with_zero", "op": "hill_ratio_evenness", "args": {"samples": [0.0, 2.0, 2.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "two equal shares, a zero: 2/2 = 1"},
    {"id": "hill_ratio_evenness.halves", "op": "hill_ratio_evenness", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.8648779018201608, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "shares 1/4, 1/8, 1/8, 1/2: (32/11)/2^(7/4)"},
    {"id": "hill_ratio_evenness.two", "op": "hill_ratio_evenness", "args": {"samples": [3.0, 1.0]}, "expected": 0.911802822781911, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "shares 3/4, 1/4: (8/5)/(4/3^(3/4)) = (2/5) 3^(3/4)"},
    {"id": "hill_ratio_evenness.ramp", "op": "hill_ratio_evenness", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.9269261135439396, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "shares 4, 1, 3, 2 tenths"},
    {"id": "hill_ratio_evenness.random", "op": "hill_ratio_evenness", "args": {"samples": [3.0, 0.0, 6.0, 6.75, 6.875, 7.625, 2.875, 7.0, 5.25, 6.375, 0.625, 1.75, 4.125, 6.0, 1.375, 2.5, 3.625, 5.375, 5.875, 7.625, 7.75, 0.875, 0.625, 1.25, 5.5, 1.625, 5.375, 1.625, 6.5, 3.0]}, "expected": 0.9129353767070293, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "30 values k/8, k from random.Random(536).randint(0, 64)"},
    {"id": "hill_ratio_evenness.empty", "op": "hill_ratio_evenness", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "hill_ratio_evenness.negative", "op": "hill_ratio_evenness", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "hill_ratio_evenness.all_zero", "op": "hill_ratio_evenness", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
