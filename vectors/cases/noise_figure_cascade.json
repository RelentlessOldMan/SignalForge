{
  "schema": 1,
  "suite": "noise_figure_cascade",
  "description": "Cascaded noise figure by Friis' formula (conventions: Noise figure, Cascade; ADR 0106).",
  "cases": [
    {"id": "noise_figure_cascade.single_stage", "op": "noise_figure_cascade", "args": {"noise_figures_db": [3.0], "gains_db": [10.0]}, "expected": {"noise_factor": 1.9952623149688795, "noise_figure_db": 3.0, "noise_temperature": 288.62607134097505, "gain_db": 10.0, "contributions": [1.9952623149688795]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "a single stage is itself: F = 10^0.3, gain 10 dB"},
    {"id": "noise_figure_cascade.lna_then_mixer", "op": "noise_figure_cascade", "args": {"noise_figures_db": [1.0, 10.0], "gains_db": [20.0, -7.0]}, "expected": {"noise_factor": 1.3489254117941674, "noise_figure_db": 1.2998793622358962, "noise_temperature": 101.18836942030853, "gain_db": 13.0, "contributions": [1.2589254117941673, 0.09]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "textbook: LNA NF 1 dB, 20 dB gain, then a 10 dB mixer: F = 10^0.1 + 9/100"},
    {"id": "noise_figure_cascade.three_exact", "op": "noise_figure_cascade", "args": {"noise_figures_db": [10.0, 20.0, 10.0], "gains_db": [10.0, 20.0, 0.0]}, "expected": {"noise_factor": 19.909, "noise_figure_db": 12.990494465975397, "noise_temperature": 5483.61, "gain_db": 30.0, "contributions": [10.0, 9.9, 0.009]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: F = 10 + 99/10 + 9/1000 = 19.909"},
    {"id": "noise_figure_cascade.loss_before_amp", "op": "noise_figure_cascade", "args": {"noise_figures_db": [6.0, 2.0], "gains_db": [-6.0, 20.0]}, "expected": {"noise_factor": 6.3095734448019325, "noise_figure_db": 8.0, "noise_temperature": 1539.7762989925604, "gain_db": 14.0, "contributions": [3.9810717055349722, 2.3285017392669602]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: a matched loss L at T0 in front gives F = L*F2: 10^0.6 * 10^0.2, NF 8 dB"},
    {"id": "noise_figure_cascade.noiseless_stages", "op": "noise_figure_cascade", "args": {"noise_figures_db": [0.0, 0.0, 0.0], "gains_db": [-10.0, 30.0, 5.0]}, "expected": {"noise_factor": 1.0, "noise_figure_db": 0.0, "noise_temperature": 0.0, "gain_db": 25.0, "contributions": [1.0, 0.0, 0.0]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: F = 1 for every stage: the chain has F = 1, NF 0 dB, 25 dB gain"},
    {"id": "noise_figure_cascade.late_stage_matters_little", "op": "noise_figure_cascade", "args": {"noise_figures_db": [2.0, 30.0], "gains_db": [40.0, 10.0]}, "expected": {"noise_factor": 1.6847931924611137, "noise_figure_db": 2.2654659904407835, "noise_temperature": 198.59002581372297, "gain_db": 50.0, "contributions": [1.5848931924611136, 0.0999]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: F = 10^0.2 + 999/10000"},
    {"id": "noise_figure_cascade.empty", "op": "noise_figure_cascade", "args": {"noise_figures_db": [], "gains_db": []}, "error": "invalid_argument", "source": "at least one stage"},
    {"id": "noise_figure_cascade.length_mismatch", "op": "noise_figure_cascade", "args": {"noise_figures_db": [1.0, 2.0], "gains_db": [10.0]}, "error": "invalid_argument", "source": "one gain per stage"},
    {"id": "noise_figure_cascade.negative_nf", "op": "noise_figure_cascade", "args": {"noise_figures_db": [1.0, -0.1], "gains_db": [10.0, 10.0]}, "error": "invalid_argument", "source": "a noise figure below 0 dB is not physical"},
    {"id": "noise_figure_cascade.nan_nf", "op": "noise_figure_cascade", "args": {"noise_figures_db": ["nan"], "gains_db": [10.0]}, "error": "invalid_argument", "source": "noise figures must be finite"},
    {"id": "noise_figure_cascade.inf_gain", "op": "noise_figure_cascade", "args": {"noise_figures_db": [1.0, 2.0], "gains_db": ["inf", 1.0]}, "error": "invalid_argument", "source": "gains must be finite"},
    {"id": "noise_figure_cascade.gain_underflows", "op": "noise_figure_cascade", "args": {"noise_figures_db": [1.0, 3.0], "gains_db": [-4000.0, 0.0]}, "error": "invalid_argument", "source": "by hand: G1 = 10^-400 is 0 in double, so (F2 - 1)/G1 is not finite"},
    {"id": "noise_figure_cascade.nf_overflows", "op": "noise_figure_cascade", "args": {"noise_figures_db": [4000.0], "gains_db": [0.0]}, "error": "invalid_argument", "source": "F = 10^400 overflows, so F is not finite"}
  ]
}
