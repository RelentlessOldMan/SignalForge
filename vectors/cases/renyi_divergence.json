{
  "schema": 1,
  "suite": "renyi_divergence",
  "description": "The R\u00e9nyi divergence (conventions: R\u00e9nyi divergence; ADR 0413).",
  "cases": [
    {"id": "renyi_divergence.same", "op": "renyi_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [2.0, 4.0, 6.0], "alpha": 2.0}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "the same distribution after scaling: 0"},
    {"id": "renyi_divergence.order_2", "op": "renyi_divergence", "args": {"p": [3.0, 1.0], "q": [1.0, 1.0], "alpha": 2.0}, "expected": 0.22314355131420976, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "P = (3/4, 1/4) from a fair coin, order 2: ln(1 + chi-square) = ln(5/4)"},
    {"id": "renyi_divergence.order_3", "op": "renyi_divergence", "args": {"p": [3.0, 1.0], "q": [1.0, 1.0], "alpha": 3.0}, "expected": 0.27980789396771133, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "order 3: sum P^3/Q^2 = (27/64 + 1/64)\u00b74 = 7/4, so ln(7/4)/2"},
    {"id": "renyi_divergence.order_half", "op": "renyi_divergence", "args": {"p": [1.0, 0.0], "q": [1.0, 1.0], "alpha": 0.5}, "expected": 0.6931471805599453, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "P = (1, 0), Q = (1/2, 1/2), order 1/2: -2 ln(1/sqrt 2) = ln 2"},
    {"id": "renyi_divergence.q_zero_low", "op": "renyi_divergence", "args": {"p": [1.0, 1.0], "q": [1.0, 0.0], "alpha": 0.5}, "expected": 0.6931471805599453, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "order 1/2 with q zero under p: sum sqrt(1/2 \u00b7 1) = 1/sqrt 2, so ln 2"},
    {"id": "renyi_divergence.counts", "op": "renyi_divergence", "args": {"p": [6.0, 6.0, 5.0, 6.0, 3.0, 1.0, 0.0, 4.0, 5.0, 5.0, 2.0, 1.0, 5.0, 4.0, 1.0, 2.0], "q": [4.0, 3.0, 1.0, 5.0, 4.0, 3.0, 3.0, 3.0, 5.0, 1.0, 4.0, 2.0, 3.0, 6.0, 3.0, 3.0], "alpha": 1.5}, "expected": 0.4368166732051518, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "16 counts each from random.Random(413), order 1.5"},
    {"id": "renyi_divergence.counts_low", "op": "renyi_divergence", "args": {"p": [6.0, 6.0, 5.0, 6.0, 3.0, 1.0, 0.0, 4.0, 5.0, 5.0, 2.0, 1.0, 5.0, 4.0, 1.0, 2.0], "q": [4.0, 3.0, 1.0, 5.0, 4.0, 3.0, 3.0, 3.0, 5.0, 1.0, 4.0, 2.0, 3.0, 6.0, 3.0, 3.0], "alpha": 0.25}, "expected": 0.1145781371663152, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "the same counts, order 0.25"},
    {"id": "renyi_divergence.huge_p", "op": "renyi_divergence", "args": {"p": [1e+308, 9e+307, 1e+300], "q": [1.0, 2.0, 3.0], "alpha": 2.0}, "expected": 0.8480889891426587, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "p sums past the largest double: the result is that of p scaled down"},
    {"id": "renyi_divergence.huge_q", "op": "renyi_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [1.5e+308, 1e+308, 2e+307], "alpha": 2.0}, "expected": 1.315066851831523, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "q sums past the largest double: the result is that of q scaled down"},
    {"id": "renyi_divergence.alpha_one", "op": "renyi_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [2.0, 1.0, 1.0], "alpha": 1.0}, "error": "invalid_argument", "source": "alpha must not be 1"},
    {"id": "renyi_divergence.alpha_zero", "op": "renyi_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [2.0, 1.0, 1.0], "alpha": 0.0}, "error": "invalid_argument", "source": "alpha must be above 0"},
    {"id": "renyi_divergence.alpha_nan", "op": "renyi_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [2.0, 1.0, 1.0], "alpha": "nan"}, "error": "invalid_argument", "source": "alpha must be finite"},
    {"id": "renyi_divergence.empty", "op": "renyi_divergence", "args": {"p": [], "q": [], "alpha": 2.0}, "error": "invalid_argument", "source": "p needs a value"},
    {"id": "renyi_divergence.lengths", "op": "renyi_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, 1.0], "alpha": 2.0}, "error": "invalid_argument", "source": "p and q must match"},
    {"id": "renyi_divergence.negative", "op": "renyi_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, -0.5, 3.0], "alpha": 2.0}, "error": "invalid_argument", "source": "values must be non-negative"},
    {"id": "renyi_divergence.zero_sum", "op": "renyi_divergence", "args": {"p": [0.0, 0.0, 0.0], "q": [2.0, 1.0, 1.0], "alpha": 2.0}, "error": "invalid_argument", "source": "p must have a positive sum"},
    {"id": "renyi_divergence.infinite", "op": "renyi_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, 0.0, 1.0], "alpha": 2.0}, "error": "invalid_argument", "source": "order 2 with q zero where p is not"},
    {"id": "renyi_divergence.disjoint", "op": "renyi_divergence", "args": {"p": [1.0, 0.0, 0.0], "q": [0.0, 1.0, 1.0], "alpha": 0.5}, "error": "invalid_argument", "source": "order 1/2 with no shared support"}
  ]
}
