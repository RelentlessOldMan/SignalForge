    {"id": "read_wav.wave_i24_mono", "op": "read_wav", "args": {"file": "wave_i24_mono.wav"}, "expected": {"channels": [[-1.0, 0.9999998807907104]], "sample_rate": 96000, "units": "FS"}, "tol": {"abs": 0, "rel": 0}, "source": "written by Python's wave module; samples from the i24 codes"},
