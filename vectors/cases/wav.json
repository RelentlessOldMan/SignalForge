    {"id": "write_wav.i24_one_sample_pad", "op": "write_wav", "args": {"channels": [[-0.5]], "sample_rate": 8000, "sample_format": "i24"}, "expected": "524946462800000057415645666d74201000000001000100401f0000c05d00000300180064617461030000000000c000", "tol": {"abs": 0, "rel": 0}, "source": "3 data bytes, padded to 4"},
    {"id": "write_wav.i16_ties_to_even", "op": "write_wav", "args": {"channels": [[4.57763671875e-05, 7.62939453125e-05, -1.52587890625e-05, -4.57763671875e-05]], "sample_rate": 1000, "sample_format": "i16"}, "expected": "524946462c00000057415645666d74201000000001000100e8030000d0070000020010006461746108000000020002000000feff", "tol": {"abs": 0, "rel": 0}, "source": "codes 1.5, 2.5, -0.5, -1.5 round half to even: 2, 2, 0, -2"},
    {"id": "write_wav.u8_ties_to_even", "op": "write_wav", "args": {"channels": [[0.00390625, 0.01171875, -0.00390625]], "sample_rate": 1000, "sample_format": "u8"}, "expected": "524946462800000057415645666d74201000000001000100e8030000e803000001000800646174610300000080828000", "tol": {"abs": 0, "rel": 0}, "source": "codes 0.5, 1.5, -0.5 round to 0, 2, 0, then +128"},
