{
  "schema": 1,
  "suite": "wav",
  "description": "Writing WAV files in every sample format, and reading WAV files laid out as SignalForge and other tools write them, from vectors/files (conventions: Signal files, WAV).",
  "cases": [
    {"id": "write_wav.u8_mono", "op": "write_wav", "args": {"channels": [[0.5, -0.25, 0.123456789, -1.0, 0.0, 0.0078125]], "sample_rate": 48000, "sample_format": "u8"}, "expected": "524946462a00000057415645666d7420100000000100010080bb000080bb0000010008006461746106000000c06090008081", "tol": {"abs": 0, "rel": 0}, "source": "struct.pack of each sample (integers: round(x * 2^(b-1)), half to even, +128 for u8); PCM headers also from Python's wave module"},
    {"id": "write_wav.i16_mono", "op": "write_wav", "args": {"channels": [[0.5, -0.25, 0.123456789, -1.0, 0.0, 0.0078125]], "sample_rate": 48000, "sample_format": "i16"}, "expected": "524946463000000057415645666d7420100000000100010080bb00000077010002001000646174610c000000004000e0cd0f008000000001", "tol": {"abs": 0, "rel": 0}, "source": "struct.pack of each sample (integers: round(x * 2^(b-1)), half to even, +128 for u8); PCM headers also from Python's wave module"},
