    {"id": "write_wav.i24_extremes", "op": "write_wav", "args": {"channels": [[-1.0, 0.9999998807907104]], "sample_rate": 1000, "sample_format": "i24"}, "expected": "524946462a00000057415645666d74201000000001000100e8030000b80b0000030018006461746106000000000080ffff7f", "tol": {"abs": 0, "rel": 0}, "source": "the most negative and most positive codes"},
    {"id": "write_wav.i32_extremes", "op": "write_wav", "args": {"channels": [[-1.0, 0.9999999995343387]], "sample_rate": 1000, "sample_format": "i32"}, "expected": "524946462c00000057415645666d74201000000001000100e8030000a00f000004002000646174610800000000000080ffffff7f", "tol": {"abs": 0, "rel": 0}, "source": "the most negative and most positive codes"},
    {"id": "write_wav.u8_extremes", "op": "write_wav", "args": {"channels": [[-1.0, 0.9921875]], "sample_rate": 1000, "sample_format": "u8"}, "expected": "524946462600000057415645666d74201000000001000100e8030000e803000001000800646174610200000000ff", "tol": {"abs": 0, "rel": 0}, "source": "bytes 0x00 and 0xff"},
    {"id": "write_wav.f32_overflow_is_inf", "op": "write_wav", "args": {"channels": [[1e+39, -1e+39]], "sample_rate": 1000, "sample_format": "f32"}, "expected": "524946463a00000057415645666d74201200000003000100e8030000a00f000004002000000066616374040000000200000064617461080000000000807f000080ff", "tol": {"abs": 0, "rel": 0}, "source": "beyond the float32 range becomes +-inf"},
