    {"id": "read_wav.float32_stereo", "op": "read_wav", "args": {"file": "float32_stereo.wav"}, "expected": {"channels": [[0.5, 0.10000000149011612], [-2.0, 0.0010000000474974513]], "sample_rate": 48000, "units": "FS"}, "tol": {"abs": 0, "rel": 0}, "source": "format 3 with a fact chunk; float32 values from a struct round trip"},
    {"id": "read_wav.float64_no_fact", "op": "read_wav", "args": {"file": "float64_no_fact.wav"}, "expected": {"channels": [[0.1, -3.5, 1e-300]], "sample_rate": 1000, "units": "FS"}, "tol": {"abs": 0, "rel": 0}, "source": "format 3 with a 16-byte fmt and no fact chunk, as some tools write"},
    {"id": "read_wav.extensible_i24_three_channels", "op": "read_wav", "args": {"file": "extensible_i24_three_channels.wav"}, "expected": {"channels": [[0.5, -1.0], [-0.5, 1.1920928955078125e-07], [0.9999998807907104, 0.0]], "sample_rate": 48000, "units": "FS"}, "tol": {"abs": 0, "rel": 0}, "source": "WAVE_FORMAT_EXTENSIBLE, PCM sub-format, 24 bits, mask 7"},
    {"id": "read_wav.extensible_i32_valid_24", "op": "read_wav", "args": {"file": "extensible_i32_valid_24.wav"}, "expected": {"channels": [[0.5, -0.5, 0.9999998807907104]], "sample_rate": 44100, "units": "FS"}, "tol": {"abs": 0, "rel": 0}, "source": "24 valid bits in a 32-bit container: scaled by the container, as left-justified"},
    {"id": "read_wav.extensible_float", "op": "read_wav", "args": {"file": "extensible_float.wav"}, "expected": {"channels": [[0.5, 0.10000000149011612], [-2.0, 0.0010000000474974513]], "sample_rate": 48000, "units": "FS"}, "tol": {"abs": 0, "rel": 0}, "source": "WAVE_FORMAT_EXTENSIBLE, IEEE float sub-format"},
    {"id": "read_wav.extra_chunks", "op": "read_wav", "args": {"file": "extra_chunks.wav"}, "expected": {"channels": [[0.0030517578125, -0.006103515625, 0.0091552734375]], "sample_rate": 22050, "units": "FS"}, "tol": {"abs": 0, "rel": 0}, "source": "odd-sized unknown chunks before and after fmt are skipped with their pad; a chunk after data and a RIFF size of 0 are ignored"},
