    {"id": "write_wav.f32_mono", "op": "write_wav", "args": {"channels": [[0.5, -0.25, 0.123456789, -1.0, 0.0, 0.0078125]], "sample_rate": 48000, "sample_format": "f32"}, "expected": "524946464a00000057415645666d7420120000000300010080bb000000ee020004002000000066616374040000000600000064617461180000000000003f000080beead6fc3d000080bf000000000000003c", "tol": {"abs": 0, "rel": 0}, "source": "struct.pack of each sample (integers: round(x * 2^(b-1)), half to even, +128 for u8); PCM headers also from Python's wave module"},
    {"id": "write_wav.f64_mono", "op": "write_wav", "args": {"channels": [[0.5, -0.25, 0.123456789, -1.0, 0.0, 0.0078125]], "sample_rate": 48000, "sample_format": "f64"}, "expected": "524946466200000057415645666d7420120000000300010080bb000000dc05000800400000006661637404000000060000006461746130000000000000000000e03f000000000000d0bf5f633937dd9abf3f000000000000f0bf0000000000000000000000000000803f", "tol": {"abs": 0, "rel": 0}, "source": "struct.pack of each sample (integers: round(x * 2^(b-1)), half to even, +128 for u8); PCM headers also from Python's wave module"},
    {"id": "write_wav.i16_stereo", "op": "write_wav", "args": {"channels": [[0.5, -0.25, 0.123456789], [-1.0, 0.0, 0.0078125]], "sample_rate": 44100, "sample_format": "i16"}, "expected": "524946463000000057415645666d7420100000000100020044ac000010b1020004001000646174610c0000000040008000e00000cd0f0001", "tol": {"abs": 0, "rel": 0}, "source": "interleaved frame by frame; struct.pack of each sample (integers: round(x * 2^(b-1)), half to even, +128 for u8); PCM headers also from Python's wave module"},
    {"id": "write_wav.f32_stereo", "op": "write_wav", "args": {"channels": [[0.5, -0.25, 0.123456789], [-1.0, 0.0, 0.0078125]], "sample_rate": 44100, "sample_format": "f32"}, "expected": "524946464a00000057415645666d7420120000000300020044ac00002062050008002000000066616374040000000300000064617461180000000000003f000080bf000080be00000000ead6fc3d0000003c", "tol": {"abs": 0, "rel": 0}, "source": "interleaved, fact chunk holds 3 frames; struct.pack of each sample (integers: round(x * 2^(b-1)), half to even, +128 for u8); PCM headers also from Python's wave module"},
    {"id": "write_wav.i24_three_channels", "op": "write_wav", "args": {"channels": [[0.5, -0.5], [0.25, -0.25], [-1.0, 0.0]], "sample_rate": 96000, "sample_format": "i24"}, "expected": "524946463600000057415645666d7420100000000100030000770100002f0d000900180064617461120000000000400000200000800000c00000e0000000", "tol": {"abs": 0, "rel": 0}, "source": "3 channels of 3 bytes, block align 9; struct.pack of each sample (integers: round(x * 2^(b-1)), half to even, +128 for u8); PCM headers also from Python's wave module"},
