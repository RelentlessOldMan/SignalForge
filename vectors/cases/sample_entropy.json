{
  "schema": 1,
  "suite": "sample_entropy",
  "description": "Sample entropy (conventions: Sample entropy; ADR 0326).",
  "cases": [
    {"id": "sample_entropy.periodic", "op": "sample_entropy", "args": {"samples": [0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0], "m": 2, "r": 0.25}, "expected": -0.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "a period-2 wave: every pair of equal phase matches at m and m+1; A = B, SampEn 0"},
    {"id": "sample_entropy.by_hand", "op": "sample_entropy", "args": {"samples": [1.0, 2.0, 1.0, 3.0, 1.0, 2.0], "m": 1, "r": 0.5}, "expected": 1.0986122886681098, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "m = 1, r = 1/2: starts 0..4 are 1,2,1,3,1; B = 3 pairs of 1s, of which A = 1 (0,4: next 2,2); SampEn ln 3"},
    {"id": "sample_entropy.at_r", "op": "sample_entropy", "args": {"samples": [0.0, 0.5, 1.0, 0.0, 0.5, 1.5], "m": 1, "r": 0.5}, "expected": 0.6931471805599453, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "a distance exactly r = 1/2 matches"},
    {"id": "sample_entropy.no_extension", "op": "sample_entropy", "args": {"samples": [0.0, 1.0, 0.0, 2.0, 0.0, 3.0], "m": 1, "r": 0.25}, "expected": "inf", "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "the 0s match at m = 1 but their successors 1, 2 do not: A = 0, +inf"},
    {"id": "sample_entropy.mixed", "op": "sample_entropy", "args": {"samples": [0.25, -1.5, 3.0, 2.75, -0.5, 0.125, 1.0, -2.25, 0.375, 2.5, -1.25, 0.75, 0.0, 1.5, -0.75, 2.0, 0.5, -1.0, 1.25, 0.625], "m": 2, "r": 1.25}, "expected": 0.6061358035703156, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "twenty arbitrary dyadic samples, m = 2, r = 5/4"},
    {"id": "sample_entropy.m_zero", "op": "sample_entropy", "args": {"samples": [0.0, 1.0, 0.0, 1.0, 0.0], "m": 0, "r": 0.5}, "error": "invalid_argument", "source": "m must be at least 1"},
    {"id": "sample_entropy.r_negative", "op": "sample_entropy", "args": {"samples": [0.0, 1.0, 0.0, 1.0, 0.0], "m": 1, "r": -0.1}, "error": "invalid_argument", "source": "r must be at least 0"},
    {"id": "sample_entropy.too_short", "op": "sample_entropy", "args": {"samples": [0.0, 1.0, 2.0], "m": 2, "r": 0.5}, "error": "invalid_argument", "source": "3 samples with m = 2 give one template"},
    {"id": "sample_entropy.no_match", "op": "sample_entropy", "args": {"samples": [0.0, 1.0, 2.0, 3.0], "m": 1, "r": 0.5}, "error": "invalid_argument", "source": "no two templates match at m: B = 0"},
    {"id": "sample_entropy.nan", "op": "sample_entropy", "args": {"samples": [0.0, "nan", 1.0], "m": 1, "r": 0.5}, "error": "invalid_argument", "source": "samples must be finite"}
  ]
}
