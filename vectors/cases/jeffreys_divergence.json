{
  "schema": 1,
  "suite": "jeffreys_divergence",
  "description": "The Jeffreys divergence (conventions: Jeffreys divergence; ADR 0414).",
  "cases": [
    {"id": "jeffreys_divergence.same", "op": "jeffreys_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [2.0, 4.0, 6.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "the same distribution after scaling: 0"},
    {"id": "jeffreys_divergence.coin", "op": "jeffreys_divergence", "args": {"p": [3.0, 1.0], "q": [1.0, 1.0]}, "expected": 0.27465307216702745, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "P = (3/4, 1/4) against a fair coin: (1/4) ln(3/2) + (1/4) ln 2 = (1/4) ln 3"},
    {"id": "jeffreys_divergence.swap", "op": "jeffreys_divergence", "args": {"p": [1.0, 2.0], "q": [2.0, 1.0]}, "expected": 0.4620981203732969, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "P = (1/3, 2/3), Q = (2/3, 1/3): (1/3) ln 2 twice = (2/3) ln 2"},
    {"id": "jeffreys_divergence.shared_zero", "op": "jeffreys_divergence", "args": {"p": [3.0, 0.0, 1.0], "q": [1.0, 0.0, 1.0]}, "expected": 0.27465307216702745, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "the coin case with an index zero in both, dropped: (1/4) ln 3"},
    {"id": "jeffreys_divergence.counts", "op": "jeffreys_divergence", "args": {"p": [28.0, 23.0, 39.0, 48.0, 15.0, 40.0, 18.0, 19.0, 5.0, 17.0, 35.0, 46.0, 45.0, 46.0, 9.0, 44.0], "q": [23.0, 25.0, 9.0, 17.0, 32.0, 11.0, 1.0, 39.0, 20.0, 2.0, 20.0, 29.0, 9.0, 41.0, 2.0, 43.0]}, "expected": 0.6680752350929731, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "16 counts each from random.Random(414), 1 to 50"},
    {"id": "jeffreys_divergence.huge_p", "op": "jeffreys_divergence", "args": {"p": [1e+308, 9e+307, 1e+300], "q": [1.0, 2.0, 3.0]}, "expected": 9.647575159958345, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "p sums past the largest double: the result is that of p scaled down"},
    {"id": "jeffreys_divergence.huge_q", "op": "jeffreys_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [1.5e+308, 1e+308, 2e+307]}, "expected": 1.2854375469352295, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "q sums past the largest double: the result is that of q scaled down"},
    {"id": "jeffreys_divergence.empty", "op": "jeffreys_divergence", "args": {"p": [], "q": []}, "error": "invalid_argument", "source": "p needs a value"},
    {"id": "jeffreys_divergence.lengths", "op": "jeffreys_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, 1.0]}, "error": "invalid_argument", "source": "p and q must match"},
    {"id": "jeffreys_divergence.negative", "op": "jeffreys_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, -0.5, 3.0]}, "error": "invalid_argument", "source": "values must be non-negative"},
    {"id": "jeffreys_divergence.not_finite", "op": "jeffreys_divergence", "args": {"p": [1.0, "inf", 1.0], "q": [2.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "values must be finite"},
    {"id": "jeffreys_divergence.zero_sum", "op": "jeffreys_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "q must have a positive sum"},
    {"id": "jeffreys_divergence.p_zero", "op": "jeffreys_divergence", "args": {"p": [1.0, 0.0, 3.0], "q": [2.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "p zero where q is not"},
    {"id": "jeffreys_divergence.q_zero", "op": "jeffreys_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, 0.0, 1.0]}, "error": "invalid_argument", "source": "q zero where p is not"}
  ]
}
