{
  "schema": 1,
  "suite": "kolmogorov_smirnov",
  "description": "The two-sample Kolmogorov-Smirnov statistic (conventions: two-sample Kolmogorov-Smirnov statistic; ADR 0402).",
  "cases": [
    {"id": "kolmogorov_smirnov.apart", "op": "kolmogorov_smirnov", "args": {"x": [1.0, 2.0], "y": [5.0, 6.0, 7.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "no overlap: 1"},
    {"id": "kolmogorov_smirnov.same", "op": "kolmogorov_smirnov", "args": {"x": [3.0, 1.0, 2.0], "y": [2.0, 3.0, 1.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "the same values: 0"},
    {"id": "kolmogorov_smirnov.hand", "op": "kolmogorov_smirnov", "args": {"x": [1.0, 2.0, 3.0], "y": [2.0, 4.0]}, "expected": 0.5, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "at t = 1: 1/3 - 0; t = 2: 2/3 - 1/2; t = 3: 1 - 1/2 = 1/2; t = 4: 0. Max 1/2"},
    {"id": "kolmogorov_smirnov.spread", "op": "kolmogorov_smirnov", "args": {"x": [0.0, 0.0, 0.0, 0.0], "y": [-1.0, 0.0, 1.0]}, "expected": 0.3333333333333333, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "same median; t = -1: 0 - 1/3; t = 0: 1 - 2/3; t = 1: 0. Max 1/3"},
    {"id": "kolmogorov_smirnov.rounded_gaussian", "op": "kolmogorov_smirnov", "args": {"x": [0.5, -0.1, -0.3, -0.5, -0.7, -0.0, -1.0, 1.1, 0.6, -0.2, 0.5, -1.1, -1.2, 0.5, 0.4, -1.2, -1.6, 0.5, 0.5, -0.8, 0.8, 1.0, 0.2, 1.3, 0.7, 0.1, 0.3, -1.0, -0.0, 1.8, -0.2, 0.8, -0.6, -0.9, 0.5, -0.7, -1.4, -0.4, 0.6, -0.4], "y": [-0.6, 0.2, 0.5, 0.2, -0.1, -1.0, -0.9, 1.7, 1.3, -2.0, 0.2, 0.4, 0.9, 0.5, 0.5, -1.9, -1.2, -1.4, -0.4, -0.3, 0.5, 0.2, 0.9, 1.1, -1.3, -0.4, -1.5, 0.5, -1.3, -0.9, -0.9, 0.8, 2.3, 0.1, -0.5, 0.3, -0.0, -0.6, 0.0, 0.7, 1.0, 0.2, -0.9, 0.7, -1.0, -1.6, -0.2, 0.5, 1.0, -0.7, 0.7, -1.0, 0.2, -0.3, 0.9]}, "expected": 0.07727272727272727, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "40 and 55 values from random.Random(402), N(0.3, 1) and N(0, 1) rounded to 0.1, so with ties"},
    {"id": "kolmogorov_smirnov.x_empty", "op": "kolmogorov_smirnov", "args": {"x": [], "y": [2.0, 4.0]}, "error": "invalid_argument", "source": "x needs a value"},
    {"id": "kolmogorov_smirnov.y_empty", "op": "kolmogorov_smirnov", "args": {"x": [1.0, 2.0, 3.0], "y": []}, "error": "invalid_argument", "source": "y needs a value"},
    {"id": "kolmogorov_smirnov.not_finite", "op": "kolmogorov_smirnov", "args": {"x": [1.0, 2.0, 3.0], "y": [2.0, "nan"]}, "error": "invalid_argument", "source": "values must be finite"}
  ]
}
