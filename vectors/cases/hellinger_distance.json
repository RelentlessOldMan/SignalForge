{
  "schema": 1,
  "suite": "hellinger_distance",
  "description": "The Hellinger distance (conventions: Hellinger distance; ADR 0409).",
  "cases": [
    {"id": "hellinger_distance.same", "op": "hellinger_distance", "args": {"p": [1.0, 2.0, 3.0], "q": [2.0, 4.0, 6.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "the same distribution after scaling: 0"},
    {"id": "hellinger_distance.disjoint", "op": "hellinger_distance", "args": {"p": [1.0, 0.0], "q": [0.0, 3.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "no common support: 1"},
    {"id": "hellinger_distance.half", "op": "hellinger_distance", "args": {"p": [1.0, 0.0], "q": [1.0, 1.0]}, "expected": 0.541196100146197, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "P = (1, 0), Q = (1/2, 1/2): 1 - sum sqrt(PQ) = 1 - 1/sqrt 2, so H = sqrt(1 - 1/sqrt 2)"},
    {"id": "hellinger_distance.quarter", "op": "hellinger_distance", "args": {"p": [1.0, 0.0, 0.0, 0.0], "q": [1.0, 1.0, 1.0, 1.0]}, "expected": 0.7071067811865476, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "P a point, Q uniform on 4: sum sqrt(PQ) = 1/2, H = sqrt(1/2)"},
    {"id": "hellinger_distance.counts", "op": "hellinger_distance", "args": {"p": [6.0, 4.0, 4.0, 3.0, 1.0, 4.0, 3.0, 5.0, 0.0, 3.0, 6.0, 6.0, 5.0, 1.0, 4.0, 0.0], "q": [4.0, 3.0, 1.0, 1.0, 2.0, 1.0, 4.0, 4.0, 1.0, 1.0, 4.0, 3.0, 0.0, 1.0, 6.0, 4.0]}, "expected": 0.3775505007061639, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "16 counts each from random.Random(409), 0 to 6, with zeros"},
    {"id": "hellinger_distance.empty", "op": "hellinger_distance", "args": {"p": [], "q": []}, "error": "invalid_argument", "source": "p needs a value"},
    {"id": "hellinger_distance.lengths", "op": "hellinger_distance", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, 1.0]}, "error": "invalid_argument", "source": "p and q must match"},
    {"id": "hellinger_distance.negative", "op": "hellinger_distance", "args": {"p": [1.0, -0.5, 3.0], "q": [2.0, 1.0, 0.0]}, "error": "invalid_argument", "source": "values must be non-negative"},
    {"id": "hellinger_distance.not_finite", "op": "hellinger_distance", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, "inf", 1.0]}, "error": "invalid_argument", "source": "values must be finite"},
    {"id": "hellinger_distance.zero_sum", "op": "hellinger_distance", "args": {"p": [0.0, 0.0, 0.0], "q": [2.0, 1.0, 0.0]}, "error": "invalid_argument", "source": "p must have a positive sum"}
  ]
}
