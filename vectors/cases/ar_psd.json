{
  "schema": 1,
  "suite": "ar_psd",
  "description": "AR model PSD (conventions: AR model PSD; ADR 0223).",
  "cases": [
    {"id": "ar_psd.order_one_two_sided", "op": "ar_psd", "args": {"coefficients": [1.0, 0.5], "error": 1.5, "sample_rate": 8.0, "nfft": 8, "one_sided": false}, "expected": {"frequencies": [-4.0, -3.0, -2.0, -1.0, 0.0, 1.0, 2.0, 3.0], "psd": [0.75, 0.3453717849152732, 0.15000000000000002, 0.0958046856729622, 0.08333333333333333, 0.0958046856729622, 0.15, 0.34537178491527304], "sample_rate": 8.0, "nperseg": 8, "num_segments": 1, "one_sided": false, "bin_width": 1.0, "enbw_hz": 1.0, "nfft": 8}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "1.5 / (8 (1 + a^2 + 2 a cos(2 pi k / 8))), a = 1/2, shifted"},
    {"id": "ar_psd.yule_walker_two_samples", "op": "ar_psd", "args": {"coefficients": [1.0, -0.4], "error": 2.1, "sample_rate": 1.0, "nfft": 2}, "expected": {"frequencies": [0.0, 0.5], "psd": [5.833333333333334, 1.0714285714285714], "sample_rate": 1.0, "nperseg": 2, "num_segments": 1, "one_sided": true, "bin_width": 0.5, "enbw_hz": 0.5, "nfft": 2}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "ADR 0203's x = [1, 2] model: a1 = -2/5, sigma^2 = 21/10"},
    {"id": "ar_psd.order_two_odd_nfft", "op": "ar_psd", "args": {"coefficients": [1.0, -0.9, 0.5], "error": 0.3, "sample_rate": 1000.0, "nfft": 9}, "expected": {"frequencies": [0.0, 111.11111111111111, 222.22222222222223, 333.33333333333337, 444.44444444444446], "psd": [0.0008333333333333332, 0.003629145348840167, 0.0009210120148291888, 0.00020618556701030937, 0.00011187320549037435], "sample_rate": 1000.0, "nperseg": 9, "num_segments": 1, "one_sided": true, "bin_width": 111.11111111111111, "enbw_hz": 111.11111111111111, "nfft": 9}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "odd nfft: no Nyquist bin"},
    {"id": "ar_psd.order_two_even_nfft", "op": "ar_psd", "args": {"coefficients": [1.0, -0.9, 0.5], "error": 0.3, "sample_rate": 1000.0, "nfft": 16}, "expected": {"frequencies": [0.0, 62.5, 125.0, 187.5, 250.0, 312.5, 375.0, 437.5, 500.0], "psd": [0.0008333333333333332, 0.002200768451514433, 0.003978471409158385, 0.00187706505647884, 0.0005660377358490566, 0.000251452295610772, 0.00015116440774773306, 0.00011403415452884492, 5.208333333333333e-05], "sample_rate": 1000.0, "nperseg": 16, "num_segments": 1, "one_sided": true, "bin_width": 62.5, "enbw_hz": 62.5, "nfft": 16}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "even nfft: half-bin Nyquist"},
    {"id": "ar_psd.order_three_minimal_nfft", "op": "ar_psd", "args": {"coefficients": [1.0, 0.2, -0.3, 0.1], "error": 2.0, "sample_rate": 4.0, "nfft": 4}, "expected": {"frequencies": [0.0, 1.0, 2.0], "psd": [0.5000000000000001, 0.588235294117647, 3.1249999999999982], "sample_rate": 4.0, "nperseg": 4, "num_segments": 1, "one_sided": true, "bin_width": 1.0, "enbw_hz": 1.0, "nfft": 4}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "nfft = order + 1"},
    {"id": "ar_psd.complex", "op": "ar_psd", "args": {"coefficients": {"re": [1.0, -0.5, 0.0], "im": [0.0, 0.5, 0.25]}, "error": 1.0, "sample_rate": 10.0, "nfft": 7}, "expected": {"frequencies": [-4.285714285714286, -2.857142857142857, -1.4285714285714286, 0.0, 1.4285714285714286, 2.857142857142857, 4.285714285714286], "psd": [0.043407872403337794, 0.08229527202657849, 4.751704286455237, 0.12307692307692308, 0.046110143317231386, 0.04457033553527007, 0.04602517998686267], "sample_rate": 10.0, "nperseg": 7, "num_segments": 1, "one_sided": false, "bin_width": 1.4285714285714286, "enbw_hz": 1.4285714285714286, "nfft": 7}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "complex: two-sided, shifted"},
    {"id": "ar_psd.not_minimum_phase", "op": "ar_psd", "args": {"coefficients": [1.0, 2.0], "error": 1.0, "sample_rate": 1.0, "nfft": 5}, "expected": {"frequencies": [0.0, 0.2, 0.4], "psd": [0.1111111111111111, 0.3207149131818564, 1.1338305413635978], "sample_rate": 1.0, "nperseg": 5, "num_segments": 1, "one_sided": true, "bin_width": 0.2, "enbw_hz": 0.2, "nfft": 5}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "|A|^2 = 5 + 4 cos w > 0: allowed"},
    {"id": "ar_psd.vanishes", "op": "ar_psd", "args": {"coefficients": [1.0, 1.0], "error": 1.0, "sample_rate": 1.0, "nfft": 4}, "error": "invalid_argument", "source": "a = [1, 1] has A = 0 at fs/2, a bin of nfft = 4"},
    {"id": "ar_psd.nfft_too_small", "op": "ar_psd", "args": {"coefficients": [1.0, 0.2, 0.1], "error": 1.0, "sample_rate": 1.0, "nfft": 2}, "error": "invalid_argument", "source": "nfft must be at least order + 1"},
    {"id": "ar_psd.a0", "op": "ar_psd", "args": {"coefficients": [2.0, 0.5], "error": 1.0, "sample_rate": 1.0, "nfft": 8}, "error": "invalid_argument", "source": "coefficients[0] must be 1"},
    {"id": "ar_psd.zero_error", "op": "ar_psd", "args": {"coefficients": [1.0, 0.5], "error": 0.0, "sample_rate": 1.0, "nfft": 8}, "error": "invalid_argument", "source": "error must be positive"},
    {"id": "ar_psd.zero_rate", "op": "ar_psd", "args": {"coefficients": [1.0, 0.5], "error": 1.0, "sample_rate": 0.0, "nfft": 8}, "error": "invalid_argument", "source": "sample_rate must be positive"},
    {"id": "ar_psd.nan", "op": "ar_psd", "args": {"coefficients": [1.0, "nan"], "error": 1.0, "sample_rate": 1.0, "nfft": 8}, "error": "invalid_argument", "source": "coefficients must be finite"}
  ]
