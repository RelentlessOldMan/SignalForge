{
  "schema": 1,
  "suite": "chi_square_divergence",
  "description": "The Pearson chi-square divergence (conventions: Pearson chi-square divergence; ADR 0412).",
  "cases": [
    {"id": "chi_square_divergence.same", "op": "chi_square_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [2.0, 4.0, 6.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "the same distribution after scaling: 0"},
    {"id": "chi_square_divergence.half", "op": "chi_square_divergence", "args": {"p": [1.0, 0.0], "q": [1.0, 1.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "P = (1, 0), Q = (1/2, 1/2): (1/4)/(1/2) twice = 1"},
    {"id": "chi_square_divergence.coin", "op": "chi_square_divergence", "args": {"p": [3.0, 1.0], "q": [1.0, 1.0]}, "expected": 0.25, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "P = (3/4, 1/4) from a fair coin: (1/16)/(1/2) twice = 1/4"},
    {"id": "chi_square_divergence.reverse", "op": "chi_square_divergence", "args": {"p": [1.0, 1.0], "q": [3.0, 1.0]}, "expected": 0.3333333333333333, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "P fair, Q = (3/4, 1/4): (1/16)/(3/4) + (1/16)/(1/4) = 1/12 + 1/4 = 1/3"},
    {"id": "chi_square_divergence.shared_zero", "op": "chi_square_divergence", "args": {"p": [2.0, 0.0, 2.0], "q": [1.0, 0.0, 3.0]}, "expected": 0.3333333333333333, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "the middle index zero in both and dropped: (1/16)/(1/4) + (1/16)/(3/4) = 1/4 + 1/12 = 1/3"},
    {"id": "chi_square_divergence.counts", "op": "chi_square_divergence", "args": {"p": [19.0, 46.0, 4.0, 7.0, 13.0, 8.0, 20.0, 13.0, 37.0, 13.0, 30.0, 31.0, 1.0, 5.0, 39.0, 45.0], "q": [12.0, 23.0, 33.0, 17.0, 42.0, 17.0, 19.0, 19.0, 50.0, 34.0, 26.0, 29.0, 22.0, 30.0, 41.0, 35.0]}, "expected": 0.47175174166255, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "16 counts each from random.Random(412), 1 to 50"},
    {"id": "chi_square_divergence.empty", "op": "chi_square_divergence", "args": {"p": [], "q": []}, "error": "invalid_argument", "source": "p needs a value"},
    {"id": "chi_square_divergence.lengths", "op": "chi_square_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, 1.0]}, "error": "invalid_argument", "source": "p and q must match"},
    {"id": "chi_square_divergence.negative", "op": "chi_square_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, -0.5, 3.0]}, "error": "invalid_argument", "source": "values must be non-negative"},
    {"id": "chi_square_divergence.not_finite", "op": "chi_square_divergence", "args": {"p": [1.0, "inf", 1.0], "q": [2.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "values must be finite"},
    {"id": "chi_square_divergence.zero_sum", "op": "chi_square_divergence", "args": {"p": [0.0, 0.0, 0.0], "q": [2.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "p must have a positive sum"},
    {"id": "chi_square_divergence.infinite", "op": "chi_square_divergence", "args": {"p": [1.0, 2.0, 3.0], "q": [1.0, 0.0, 1.0]}, "error": "invalid_argument", "source": "q is zero where p is not"}
  ]
}
