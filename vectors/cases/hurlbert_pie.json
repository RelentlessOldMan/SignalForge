{
  "schema": 1,
  "suite": "hurlbert_pie",
  "description": "Hurlbert's PIE (conventions: Hurlbert's PIE; ADR 0548).",
  "cases": [
    {"id": "hurlbert_pie.two_ones", "op": "hurlbert_pie", "args": {"samples": [1.0, 1.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "N = 2: 2 (1 - 1/2) = 1"},
    {"id": "hurlbert_pie.two_twos", "op": "hurlbert_pie", "args": {"samples": [2.0, 2.0]}, "expected": 0.6666666666666666, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "N = 4: (4/3)(1/2) = 2/3"},
    {"id": "hurlbert_pie.one_holds_all", "op": "hurlbert_pie", "args": {"samples": [0.0, 4.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "one kind: 0"},
    {"id": "hurlbert_pie.two", "op": "hurlbert_pie", "args": {"samples": [3.0, 1.0]}, "expected": 0.5, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "N = 4: (4/3)(6/16) = 1/2"},
    {"id": "hurlbert_pie.ramp", "op": "hurlbert_pie", "args": {"samples": [1.0, 2.0, 3.0]}, "expected": 0.7333333333333333, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "N = 6: (6/5)(22/36) = 11/15"},
    {"id": "hurlbert_pie.four_ones", "op": "hurlbert_pie", "args": {"samples": [1.0, 1.0, 1.0, 1.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "N = 4: (4/3)(3/4) = 1"},
    {"id": "hurlbert_pie.halves", "op": "hurlbert_pie", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 1.3125, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "N = 2: 2 (42/64) = 21/16, above 1"},
    {"id": "hurlbert_pie.random", "op": "hurlbert_pie", "args": {"samples": [0.5, 0.5, 8.0, 2.25, 1.25, 6.25, 8.0, 2.625, 7.75, 4.25, 1.125, 1.375, 2.875, 6.875, 1.0, 5.375, 0.125, 0.125, 6.25, 6.125, 3.375, 7.375, 6.75, 0.875, 1.75, 6.0, 4.5, 5.375, 4.0, 7.875]}, "expected": 0.9595674404069515, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "30 values k/8, k from random.Random(548).randint(0, 64)"},
    {"id": "hurlbert_pie.empty", "op": "hurlbert_pie", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "hurlbert_pie.negative", "op": "hurlbert_pie", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "hurlbert_pie.all_zero", "op": "hurlbert_pie", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be above 1"},
    {"id": "hurlbert_pie.total_one", "op": "hurlbert_pie", "args": {"samples": [0.5, 0.5]}, "error": "invalid_argument", "source": "the total must be above 1"},
    {"id": "hurlbert_pie.single_one", "op": "hurlbert_pie", "args": {"samples": [1.0]}, "error": "invalid_argument", "source": "the total must be above 1"}
  ]
}
