{
  "schema": 1,
  "suite": "amplifier",
  "description": "Saleh and Rapp amplifier models (conventions: Channel, Amplifier models; ADR 0114).",
  "cases": [
    {"id": "saleh_amplifier.travelling_wave_tube", "op": "saleh_amplifier", "args": {"samples": {"re": [0.0, 0.2632747685671118, -0.4161468365471424, -0.7, 0.4226682726138998, 1.6209069176044193], "im": [0.0, 0.1438276615812609, -0.9092974268256817, 0.0, 0.8304415704307657, 2.5244129544236893]}, "alpha_a": 2.1587, "beta_a": 1.1517, "alpha_phi": 4.0033, "beta_phi": 9.104}, "expected": {"re": [0.0, 0.4495419157826481, -0.03309558394678591, -0.9043124615918628, 0.08082335281579717, 0.07746402494141091], "im": [0.0, 0.3771364010689272, -1.0027072100818284, -0.33956767957437844, 1.0025031798356403, 0.5645233494669631]}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "by hand: y = x aa/(1 + ba r^2) e^{j ap r^2/(1 + bp r^2)} with Saleh's tube values, at zero, a negative real sample, the output peak r = 1/sqrt(ba) and past it"},
    {"id": "saleh_amplifier.am_am_only", "op": "saleh_amplifier", "args": {"samples": {"re": [1.0, 0.0, 2.0], "im": [0.0, 1.0, 0.0]}, "alpha_a": 2.0, "beta_a": 1.0, "alpha_phi": 0.0, "beta_phi": 0.0}, "expected": {"re": [1.0, 0.0, 0.8], "im": [0.0, 1.0, 0.0]}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "by hand: aa = 2, ba = 1, no phase: 1 -> 1, j -> j, 2 -> 2*2/5 = 0.8"},
    {"id": "saleh_amplifier.negative_unbounded_phase", "op": "saleh_amplifier", "args": {"samples": {"re": [0.5, 1.910672978251212], "im": [0.0, -0.5910404133226791]}, "alpha_a": 1.0, "beta_a": 0.0, "alpha_phi": -0.8, "beta_phi": 0.0}, "expected": {"re": [0.4900332889206208, -1.8729133745815927], "im": [-0.09933466539753061, 0.70156645537924]}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "by hand: linear gain 1, phase -0.8 r^2 with no knee"},
    {"id": "saleh_amplifier.empty", "op": "saleh_amplifier", "args": {"samples": {"re": [], "im": []}, "alpha_a": 2.1587, "beta_a": 1.1517, "alpha_phi": 4.0033, "beta_phi": 9.104}, "expected": {"re": [], "im": []}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "by hand: no samples in, none out"},
    {"id": "rapp_amplifier.p1", "op": "rapp_amplifier", "args": {"samples": {"re": [0.0, 0.25, 0.0, 1.529684374568977, -0.001, 1e+300], "im": [0.0, 0.0, 0.5, 1.288435374475382, 0.0, 0.0]}, "gain": 2.0, "saturation": 1.0, "smoothness": 1.0}, "expected": {"re": [0.0, 0.4472135954999579, 0.0, 0.7420059117887978, -0.0019999960000120004, 1.0], "im": [0.0, 0.0, 0.7071067811865475, 0.624982957734617, 0.0, 0.0]}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "by hand: g = 2, A_sat = 1, p = 1; u = 0.5, exactly 1 (A = 1/sqrt 2), 4, 0.002 on a negative real sample, and 2e300 (A = A_sat)"},
    {"id": "rapp_amplifier.p_half", "op": "rapp_amplifier", "args": {"samples": {"re": [0.0, 0.25, 0.0, 1.529684374568977, -0.001, 1e+300], "im": [0.0, 0.0, 0.5, 1.288435374475382, 0.0, 0.0]}, "gain": 2.0, "saturation": 1.0, "smoothness": 0.5}, "expected": {"re": [0.0, 0.3333333333333333, 0.0, 0.6118737498275908, -0.001996007984031936, 1.0], "im": [0.0, 0.0, 0.5, 0.5153741497901528, 0.0, 0.0]}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "by hand: as p1 with p = 0.5, A(u) = A_sat u/(1 + u)"},
    {"id": "rapp_amplifier.p3", "op": "rapp_amplifier", "args": {"samples": {"re": [0.0, 0.25, 0.0, 1.529684374568977, -0.001, 1e+300], "im": [0.0, 0.0, 0.5, 1.288435374475382, 0.0, 0.0]}, "gain": 2.0, "saturation": 1.0, "smoothness": 3.0}, "expected": {"re": [0.0, 0.4987096523225876, 0.0, 0.7648110702076165, -0.002, 1.0], "im": [0.0, 0.0, 0.8908987181403393, 0.6441914776854077, 0.0, 0.0]}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "by hand: as p1 with p = 3, a sharp knee"},
    {"id": "rapp_amplifier.unit_gain_low_saturation", "op": "rapp_amplifier", "args": {"samples": {"re": [0.1, 0.0, 5.0], "im": [0.1, 0.3, 0.0]}, "gain": 1.0, "saturation": 0.2, "smoothness": 2.0}, "expected": {"re": [0.09457416090031759, 0.0, 0.19999987200020483], "im": [0.09457416090031759, 0.19118698163005318, 0.0]}, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "by hand: g = 1, A_sat = 0.2, p = 2"},
    {"id": "saleh_amplifier.alpha_a_zero", "op": "saleh_amplifier", "args": {"samples": {"re": [1.0], "im": [0.0]}, "alpha_a": 0.0, "beta_a": 1.0, "alpha_phi": 1.0, "beta_phi": 1.0}, "error": "invalid_argument", "source": "alpha_a must be positive"},
    {"id": "saleh_amplifier.alpha_a_negative", "op": "saleh_amplifier", "args": {"samples": {"re": [1.0], "im": [0.0]}, "alpha_a": -1.0, "beta_a": 1.0, "alpha_phi": 1.0, "beta_phi": 1.0}, "error": "invalid_argument", "source": "alpha_a must be positive"},
    {"id": "saleh_amplifier.beta_a_negative", "op": "saleh_amplifier", "args": {"samples": {"re": [1.0], "im": [0.0]}, "alpha_a": 1.0, "beta_a": -0.1, "alpha_phi": 1.0, "beta_phi": 1.0}, "error": "invalid_argument", "source": "beta_a must not be negative"},
    {"id": "saleh_amplifier.beta_phi_negative", "op": "saleh_amplifier", "args": {"samples": {"re": [1.0], "im": [0.0]}, "alpha_a": 1.0, "beta_a": 1.0, "alpha_phi": 1.0, "beta_phi": -1.0}, "error": "invalid_argument", "source": "beta_phi must not be negative"},
    {"id": "saleh_amplifier.alpha_phi_nan", "op": "saleh_amplifier", "args": {"samples": {"re": [1.0], "im": [0.0]}, "alpha_a": 1.0, "beta_a": 1.0, "alpha_phi": "nan", "beta_phi": 1.0}, "error": "invalid_argument", "source": "alpha_phi must be finite"},
    {"id": "saleh_amplifier.beta_a_inf", "op": "saleh_amplifier", "args": {"samples": {"re": [1.0], "im": [0.0]}, "alpha_a": 1.0, "beta_a": "inf", "alpha_phi": 1.0, "beta_phi": 1.0}, "error": "invalid_argument", "source": "beta_a must be finite"},
    {"id": "rapp_amplifier.gain_zero", "op": "rapp_amplifier", "args": {"samples": {"re": [1.0], "im": [0.0]}, "gain": 0.0, "saturation": 1.0, "smoothness": 1.0}, "error": "invalid_argument", "source": "gain must be positive"},
    {"id": "rapp_amplifier.saturation_inf", "op": "rapp_amplifier", "args": {"samples": {"re": [1.0], "im": [0.0]}, "gain": 1.0, "saturation": "inf", "smoothness": 1.0}, "error": "invalid_argument", "source": "saturation must be finite"},
    {"id": "rapp_amplifier.smoothness_zero", "op": "rapp_amplifier", "args": {"samples": {"re": [1.0], "im": [0.0]}, "gain": 1.0, "saturation": 1.0, "smoothness": 0.0}, "error": "invalid_argument", "source": "smoothness must be positive"},
    {"id": "rapp_amplifier.smoothness_negative", "op": "rapp_amplifier", "args": {"samples": {"re": [1.0], "im": [0.0]}, "gain": 1.0, "saturation": 1.0, "smoothness": -2.0}, "error": "invalid_argument", "source": "smoothness must be positive"}
  ]
