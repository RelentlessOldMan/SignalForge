{
  "schema": 1,
  "suite": "brillouin_index",
  "description": "The Brillouin index (conventions: the Brillouin index; ADR 0546).",
  "cases": [
    {"id": "brillouin_index.two_ones", "op": "brillouin_index", "args": {"samples": [1.0, 1.0]}, "expected": 0.34657359027997264, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "N = 2, 2!/(1! 1!) = 2: ln 2 / 2"},
    {"id": "brillouin_index.one_holds_all", "op": "brillouin_index", "args": {"samples": [0.0, 4.0]}, "expected": 0.0, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "one kind: ln 1 / 4 = 0"},
    {"id": "brillouin_index.single", "op": "brillouin_index", "args": {"samples": [2.0]}, "expected": 0.0, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "one kind: 0"},
    {"id": "brillouin_index.four_ones", "op": "brillouin_index", "args": {"samples": [1.0, 1.0, 1.0, 1.0]}, "expected": 0.7945134575869864, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "4! = 24: ln 24 / 4"},
    {"id": "brillouin_index.two_twos", "op": "brillouin_index", "args": {"samples": [2.0, 2.0]}, "expected": 0.44793986730701374, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "4!/(2! 2!) = 6: ln 6 / 4"},
    {"id": "brillouin_index.two", "op": "brillouin_index", "args": {"samples": [3.0, 1.0]}, "expected": 0.34657359027997264, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "4!/3! = 4: ln 4 / 4"},
    {"id": "brillouin_index.ramp", "op": "brillouin_index", "args": {"samples": [1.0, 2.0, 3.0]}, "expected": 0.6823907603703501, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "6!/(1! 2! 3!) = 60: ln 60 / 6"},
    {"id": "brillouin_index.larger", "op": "brillouin_index", "args": {"samples": [40.0, 25.0, 0.0, 10.0, 25.0]}, "expected": 1.2230711282176954, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "100!/(40! 25! 10! 25!) exactly"},
    {"id": "brillouin_index.random", "op": "brillouin_index", "args": {"samples": [0.0, 8.0, 12.0, 12.0, 1.0, 11.0, 12.0, 4.0, 10.0, 4.0, 6.0, 11.0, 17.0, 11.0, 1.0, 1.0, 7.0, 11.0, 4.0, 18.0, 18.0, 9.0, 17.0, 6.0, 1.0, 19.0, 13.0, 18.0, 7.0, 3.0]}, "expected": 2.972041593653576, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "30 whole values from random.Random(546).randint(0, 20)"},
    {"id": "brillouin_index.empty", "op": "brillouin_index", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "brillouin_index.negative", "op": "brillouin_index", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "brillouin_index.all_zero", "op": "brillouin_index", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"},
    {"id": "brillouin_index.fraction", "op": "brillouin_index", "args": {"samples": [1.5, 2.0]}, "error": "invalid_argument", "source": "values must be whole numbers"},
    {"id": "brillouin_index.too_large", "op": "brillouin_index", "args": {"samples": [10000000.0, 1.0]}, "error": "invalid_argument", "source": "the total must be at most 10 000 000"}
  ]
}
