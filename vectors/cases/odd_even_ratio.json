{
  "schema": 1,
  "suite": "odd_even_ratio",
  "description": "Odd-to-even harmonic ratio (conventions: Spectra, Odd-to-even ratio; ADR 0141).",
  "cases": [
    {"id": "odd_even_ratio.mixed", "op": "odd_even_ratio", "args": {"heights": [4.0, 1.0, 2.0, 1.0], "orders": [1, 2, 3, 4]}, "expected": 3.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "odd 4 + 2 = 6 over even 1 + 1 = 2"},
    {"id": "odd_even_ratio.any_sequence", "op": "odd_even_ratio", "args": {"heights": [1.0, 2.0, 3.0], "orders": [2, 1, 3]}, "expected": 5.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "odd 2 + 3 = 5 over even 1"},
    {"id": "odd_even_ratio.unmatched", "op": "odd_even_ratio", "args": {"heights": [1.0, 9.0, 3.0], "orders": [1, 0, 2]}, "expected": 0.3333333333333333, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "order 0 left out: odd 1 over even 3"},
    {"id": "odd_even_ratio.odd_only", "op": "odd_even_ratio", "args": {"heights": [1.0, 0.25, 0.0625], "orders": [1, 3, 5]}, "expected": "inf", "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "a square wave's odd harmonics only: no even power gives inf"},
    {"id": "odd_even_ratio.even_only", "op": "odd_even_ratio", "args": {"heights": [1.0, 2.0], "orders": [2, 4]}, "expected": 0.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "no odd power over even 3"},
    {"id": "odd_even_ratio.silent_even", "op": "odd_even_ratio", "args": {"heights": [2.0, 0.0], "orders": [1, 2]}, "expected": "inf", "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "the even tone has no power"},
    {"id": "odd_even_ratio.nothing", "op": "odd_even_ratio", "args": {"heights": [1.0, 2.0], "orders": [0, 0]}, "error": "invalid_argument", "source": "no harmonic tones"},
    {"id": "odd_even_ratio.all_silent", "op": "odd_even_ratio", "args": {"heights": [0.0, 0.0], "orders": [1, 2]}, "error": "invalid_argument", "source": "the harmonics have no power"},
    {"id": "odd_even_ratio.length_mismatch", "op": "odd_even_ratio", "args": {"heights": [1.0, 2.0], "orders": [1]}, "error": "invalid_argument", "source": "orders is shorter than heights"},
    {"id": "odd_even_ratio.negative_height", "op": "odd_even_ratio", "args": {"heights": [1.0, -2.0], "orders": [1, 2]}, "error": "invalid_argument", "source": "heights must be non-negative"},
    {"id": "odd_even_ratio.negative_order", "op": "odd_even_ratio", "args": {"heights": [1.0, 2.0], "orders": [1, -2]}, "error": "invalid_argument", "source": "orders must be >= 0"}
  ]
}
