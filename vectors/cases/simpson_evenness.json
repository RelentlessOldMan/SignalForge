{
  "schema": 1,
  "suite": "simpson_evenness",
  "description": "Simpson's evenness (conventions: Simpson's evenness; ADR 0532).",
  "cases": [
    {"id": "simpson_evenness.equal", "op": "simpson_evenness", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "four equal shares: 1/(4 (4/16)) = 1"},
    {"id": "simpson_evenness.single", "op": "simpson_evenness", "args": {"samples": [5.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "one value: 1"},
    {"id": "simpson_evenness.one_holds_all", "op": "simpson_evenness", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 0.25, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "one share of 1: 1/4"},
    {"id": "simpson_evenness.two", "op": "simpson_evenness", "args": {"samples": [3.0, 1.0]}, "expected": 0.8, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 3/4, 1/4: 1/(2 (10/16)) = 4/5"},
    {"id": "simpson_evenness.ramp", "op": "simpson_evenness", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.8333333333333334, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 4, 1, 3, 2 tenths: 1/(4 (30/100)) = 5/6"},
    {"id": "simpson_evenness.three", "op": "simpson_evenness", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.5333333333333333, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 3/4, 0, 1/4: 1/(3 (10/16)) = 8/15"},
    {"id": "simpson_evenness.halves", "op": "simpson_evenness", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.7272727272727273, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 1/4, 1/8, 1/8, 1/2: 1/(4 (22/64)) = 8/11"},
    {"id": "simpson_evenness.random", "op": "simpson_evenness", "args": {"samples": [3.25, 2.25, 1.375, 7.75, 5.375, 0.125, 1.5, 2.125, 7.5, 5.625, 2.375, 4.0, 5.75, 2.875, 3.75, 5.875, 7.375, 3.0, 4.625, 4.125, 0.875, 1.75, 0.125, 1.0, 4.375, 2.0, 1.375, 1.125, 4.625, 2.625]}, "expected": 0.7104253214638971, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "30 values k/8, k from random.Random(532).randint(0, 64)"},
    {"id": "simpson_evenness.huge", "op": "simpson_evenness", "args": {"samples": [1e+308, 9e+307, 1e+300]}, "expected": 0.664825053038674, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "values whose sum overflows a double: the result is that of the values scaled down"},
    {"id": "simpson_evenness.empty", "op": "simpson_evenness", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "simpson_evenness.negative", "op": "simpson_evenness", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "simpson_evenness.all_zero", "op": "simpson_evenness", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
