{
  "schema": 1,
  "suite": "wavetable",
  "description": "Wavetable oscillator (conventions: Wavetable oscillator; ADR 0308).",
  "cases": [
    {"id": "wavetable.on_the_points", "op": "wavetable", "args": {"table": [0.0, 1.0, 0.0, -1.0], "sample_rate": 8000.0, "num_samples": 8, "frequency": 2000.0}, "expected": [0.0, 1.0, 0.0, -1.0, 0.0, 1.0, 0.0, -1.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "one table entry per sample: the table itself"},
    {"id": "wavetable.halfway", "op": "wavetable", "args": {"table": [0.0, 1.0, 0.0, -1.0], "sample_rate": 8000.0, "num_samples": 8, "frequency": 1000.0}, "expected": [0.0, 0.5, 1.0, 0.5, 0.0, -0.5, -1.0, -0.5], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "two samples per entry: the midpoints, wrapping from the last entry to the first"},
    {"id": "wavetable.odd_table", "op": "wavetable", "args": {"table": [0.1, 0.9, 0.4, -0.3, -0.8, -0.2, 0.6], "sample_rate": 48000.0, "num_samples": 40, "frequency": 1234.5, "phase": 0.3}, "expected": [0.33000000000000007, 0.20397812500000007, 0.07795625000000007, -0.04806562499999993, -0.17408749999999992, -0.300078125, -0.39009374999999996, -0.48010937499999995, -0.570125, -0.660140625, -0.75015625, -0.75179375, -0.6437750000000001, -0.53575625, -0.42773750000000005, -0.31971875000000005, -0.21170000000000005, -0.07157500000000007, 0.07244999999999992, 0.21647499999999992, 0.36049999999999993, 0.5045249999999999, 0.56965625, 0.47964062500000004, 0.38962500000000005, 0.299609375, 0.20959375000000005, 0.11957812500000005, 0.21269999999999994, 0.35672499999999996, 0.5007499999999999, 0.644775, 0.7888, 0.8794843750000001, 0.78946875, 0.699453125, 0.6094375000000001, 0.519421875, 0.42940625000000004, 0.31514687500000005], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "a 7-entry table at 1234.5 Hz"},
    {"id": "wavetable.backwards", "op": "wavetable", "args": {"table": [0.1, 0.9, 0.4, -0.3, -0.8, -0.2, 0.6], "sample_rate": 8000.0, "num_samples": 24, "frequency": -700.0}, "expected": [0.1, 0.40625, 0.42, -0.07, -0.47000000000000003, -0.76875, -0.4625, -0.09874999999999999, 0.33, 0.65625, 0.8, 0.31, 0.275, 0.5812499999999999, 0.13999999999999999, -0.3125, -0.68, -0.59375, -0.2825, 0.14625000000000002, 0.525, 0.83125, 0.52, 0.14375000000000002], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "a negative frequency reads backwards"},
    {"id": "wavetable.constant", "op": "wavetable", "args": {"table": [0.25], "sample_rate": 8000.0, "num_samples": 4, "frequency": 1000.0}, "expected": [0.25, 0.25, 0.25, 0.25], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "a one-entry table is a constant"},
    {"id": "wavetable.empty_table", "op": "wavetable", "args": {"table": [], "sample_rate": 8000.0, "num_samples": 4, "frequency": 1000.0}, "error": "invalid_argument", "source": "table must hold at least one entry"},
    {"id": "wavetable.rate_zero", "op": "wavetable", "args": {"table": [0.0, 1.0], "sample_rate": 0.0, "num_samples": 4, "frequency": 1000.0}, "error": "invalid_argument", "source": "sample_rate must be positive"}
  ]
}
