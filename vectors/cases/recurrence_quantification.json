    {"id": "recurrence_quantification.m_zero", "op": "recurrence_quantification", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5, 0.0], "m": 0, "radius": 1.0}, "error": "invalid_argument", "source": "m must be at least 1"},
