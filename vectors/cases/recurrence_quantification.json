{
  "schema": 1,
  "suite": "recurrence_quantification",
  "description": "Recurrence quantification (conventions: Recurrence quantification; ADR 0350).",
  "cases": [
    {"id": "recurrence_quantification.period_three", "op": "recurrence_quantification", "args": {"samples": [0.0, 1.0, 2.0, 0.0, 1.0, 2.0, 0.0, 1.0, 2.0, 0.0, 1.0, 2.0], "m": 1, "radius": 0.5}, "expected": {"rate": 0.2727272727272727, "determinism": 1.0, "longest": 9}, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "period 3, twelve samples, m = 1: only the diagonals s = 3, 6, 9 recur, all of them, with 9 + 6 + 3 = 18 of the 66 points; each is one line, so determinism 1, longest 9"},
    {"id": "recurrence_quantification.isolated", "op": "recurrence_quantification", "args": {"samples": [0.0, 4.0, 1.0, 5.0, 0.25], "m": 1, "radius": 0.5}, "expected": {"rate": 0.1, "determinism": 0.0, "longest": 1}, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "only the pair (0, 4) recurs, alone on its diagonal: rate 1/10, determinism 0, longest 1"},
    {"id": "recurrence_quantification.radius_on_a_distance", "op": "recurrence_quantification", "args": {"samples": [0.0, 1.0, 0.0, 1.0, 0.5, 2.0], "m": 1, "radius": 1.0}, "expected": {"rate": 0.4, "determinism": 0.5, "longest": 3}, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "distances of exactly 1 must not recur"},
