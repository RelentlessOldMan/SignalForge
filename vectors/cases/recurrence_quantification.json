    {"id": "recurrence_quantification.no_recurrence", "op": "recurrence_quantification", "args": {"samples": [0.0, 1.0, 2.0, 3.0], "m": 1, "radius": 0.25}, "error": "invalid_argument", "source": "nothing is closer than 0.25"},
