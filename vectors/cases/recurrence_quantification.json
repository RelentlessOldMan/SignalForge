    {"id": "recurrence_quantification.min_line_zero", "op": "recurrence_quantification", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5, 0.0], "m": 2, "radius": 1.0, "min_line": 0}, "error": "invalid_argument", "source": "min_line must be at least 1"},
    {"id": "recurrence_quantification.theiler_negative", "op": "recurrence_quantification", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5, 0.0], "m": 2, "radius": 1.0, "theiler": -1}, "error": "invalid_argument", "source": "theiler must be at least 0"},
    {"id": "recurrence_quantification.radius_zero", "op": "recurrence_quantification", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5, 0.0], "m": 2, "radius": 0.0}, "error": "invalid_argument", "source": "radius must be positive"},
