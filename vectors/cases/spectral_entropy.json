{
  "schema": 1,
  "suite": "spectral_entropy",
  "description": "Spectral entropy (conventions: Spectra, Spectral entropy; ADR 0128).",
  "cases": [
    {"id": "spectral_entropy.flat", "op": "spectral_entropy", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 2.0, 2.0, 2.0]}, "expected": {"entropy": 1.3862943611198906, "entropy_bandwidth": 4.0, "normalized": 1.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "flat over a width of 4: entropy ln 4, bandwidth 4, normalized 1"},
    {"id": "spectral_entropy.single_bin", "op": "spectral_entropy", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 5.0, 0.0, 0.0]}, "expected": {"entropy": 0.0, "entropy_bandwidth": 1.0, "normalized": 0.25}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "all power flat in one bin of width 1: entropy 0, bandwidth 1, normalized 1/4"},
    {"id": "spectral_entropy.two_ends", "op": "spectral_entropy", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 0.0, 0.0, 1.0]}, "expected": {"entropy": 0.6931471805599453, "entropy_bandwidth": 2.0, "normalized": 0.5}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "two equal bins of width 1: entropy ln 2, bandwidth 2, normalized 1/2"},
    {"id": "spectral_entropy.narrow_bins", "op": "spectral_entropy", "args": {"frequencies": [0.0, 0.25, 0.5, 0.75], "psd": [0.0, 1.0, 0.0, 0.0]}, "expected": {"entropy": -1.3862943611198906, "entropy_bandwidth": 0.25, "normalized": 0.25}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "one bin of width 1/4: entropy ln(1/4) < 0, bandwidth 1/4, normalized 1/4"},
    {"id": "spectral_entropy.uneven", "op": "spectral_entropy", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0]}, "expected": {"entropy": 1.2798542258336678, "entropy_bandwidth": 3.596115466624323, "normalized": 0.8990288666560807}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "shares 0.1, 0.2, 0.3, 0.4 on unit bins: entropy -sum q ln q"},
    {"id": "spectral_entropy.cut_band", "op": "spectral_entropy", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0], "band": [0.25, 2.75]}, "expected": {"entropy": 0.8616333696292525, "entropy_bandwidth": 2.367023762662837, "normalized": 0.9468095050651348}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "band [0.25, 2.75] cuts bins 0 and 3 to a quarter"},
    {"id": "spectral_entropy.span_clipped", "op": "spectral_entropy", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 1.0, 1.0, 2.0], "span": [0.0, 3.0]}, "expected": {"entropy": 0.8675632284814613, "entropy_bandwidth": 2.3811015779522995, "normalized": 0.7937005259840998}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "span (0, 3): halved bins 0 and 3 at density 4, inner bins at 1; power 6"},
    {"id": "spectral_entropy.no_power", "op": "spectral_entropy", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 0.0, 1.0, 0.0], "band": [-0.5, 1.5]}, "error": "invalid_argument", "source": "the band has no power"},
    {"id": "spectral_entropy.band_outside", "op": "spectral_entropy", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [-1.0, 3.0]}, "error": "invalid_argument", "source": "band [-1, 3] leaves the spectrum [-0.5, 3.5]"},
    {"id": "spectral_entropy.one_bin", "op": "spectral_entropy", "args": {"frequencies": [0.0], "psd": [1.0]}, "error": "invalid_argument", "source": "need at least two bins"}
  ]
}
