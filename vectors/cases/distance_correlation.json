{
  "schema": 1,
  "suite": "distance_correlation",
  "description": "Distance correlation (conventions: Distance correlation; ADR 0372).",
  "cases": [
    {"id": "distance_correlation.two_points", "op": "distance_correlation", "args": {"x": [0.0, 1.0], "y": [5.0, 3.0]}, "expected": 1.0, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "N = 2: A = [[-1/2, 1/2], [1/2, -1/2]], B = 2A: dCov^2 = 1/2, dVar^2 1/4 and 1: dCor = sqrt((1/2)/sqrt(1/4)) = 1"},
    {"id": "distance_correlation.line", "op": "distance_correlation", "args": {"x": [0.0, 1.0, 2.0, 4.0], "y": [1.0, -1.0, -3.0, -7.0]}, "expected": 1.0, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "y = 1 - 2x: B = 2A exactly, so dCor = 1"},
    {"id": "distance_correlation.square", "op": "distance_correlation", "args": {"x": [-2.0, -1.0, 0.0, 1.0, 2.0], "y": [4.0, 1.0, 0.0, 1.0, 4.0]}, "expected": 0.5159234568589328, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "y = x^2 on symmetric x: Pearson r is 0, but dCor is not"},
    {"id": "distance_correlation.noisy_parabola", "op": "distance_correlation", "args": {"x": [-2.125, 2.625, 2.875, -0.125, -1.125, -2.375, 1.125, -1.375, 2.625, 0.625, 0.375, 1.75, 1.0, 2.875, -1.375, 0.375, -2.0, 1.625, -0.625, -1.125, -0.125, -2.625, -2.0, 1.375, -0.625, -0.625, 2.875, -1.375, 0.375, -1.875, -0.125, -0.75, 2.25, 1.5, 2.875, -1.375, -2.75, 2.625, -0.875, -0.875], "y": [0.62890625, 1.72265625, 2.06640625, -0.37109375, 1.06640625, 1.16015625, -0.55859375, 0.72265625, 1.09765625, 0.97265625, -0.58984375, -0.109375, 0.75, 1.19140625, 0.59765625, 0.16015625, 0.25, 1.53515625, 0.97265625, -0.30859375, 0.87890625, 1.34765625, 0.625, -0.02734375, -0.65234375, -0.02734375, 2.56640625, 0.84765625, -0.33984375, 1.62890625, 0.62890625, -0.484375, 2.265625, -0.1875, 1.94140625, 1.09765625, 2.390625, 2.72265625, 0.81640625, -0.55859375]}, "expected": 0.46918996044668165, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "40 random eighths from random.Random(372), y = x^2/4 plus random eighths"},
    {"id": "distance_correlation.huge", "op": "distance_correlation", "args": {"x": [-2.1430172143725346e+301, -1.0715086071862673e+301, 0.0, 1.0715086071862673e+301, 2.1430172143725346e+301], "y": [4.2860344287450693e+301, 1.0715086071862673e+301, 0.0, 1.0715086071862673e+301, 4.2860344287450693e+301]}, "expected": 0.5159234568589328, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "case square times 2^1000: squares of the deviations overflow a double, but the measure is scale-free, so the same value"},
    {"id": "distance_correlation.tiny", "op": "distance_correlation", "args": {"x": [-1.8665272370064378e-301, -9.332636185032189e-302, 0.0, 9.332636185032189e-302, 1.8665272370064378e-301], "y": [3.7330544740128755e-301, 9.332636185032189e-302, 0.0, 9.332636185032189e-302, 3.7330544740128755e-301]}, "expected": 0.5159234568589328, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "case square times 2^-1000: squares of the deviations underflow to 0, but the measure is scale-free, so the same value"},
    {"id": "distance_correlation.lengths_differ", "op": "distance_correlation", "args": {"x": [0.0, 1.0, 0.5], "y": [1.0, 2.0]}, "error": "invalid_argument", "source": "x and y must be the same length"},
    {"id": "distance_correlation.one_sample", "op": "distance_correlation", "args": {"x": [1.0], "y": [2.0]}, "error": "invalid_argument", "source": "N must be at least 2"},
    {"id": "distance_correlation.constant_x", "op": "distance_correlation", "args": {"x": [1.0, 1.0, 1.0], "y": [2.0, 1.0, 3.0]}, "error": "invalid_argument", "source": "x must not be constant"},
    {"id": "distance_correlation.constant_y", "op": "distance_correlation", "args": {"x": [0.0, 1.0, 0.5], "y": [1.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "y must not be constant"},
    {"id": "distance_correlation.nan", "op": "distance_correlation", "args": {"x": [0.0, "nan", 1.0], "y": [2.0, 1.0, 3.0]}, "error": "invalid_argument", "source": "samples must be finite"}
  ]
}
