{
  "schema": 1,
  "suite": "cepstral_distance",
  "description": "Cepstral distance between AR models (conventions: Cepstral distance between AR models; ADR 0218).",
  "cases": [
    {"id": "cepstral_distance.identical", "op": "cepstral_distance", "args": {"reference": [1.0, -0.16666666666666666, -0.16666666666666666], "test": [1.0, -0.16666666666666666, -0.16666666666666666], "num_coefficients": 6}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "equal models: 0"},
    {"id": "cepstral_distance.order_one", "op": "cepstral_distance", "args": {"reference": [1.0, 0.5], "test": [1.0, -0.25], "num_coefficients": 3}, "expected": 0.7572888010032897, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "a = 1/2 vs -1/4: c = -1/2, 1/8, -1/24 and 1/4, 1/32, 1/192"},
    {"id": "cepstral_distance.one_coefficient", "op": "cepstral_distance", "args": {"reference": [1.0, 0.5], "test": [1.0, -0.25], "num_coefficients": 1}, "expected": 0.75, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "L = 1: |c_1 difference| = 3/4"},
    {"id": "cepstral_distance.order_two_vs_white", "op": "cepstral_distance", "args": {"reference": [1.0, -0.16666666666666666, -0.16666666666666666], "test": [1.0], "num_coefficients": 5}, "expected": 0.24822847500563436, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "poles 1/2, -1/3 (a = [1, -1/6, -1/6]) vs A = 1: c_n = ((1/2)^n + (-1/3)^n)/n"},
    {"id": "cepstral_distance.order_two_vs_three", "op": "cepstral_distance", "args": {"reference": [1.0, -0.2, -0.24], "test": [1.0, -0.05, -0.4, 0.0875], "num_coefficients": 8}, "expected": 0.24478235068054496, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "real poles of orders 2 and 3"},
    {"id": "cepstral_distance.complex", "op": "cepstral_distance", "args": {"reference": {"re": [1.0, 0.0], "im": [0.0, -0.5]}, "test": {"re": [1.0, -0.09999999999999998, -0.06], "im": [0.0, -0.4, -0.08000000000000002]}, "num_coefficients": 6}, "expected": 0.22905595038403462, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "complex poles: A = 1 - 0.5j z^-1 vs (1 - (0.3 + 0.4j) z^-1)(1 + 0.2 z^-1)"},
    {"id": "cepstral_distance.conjugate_pair", "op": "cepstral_distance", "args": {"reference": {"re": [1.0, -1.2, 0.44999999999999996], "im": [0.0, 0.0, 0.0]}, "test": [1.0, -0.5], "num_coefficients": 7}, "expected": 0.718443384525565, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "a real filter with a complex-conjugate pole pair: c_n = 2 Re(p^n)/n"},
    {"id": "cepstral_distance.reference_not_minimum_phase", "op": "cepstral_distance", "args": {"reference": [1.0, 0.0, 1.0], "test": [1.0, -0.25], "num_coefficients": 4}, "error": "invalid_argument", "source": "a = [1, 0, 1] has k2 = 1"},
    {"id": "cepstral_distance.test_not_minimum_phase", "op": "cepstral_distance", "args": {"reference": [1.0, 0.5], "test": [1.0, 2.0], "num_coefficients": 4}, "error": "invalid_argument", "source": "a = [1, 2] has k1 = 2"},
    {"id": "cepstral_distance.test_a0", "op": "cepstral_distance", "args": {"reference": [1.0, 0.5], "test": [2.0, 0.5], "num_coefficients": 4}, "error": "invalid_argument", "source": "test[0] must be 1"},
    {"id": "cepstral_distance.reference_empty", "op": "cepstral_distance", "args": {"reference": [], "test": [1.0, -0.25], "num_coefficients": 4}, "error": "invalid_argument", "source": "reference must not be empty"},
    {"id": "cepstral_distance.test_nan", "op": "cepstral_distance", "args": {"reference": [1.0, 0.5], "test": [1.0, "nan"], "num_coefficients": 4}, "error": "invalid_argument", "source": "test must be finite"},
    {"id": "cepstral_distance.zero_coefficients", "op": "cepstral_distance", "args": {"reference": [1.0, 0.5], "test": [1.0, -0.25], "num_coefficients": 0}, "error": "invalid_argument", "source": "num_coefficients must be at least 1"}
  ]
}
