{
  "schema": 1,
  "suite": "itakura_saito",
  "description": "Itakura-Saito distance between AR models (conventions: Itakura-Saito distance between AR models; ADR 0217).",
  "cases": [
    {"id": "itakura_saito.identical", "op": "itakura_saito", "args": {"reference": [1.0, 0.5], "reference_error": 1.0, "test": [1.0, 0.5], "test_error": 1.0}, "expected": 0.0, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "equal models: q = r0 (1 - a^2) = s, d = 1 - 0 - 1 = 0"},
    {"id": "itakura_saito.order_one", "op": "itakura_saito", "args": {"reference": [1.0, 0.5], "reference_error": 1.0, "test": [1.0, -0.25], "test_error": 2.0}, "expected": 0.5681471805599454, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "r0 = 4/3, r1 = -2/3; q = 4/3 (1 + 1/16) + 2(-1/4)(-2/3) = 7/4; d = 7/8 + ln 2 - 1"},
    {"id": "itakura_saito.order_one_swapped", "op": "itakura_saito", "args": {"reference": [1.0, -0.25], "reference_error": 2.0, "test": [1.0, 0.5], "test_error": 1.0}, "expected": 1.5068528194400548, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "the distance is not symmetric: the swapped pair"},
    {"id": "itakura_saito.white_test", "op": "itakura_saito", "args": {"reference": [1.0, -0.6], "reference_error": 1.0, "test": [1.0], "test_error": 1.0}, "expected": 0.5625, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "a white test model: q = r0 = 1/(1 - 9/25) = 25/16, d = 25/16 - 1"},
    {"id": "itakura_saito.white_reference", "op": "itakura_saito", "args": {"reference": [1.0], "reference_error": 3.0, "test": [1.0, 0.5, -0.2], "test_error": 2.0}, "expected": 0.5295348918918357, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "a white reference: q = 3 (1 + 1/4 + 1/25), d = q/2 - ln(3/2) - 1"},
    {"id": "itakura_saito.order_two_vs_three", "op": "itakura_saito", "args": {"reference": [1.0, 0.35, -0.3], "reference_error": 0.5, "test": [1.0, 0.3333333333333333, 0.25, -0.125], "test_error": 0.75}, "expected": 0.4611902471666367, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "orders 2 and 3 with the reference autocorrelation extended past its order"},
    {"id": "itakura_saito.complex", "op": "itakura_saito", "args": {"reference": {"re": [1.0, 0.3], "im": [0.0, 0.4]}, "reference_error": 1.5, "test": {"re": [1.0, -0.2, 0.0], "im": [0.0, 0.1, 0.25]}, "test_error": 1.0}, "expected": 1.189534891891836, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "complex models; the closed form agrees with the integral"},
    {"id": "itakura_saito.reference_not_minimum_phase", "op": "itakura_saito", "args": {"reference": [1.0, 0.0, 1.0], "reference_error": 1.0, "test": [1.0, -0.25], "test_error": 1.0}, "error": "invalid_argument", "source": "a = [1, 0, 1] has k2 = 1"},
    {"id": "itakura_saito.test_not_minimum_phase", "op": "itakura_saito", "args": {"reference": [1.0, 0.5], "reference_error": 1.0, "test": [1.0, 2.0], "test_error": 1.0}, "error": "invalid_argument", "source": "a = [1, 2] has k1 = 2"},
    {"id": "itakura_saito.test_a0", "op": "itakura_saito", "args": {"reference": [1.0, 0.5], "reference_error": 1.0, "test": [2.0, 0.5], "test_error": 1.0}, "error": "invalid_argument", "source": "test[0] must be 1"},
    {"id": "itakura_saito.reference_empty", "op": "itakura_saito", "args": {"reference": [], "reference_error": 1.0, "test": [1.0, -0.25], "test_error": 1.0}, "error": "invalid_argument", "source": "reference must not be empty"},
    {"id": "itakura_saito.reference_nan", "op": "itakura_saito", "args": {"reference": [1.0, "nan"], "reference_error": 1.0, "test": [1.0, -0.25], "test_error": 1.0}, "error": "invalid_argument", "source": "reference must be finite"},
    {"id": "itakura_saito.zero_reference_error", "op": "itakura_saito", "args": {"reference": [1.0, 0.5], "reference_error": 0.0, "test": [1.0, -0.25], "test_error": 1.0}, "error": "invalid_argument", "source": "reference_error must be positive"},
    {"id": "itakura_saito.inf_test_error", "op": "itakura_saito", "args": {"reference": [1.0, 0.5], "reference_error": 1.0, "test": [1.0, -0.25], "test_error": "inf"}, "error": "invalid_argument", "source": "test_error must be finite"}
  ]
}
