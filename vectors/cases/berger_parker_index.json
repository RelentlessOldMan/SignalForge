{
  "schema": 1,
  "suite": "berger_parker_index",
  "description": "The Berger-Parker index (conventions: the Berger-Parker index; ADR 0530).",
  "cases": [
    {"id": "berger_parker_index.equal", "op": "berger_parker_index", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 0.25, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "four equal shares: 1/4"},
    {"id": "berger_parker_index.single", "op": "berger_parker_index", "args": {"samples": [5.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "one value: 1"},
    {"id": "berger_parker_index.one_holds_all", "op": "berger_parker_index", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "one share of 1: 1"},
    {"id": "berger_parker_index.two", "op": "berger_parker_index", "args": {"samples": [3.0, 1.0]}, "expected": 0.75, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 3/4, 1/4: 3/4"},
    {"id": "berger_parker_index.ramp", "op": "berger_parker_index", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.4, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "largest 4 of 10: 2/5"},
    {"id": "berger_parker_index.three", "op": "berger_parker_index", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.75, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "largest 3 of 4: 3/4"},
    {"id": "berger_parker_index.halves", "op": "berger_parker_index", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.5, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "largest 1 of 2: 1/2"},
    {"id": "berger_parker_index.tie", "op": "berger_parker_index", "args": {"samples": [3.0, 3.0, 2.0]}, "expected": 0.375, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "two largest of 3 tie, 3 of 8: 3/8"},
    {"id": "berger_parker_index.random", "op": "berger_parker_index", "args": {"samples": [5.25, 1.625, 3.5, 7.75, 1.375, 6.25, 6.125, 2.625, 0.5, 0.875, 8.0, 4.5, 4.625, 5.5, 0.375, 0.25, 0.625, 5.375, 2.0, 2.625, 6.625, 1.875, 0.25, 4.375, 4.25, 3.25, 0.125, 4.0, 4.25, 0.125]}, "expected": 0.08091024020227561, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "30 values k/8, k from random.Random(530).randint(0, 64)"},
    {"id": "berger_parker_index.huge", "op": "berger_parker_index", "args": {"samples": [1e+308, 9e+307, 1e+300]}, "expected": 0.5263157867036011, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "values whose sum overflows a double: the result is that of the values scaled down"},
    {"id": "berger_parker_index.empty", "op": "berger_parker_index", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "berger_parker_index.negative", "op": "berger_parker_index", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "berger_parker_index.all_zero", "op": "berger_parker_index", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
