{
  "schema": 1,
  "suite": "hutcheson_variance",
  "description": "Hutcheson's variance (conventions: Hutcheson's variance; ADR 0556).",
  "cases": [
    {"id": "hutcheson_variance.one_kind", "op": "hutcheson_variance", "args": {"samples": [0.0, 4.0]}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "one kind: 0 + 0"},
    {"id": "hutcheson_variance.two_twos", "op": "hutcheson_variance", "args": {"samples": [2.0, 2.0]}, "expected": 0.03125, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "even shares: 0 + 1/32"},
    {"id": "hutcheson_variance.halves_quarters", "op": "hutcheson_variance", "args": {"samples": [1.0, 1.0, 2.0]}, "expected": 0.0925283133698876, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "Q - L^2 = (ln 2)^2/4: ((ln 2)^2 + 1)/16"},
    {"id": "hutcheson_variance.four_ones", "op": "hutcheson_variance", "args": {"samples": [1.0, 1.0, 1.0, 1.0]}, "expected": 0.09375, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "even shares: 0 + 3/32"},
    {"id": "hutcheson_variance.ramp", "op": "hutcheson_variance", "args": {"samples": [1.0, 2.0, 3.0]}, "expected": 0.05355631774830158, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "N = 6, k = 3"},
    {"id": "hutcheson_variance.mixed", "op": "hutcheson_variance", "args": {"samples": [5.0, 1.0, 1.0, 0.0, 2.0]}, "expected": 0.06820384505989013, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "N = 9, k = 4"},
    {"id": "hutcheson_variance.large", "op": "hutcheson_variance", "args": {"samples": [1000.0, 2000.0, 3000.0, 4000.0]}, "expected": 1.8107168665391798e-05, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "N = 10000, k = 4"},
    {"id": "hutcheson_variance.random", "op": "hutcheson_variance", "args": {"samples": [7.0, 3.0, 9.0, 7.0, 8.0, 4.0, 0.0, 0.0, 6.0, 9.0, 3.0, 8.0, 2.0, 1.0, 8.0, 0.0, 4.0, 0.0, 1.0, 2.0, 2.0, 4.0, 2.0, 2.0, 6.0, 9.0, 6.0, 7.0, 1.0, 0.0, 9.0, 6.0, 7.0, 7.0, 7.0, 7.0, 9.0, 1.0, 4.0, 5.0]}, "expected": 0.0017346061547713375, "tol": {"abs": 1e-14, "rel": 1e-12}, "source": "40 whole values from random.Random(556).randint(0, 9)"},
    {"id": "hutcheson_variance.empty", "op": "hutcheson_variance", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "hutcheson_variance.negative", "op": "hutcheson_variance", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "hutcheson_variance.all_zero", "op": "hutcheson_variance", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"},
    {"id": "hutcheson_variance.fraction", "op": "hutcheson_variance", "args": {"samples": [1.5, 2.0]}, "error": "invalid_argument", "source": "values must be whole numbers"},
    {"id": "hutcheson_variance.too_large", "op": "hutcheson_variance", "args": {"samples": [10000000.0, 1.0]}, "error": "invalid_argument", "source": "the total must be at most 10 000 000"}
  ]
}
