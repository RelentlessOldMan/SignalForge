    {"id": "fir_equiripple.even_taps_gain_at_nyquist", "op": "fir_equiripple", "args": {"num_taps": 20, "bands": [0, 0.3, 0.35, 0.5], "desired": [0, 1], "sample_rate": 1}, "error": "invalid_argument", "source": "conventions: an even num_taps has zero gain at fs/2, so desired there must be 0"},
    {"id": "fir_equiripple.too_few_grid_points", "op": "fir_equiripple", "args": {"num_taps": 101, "bands": [0, 0.001, 0.002, 0.003], "desired": [1, 0], "sample_rate": 1}, "error": "invalid_argument", "source": "conventions: step 0.5/(16*51); two intervals per band gives 6 points, fewer than L + 1 = 52"},
    {"id": "fir_equiripple.hilbert_3_by_hand", "op": "fir_equiripple", "args": {"num_taps": 3, "bands": [0.1, 0.4], "desired": [1], "sample_rate": 1, "kind": "hilbert"}, "expected": [-0.6298080918412499, 0.0, 0.6298080918412499], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "by hand: type III, L = 1, A = a sin(2 pi nu) with a = 2 h[2]; the error 1 - a sin is largest at the band ends (sin(0.2 pi)) and at 0.25 (sin = 1, a grid point), so the optimum levels them: a = 2/(sin(0.2 pi) + 1)"},
