{
  "schema": 1,
  "suite": "equiripple",
  "description": "Equiripple (Parks-McClellan) FIR design (conventions: FIR filters, Equiripple design).",
  "cases": [
    {"id": "fir_equiripple.three_taps_analytic", "op": "fir_equiripple", "args": {"num_taps": 3, "bands": [0, 0.1, 0.4, 0.5], "desired": [1, 0], "sample_rate": 1}, "expected": [0.276393202250021, 0.5, 0.276393202250021], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "hand: A = b + s*cos(2 pi nu), s = 2a; the error alternates at the four band edges (cos 2 pi nu = 1, cos(pi/5), -cos(pi/5), -1), all on the grid; so b = 1/2 and s = 1/(1 + cos(pi/5)), delta = 1/2 - s cos(pi/5)"},
    {"id": "fir_equiripple.two_taps_analytic", "op": "fir_equiripple", "args": {"num_taps": 2, "bands": [0, 0.1, 0.4, 0.5], "desired": [1, 0], "sample_rate": 1}, "expected": [0.39680224666742053, 0.39680224666742053], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "hand: A = 2h cos(pi nu); L = 1 needs two alternation points, the inner band edges: 1 - 2h cos(pi/10) = 2h cos(2pi/5), so h = 1/(2(cos(pi/10) + cos(2pi/5)))"},
    {"id": "fir_equiripple.two_taps_weighted", "op": "fir_equiripple", "args": {"num_taps": 2, "bands": [0, 0.1, 0.4, 0.5], "desired": [1, 0], "sample_rate": 1, "weights": [1, 10]}, "expected": [0.12372481595462938, 0.12372481595462938], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "hand: as two_taps_analytic with stopband weight 10: 1 - 2h cos(pi/10) = 10*2h cos(2pi/5)"},
    {"id": "fir_equiripple.zero_delta_start", "op": "fir_equiripple", "args": {"num_taps": 1, "bands": [0, 0.2, 0.25, 0.35, 0.4, 0.5], "desired": [0, 1, 0], "sample_rate": 1}, "expected": [0.5], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "hand: a constant c minimizing max(|c|, |1 - c|) is 1/2; the first extremal set (the first and last grid points) lies only in the 0 bands, so the first delta is 0 and the old set's points must still count as extrema"},
    {"id": "fir_equiripple.one_tap", "op": "fir_equiripple", "args": {"num_taps": 1, "bands": [0, 0.1, 0.4, 0.5], "desired": [1, 0], "sample_rate": 1}, "expected": [0.5], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "hand: a constant c minimizing max(|1 - c|, |c|) is 1/2"},
    {"id": "fir_equiripple.one_tap_weighted", "op": "fir_equiripple", "args": {"num_taps": 1, "bands": [0, 0.1, 0.4, 0.5], "desired": [1, 0], "sample_rate": 1, "weights": [1, 3]}, "expected": [0.25], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "hand: |1 - c| = 3|c| gives c = 1/4"},
    {"id": "fir_equiripple.constant_exact", "op": "fir_equiripple", "args": {"num_taps": 5, "bands": [0, 0.5], "desired": [2], "sample_rate": 1}, "expected": [0, 0, 2, 0, 0], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "conventions: odd num_taps with all desired equal is exact, 2 at the center"},
    {"id": "fir_equiripple.all_zero_even", "op": "fir_equiripple", "args": {"num_taps": 4, "bands": [0, 0.2, 0.3, 0.5], "desired": [0, 0], "sample_rate": 1}, "expected": [0, 0, 0, 0], "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "conventions: every desired value 0 gives zero taps"},
