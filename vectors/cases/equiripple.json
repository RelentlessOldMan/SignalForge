    {"id": "fir_equiripple.lowpass_21_density_4", "op": "fir_equiripple", "args": {"num_taps": 21, "bands": [0, 0.1, 0.2, 0.5], "desired": [1, 0], "sample_rate": 1, "grid_density": 4}, "expected": [-0.0023426998103219052, 0.010788085345531285, 0.016116344904921486, 0.007580083914614163, -0.019569448978801213, -0.04671142305075671, -0.038686597043858226, 0.029261548990895156, 0.1443320857505668, 0.25456266638178826, 0.3003006303549861, 0.25456266638178826, 0.1443320857505668, 0.029261548990895156, -0.038686597043858226, -0.04671142305075671, -0.019569448978801213, 0.007580083914614163, 0.016116344904921486, 0.010788085345531285, -0.0023426998103219052], "tol": {"abs": 1e-11, "rel": 1e-09}, "source": "discrete minimax optimum on the conventions' grid, solved in 50-digit decimal arithmetic (cosine-basis solves, Clenshaw evaluation) and certified by alternation: 12 alternating extrema at |E| = delta = 1.096192e-02, no grid point larger"},
