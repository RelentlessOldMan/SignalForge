    {"id": "fir_lowpass.cutoff_nyquist", "op": "fir_lowpass", "args": {"num_taps": 5, "cutoff": 500, "sample_rate": 1000}, "error": "invalid_argument", "source": "cutoff < fs/2 required"},
    {"id": "fir_lowpass.zero_taps", "op": "fir_lowpass", "args": {"num_taps": 0, "cutoff": 100, "sample_rate": 1000}, "error": "invalid_argument", "source": "num_taps >= 1 required"},
    {"id": "fir_lowpass.bad_rate", "op": "fir_lowpass", "args": {"num_taps": 5, "cutoff": 100, "sample_rate": 0}, "error": "invalid_argument", "source": "sample_rate must be positive"},
    {"id": "fir_lowpass.kaiser_no_beta", "op": "fir_lowpass", "args": {"num_taps": 5, "cutoff": 100, "sample_rate": 1000, "window": "kaiser"}, "error": "invalid_argument", "source": "kaiser needs beta"},
    {"id": "fir_lowpass.beta_not_kaiser", "op": "fir_lowpass", "args": {"num_taps": 5, "cutoff": 100, "sample_rate": 1000, "beta": 3}, "error": "invalid_argument", "source": "beta is only allowed for kaiser"},
    {"id": "fir_lowpass.zero_window", "op": "fir_lowpass", "args": {"num_taps": 2, "cutoff": 100, "sample_rate": 1000, "window": "hann"}, "error": "invalid_argument", "source": "the symmetric Hann window of length 2 is [0, 0], so the taps have no gain to scale"},
    {"id": "fir_highpass.even_taps", "op": "fir_highpass", "args": {"num_taps": 8, "cutoff": 100, "sample_rate": 1000}, "error": "invalid_argument", "source": "a high-pass needs an odd num_taps"},
    {"id": "fir_bandpass.reversed", "op": "fir_bandpass", "args": {"num_taps": 11, "low": 200, "high": 100, "sample_rate": 1000}, "error": "invalid_argument", "source": "low < high required"},
    {"id": "fir_bandpass.equal", "op": "fir_bandpass", "args": {"num_taps": 11, "low": 100, "high": 100, "sample_rate": 1000}, "error": "invalid_argument", "source": "low < high required"},
    {"id": "kaiser_parameters.zero_attenuation", "op": "kaiser_parameters", "args": {"attenuation_db": 0, "transition_width": 10, "sample_rate": 100}, "error": "invalid_argument", "source": "A > 0 required"},
    {"id": "kaiser_parameters.width_nyquist", "op": "kaiser_parameters", "args": {"attenuation_db": 40, "transition_width": 50, "sample_rate": 100}, "error": "invalid_argument", "source": "transition_width < fs/2 required"},
    {"id": "fir_response.empty_taps", "op": "fir_response", "args": {"taps": [], "frequencies": [0], "sample_rate": 1}, "error": "invalid_argument", "source": "taps must be non-empty"},
    {"id": "fir_filter.empty_taps", "op": "fir_filter", "args": {"taps": [], "samples": [1], "chunks": [1]}, "error": "invalid_argument", "source": "taps must be non-empty"},
    {"id": "fir_filter.nan_tap", "op": "fir_filter", "args": {"taps": [1, "nan"], "samples": [1], "chunks": [1]}, "error": "invalid_argument", "source": "taps must be finite"}
