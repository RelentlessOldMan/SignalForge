    {"id": "fir_highpass.rect_3_quarter", "op": "fir_highpass", "args": {"num_taps": 3, "cutoff": 250, "sample_rate": 1000, "window": "rectangular"}, "expected": [-0.2800495767557787, 0.4399008464884426, -0.2800495767557787], "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: d = sinc(t) - 0.5 sinc(0.5 t) = [-1/pi, 1/2, -1/pi]; gain at fs/2 is 1/2 + 2/pi (cos(pi t) = -1 at t = +-1)"},
    {"id": "fir_bandpass.hamming_41", "op": "fir_bandpass", "args": {"num_taps": 41, "low": 100, "high": 200, "sample_rate": 1000}, "expected": [6.999981915062595e-19, -0.000519130633448093, 0.0006557613578101043, 0.003733790296421268, 0.0051168780554685265, 3.2551262955510593e-18, -0.009393342694372645, -0.012425054708876306, -0.003817470020018175, 0.00489920437981569, 4.57400525592085e-18, -0.007829167039191884, 0.009818013911310179, 0.052177890503681414, 0.06587735783665746, 1.3056525754553061e-17, -0.11122522396341636, -0.15443216990066674, -0.056275023545058846, 0.11449026949518577, 0.1991516731880038, 0.11449026949518577, -0.05627502354505885, -0.15443216990066674, -0.11122522396341637, 1.3056525754553062e-17, 0.06587735783665748, 0.052177890503681414, 0.009818013911310182, -0.007829167039191884, 4.5740052559208516e-18, 0.004899204379815691, -0.0038174700200181762, -0.01242505470887631, -0.009393342694372647, 3.25512629555106e-18, 0.005116878055468528, 0.0037337902964212698, 0.0006557613578101043, -0.0005191306334480934, 6.999981915062595e-19], "tol": {"abs": 1e-12, "rel": 0}, "source": "vectors/generators/fir.py (stdlib only): ideal response by Simpson integration of the brick-wall spectrum, times the symmetric hamming window from its definition, scaled to unit zero-phase gain at the band center 150 Hz"},
    {"id": "fir_bandpass.kaiser_33", "op": "fir_bandpass", "args": {"num_taps": 33, "low": 0.05, "high": 0.3, "sample_rate": 1, "window": "kaiser", "beta": 8.6}, "expected": [2.0553286689139517e-21, 0.00013718787530469845, 0.0007503608969607504, 0.00019898847779566424, -2.601284756045288e-19, 0.0040872903932960706, 1.2868554620230724e-18, -0.011089604261226044, -1.1788369552636069e-18, -0.00446728207588164, -0.05602424449570997, -0.04249494367824931, 1.1071889836623316e-18, -0.12841357047652227, -0.17559533969868152, 0.20115009833051664, 0.49996682015336774, 0.20115009833051664, -0.17559533969868152, -0.12841357047652227, 1.1071889836623316e-18, -0.04249494367824931, -0.05602424449570997, -0.00446728207588164, -1.1788369552636069e-18, -0.011089604261226044, 1.2868554620230724e-18, 0.0040872903932960706, -2.601284756045288e-19, 0.00019898847779566424, 0.0007503608969607504, 0.00013718787530469845, 2.0553286689139517e-21], "tol": {"abs": 1e-12, "rel": 0}, "source": "vectors/generators/fir.py (stdlib only): ideal response by Simpson integration of the brick-wall spectrum, times the symmetric kaiser window from its definition, scaled to unit zero-phase gain at the band center 0.175"},
    {"id": "kaiser_parameters.a60", "op": "kaiser_parameters", "args": {"attenuation_db": 60, "transition_width": 50, "sample_rate": 1000}, "expected": [74, 5.65326], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "Kaiser's formulas (Oppenheim and Schafer): A > 50, beta = 0.1102*(60 - 8.7); M = ceil((60 - 8)/(2.285*2pi*50/1000)) = 73"},
    {"id": "kaiser_parameters.a30", "op": "kaiser_parameters", "args": {"attenuation_db": 30, "transition_width": 100, "sample_rate": 1000}, "expected": [17, 2.1166248611409806], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "Kaiser's formulas (Oppenheim and Schafer): 21 <= A <= 50, beta = 0.5842*9^0.4 + 0.07886*9; M = ceil((30 - 8)/(2.285*2pi*100/1000)) = 16"},
    {"id": "kaiser_parameters.a50", "op": "kaiser_parameters", "args": {"attenuation_db": 50, "transition_width": 2, "sample_rate": 48}, "expected": [72, 4.533514120981248], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "Kaiser's formulas (Oppenheim and Schafer): A = 50 is in the middle band: 0.5842*29^0.4 + 0.07886*29; M = ceil((50 - 8)/(2.285*2pi*2/48)) = 71"},
    {"id": "kaiser_parameters.a21", "op": "kaiser_parameters", "args": {"attenuation_db": 21, "transition_width": 10, "sample_rate": 100}, "expected": [11, 0.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "Kaiser's formulas (Oppenheim and Schafer): A = 21: beta = 0.5842*0^0.4 + 0 = 0; M = ceil((21 - 8)/(2.285*2pi*10/100)) = 10"},
    {"id": "kaiser_parameters.a15", "op": "kaiser_parameters", "args": {"attenuation_db": 15, "transition_width": 10, "sample_rate": 100}, "expected": [6, 0.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "Kaiser's formulas (Oppenheim and Schafer): A < 21, beta = 0; M = ceil((15 - 8)/(2.285*2pi*10/100)) = 5"},
    {"id": "kaiser_parameters.a5_order0", "op": "kaiser_parameters", "args": {"attenuation_db": 5, "transition_width": 10, "sample_rate": 100}, "expected": [1, 0.0], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "Kaiser's formulas (Oppenheim and Schafer): A < 8 makes the order negative, so M = 0; M = ceil((5 - 8)/(2.285*2pi*10/100)) = 0"},
    {"id": "fir_response.pair", "op": "fir_response", "args": {"taps": [1, 1], "frequencies": [0, 250, 500, -250], "sample_rate": 1000}, "expected": {"re": [2, 1, 0, 1], "im": [0, -1, 0, 1]}, "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: 1 + e^(-j2 pi f/fs) is 2, 1 - j, 0, 1 + j"},
    {"id": "fir_response.three", "op": "fir_response", "args": {"taps": [1, 2, 3], "frequencies": [0, 0.5, 1], "sample_rate": 1}, "expected": {"re": [6, 2, 6], "im": [0, 0, 0]}, "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: H(0) = 1+2+3; H(fs/2) = 1-2+3; H(fs) = H(0)"},
    {"id": "fir_response.empty_freqs", "op": "fir_response", "args": {"taps": [1], "frequencies": [], "sample_rate": 1}, "expected": {"re": [], "im": []}, "source": "no frequencies, no values"},
    {"id": "fir_filter.chunks", "op": "fir_filter", "args": {"taps": [1, 2, 3], "samples": [1, 0, 0, 1, 1], "chunks": [2, 0, 3]}, "expected": [1, 2, 3, 1, 3], "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: y[n] = x[n] + 2x[n-1] + 3x[n-2], state carried across the chunks"},
    {"id": "fir_filter.one_chunk", "op": "fir_filter", "args": {"taps": [1, 2, 3], "samples": [1, 0, 0, 1, 1], "chunks": [5]}, "expected": [1, 2, 3, 1, 3], "tol": {"abs": 1e-12, "rel": 0}, "source": "the same as fir_filter.chunks in one chunk"},
    {"id": "fir_filter.complex", "op": "fir_filter", "args": {"taps": [1, -1], "samples": {"re": [0, 1, 1], "im": [1, 0, 1]}, "chunks": [1, 1, 1]}, "expected": {"re": [0, 1, 0], "im": [1, -1, 1]}, "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: y[n] = x[n] - x[n-1] for x = [j, 1, 1+j] is [j, 1-j, j]"},
    {"id": "fir_filter.short_chunks_long_taps", "op": "fir_filter", "args": {"taps": [0, 0, 0, 1], "samples": [5, 6, 7, 8, 9], "chunks": [1, 1, 3]}, "expected": [0, 0, 0, 5, 6], "tol": {"abs": 1e-12, "rel": 0}, "source": "a pure 3-sample delay, chunks shorter than the state"},
