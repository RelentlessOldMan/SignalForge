    {"id": "fir_lowpass.rect_3_quarter", "op": "fir_lowpass", "args": {"num_taps": 3, "cutoff": 250, "sample_rate": 1000, "window": "rectangular"}, "expected": [0.2800495767557787, 0.4399008464884426, 0.2800495767557787], "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: d = 0.5 sinc(0.5 t) at t = -1, 0, 1 is [1/pi, 1/2, 1/pi]; divided by its sum 1/2 + 2/pi"},
