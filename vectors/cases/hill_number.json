{
  "schema": 1,
  "suite": "hill_number",
  "description": "The Hill number (conventions: the Hill number; ADR 0563).",
  "cases": [
    {"id": "hill_number.even_pair", "op": "hill_number", "args": {"samples": [1.0, 1.0], "order": 2.0}, "expected": 2.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "two equal shares: 2 at any order"},
    {"id": "hill_number.richness", "op": "hill_number", "args": {"samples": [0.0, 3.0, 5.0], "order": 0.0}, "expected": 2.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "q = 0 counts the values above 0: 2"},
    {"id": "hill_number.inverse_simpson", "op": "hill_number", "args": {"samples": [1.0, 1.0, 2.0], "order": 2.0}, "expected": 2.6666666666666665, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "shares 1/4, 1/4, 1/2: 1/(3/8) = 8/3"},
    {"id": "hill_number.shannon", "op": "hill_number", "args": {"samples": [1.0, 1.0, 2.0], "order": 1.0}, "expected": 2.8284271247461903, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "exp(ln 4/2 + ln 2/2) = 2^(3/2)"},
    {"id": "hill_number.cubic", "op": "hill_number", "args": {"samples": [1.0, 1.0, 2.0], "order": 3.0}, "expected": 2.5298221281347035, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "sum p^3 = 10/64: (10/64)^(-1/2) = 8/sqrt 10"},
    {"id": "hill_number.half", "op": "hill_number", "args": {"samples": [1.0, 3.0], "order": 0.5}, "expected": 1.8660254037844386, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "((1 + sqrt 3)/2)^2 = 1 + sqrt(3)/2"},
    {"id": "hill_number.near_one", "op": "hill_number", "args": {"samples": [2.0, 0.5, 3.25, 1.0], "order": 1.000001}, "expected": 3.2805434058460325, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "q just above 1: the expm1 form"},
    {"id": "hill_number.below_one", "op": "hill_number", "args": {"samples": [2.0, 0.5, 3.25, 1.0], "order": 0.9}, "expected": 3.3357161430161133, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "q = 0.9"},
    {"id": "hill_number.edge", "op": "hill_number", "args": {"samples": [2.0, 0.5, 3.25, 1.0], "order": 1.5}, "expected": 3.0504033456698254, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "q = 1.5: the max form"},
    {"id": "hill_number.large", "op": "hill_number", "args": {"samples": [2.0, 0.5, 3.25, 1.0, 0.0], "order": 250.0}, "expected": 2.083028407028971, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "q = 250: near 1/max p = 6.75/3.25"},
    {"id": "hill_number.small_order", "op": "hill_number", "args": {"samples": [2.0, 0.5, 3.25, 1.0], "order": 0.1}, "expected": 3.9105001646183717, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "q = 0.1"},
    {"id": "hill_number.random", "op": "hill_number", "args": {"samples": [2.61, 4.347, 1.517, 0.026, 4.728, 4.69, 4.598, 1.829, 2.272, 3.022, 2.989, 4.994, 4.77, 4.42, 1.637, 0.03, 0.947, 4.793, 3.305, 2.376, 4.787, 2.456, 2.289, 4.09, 0.124, 4.557, 2.833, 3.555, 4.736, 4.887], "order": 2.5}, "expected": 23.57407945829424, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "30 values from random.Random(563).uniform(0, 5), 3 places, q = 2.5"},
    {"id": "hill_number.empty", "op": "hill_number", "args": {"samples": [], "order": 2.0}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "hill_number.negative", "op": "hill_number", "args": {"samples": [1.0, -0.5, 2.0], "order": 2.0}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "hill_number.all_zero", "op": "hill_number", "args": {"samples": [0.0, 0.0, 0.0], "order": 2.0}, "error": "invalid_argument", "source": "the total must be positive"},
    {"id": "hill_number.negative_order", "op": "hill_number", "args": {"samples": [1.0, 2.0, 3.0], "order": -0.5}, "error": "invalid_argument", "source": "the order must be at least 0"}
  ]
}
