{
  "schema": 1,
  "suite": "pianka_overlap",
  "description": "Pianka's niche overlap (conventions: Pianka's niche overlap; ADR 0571).",
  "cases": [
    {"id": "pianka_overlap.same", "op": "pianka_overlap", "args": {"x": [1.0, 2.0, 3.0], "y": [1.0, 2.0, 3.0]}, "expected": 1.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "identical records: 1"},
    {"id": "pianka_overlap.proportional", "op": "pianka_overlap", "args": {"x": [1.0, 2.0, 3.0], "y": [2.0, 4.0, 6.0]}, "expected": 1.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "proportional records: 1"},
    {"id": "pianka_overlap.disjoint", "op": "pianka_overlap", "args": {"x": [1.0, 0.0], "y": [0.0, 1.0]}, "expected": 0.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "no shared resource: 0"},
    {"id": "pianka_overlap.half", "op": "pianka_overlap", "args": {"x": [1.0, 1.0], "y": [1.0, 0.0]}, "expected": 0.7071067811865476, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "1/sqrt 2"},
    {"id": "pianka_overlap.reversed", "op": "pianka_overlap", "args": {"x": [1.0, 2.0, 3.0], "y": [3.0, 2.0, 1.0]}, "expected": 0.7142857142857143, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "10/14 = 5/7"},
    {"id": "pianka_overlap.shifted", "op": "pianka_overlap", "args": {"x": [1.0, 1.0, 2.0], "y": [2.0, 1.0, 1.0]}, "expected": 0.8333333333333334, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "5/6"},
    {"id": "pianka_overlap.huge", "op": "pianka_overlap", "args": {"x": [1e+300, 2e+300], "y": [1.0, 3.0]}, "expected": 0.9899494936611666, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "7/sqrt 50: squares would overflow"},
    {"id": "pianka_overlap.tiny", "op": "pianka_overlap", "args": {"x": [1e-300, 3e-301, 0.0], "y": [2.0, 5.0, 1.0]}, "expected": 0.6120602396848354, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "values near the bottom of the range"},
    {"id": "pianka_overlap.random", "op": "pianka_overlap", "args": {"x": [0.763, 4.332, 3.091, 2.104, 3.304, 0.287, 4.508, 0.893, 4.888, 0.912, 2.732, 3.827, 1.319, 3.304, 2.446, 4.044, 3.104, 4.766, 1.405, 1.621, 0.198, 1.956, 0.25, 4.87, 4.516], "y": [2.992, 1.554, 3.683, 3.503, 0.915, 3.237, 0.714, 2.46, 1.164, 3.479, 2.333, 0.44, 2.844, 3.979, 4.999, 0.352, 0.467, 0.046, 2.676, 3.289, 1.165, 2.073, 0.476, 3.129, 0.332]}, "expected": 0.6097507166532725, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x then y, 25 values each from random.Random(571).uniform(0, 5), 3 places"},
    {"id": "pianka_overlap.empty", "op": "pianka_overlap", "args": {"x": [], "y": []}, "error": "invalid_argument", "source": "a record needs a value"},
    {"id": "pianka_overlap.negative", "op": "pianka_overlap", "args": {"x": [1.0, 2.0, 3.0], "y": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "pianka_overlap.all_zero", "op": "pianka_overlap", "args": {"x": [0.0, 0.0, 0.0], "y": [3.0, 1.0, 2.0]}, "error": "invalid_argument", "source": "each record needs a value above 0"},
    {"id": "pianka_overlap.lengths", "op": "pianka_overlap", "args": {"x": [1.0, 2.0, 3.0], "y": [1.0, 2.0]}, "error": "invalid_argument", "source": "the records must have the same length"}
  ]
}
