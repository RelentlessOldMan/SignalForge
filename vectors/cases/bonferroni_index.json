{
  "schema": 1,
  "suite": "bonferroni_index",
  "description": "The Bonferroni index (conventions: the Bonferroni index; ADR 0520).",
  "cases": [
    {"id": "bonferroni_index.equal", "op": "bonferroni_index", "args": {"samples": [2.0, 2.0, 2.0]}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "every value equal: 0"},
    {"id": "bonferroni_index.one_holds_all", "op": "bonferroni_index", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "one of four holds the total: 1"},
    {"id": "bonferroni_index.two", "op": "bonferroni_index", "args": {"samples": [3.0, 1.0]}, "expected": 0.5, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "mean 2, m1 1: (1/2)"},
    {"id": "bonferroni_index.ramp", "op": "bonferroni_index", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.4, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "mean 5/2, m 1, 3/2, 2: (3/2 + 1 + 1/2)/(5/2)/3 = 2/5"},
    {"id": "bonferroni_index.three", "op": "bonferroni_index", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.8125, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "mean 4/3, m 0, 1/2: (1 + 5/8)/2 = 13/16"},
    {"id": "bonferroni_index.halves", "op": "bonferroni_index", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.4444444444444444, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "mean 1/2, m 1/4, 1/4, 1/3: (1/2 + 1/2 + 1/3)/3 = 4/9"},
    {"id": "bonferroni_index.random", "op": "bonferroni_index", "args": {"samples": [0.125, 0.875, 6.25, 6.375, 2.125, 7.125, 6.875, 6.625, 3.25, 3.875, 6.125, 6.625, 2.75, 6.75, 1.75, 5.75, 5.125, 3.375, 0.5, 6.0, 3.75, 2.875, 7.625, 7.875, 2.625, 1.75, 4.125, 2.375, 7.5, 2.125]}, "expected": 0.46623237801371886, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "30 values k/8, k from random.Random(520).randint(0, 64)"},
    {"id": "bonferroni_index.huge", "op": "bonferroni_index", "args": {"samples": [1e+308, 9e+307, 1e+300]}, "expected": 0.6447368321329641, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "values whose sum overflows a double: the result is that of the values scaled down"},
    {"id": "bonferroni_index.empty", "op": "bonferroni_index", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs at least 2 values"},
    {"id": "bonferroni_index.single", "op": "bonferroni_index", "args": {"samples": [5.0]}, "error": "invalid_argument", "source": "the record needs at least 2 values"},
    {"id": "bonferroni_index.negative", "op": "bonferroni_index", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "bonferroni_index.all_zero", "op": "bonferroni_index", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
