    {"id": "chao1_richness.negative", "op": "chao1_richness", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "chao1_richness.all_zero", "op": "chao1_richness", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
