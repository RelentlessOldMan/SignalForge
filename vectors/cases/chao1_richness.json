  "schema": 1,
  "suite": "chao1_richness",
  "description": "The Chao1 richness (conventions: the Chao1 richness; ADR 0545).",
  "cases": [
    {"id": "chao1_richness.three_ones", "op": "chao1_richness", "args": {"samples": [1.0, 1.0, 1.0, 2.0]}, "expected": 5.5, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "k = 4, F1 = 3, F2 = 1: 4 + 6/4"},
    {"id": "chao1_richness.no_ones", "op": "chao1_richness", "args": {"samples": [2.0, 2.0, 2.0]}, "expected": 3.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "k = 3, F1 = 0: 3"},
    {"id": "chao1_richness.two_ones", "op": "chao1_richness", "args": {"samples": [1.0, 1.0]}, "expected": 3.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "k = 2, F1 = 2, F2 = 0: 2 + 2/2"},
    {"id": "chao1_richness.single_one", "op": "chao1_richness", "args": {"samples": [1.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "k = 1, F1 = 1: 1"},
    {"id": "chao1_richness.mixed", "op": "chao1_richness", "args": {"samples": [5.0, 1.0, 1.0, 0.0, 2.0]}, "expected": 4.5, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "k = 4, F1 = 2, F2 = 1: 4 + 2/4"},
    {"id": "chao1_richness.two", "op": "chao1_richness", "args": {"samples": [3.0, 1.0]}, "expected": 2.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "k = 2, F1 = 1: 2"},
    {"id": "chao1_richness.no_twos", "op": "chao1_richness", "args": {"samples": [1.0, 1.0, 1.0, 1.0, 0.0, 3.0]}, "expected": 11.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "k = 5, F1 = 4, F2 = 0: 5 + 12/2"},
    {"id": "chao1_richness.fractions", "op": "chao1_richness", "args": {"samples": [0.5, 1.0, 2.5, 1.0]}, "expected": 5.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "k = 4, F1 = 2, F2 = 0: 4 + 1"},
    {"id": "chao1_richness.random", "op": "chao1_richness", "args": {"samples": [1.0, 0.0, 1.0, 3.0, 0.0, 3.0, 2.0, 2.0, 4.0, 4.0, 0.0, 1.0, 1.0, 2.0, 0.0, 2.0, 3.0, 0.0, 1.0, 2.0, 0.0, 3.0, 3.0, 0.0, 2.0, 0.0, 1.0, 1.0, 1.0, 1.0]}, "expected": 27.142857142857142, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "30 whole values from random.Random(545).randint(0, 4)"},
