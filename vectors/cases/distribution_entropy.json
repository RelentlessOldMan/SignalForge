{
  "schema": 1,
  "suite": "distribution_entropy",
  "description": "Distribution entropy (conventions: Distribution entropy; ADR 0348).",
  "cases": [
    {"id": "distribution_entropy.equal_distances", "op": "distribution_entropy", "args": {"samples": [0.0, 1.0, 2.0], "m": 1, "bins": 4}, "expected": 0.4591479170272447, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "three points 0, 1, 2: distances 1, 2, 1 fall in bins 0, 3, 0"},
    {"id": "distribution_entropy.one_distance", "op": "distribution_entropy", "args": {"samples": [0.0, 1.0, 0.0, 1.0], "m": 3, "bins": 8}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "two windows: one pair, one bin, so 0"},
    {"id": "distribution_entropy.mixed", "op": "distribution_entropy", "args": {"samples": [0.25, -1.5, 3.0, 2.75, -0.5, 0.125, 1.0, -2.25, 0.375, 2.5, -1.25, 0.75, 0.0, 1.5, -0.75, 2.0, 0.5, -1.0], "m": 2, "bins": 10}, "expected": 0.9450740352272551, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "eighteen arbitrary dyadic samples, M = 10"},
    {"id": "distribution_entropy.noise_default_bins", "op": "distribution_entropy", "args": {"samples": [0.0, -2.125, -1.625, -1.125, 2.25, 0.75, -3.625, 3.875, -2.0, 1.625, -4.875, 2.0, 0.0, -2.375, 0.625, -3.375, -4.75, 3.75, 4.0, 2.125, -3.5, 2.375, -1.5, 1.125, 2.375, -2.25, -1.125, 1.375, 2.25, 4.0, -2.0, 4.5, 3.875, -2.25, -2.375, 0.75, -4.0, 1.75, 4.625, -3.25, 2.625, 1.0, -2.125, -2.875, -2.5, 4.375, -3.625, -1.875, 3.375, 2.625, -4.5, 2.5, -4.125, -1.5, 3.125, 0.375, 2.25, -2.0, 2.0, 3.75, 2.75, -4.75, -2.0, -4.75, -4.75, -4.875, 2.125, -4.5, -3.375, 0.0, 4.5, -3.625, -4.625, 4.5, 2.875, 2.375, -4.125, 1.0, 2.875, -1.0, 1.75, -3.75, 1.75, 3.375, -1.125, -1.75, 2.0, -2.5, 4.875, 2.375, -3.75, 3.375, 1.0, -3.5, -1.375, 3.25, -1.375, -1.25, -0.375, -3.375, 1.625, 0.625, 4.875, 1.0, -2.75, -0.625, -2.125, 3.5, -1.125, -1.375, 0.875, -1.125, -2.875, -3.0, -2.875, -0.375, -4.625, 3.375, 4.25, 1.625, 4.0, -5.0, 4.875, 3.5, -1.25, -3.875, 5.0, -1.625, 3.375, 4.625, 5.0, 4.125, -1.125, -2.375, 2.0, -4.875, 3.875, -4.25, -0.125, 3.25, 3.125, 0.0, 0.5, -1.625, -0.375, 2.125, -4.125, 1.125, -3.0, 0.625], "m": 3}, "expected": 0.6703014223290459, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "150 random eighths from random.Random(348), m = 3, the default 512 bins"},
    {"id": "distribution_entropy.m_zero", "op": "distribution_entropy", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 0}, "error": "invalid_argument", "source": "m must be at least 1"},
    {"id": "distribution_entropy.one_bin", "op": "distribution_entropy", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 2, "bins": 1}, "error": "invalid_argument", "source": "bins must be at least 2"},
    {"id": "distribution_entropy.too_short", "op": "distribution_entropy", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 5}, "error": "invalid_argument", "source": "one window has no pair"},
    {"id": "distribution_entropy.inf", "op": "distribution_entropy", "args": {"samples": [0.0, "inf", 1.0, 2.0], "m": 2}, "error": "invalid_argument", "source": "samples must be finite"}
  ]
