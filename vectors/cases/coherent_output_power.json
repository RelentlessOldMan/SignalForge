{
  "schema": 1,
  "suite": "coherent_output_power",
  "description": "Coherent output power (conventions: Coherent output power; ADR 0198).",
  "cases": [
    {"id": "coherent_output_power.scaled", "op": "coherent_output_power", "args": {"x": [1.0, 2.0, 3.0, 4.0], "y": [-2.0, -4.0, -6.0, -8.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [0.0, 1.0], "coherent": [29.0, 1.0], "noncoherent": [0.0, 0.0], "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "y = -2x: X = [3, -1], [7, -1]; Syy = 4 [9 + 49, 1 + 1] = [232, 8], Pyy = Syy / (2 * 2 * 2) = [29, 1] (nfft 2 doubles no bin); gamma^2 = 1, so all coherent"},
    {"id": "coherent_output_power.three_segments", "op": "coherent_output_power", "args": {"x": [1.0, 0.0, 1.0, 0.0, 1.0, 0.0], "y": [1.0, 0.0, 1.0, 0.0, 0.0, 1.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [0.0, 1.0], "coherent": [0.25, 0.027777777777777776], "noncoherent": [0.0, 0.2222222222222222], "num_segments": 3}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "X = [1, 1] thrice; Y = [1, 1], [1, 1], [1, -1]: Sxx = Syy = [3, 3], Sxy = [3, 1], gamma^2 = [1, 1/9]; Pyy = 3 / (3 * 2 * 2) = 0.25 per bin"},
    {"id": "coherent_output_power.doubled_bin", "op": "coherent_output_power", "args": {"x": [1.0, 0.0, 0.0, 0.0], "y": [1.0, 1.0, 0.0, 0.0], "sample_rate": 4.0, "nperseg": 4, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [0.0, 1.0, 2.0], "coherent": [0.25, 0.25, 0.0], "noncoherent": [0.0, 0.0, 0.0], "num_segments": 1}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "X = 1, Y = 1 + e^{-j pi k/2} = [2, 1 - j, 0]: |Y|^2 = [4, 2, 0], Pyy = [4, 2 * 2, 0] / (4 * 4) = [0.25, 0.25, 0]; one segment, gamma^2 = 1 where Syy > 0; at bin 2 both parts are 0"},
    {"id": "coherent_output_power.silent_input", "op": "coherent_output_power", "args": {"x": [0.0, 0.0], "y": [1.0, 0.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [0.0, 1.0], "coherent": [0.0, 0.0], "noncoherent": [0.25, 0.25], "num_segments": 1}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "Sxx = 0, so gamma^2 = 0: Y = [1, 1], Pyy = 1 / (2 * 2) = 0.25, all noncoherent"},
    {"id": "coherent_output_power.silent_output", "op": "coherent_output_power", "args": {"x": [1.0, 0.0], "y": [0.0, 0.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [0.0, 1.0], "coherent": [0.0, 0.0], "noncoherent": [0.0, 0.0], "num_segments": 1}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "Syy = 0, so Pyy = 0 and both parts are 0"},
    {"id": "coherent_output_power.complex", "op": "coherent_output_power", "args": {"x": {"re": [1.0, 0.0, 1.0, 0.0], "im": [0.0, 1.0, 0.0, 1.0]}, "y": [1.0, 0.0, 0.0, 1.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [-1.0, 0.0], "coherent": [0.0, 0.25], "noncoherent": [0.25, 0.0], "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "X = [1 + j, 1 - j] twice, Y = [1, 1], [1, -1]: Syy = [2, 2], Sxy = [2 - 2j, 0], Sxx = [4, 4]; gamma^2 = [8/8, 0]; Pyy = 2 / (2 * 2 * 2) = 0.25, two-sided; shifted [bin 1, bin 0]"},
    {"id": "coherent_output_power.lengths", "op": "coherent_output_power", "args": {"x": [1.0, 2.0], "y": [1.0], "sample_rate": 1.0}, "error": "invalid_argument", "source": "x and y differ in length"},
    {"id": "coherent_output_power.nan", "op": "coherent_output_power", "args": {"x": [1.0, "nan"], "y": [1.0, 2.0], "sample_rate": 1.0}, "error": "invalid_argument", "source": "not finite"},
    {"id": "coherent_output_power.zero_rate", "op": "coherent_output_power", "args": {"x": [1.0, 2.0], "y": [1.0, 2.0], "sample_rate": 0.0}, "error": "invalid_argument", "source": "sample_rate must be positive"}
  ]
}
