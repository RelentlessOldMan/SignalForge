{
  "schema": 1,
  "suite": "brillouin_evenness",
  "description": "The Brillouin evenness (conventions: the Brillouin evenness; ADR 0547).",
  "cases": [
    {"id": "brillouin_evenness.two_twos", "op": "brillouin_evenness", "args": {"samples": [2.0, 2.0]}, "expected": 1.0, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "already even: 1"},
    {"id": "brillouin_evenness.four_ones", "op": "brillouin_evenness", "args": {"samples": [1.0, 1.0, 1.0, 1.0]}, "expected": 1.0, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "already even: 1"},
    {"id": "brillouin_evenness.uneven_but_best", "op": "brillouin_evenness", "args": {"samples": [0.0, 2.0, 1.0]}, "expected": 1.0, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "N = 3, k = 2: 1 and 2 is the best: 1"},
    {"id": "brillouin_evenness.two", "op": "brillouin_evenness", "args": {"samples": [3.0, 1.0]}, "expected": 0.7737056144690831, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "4!/3! = 4 against 4!/(2! 2!) = 6: ln 4 / ln 6"},
    {"id": "brillouin_evenness.five_one", "op": "brillouin_evenness", "args": {"samples": [5.0, 1.0]}, "expected": 0.5981040045018438, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "6!/5! = 6 against 6!/(3! 3!) = 20: ln 6 / ln 20"},
    {"id": "brillouin_evenness.ramp", "op": "brillouin_evenness", "args": {"samples": [1.0, 2.0, 3.0]}, "expected": 0.9098928315164928, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "60 against 6!/(2!)^3 = 90: ln 60 / ln 90"},
    {"id": "brillouin_evenness.larger", "op": "brillouin_evenness", "args": {"samples": [40.0, 25.0, 0.0, 10.0, 25.0]}, "expected": 0.9285037382178627, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "100!/(40! 25! 10! 25!) against 100!/(25!)^4"},
    {"id": "brillouin_evenness.random", "op": "brillouin_evenness", "args": {"samples": [1.0, 2.0, 8.0, 10.0, 15.0, 6.0, 13.0, 11.0, 17.0, 6.0, 14.0, 9.0, 2.0, 14.0, 1.0, 8.0, 6.0, 19.0, 9.0, 1.0, 8.0, 19.0, 14.0, 15.0, 6.0, 5.0, 9.0, 3.0, 11.0, 19.0]}, "expected": 0.9435503472806659, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "30 whole values from random.Random(547).randint(0, 20)"},
    {"id": "brillouin_evenness.empty", "op": "brillouin_evenness", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "brillouin_evenness.negative", "op": "brillouin_evenness", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "brillouin_evenness.all_zero", "op": "brillouin_evenness", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"},
    {"id": "brillouin_evenness.fraction", "op": "brillouin_evenness", "args": {"samples": [1.5, 2.0]}, "error": "invalid_argument", "source": "values must be whole numbers"},
    {"id": "brillouin_evenness.too_large", "op": "brillouin_evenness", "args": {"samples": [10000000.0, 1.0]}, "error": "invalid_argument", "source": "the total must be at most 10 000 000"},
    {"id": "brillouin_evenness.single", "op": "brillouin_evenness", "args": {"samples": [4.0]}, "error": "invalid_argument", "source": "at least 2 values above 0"},
    {"id": "brillouin_evenness.one_positive", "op": "brillouin_evenness", "args": {"samples": [0.0, 5.0, 0.0]}, "error": "invalid_argument", "source": "at least 2 values above 0"}
  ]
}
