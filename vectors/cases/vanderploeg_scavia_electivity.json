{
  "schema": 1,
  "suite": "vanderploeg_scavia_electivity",
  "description": "Vanderploeg and Scavia's relativized electivity (conventions: Vanderploeg and Scavia's relativized electivity; ADR 0605).",
  "cases": [
    {"id": "vanderploeg_scavia_electivity.as_available", "op": "vanderploeg_scavia_electivity", "args": {"x": [1.0, 2.0, 3.0], "available": [1.0, 2.0, 3.0]}, "expected": [0.0, 0.0, 0.0], "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "use as availability: alpha 1/3 each, 0 for each kind"},
    {"id": "vanderploeg_scavia_electivity.even_use", "op": "vanderploeg_scavia_electivity", "args": {"x": [1.0, 1.0], "available": [1.0, 3.0]}, "expected": [0.2, -0.3333333333333333], "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "alpha 3/4, 1/4 with 1/n = 1/2: 1/5, -1/3"},
    {"id": "vanderploeg_scavia_electivity.one_kind_used", "op": "vanderploeg_scavia_electivity", "args": {"x": [1.0, 0.0], "available": [1.0, 3.0]}, "expected": [0.3333333333333333, -1.0], "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "alpha 1, 0 with 1/n = 1/2: 1/3, -1"},
    {"id": "vanderploeg_scavia_electivity.uneven", "op": "vanderploeg_scavia_electivity", "args": {"x": [2.0, 1.0, 1.0], "available": [1.0, 2.0, 1.0]}, "expected": [0.2631578947368421, -0.4, -0.07692307692307693], "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "alpha 4/7, 1/7, 2/7 with 1/n = 1/3: 5/19, -2/5, -1/13"},
    {"id": "vanderploeg_scavia_electivity.one_kind", "op": "vanderploeg_scavia_electivity", "args": {"x": [2.0], "available": [5.0]}, "expected": [0.0], "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "one kind: alpha 1, 1/n = 1: 0"},
    {"id": "vanderploeg_scavia_electivity.huge", "op": "vanderploeg_scavia_electivity", "args": {"x": [1e+308, 1e+308], "available": [1e+308, 1e+308]}, "expected": [0.0, 0.0], "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "the sums would overflow: alpha 1/2, 1/2: 0, 0"},
