    {"id": "vanderploeg_scavia_electivity.empty", "op": "vanderploeg_scavia_electivity", "args": {"x": [], "available": []}, "error": "invalid_argument", "source": "a record needs a value"},
    {"id": "vanderploeg_scavia_electivity.negative", "op": "vanderploeg_scavia_electivity", "args": {"x": [1.0, -0.5, 2.0], "available": [1.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "vanderploeg_scavia_electivity.all_zero", "op": "vanderploeg_scavia_electivity", "args": {"x": [0.0, 0.0, 0.0], "available": [1.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "a record needs a value above 0"},
