    {"id": "vanderploeg_scavia_electivity.unavailable", "op": "vanderploeg_scavia_electivity", "args": {"x": [1.0, 2.0, 3.0], "available": [1.0, 0.0, 1.0]}, "error": "invalid_argument", "source": "available must be above 0 everywhere"},
    {"id": "vanderploeg_scavia_electivity.underflow", "op": "vanderploeg_scavia_electivity", "args": {"x": [1.0, 2.0, 3.0], "available": [1e+300, 5e-324, 1.0]}, "error": "invalid_argument", "source": "the share 5e-324/1e300 underflows to 0"},
    {"id": "vanderploeg_scavia_electivity.overflow", "op": "vanderploeg_scavia_electivity", "args": {"x": [1.0, 1.0, 1.0], "available": [1.0, 1e-310, 1.0]}, "error": "invalid_argument", "source": "(1/3)/(1e-310/(2 + 1e-310)) is above the largest double"}
