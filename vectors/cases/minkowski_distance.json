{
  "schema": 1,
  "suite": "minkowski_distance",
  "description": "The Minkowski distance (conventions: Minkowski distance; ADR 0419).",
  "cases": [
    {"id": "minkowski_distance.same", "op": "minkowski_distance", "args": {"x": [1.0, -2.0], "y": [1.0, -2.0], "order": 2.0}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "equal vectors: 0"},
    {"id": "minkowski_distance.city_block", "op": "minkowski_distance", "args": {"x": [0.0, 0.0], "y": [3.0, 4.0], "order": 1.0}, "expected": 7.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "order 1: 3 + 4 = 7"},
    {"id": "minkowski_distance.euclid", "op": "minkowski_distance", "args": {"x": [0.0, 0.0], "y": [3.0, 4.0], "order": 2.0}, "expected": 5.0, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "order 2: the 3-4-5 triangle, 5"},
    {"id": "minkowski_distance.cubic", "op": "minkowski_distance", "args": {"x": [1.0, -1.0], "y": [-2.0, 3.0], "order": 3.0}, "expected": 4.497941445275415, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "order 3: (27 + 64)^(1/3), the cube root of 91"},
    {"id": "minkowski_distance.huge", "op": "minkowski_distance", "args": {"x": [1e+300, 0.0], "y": [0.0, 1e+300], "order": 2.0}, "expected": 1.4142135623730952e+300, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "order 2 with differences of 1e300, whose squares overflow a double: sqrt 2 \u00b7 1e300"},
    {"id": "minkowski_distance.tiny", "op": "minkowski_distance", "args": {"x": [3e-300, 0.0], "y": [0.0, 4e-300], "order": 2.0}, "expected": 5e-300, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "order 2 with differences near 1e-300, whose squares underflow: 5e-300"},
    {"id": "minkowski_distance.random", "op": "minkowski_distance", "args": {"x": [4.75, -3.0, -3.0, -0.5, 0.75, 3.25, -3.75, -5.0, 3.25, -2.5, -4.0, 2.25, -0.75, -4.5, -5.0, 0.0], "y": [-4.0, 2.0, -0.5, 4.5, 1.5, 2.75, -3.25, 0.25, 0.0, -2.0, -5.0, -1.75, -0.5, -3.25, 2.75, 5.0], "order": 2.5}, "expected": 13.65693584889952, "tol": {"abs": 1e-15, "rel": 1e-13}, "source": "16 quarters each from random.Random(419), order 2.5"},
    {"id": "minkowski_distance.order_low", "op": "minkowski_distance", "args": {"x": [1.0, 2.0, 3.0], "y": [2.0, 1.0, 0.0], "order": 0.5}, "error": "invalid_argument", "source": "order must be at least 1"},
    {"id": "minkowski_distance.order_inf", "op": "minkowski_distance", "args": {"x": [1.0, 2.0, 3.0], "y": [2.0, 1.0, 0.0], "order": "inf"}, "error": "invalid_argument", "source": "order must be finite"},
    {"id": "minkowski_distance.empty", "op": "minkowski_distance", "args": {"x": [], "y": [], "order": 2.0}, "error": "invalid_argument", "source": "x needs a value"},
    {"id": "minkowski_distance.lengths", "op": "minkowski_distance", "args": {"x": [1.0, 2.0, 3.0], "y": [1.0, 1.0], "order": 2.0}, "error": "invalid_argument", "source": "x and y must match"},
    {"id": "minkowski_distance.not_finite", "op": "minkowski_distance", "args": {"x": [1.0, "nan", 1.0], "y": [2.0, 1.0, 0.0], "order": 2.0}, "error": "invalid_argument", "source": "values must be finite"},
    {"id": "minkowski_distance.overflow", "op": "minkowski_distance", "args": {"x": [1e+308], "y": [-1e+308], "order": 2.0}, "error": "invalid_argument", "source": "the difference 1e308 - (-1e308) overflows"}
  ]
}
