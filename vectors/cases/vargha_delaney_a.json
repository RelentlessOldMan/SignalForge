  "schema": 1,
  "suite": "vargha_delaney_a",
  "description": "The Vargha-Delaney A (conventions: Vargha-Delaney A; ADR 0401).",
  "cases": [
    {"id": "vargha_delaney_a.above", "op": "vargha_delaney_a", "args": {"x": [5.0, 6.0], "y": [1.0, 2.0, 3.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "every x above every y: 1"},
    {"id": "vargha_delaney_a.below", "op": "vargha_delaney_a", "args": {"x": [1.0, 2.0], "y": [5.0, 6.0, 7.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "every x below every y: 0"},
    {"id": "vargha_delaney_a.all_tied", "op": "vargha_delaney_a", "args": {"x": [2.0, 2.0], "y": [2.0, 2.0, 2.0]}, "expected": 0.5, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "every pair tied: 1/2"},
    {"id": "vargha_delaney_a.hand", "op": "vargha_delaney_a", "args": {"x": [1.0, 3.0, 5.0], "y": [2.0, 3.0, 4.0]}, "expected": 0.5, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "wins 4, ties 1 (3 = 3): (8 + 1)/18 = 1/2"},
    {"id": "vargha_delaney_a.hand_two", "op": "vargha_delaney_a", "args": {"x": [2.0, 4.0, 6.0, 8.0], "y": [1.0, 5.0, 6.0]}, "expected": 0.625, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "wins 1 + 1 + 2 + 3 = 7, ties 1 (6 = 6): (14 + 1)/24 = 5/8"},
