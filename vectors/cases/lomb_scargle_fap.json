    {"id": "lomb_scargle_false_alarm.tiny_p1_one", "op": "lomb_scargle_false_alarm", "args": {"power": 0.9, "num_samples": 203}, "expected": 1e-100, "tol": {"abs": 0, "rel": 1e-12}, "source": "exact fractions: 1 - (1 - (1 - 0.9)^100)^1"},
    {"id": "lomb_scargle_false_alarm.mid_m200", "op": "lomb_scargle_false_alarm", "args": {"power": 0.2, "num_samples": 43, "num_frequencies": 200}, "expected": 0.90165153553095, "tol": {"abs": 0, "rel": 1e-12}, "source": "exact fractions: 1 - (1 - (1 - 0.2)^20)^200"},
