    {"id": "lomb_scargle_false_alarm.min_n_centered", "op": "lomb_scargle_false_alarm", "args": {"power": 0.3, "num_samples": 5}, "expected": 0.7, "tol": {"abs": 0, "rel": 1e-12}, "source": "exact fractions: 1 - (1 - (1 - 0.3)^1)^1"},
