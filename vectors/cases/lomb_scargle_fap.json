{
  "schema": 1,
  "suite": "lomb_scargle_fap",
  "description": "Lomb-Scargle false-alarm probability, its inverse level, the Baluev estimate and frequency grid (conventions: Spectra, Lomb-Scargle false-alarm probability and frequency grid, Lomb-Scargle false-alarm level, Baluev false-alarm probability and level, bootstrap maxima; ADRs 0062, 0082, 0098, 0099 and 0101).",
  "cases": [
    {"id": "lomb_scargle_false_alarm.half_n13", "op": "lomb_scargle_false_alarm", "args": {"power": 0.5, "num_samples": 13}, "expected": 0.03125, "tol": {"abs": 0, "rel": 1e-12}, "source": "exact fractions: 1 - (1 - (1 - 0.5)^5)^1"},
    {"id": "lomb_scargle_false_alarm.half_n13_m10", "op": "lomb_scargle_false_alarm", "args": {"power": 0.5, "num_samples": 13, "num_frequencies": 10}, "expected": 0.27202384332787144, "tol": {"abs": 0, "rel": 1e-12}, "source": "exact fractions: 1 - (1 - (1 - 0.5)^5)^10"},
    {"id": "lomb_scargle_false_alarm.n12_uncentered", "op": "lomb_scargle_false_alarm", "args": {"power": 0.5, "num_samples": 12, "center": false}, "expected": 0.03125, "tol": {"abs": 0, "rel": 1e-12}, "source": "exact fractions: 1 - (1 - (1 - 0.5)^5)^1"},
    {"id": "lomb_scargle_false_alarm.small_z", "op": "lomb_scargle_false_alarm", "args": {"power": 0.01, "num_samples": 101}, "expected": 0.6111172395328653, "tol": {"abs": 0, "rel": 1e-12}, "source": "exact fractions: 1 - (1 - (1 - 0.01)^49)^1"},
