{
  "schema": 1,
  "suite": "least_squares",
  "description": "Least-squares FIR design: exact weighted integral squared error, the desired gain linear across each band (conventions: FIR filters, Least-squares design).",
  "cases": [
    {"id": "fir_least_squares.one_tap_mean", "op": "fir_least_squares", "args": {"num_taps": 1, "bands": [0, 0.2, 0.3, 0.5], "desired": [1, 1, 0, 0], "sample_rate": 1}, "expected": [0.5], "tol": {"abs": 1e-11, "rel": 1e-10}, "source": "by hand: N = 1, A = a0: minimizing int (a0 - D)^2 gives the mean of D over the bands, 0.2/0.4"},
    {"id": "fir_least_squares.full_band_flat", "op": "fir_least_squares", "args": {"num_taps": 3, "bands": [0, 0.5], "desired": [1, 1], "sample_rate": 1}, "expected": [0, 1, 0], "tol": {"abs": 1e-11, "rel": 1e-10}, "source": "by hand: the cosines are orthogonal over [0, 0.5], so a_k = p_k/G_kk; p_0 = 0.5 = G_00, p_1 = int cos(2 pi nu) = 0"},
    {"id": "fir_least_squares.full_band_ramp", "op": "fir_least_squares", "args": {"num_taps": 3, "bands": [0, 0.5], "desired": [0, 1], "sample_rate": 1}, "expected": [-0.20264236728467555, 0.5, -0.20264236728467555], "tol": {"abs": 1e-11, "rel": 1e-10}, "source": "by hand: D = 2 nu: a_0 = int 2 nu / 0.5 = 0.5; a_1 = int 2 nu cos(2 pi nu) / (1/4) = 4 (-1/pi^2) (the Fourier series of a triangle wave); h = [a_1/2, a_0, a_1/2]"},
    {"id": "fir_least_squares.type_2_flat", "op": "fir_least_squares", "args": {"num_taps": 2, "bands": [0, 0.5], "desired": [1, 1], "sample_rate": 1}, "expected": [0.6366197723675814, 0.6366197723675814], "tol": {"abs": 1e-11, "rel": 1e-10}, "source": "by hand: N = 2, A = b0 cos(pi nu): b0 = int cos(pi nu) / int cos^2(pi nu) = (1/pi)/(1/4), h = [b0/2, b0/2]"},
    {"id": "fir_least_squares.weights_scale_cancel", "op": "fir_least_squares", "args": {"num_taps": 3, "bands": [0, 0.5], "desired": [0, 1], "weights": [7], "sample_rate": 1}, "expected": [-0.20264236728467555, 0.5, -0.20264236728467555], "tol": {"abs": 1e-11, "rel": 1e-10}, "source": "by hand: one band: its weight scales G and p alike, so full_band_ramp's taps"},
