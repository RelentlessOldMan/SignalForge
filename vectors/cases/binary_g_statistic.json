    {"id": "binary_g_statistic.not_binary", "op": "binary_g_statistic", "args": {"truth": [1.0, 0.0, 1.0], "decision": [1.0, 0.5, 0.0]}, "error": "invalid_argument", "source": "values must be 0 or 1"}
