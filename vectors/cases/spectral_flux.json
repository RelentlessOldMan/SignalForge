{
  "schema": 1,
  "suite": "spectral_flux",
  "description": "Spectral flux (conventions: Spectra, Spectral flux; ADR 0129).",
  "cases": [
    {"id": "spectral_flux.identical", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 2.0, 1.0, 1.0], "current": [1.0, 2.0, 1.0, 1.0]}, "expected": 0.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "identical frames: flux 0"},
    {"id": "spectral_flux.doubled_normalized", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 2.0, 1.0, 1.0], "current": [2.0, 4.0, 2.0, 2.0]}, "expected": 0.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "a frame against its double, normalized: the same shape, flux 0"},
    {"id": "spectral_flux.doubled_raw", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0, 1.0], "current": [2.0, 2.0, 2.0, 2.0], "normalize": false}, "expected": 2.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "flat 1 to flat 2, not normalized: a rise of 1 over a width of 4, flux^2 = 4, flux 2"},
    {"id": "spectral_flux.one_bin_raw", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0, 1.0], "current": [1.0, 2.0, 1.0, 1.0], "normalize": false}, "expected": 1.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "bin 1 rises by 1 over width 1, not normalized: flux 1"},
    {"id": "spectral_flux.one_bin_normalized", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0, 1.0], "current": [1.0, 2.0, 1.0, 1.0]}, "expected": 0.15, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "normalized: 1/4 each, then 1/5, 2/5, 1/5, 1/5; the only rise is 3/20, flux 3/20"},
    {"id": "spectral_flux.one_bin_both_ways", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0, 1.0], "current": [1.0, 2.0, 1.0, 1.0], "rectify": false}, "expected": 0.17320508075688773, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "normalized, not rectified: steps -1/20, 3/20, -1/20, -1/20; flux^2 = 12/400"},
    {"id": "spectral_flux.falls_only", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 2.0, 1.0, 1.0], "current": [1.0, 1.0, 1.0, 1.0], "normalize": false}, "expected": 0.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "bin 1 falls, nothing rises, rectified and not normalized: flux 0"},
    {"id": "spectral_flux.falls_unrectified", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 2.0, 1.0, 1.0], "current": [1.0, 1.0, 1.0, 1.0], "normalize": false, "rectify": false}, "expected": 1.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "bin 1 falls by 1, not rectified: flux 1"},
    {"id": "spectral_flux.cut_band", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0, 1.0], "current": [3.0, 1.0, 1.0, 1.0], "band": [0.25, 3.0], "normalize": false}, "expected": 1.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "band [0.25, 3] keeps a quarter of bin 0, which rises by 2: flux^2 = 4 x 1/4 = 1"},
    {"id": "spectral_flux.span_clipped", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0, 1.0], "current": [2.0, 1.0, 1.0, 1.0], "span": [0.0, 3.0], "normalize": false}, "expected": 1.4142135623730951, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "span (0, 3) halves bin 0, doubling its density: 2 to 4, a rise of 2 over width 1/2, flux^2 = 2"},
    {"id": "spectral_flux.no_power_normalized", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [0.0, 0.0, 0.0, 0.0], "current": [1.0, 1.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "with normalize, each frame needs power in the band"},
    {"id": "spectral_flux.length_mismatch", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0, 1.0], "current": [1.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "frequencies and psd must be the same length"},
    {"id": "spectral_flux.negative", "op": "spectral_flux", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0, 1.0], "current": [1.0, -1.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "psd must be non-negative"}
  ]
}
