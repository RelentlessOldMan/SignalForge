{
  "schema": 1,
  "suite": "interpolate_peak",
  "description": "Peak interpolation (conventions: Spectra, Peak interpolation; ADR 0136).",
  "cases": [
    {"id": "interpolate_peak.parabola_right", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0, 4.0], "psd": [4.710000000000001, 8.31, 9.91, 9.51, 7.109999999999999], "index": 2, "scale": "linear"}, "expected": {"frequency": 2.3, "height": 10.0, "offset": 0.3}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "10 - (k - 2.3)^2 on the linear scale: vertex 2.3, height 10"},
    {"id": "interpolate_peak.parabola_left", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0, 4.0], "psd": [6.9375, 9.4375, 9.9375, 8.4375, 4.9375], "index": 2, "scale": "linear"}, "expected": {"frequency": 1.75, "height": 10.0, "offset": -0.25}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "10 - (k - 1.75)^2, exact in binary: vertex 1.75, height 10"},
    {"id": "interpolate_peak.gaussian_db", "op": "interpolate_peak", "args": {"frequencies": [0.0, 100.0, 200.0, 300.0, 400.0, 500.0, 600.0, 700.0, 800.0, 900.0], "psd": [0.009827265841957141, 0.07936437897748115, 0.4109592596099772, 1.3644327923863677, 2.9045961482947633, 3.9646020019531396, 3.4697138927336435, 1.947009023839887, 0.7005231533806041, 0.16160591549665296], "index": 5, "scale": "db"}, "expected": {"frequency": 520.0, "height": 4.0, "offset": 0.2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "4 exp(-(k - 5.2)^2/4.5) on 100 Hz bins, dB scale: vertex 520 Hz, height 4"},
    {"id": "interpolate_peak.gaussian_default", "op": "interpolate_peak", "args": {"frequencies": [0.0, 100.0, 200.0, 300.0, 400.0, 500.0, 600.0, 700.0, 800.0, 900.0], "psd": [0.03630035126260624, 0.224539051336535, 0.8905394635155642, 2.264616598068791, 3.6924653855465435, 3.860276471158721, 2.587620701857409, 1.1121492018127763, 0.30648252872197385, 0.05415376054660938], "index": 5}, "expected": {"frequency": 460.0, "height": 4.0, "offset": -0.4}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "the default scale is dB: 4 exp(-(k - 4.6)^2/4.5), vertex 460 Hz, height 4"},
    {"id": "interpolate_peak.symmetric", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0], "psd": [1.0, 3.0, 1.0], "index": 1, "scale": "linear"}, "expected": {"frequency": 1.0, "height": 3.0, "offset": 0.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "equal neighbours: offset 0, height 3"},
    {"id": "interpolate_peak.two_top_bins", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 2.0, 1.0], "index": 1}, "expected": {"frequency": 1.5, "height": 2.1810154653305154, "offset": 0.5}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "dB values 0, D, D with D = 10 log10 2: offset 1/2, vertex D + D/8, so height 2^(9/8)"},
    {"id": "interpolate_peak.two_top_linear", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 2.0, 1.0], "index": 1, "scale": "linear"}, "expected": {"frequency": 1.5, "height": 2.125, "offset": 0.5}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "linear 1, 2, 2: curvature -1, offset 1/2, height 2 + 1/8"},
    {"id": "interpolate_peak.zero_neighbour", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0], "psd": [0.0, 1.0, 0.5], "index": 1, "scale": "linear"}, "expected": {"frequency": 1.1666666666666667, "height": 1.0208333333333333, "offset": 0.16666666666666666}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "linear 0, 1, 1/2 lie on -3k^2/4 + 7k/4: vertex 7/6, height 49/48"},
    {"id": "interpolate_peak.first_bin", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 2.0], "index": 0}, "error": "invalid_argument", "source": "the first bin has one neighbour"},
    {"id": "interpolate_peak.last_bin", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 2.0], "index": 3}, "error": "invalid_argument", "source": "the last bin has one neighbour"},
    {"id": "interpolate_peak.past_end", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 2.0], "index": 9}, "error": "invalid_argument", "source": "index past the end"},
    {"id": "interpolate_peak.not_a_maximum", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 2.0], "index": 1}, "error": "invalid_argument", "source": "bin 1 is lower than bin 2"},
    {"id": "interpolate_peak.flat", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0], "psd": [2.0, 2.0, 2.0], "index": 1}, "error": "invalid_argument", "source": "three equal bins have no curvature"},
    {"id": "interpolate_peak.zero_in_db", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0], "psd": [0.0, 1.0, 0.5], "index": 1}, "error": "invalid_argument", "source": "a zero bin has no dB value"},
    {"id": "interpolate_peak.unknown_scale", "op": "interpolate_peak", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 2.0], "index": 2, "scale": "log"}, "error": "invalid_argument", "source": "scale must be \"db\" or \"linear\""}
  ]
}
