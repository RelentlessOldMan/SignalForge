{
  "schema": 1,
  "suite": "group_delay",
  "description": "Group delay in samples of FIR taps and of second-order sections, NaN at a zero on the unit circle (conventions: FIR filters and IIR filters, Group delay).",
  "cases": [
    {"id": "fir_group_delay.pure_delay", "op": "fir_group_delay", "args": {"taps": [0, 0, 0, 1], "frequencies": [0, 0.1, 0.37], "sample_rate": 1}, "expected": [3, 3, 3], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "by hand: H = e^(-j3w), phase -3w, delay 3"},
    {"id": "fir_group_delay.symmetric", "op": "fir_group_delay", "args": {"taps": [1, 2, 3, 2, 1], "frequencies": [0, 0.1, 0.25, 0.45], "sample_rate": 1}, "expected": [2, 2, 2, 2], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "by hand: symmetric taps are linear phase, (N - 1)/2 = 2 wherever H != 0"},
    {"id": "fir_group_delay.zero_on_circle_nan", "op": "fir_group_delay", "args": {"taps": [1, 2, 3, 2, 1], "frequencies": [1, 0.3], "sample_rate": 3}, "expected": ["nan", 2], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "by hand: 1 + 2z + 3z^2 + 2z^3 + z^4 = (1 + z + z^2)^2 has zeros at e^(+-j2pi/3), so H(fs/3) = 0 (to rounding) and the conventions give NaN; elsewhere 2"},
    {"id": "fir_group_delay.two_taps_nyquist", "op": "fir_group_delay", "args": {"taps": [1, 1], "frequencies": [0.2, 0.5], "sample_rate": 1}, "expected": [0.5, "nan"], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "by hand: 1 + e^(-jw) = 2 cos(w/2) e^(-jw/2): delay 1/2, and H(fs/2) = 0 is NaN"},
    {"id": "fir_group_delay.first_order", "op": "fir_group_delay", "args": {"taps": [1, 0.5], "frequencies": [0, 0.25, 0.5], "sample_rate": 1}, "expected": [0.3333333333333333, 0.2, -1], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "by hand: P = 1 + a e^(-jw), Re(R/P) = (a cos w + a^2)/(1 + 2a cos w + a^2), a = 0.5: 0.75/2.25, 0.25/1.25, -0.25/0.25"},
    {"id": "fir_group_delay.minimum_phase_hz", "op": "fir_group_delay", "args": {"taps": [0.0, 2.0, -1.821761997273303, 1.051021256884336, -0.6836132710682085, 1.0135084312202025, -0.1048284301240098, -0.15552000000000005], "frequencies": [0.0, 400.0, 800.0, 1200.0, 1600.0, 2000.0, 2400.0, 2800.0, 3200.0, 3600.0, 4000.0], "sample_rate": 8000.0}, "expected": [1.636132173813842, 1.5287319038425338, -3.9003373107873305, 1.2863578875030413, 2.4240666435946996, 2.074034459157418, -0.478705109405434, 0.5079146842816811, 2.173386113487939, 2.4451763305915217, 2.4755921656997106], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "vectors/generators/group_delay.py (stdlib only): taps expanded from chosen roots; expected is the sum over the roots of each first-order factor's closed-form delay"},
    {"id": "fir_group_delay.maximum_phase_roots", "op": "fir_group_delay", "args": {"taps": [-0.7, 0.8882528826304653, -1.5063728321980847, -0.4473005694310842, 0.21973169643577734, 0.06451200000000001], "frequencies": [0.0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5], "sample_rate": 1.0}, "expected": [1.5291271574158223, 1.7495049504330298, 2.3879057778347046, 3.3590367327956288, 3.402932234269552, 2.5114653012237174, 1.8962713785137324, 1.4814293139477979, 1.1456073251184804, 0.897814267719075, 0.8036297395941616], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "vectors/generators/group_delay.py (stdlib only): taps expanded from chosen roots; expected is the sum over the roots of each first-order factor's closed-form delay"},
    {"id": "fir_group_delay.empty_taps", "op": "fir_group_delay", "args": {"taps": [], "frequencies": [0], "sample_rate": 1}, "error": "invalid_argument", "source": "taps must be non-empty"},
    {"id": "fir_group_delay.nan_frequency", "op": "fir_group_delay", "args": {"taps": [1], "frequencies": ["nan"], "sample_rate": 1}, "error": "invalid_argument", "source": "frequencies must be finite"},
    {"id": "fir_group_delay.zero_rate", "op": "fir_group_delay", "args": {"taps": [1], "frequencies": [0], "sample_rate": 0}, "error": "invalid_argument", "source": "sample_rate must be > 0"},
    {"id": "sos_group_delay.one_pole", "op": "sos_group_delay", "args": {"sos": [[1, 0, 0, 1, -0.5, 0]], "frequencies": [0, 0.25, 0.5], "sample_rate": 1}, "expected": [1, -0.2, -0.3333333333333333], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "by hand: 1/(1 - p z^-1): -Re(-p e^(-jw)/(1 - p e^(-jw))) = (p cos w - p^2)/(1 - 2p cos w + p^2), p = 0.5: 0.25/0.25, -0.25/1.25, -0.75/2.25"},
    {"id": "sos_group_delay.a0_scaled", "op": "sos_group_delay", "args": {"sos": [[2, 0, 0, 2, -1, 0]], "frequencies": [0, 0.5], "sample_rate": 1}, "expected": [1, -0.3333333333333333], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "by hand: the one_pole section times 2: dividing by a0 leaves the delay unchanged"},
    {"id": "sos_group_delay.unit_delay", "op": "sos_group_delay", "args": {"sos": [[0, 1, 0, 1, 0, 0]], "frequencies": [0, 0.3], "sample_rate": 1}, "expected": [1, 1], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "by hand: H = z^-1"},
    {"id": "sos_group_delay.allpass", "op": "sos_group_delay", "args": {"sos": [[-0.5, 1, 0, 1, -0.5, 0]], "frequencies": [0, 0.25, 0.5], "sample_rate": 1}, "expected": [3, 0.6, 0.3333333333333333], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "by hand: (-p + z^-1)/(1 - p z^-1): numerator (1 - p cos w)/(1 - 2p cos w + p^2) minus denominator (p^2 - p cos w)/(same) = (1 - p^2)/(1 - 2p cos w + p^2), p = 0.5: 0.75/0.25, 0.75/1.25, 0.75/2.25"},
    {"id": "sos_group_delay.zero_on_circle", "op": "sos_group_delay", "args": {"sos": [[1, 1, 0, 1, 0, 0]], "frequencies": [0.2, 0.5], "sample_rate": 1}, "expected": [0.5, "nan"], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "by hand: as fir_group_delay.two_taps_nyquist"},
    {"id": "sos_group_delay.two_sections_hz", "op": "sos_group_delay", "args": {"sos": [[0.3, 0.4806861693281602, 0.29999999999999993, 1.0, -1.579648611402671, 0.8100000000000002], [1.0, -0.09903208233478407, 0.48999999999999994, 1.0, -0.39999999999999997, -0.12]], "frequencies": [0.0, 400.0, 800.0, 1200.0, 1600.0, 2000.0, 2400.0, 2800.0, 3200.0, 3600.0, 4000.0], "sample_rate": 8000.0}, "expected": [2.791508979221135, 3.879745663020189, 4.549278673099005, 0.49960322704308, -1.0643611197294716, -1.982723704745151, -0.61103405109544, 0.12084838308246765, 0.4235710255272005, 0.5656737609198547, 0.6101029113890668], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "vectors/generators/group_delay.py (stdlib only): taps expanded from chosen roots; expected is the sum over the roots of each first-order factor's closed-form delay; zeros minus poles per section"},
    {"id": "sos_group_delay.first_order_sections", "op": "sos_group_delay", "args": {"sos": [[0.125, 0.1225, 0.0, 1.0, -0.75, 0.0], [2.0, -0.4, 0.0, 1.0, 0.4, 0.0], [1.0, 0.0, 0.0, 1.0, -0.6884797335056798, 0.9024999999999999]], "frequencies": [0.0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5], "sample_rate": 1.0}, "expected": [2.0395468833405737, 0.19195102732510982, -0.6359015337129562, -0.2589257646872572, 7.76969203801574, -0.5859300010874252, -0.7330998004425183, -0.633755343421073, -0.4587000054278898, -0.3781103342741317, -49.55760754230892], "tol": {"abs": 1e-09, "rel": 1e-09}, "source": "vectors/generators/group_delay.py (stdlib only): taps expanded from chosen roots; expected is the sum over the roots of each first-order factor's closed-form delay; zeros minus poles per section"},
    {"id": "sos_group_delay.a0_zero", "op": "sos_group_delay", "args": {"sos": [[1, 0, 0, 0, 1, 0]], "frequencies": [0], "sample_rate": 1}, "error": "invalid_argument", "source": "every section needs a0 != 0"},
    {"id": "sos_group_delay.five_columns", "op": "sos_group_delay", "args": {"sos": [[1, 0, 0, 1, 0]], "frequencies": [0], "sample_rate": 1}, "error": "invalid_argument", "source": "sections have 6 values"},
    {"id": "sos_group_delay.inf_frequency", "op": "sos_group_delay", "args": {"sos": [[1, 0, 0, 1, 0, 0]], "frequencies": ["inf"], "sample_rate": 1}, "error": "invalid_argument", "source": "frequencies must be finite"}
  ]
}
