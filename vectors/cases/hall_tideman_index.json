{
  "schema": 1,
  "suite": "hall_tideman_index",
  "description": "The Hall-Tideman index (conventions: the Hall-Tideman index; ADR 0525).",
  "cases": [
    {"id": "hall_tideman_index.equal", "op": "hall_tideman_index", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 0.25, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "four equal shares: 1/(2 (10/4) - 1) = 1/4"},
    {"id": "hall_tideman_index.single", "op": "hall_tideman_index", "args": {"samples": [5.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "one value: 1"},
    {"id": "hall_tideman_index.one_holds_all", "op": "hall_tideman_index", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "the largest holds the total: 1"},
    {"id": "hall_tideman_index.ramp", "op": "hall_tideman_index", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.3333333333333333, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "ranked 4, 3, 2, 1 of 10: 1/(2 (20/10) - 1) = 1/3"},
    {"id": "hall_tideman_index.three", "op": "hall_tideman_index", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.6666666666666666, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "ranked 3, 1, 0 of 4: 1/(2 (5/4) - 1) = 2/3"},
    {"id": "hall_tideman_index.halves", "op": "hall_tideman_index", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.36363636363636365, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "ranked 1, 1/2, 1/4, 1/4 of 2: 1/(2 (15/8) - 1) = 4/11"},
    {"id": "hall_tideman_index.random", "op": "hall_tideman_index", "args": {"samples": [1.75, 7.5, 2.625, 2.875, 1.625, 2.25, 4.375, 7.0, 0.5, 3.375, 3.875, 7.5, 3.0, 7.0, 2.0, 4.375, 2.875, 0.125, 1.0, 3.5, 1.375, 6.0, 4.75, 1.625, 4.625, 1.125, 2.375, 8.0, 4.5, 4.5]}, "expected": 0.05063884655960614, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "30 values k/8, k from random.Random(525).randint(0, 64)"},
    {"id": "hall_tideman_index.empty", "op": "hall_tideman_index", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "hall_tideman_index.negative", "op": "hall_tideman_index", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "hall_tideman_index.all_zero", "op": "hall_tideman_index", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
