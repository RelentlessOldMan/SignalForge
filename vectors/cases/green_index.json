{
  "schema": 1,
  "suite": "green_index",
  "description": "Green's index of dispersion (conventions: Green's index of dispersion; ADR 0611).",
  "cases": [
    {"id": "green_index.even", "op": "green_index", "args": {"counts": [2.0, 2.0, 2.0]}, "expected": -0.2, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "no variance: -1/(6 - 1) = -1/5"},
    {"id": "green_index.clumped", "op": "green_index", "args": {"counts": [0.0, 0.0, 6.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "all in one unit: s^2/m = 12/2, (6 - 1)/5 = 1"},
    {"id": "green_index.two_units", "op": "green_index", "args": {"counts": [0.0, 3.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "all in one unit: s^2/m = 4.5/1.5, (3 - 1)/2 = 1"},
    {"id": "green_index.mixed", "op": "green_index", "args": {"counts": [1.0, 2.0, 3.0]}, "expected": -0.1, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "m 2, s^2 1: (1/2 - 1)/5 = -1/10"},
    {"id": "green_index.uneven", "op": "green_index", "args": {"counts": [4.0, 0.0, 1.0, 0.0, 3.0]}, "expected": 0.15178571428571427, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "m 8/5, s^2 33/10: (33/16 - 1)/7 = 17/112"},
    {"id": "green_index.singles", "op": "green_index", "args": {"counts": [1.0, 1.0, 0.0, 0.0]}, "expected": -0.3333333333333333, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "m 1/2, s^2 1/3: (2/3 - 1)/1 = -1/3"},
    {"id": "green_index.huge", "op": "green_index", "args": {"counts": [1e+308, 0.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "the sums would overflow: all in one unit, 1"},
    {"id": "green_index.large_mean_spread", "op": "green_index", "args": {"counts": [1000000000.0, 1000200000.0]}, "expected": 9.498050299709055e-09, "tol": {"abs": 0.0, "rel": 1e-13}, "source": "s^2 2e10, m 1e9 + 1e5, total 2e9 + 2e5: (2e10/m - 1)/(total - 1)"},
    {"id": "green_index.random", "op": "green_index", "args": {"counts": [3.0, 1.0, 7.0, 0.0, 7.0, 1.0, 3.0, 0.0, 3.0, 2.0, 0.0, 2.0, 3.0, 3.0, 7.0, 3.0, 0.0, 0.0, 3.0, 0.0, 0.0, 0.0, 7.0, 0.0, 3.0, 0.0, 0.0, 7.0, 7.0, 2.0]}, "expected": 0.024116227706213536, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "30 counts from random.Random(611).choice([0, 0, 1, 2, 3, 7])"},
    {"id": "green_index.empty", "op": "green_index", "args": {"counts": []}, "error": "invalid_argument", "source": "there must be a unit"},
    {"id": "green_index.one_unit", "op": "green_index", "args": {"counts": [5.0]}, "error": "invalid_argument", "source": "the variance needs at least two units"},
    {"id": "green_index.total_one", "op": "green_index", "args": {"counts": [1.0, 0.0]}, "error": "invalid_argument", "source": "the total must be above 1"},
    {"id": "green_index.negative", "op": "green_index", "args": {"counts": [1.0, -1.0, 2.0]}, "error": "invalid_argument", "source": "counts must be at least 0"},
    {"id": "green_index.all_zero", "op": "green_index", "args": {"counts": [0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be above 0"},
    {"id": "green_index.not_whole", "op": "green_index", "args": {"counts": [1.0, 2.5]}, "error": "invalid_argument", "source": "counts must be whole numbers"}
  ]
}
