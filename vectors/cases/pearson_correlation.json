    {"id": "pearson_correlation.by_hand", "op": "pearson_correlation", "args": {"x": [1.0, 2.0, 3.0, 4.0], "y": [1.0, 3.0, 2.0, 4.0]}, "expected": 0.8, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "deviations -3/2,-1/2,1/2,3/2 and -3/2,1/2,-1/2,3/2: products sum to 4, squares to 5 each: r = 4/5"},
    {"id": "pearson_correlation.not_monotone", "op": "pearson_correlation", "args": {"x": [0.0, 1.0, 2.0, 3.0], "y": [0.0, 2.0, 2.0, 0.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "a tent: deviations -3/2,-1/2,1/2,3/2 and -1,1,1,-1; products sum to 0, so r = 0"},
