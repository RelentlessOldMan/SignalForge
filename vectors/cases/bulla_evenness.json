{
  "schema": 1,
  "suite": "bulla_evenness",
  "description": "Bulla's evenness (conventions: Bulla's evenness; ADR 0535).",
  "cases": [
    {"id": "bulla_evenness.equal", "op": "bulla_evenness", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "four equal shares, overlap 1: 1"},
    {"id": "bulla_evenness.one_holds_all", "op": "bulla_evenness", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "overlap 1/4: 0"},
    {"id": "bulla_evenness.two", "op": "bulla_evenness", "args": {"samples": [3.0, 1.0]}, "expected": 0.5, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "overlap 1/2 + 1/4 = 3/4: (1/4)/(1/2) = 1/2"},
    {"id": "bulla_evenness.ramp", "op": "bulla_evenness", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.7333333333333333, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "overlap 1/4 + 1/10 + 1/4 + 1/5 = 4/5: (11/20)/(3/4) = 11/15"},
    {"id": "bulla_evenness.three", "op": "bulla_evenness", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.375, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "overlap 1/3 + 0 + 1/4 = 7/12: (1/4)/(2/3) = 3/8"},
    {"id": "bulla_evenness.halves", "op": "bulla_evenness", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.6666666666666666, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "overlap 1/4 + 1/8 + 1/8 + 1/4 = 3/4: (1/2)/(3/4) = 2/3"},
    {"id": "bulla_evenness.one_zero", "op": "bulla_evenness", "args": {"samples": [0.0, 2.0, 2.0, 2.0, 2.0]}, "expected": 0.75, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "overlap 4/5: (3/5)/(4/5) = 3/4"},
    {"id": "bulla_evenness.random", "op": "bulla_evenness", "args": {"samples": [2.25, 6.625, 6.25, 6.375, 2.25, 1.875, 3.625, 1.625, 2.5, 7.375, 6.125, 2.875, 7.875, 3.25, 0.375, 7.625, 0.25, 8.0, 7.0, 3.375, 2.125, 4.75, 5.5, 3.875, 6.75, 0.375, 4.5, 8.0, 5.25, 5.5]}, "expected": 0.7534466690233634, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "30 values k/8, k from random.Random(535).randint(0, 64)"},
    {"id": "bulla_evenness.empty", "op": "bulla_evenness", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs at least 2 values"},
    {"id": "bulla_evenness.single", "op": "bulla_evenness", "args": {"samples": [5.0]}, "error": "invalid_argument", "source": "the record needs at least 2 values"},
    {"id": "bulla_evenness.negative", "op": "bulla_evenness", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "bulla_evenness.all_zero", "op": "bulla_evenness", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
