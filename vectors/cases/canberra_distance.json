{
  "schema": 1,
  "suite": "canberra_distance",
  "description": "The Canberra distance (conventions: Canberra distance; ADR 0417).",
  "cases": [
    {"id": "canberra_distance.same", "op": "canberra_distance", "args": {"x": [1.0, -2.0, 3.0], "y": [1.0, -2.0, 3.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "equal vectors: 0"},
    {"id": "canberra_distance.apart", "op": "canberra_distance", "args": {"x": [1.0, 0.0], "y": [0.0, 1.0]}, "expected": 2.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "each coordinate zero in one: 1 each, 2"},
    {"id": "canberra_distance.signs", "op": "canberra_distance", "args": {"x": [1.0, -1.0], "y": [-1.0, 1.0]}, "expected": 2.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "opposite signs: 2/2 each, 2"},
    {"id": "canberra_distance.mixed", "op": "canberra_distance", "args": {"x": [1.0, 3.0], "y": [2.0, 1.0]}, "expected": 0.8333333333333334, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "1/3 + 2/4 = 5/6"},
    {"id": "canberra_distance.shared_zero", "op": "canberra_distance", "args": {"x": [0.0, 1.0], "y": [0.0, 3.0]}, "expected": 0.5, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "index 0 zero in both, dropped: 2/4 = 1/2"},
    {"id": "canberra_distance.scale", "op": "canberra_distance", "args": {"x": [1000.0, 0.001], "y": [2000.0, 0.002]}, "expected": 0.6666666666666666, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "each coordinate doubled: 1/3 + 1/3 = 2/3 whatever its size"},
    {"id": "canberra_distance.random", "op": "canberra_distance", "args": {"x": [4.5, -3.75, -4.5, 1.0, -0.5, -4.5, 0.5, -5.0, 2.25, -5.0, 1.0, -3.75, -4.75, 0.0, 1.0, -5.0], "y": [-1.0, -3.75, 0.5, -1.0, -5.0, 0.25, 1.5, -3.5, 2.5, 2.75, -4.75, 4.5, 4.25, 1.5, -3.25, 3.0]}, "expected": 12.54728398536448, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "16 quarters each from random.Random(417), -5 to 5"},
    {"id": "canberra_distance.empty", "op": "canberra_distance", "args": {"x": [], "y": []}, "error": "invalid_argument", "source": "x needs a value"},
    {"id": "canberra_distance.lengths", "op": "canberra_distance", "args": {"x": [1.0, 2.0, 3.0], "y": [1.0, 1.0]}, "error": "invalid_argument", "source": "x and y must match"},
    {"id": "canberra_distance.not_finite", "op": "canberra_distance", "args": {"x": [1.0, "inf", 1.0], "y": [2.0, 1.0, 0.0]}, "error": "invalid_argument", "source": "values must be finite"},
    {"id": "canberra_distance.nan", "op": "canberra_distance", "args": {"x": [1.0, 2.0, 3.0], "y": [1.0, "nan", 1.0]}, "error": "invalid_argument", "source": "values must be finite"}
  ]
}
