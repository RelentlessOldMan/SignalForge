{
  "schema": 1,
  "suite": "wolfson_index",
  "description": "The Wolfson polarization index (conventions: the Wolfson polarization index; ADR 0522).",
  "cases": [
    {"id": "wolfson_index.equal", "op": "wolfson_index", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "every value equal: 0"},
    {"id": "wolfson_index.single", "op": "wolfson_index", "args": {"samples": [5.0]}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "one value: L(1/2) = 1/2, G = 0, so 0"},
    {"id": "wolfson_index.two", "op": "wolfson_index", "args": {"samples": [3.0, 1.0]}, "expected": 0.5, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "mean 2, median 2, L(1/2) 1/4, G 1/4: 2 (1 - 1/2 - 1/4) = 1/2"},
    {"id": "wolfson_index.ramp", "op": "wolfson_index", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.3, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "mean = median 5/2, L(1/2) 3/10, G 1/4: 2 (1 - 3/5 - 1/4) = 3/10"},
    {"id": "wolfson_index.three", "op": "wolfson_index", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.6666666666666666, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "mean 4/3, median 1, L(1/2) 1/8, G 1/2: 2 (4/3) (1 - 1/4 - 1/2) = 2/3"},
    {"id": "wolfson_index.halves", "op": "wolfson_index", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.5, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "mean 1/2, median 3/8, L(1/2) 1/4, G 5/16: 2 (4/3) (3/16) = 1/2"},
    {"id": "wolfson_index.random", "op": "wolfson_index", "args": {"samples": [1.25, 3.75, 6.25, 0.375, 2.25, 1.5, 3.125, 2.25, 0.75, 7.125, 5.0, 5.0, 4.0, 6.625, 7.625, 2.25, 0.25, 5.5, 6.5, 1.25, 7.625, 7.375, 6.0, 2.375, 6.25, 7.125, 7.625, 5.875, 0.5, 6.5]}, "expected": 0.33261111111111114, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "30 values k/8, k from random.Random(522).randint(1, 64)"},
    {"id": "wolfson_index.empty", "op": "wolfson_index", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "wolfson_index.negative", "op": "wolfson_index", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "wolfson_index.all_zero", "op": "wolfson_index", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the median must be above 0"},
    {"id": "wolfson_index.median_zero", "op": "wolfson_index", "args": {"samples": [0.0, 0.0, 0.0, 1.0, 2.0]}, "error": "invalid_argument", "source": "the median must be above 0"}
  ]
}
