{
  "schema": 1,
  "suite": "hannah_kay_index",
  "description": "The Hannah-Kay index (conventions: the Hannah-Kay index; ADR 0527).",
  "cases": [
    {"id": "hannah_kay_index.equal_2", "op": "hannah_kay_index", "args": {"samples": [2.0, 2.0, 2.0, 2.0], "alpha": 2.0}, "expected": 4.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "four equal shares: 4"},
    {"id": "hannah_kay_index.equal_1", "op": "hannah_kay_index", "args": {"samples": [2.0, 2.0, 2.0, 2.0], "alpha": 1.0}, "expected": 4.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "four equal shares: exp(ln 4) = 4"},
    {"id": "hannah_kay_index.equal_half", "op": "hannah_kay_index", "args": {"samples": [2.0, 2.0, 2.0, 2.0], "alpha": 0.5}, "expected": 4.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "four equal shares: (4 (1/2))^2 = 4"},
    {"id": "hannah_kay_index.one_holds_all_2", "op": "hannah_kay_index", "args": {"samples": [0.0, 0.0, 0.0, 4.0], "alpha": 2.0}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "one share of 1: 1"},
    {"id": "hannah_kay_index.one_holds_all_1", "op": "hannah_kay_index", "args": {"samples": [0.0, 0.0, 0.0, 4.0], "alpha": 1.0}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "one share of 1, 0 ln 0 = 0: 1"},
    {"id": "hannah_kay_index.ramp_2", "op": "hannah_kay_index", "args": {"samples": [4.0, 1.0, 3.0, 2.0], "alpha": 2.0}, "expected": 3.3333333333333335, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "1/(30/100) = 10/3"},
    {"id": "hannah_kay_index.three_2", "op": "hannah_kay_index", "args": {"samples": [3.0, 0.0, 1.0], "alpha": 2.0}, "expected": 1.6, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "1/(10/16) = 8/5"},
    {"id": "hannah_kay_index.halves_3", "op": "hannah_kay_index", "args": {"samples": [0.5, 0.25, 0.25, 1.0], "alpha": 3.0}, "expected": 2.6303837968857167, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "shares 1/4, 1/8, 1/8, 1/2: (37/256)^(-1/2) = 16/sqrt(37)"},
    {"id": "hannah_kay_index.ramp_1", "op": "hannah_kay_index", "args": {"samples": [4.0, 1.0, 3.0, 2.0], "alpha": 1.0}, "expected": 3.596115466624322, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "exp(-sum s ln s), shares 4, 1, 3, 2 tenths"},
    {"id": "hannah_kay_index.ramp_half", "op": "hannah_kay_index", "args": {"samples": [4.0, 1.0, 3.0, 2.0], "alpha": 0.5}, "expected": 3.777656570521819, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "(sum sqrt s)^2, shares 4, 1, 3, 2 tenths"},
    {"id": "hannah_kay_index.random", "op": "hannah_kay_index", "args": {"samples": [6.875, 5.375, 2.5, 5.0, 3.75, 4.875, 0.5, 0.125, 2.625, 4.5, 7.5, 5.875, 1.375, 6.0, 2.125, 6.125, 0.25, 5.5, 2.875, 7.5, 0.125, 6.125, 5.375, 4.875, 2.25, 3.0, 7.0, 3.25, 4.375, 0.75], "alpha": 1.5}, "expected": 23.301877287594966, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "30 values k/8, k from random.Random(527).randint(0, 64); alpha 3/2"},
    {"id": "hannah_kay_index.empty", "op": "hannah_kay_index", "args": {"samples": [], "alpha": 2.0}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "hannah_kay_index.negative", "op": "hannah_kay_index", "args": {"samples": [1.0, -0.5, 2.0], "alpha": 2.0}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "hannah_kay_index.all_zero", "op": "hannah_kay_index", "args": {"samples": [0.0, 0.0, 0.0], "alpha": 2.0}, "error": "invalid_argument", "source": "the total must be positive"},
    {"id": "hannah_kay_index.alpha_zero", "op": "hannah_kay_index", "args": {"samples": [1.0, 2.0, 3.0], "alpha": 0.0}, "error": "invalid_argument", "source": "alpha must be above 0"},
    {"id": "hannah_kay_index.alpha_negative", "op": "hannah_kay_index", "args": {"samples": [1.0, 2.0, 3.0], "alpha": -1.0}, "error": "invalid_argument", "source": "alpha must be above 0"}
  ]
}
