{
  "schema": 1,
  "suite": "complex_cross_spectra",
  "description": "Coherence, H1 and H2 of complex input (conventions: Complex coherence and transfer functions; ADR 0197).",
  "cases": [
    {"id": "complex_cross_spectra.scaled_h1", "op": "transfer_function", "args": {"x": {"re": [1.0, 0.0, 2.0, 0.0], "im": [0.0, 1.0, 0.0, 0.0]}, "y": {"re": [1.0, -1.0, 2.0, 0.0], "im": [1.0, 1.0, 2.0, 0.0]}, "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [-1.0, 0.0], "response": {"re": [1.0, 1.0], "im": [1.0, 1.0]}, "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "y = (1 + j) x, segments X = [1 + j, 1 - j] and [2, 2], all non-zero: Sxy = (1 + j) Sxx and Syy = 2 Sxx, so H1 = 1 + j"},
    {"id": "complex_cross_spectra.scaled_h2", "op": "transfer_function_h2", "args": {"x": {"re": [1.0, 0.0, 2.0, 0.0], "im": [0.0, 1.0, 0.0, 0.0]}, "y": {"re": [1.0, -1.0, 2.0, 0.0], "im": [1.0, 1.0, 2.0, 0.0]}, "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [-1.0, 0.0], "response": {"re": [1.0, 1.0], "im": [1.0, 1.0]}, "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "y = (1 + j) x, segments X = [1 + j, 1 - j] and [2, 2], all non-zero: Sxy = (1 + j) Sxx and Syy = 2 Sxx, so H2 = 2 Sxx / ((1 - j) Sxx) = 1 + j"},
    {"id": "complex_cross_spectra.scaled_coherence", "op": "coherence", "args": {"x": {"re": [1.0, 0.0, 2.0, 0.0], "im": [0.0, 1.0, 0.0, 0.0]}, "y": {"re": [1.0, -1.0, 2.0, 0.0], "im": [1.0, 1.0, 2.0, 0.0]}, "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [-1.0, 0.0], "values": [1.0, 1.0], "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "y = (1 + j) x, segments X = [1 + j, 1 - j] and [2, 2], all non-zero: Sxy = (1 + j) Sxx and Syy = 2 Sxx, so |Sxy|^2 / (Sxx Syy) = 2 / 2 = 1"},
    {"id": "complex_cross_spectra.single_h1", "op": "transfer_function", "args": {"x": {"re": [1.0, 0.0], "im": [0.0, 1.0]}, "y": [1.0, 0.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [-1.0, 0.0], "response": {"re": [0.5, 0.5], "im": [0.5, -0.5]}, "num_segments": 1}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x = [1, j], y = [1, 0]: X = [1 + j, 1 - j], Y = [1, 1]; one segment, so H = Y / X = [(1 - j)/2, (1 + j)/2]; shifted [bin 1, bin 0]: [(1 + j)/2, (1 - j)/2]"},
    {"id": "complex_cross_spectra.single_h2", "op": "transfer_function_h2", "args": {"x": {"re": [1.0, 0.0], "im": [0.0, 1.0]}, "y": [1.0, 0.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [-1.0, 0.0], "response": {"re": [0.5, 0.5], "im": [0.5, -0.5]}, "num_segments": 1}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x = [1, j], y = [1, 0]: X = [1 + j, 1 - j], Y = [1, 1]; one segment, so H = Y / X = [(1 - j)/2, (1 + j)/2]; shifted [bin 1, bin 0]: [(1 + j)/2, (1 - j)/2] (H2 = |Y|^2 / (conj Y X) = Y / X too)"},
    {"id": "complex_cross_spectra.disagree_h1", "op": "transfer_function", "args": {"x": {"re": [1.0, 0.0, 1.0, 0.0], "im": [0.0, 1.0, 0.0, 1.0]}, "y": [1.0, 0.0, 0.0, 1.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [-1.0, 0.0], "response": {"re": [0.0, 0.5], "im": [0.0, -0.5]}, "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x = [1, j] twice, y = [1, 0], [0, 1]: X = [1 + j, 1 - j] twice, Y = [1, 1], [1, -1]. Sxx = [4, 4], Syy = [2, 2], Sxy = [(1 - j) 2, (1 + j) 0] = [2 - 2j, 0]. H1 = [0.5 - 0.5j, 0]; shifted [0, 0.5 - 0.5j]"},
    {"id": "complex_cross_spectra.disagree_h2", "op": "transfer_function_h2", "args": {"x": {"re": [1.0, 0.0, 1.0, 0.0], "im": [0.0, 1.0, 0.0, 1.0]}, "y": [1.0, 0.0, 0.0, 1.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [-1.0, 0.0], "response": {"re": ["nan", 0.5], "im": ["nan", -0.5]}, "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x = [1, j] twice, y = [1, 0], [0, 1]: X = [1 + j, 1 - j] twice, Y = [1, 1], [1, -1]. Sxx = [4, 4], Syy = [2, 2], Sxy = [(1 - j) 2, (1 + j) 0] = [2 - 2j, 0]. H2 = Syy / conj Sxy = [2 / (2 + 2j), NaN] = [0.5 - 0.5j, NaN]; shifted [NaN, 0.5 - 0.5j]"},
    {"id": "complex_cross_spectra.disagree_coherence", "op": "coherence", "args": {"x": {"re": [1.0, 0.0, 1.0, 0.0], "im": [0.0, 1.0, 0.0, 1.0]}, "y": [1.0, 0.0, 0.0, 1.0], "sample_rate": 2.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [-1.0, 0.0], "values": [0.0, 1.0], "num_segments": 2}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "x = [1, j] twice, y = [1, 0], [0, 1]: X = [1 + j, 1 - j] twice, Y = [1, 1], [1, -1]. Sxx = [4, 4], Syy = [2, 2], Sxy = [(1 - j) 2, (1 + j) 0] = [2 - 2j, 0]. Coherence = [8 / 8, 0]; shifted [0, 1]"},
    {"id": "complex_cross_spectra.mixed_h1", "op": "transfer_function", "args": {"x": [1.0, 0.0], "y": {"re": [0.0, 1.0], "im": [1.0, 0.0]}, "sample_rate": 4.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [-2.0, 0.0], "response": {"re": [-1.0, 1.0], "im": [1.0, 1.0]}, "num_segments": 1}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "real x = delta, complex y = [j, 1]: X = [1, 1], Y = [1 + j, -1 + j]; H = Y; shifted [-1 + j, 1 + j]"},
    {"id": "complex_cross_spectra.mixed_coherence", "op": "coherence", "args": {"x": [1.0, 0.0], "y": {"re": [0.0, 1.0], "im": [1.0, 0.0]}, "sample_rate": 4.0, "nperseg": 2, "noverlap": 0, "window": "rectangular"}, "expected": {"frequencies": [-2.0, 0.0], "values": [1.0, 1.0], "num_segments": 1}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "real x = delta, complex y = [j, 1]: X = [1, 1], Y = [1 + j, -1 + j]; H = Y; shifted [-1 + j, 1 + j]; one segment, so coherence 1"},
    {"id": "complex_cross_spectra.lengths", "op": "coherence", "args": {"x": {"re": [1.0, 2.0], "im": [0.0, 1.0]}, "y": [1.0], "sample_rate": 1.0}, "error": "invalid_argument", "source": "x and y differ in length"},
    {"id": "complex_cross_spectra.nan", "op": "transfer_function", "args": {"x": {"re": [1.0, 2.0], "im": ["nan", 1.0]}, "y": [1.0, 2.0], "sample_rate": 1.0}, "error": "invalid_argument", "source": "not finite"}
  ]
}
