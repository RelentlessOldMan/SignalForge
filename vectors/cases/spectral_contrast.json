{
  "schema": 1,
  "suite": "spectral_contrast",
  "description": "Spectral contrast (conventions: Spectra, Spectral contrast; ADR 0133).",
  "cases": [
    {"id": "spectral_contrast.flat", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 2.0, 2.0, 2.0]}, "expected": {"peak": 2.0, "valley": 2.0, "contrast_db": 0.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "flat: peak = valley, 0 dB"},
    {"id": "spectral_contrast.ramp_default", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0]}, "expected": {"peak": 4.0, "valley": 1.0, "contrast_db": 6.020599913279624}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "fraction 0.2 of width 4 is 0.8, inside the top and bottom bins: peak 4, valley 1"},
    {"id": "spectral_contrast.ramp_quarter", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0], "fraction": 0.25}, "expected": {"peak": 4.0, "valley": 1.0, "contrast_db": 6.020599913279624}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "fraction 1/4: exactly the top and bottom bins"},
    {"id": "spectral_contrast.ramp_half", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0], "fraction": 0.5}, "expected": {"peak": 3.5, "valley": 1.5, "contrast_db": 3.679767852945944}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "fraction 1/2: (4 + 3)/2 and (1 + 2)/2"},
    {"id": "spectral_contrast.ramp_split", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0], "fraction": 0.375}, "expected": {"peak": 3.6666666666666665, "valley": 1.3333333333333333, "contrast_db": 4.393326938302627}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "fraction 3/8, width 3/2: (4 + 3/2)/(3/2) and (1 + 1)/(3/2), splitting the second bins"},
    {"id": "spectral_contrast.unsorted", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [3.0, 1.0, 4.0, 2.0], "fraction": 0.5}, "expected": {"peak": 3.5, "valley": 1.5, "contrast_db": 3.679767852945944}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "the ramp shuffled: sorting gives the same as ramp_half"},
    {"id": "spectral_contrast.cut_band", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0], "band": [0.25, 3.0], "fraction": 0.25}, "expected": {"peak": 3.727272727272727, "valley": 1.6363636363636365, "contrast_db": 3.575113516164294}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "band [0.25, 3], widths 1/4, 1, 1, 1/2, W 11/4, limit 11/16: top 4 x 1/2 + 3 x 3/16, bottom 1 x 1/4 + 2 x 7/16, each over 11/16"},
    {"id": "spectral_contrast.span_clipped", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 1.0, 1.0, 2.0], "span": [0.0, 3.0], "fraction": 0.5}, "expected": {"peak": 3.0, "valley": 1.0, "contrast_db": 4.771212547196624}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "span (0, 3): densities 4, 1, 1, 4 on widths 1/2, 1, 1, 1/2; half of 3 is 3/2: top 4 x 1/2 + 4 x 1/2 + 1 x 1/2 over 3/2, bottom 1 + 1 x 1/2 over 3/2"},
    {"id": "spectral_contrast.zero_valley", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 1.0, 2.0, 3.0], "fraction": 0.25}, "expected": {"peak": 3.0, "valley": 0.0, "contrast_db": "inf"}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "the quietest quarter is the empty bin: valley 0, contrast +inf"},
    {"id": "spectral_contrast.fraction_zero", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0], "fraction": 0.0}, "error": "invalid_argument", "source": "fraction must be > 0"},
    {"id": "spectral_contrast.fraction_over_half", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0], "fraction": 0.6}, "error": "invalid_argument", "source": "fraction must be at most 1/2"},
    {"id": "spectral_contrast.no_power", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the band has no power"},
    {"id": "spectral_contrast.band_outside", "op": "spectral_contrast", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0], "band": [0.0, 4.0]}, "error": "invalid_argument", "source": "band [0, 4] leaves the spectrum [-0.5, 3.5]"}
  ]
}
