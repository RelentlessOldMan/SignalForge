{
  "schema": 1,
  "suite": "spectral_rolloff",
  "description": "Spectral rolloff (conventions: Spectra, Spectral rolloff; ADR 0124).",
  "cases": [
    {"id": "spectral_rolloff.flat_85", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "fraction": 0.85}, "expected": 2.9, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "flat over [-0.5, 3.5]: rolloff = -0.5 + 0.85 x 4 = 2.9"},
    {"id": "spectral_rolloff.flat_half", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "fraction": 0.5}, "expected": 1.5, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "flat over [-0.5, 3.5]: half the power lies below the centre, 1.5"},
    {"id": "spectral_rolloff.flat_all", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "fraction": 1.0}, "expected": 3.5, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "fraction 1 on a flat PSD: the top edge, 3.5"},
    {"id": "spectral_rolloff.uneven", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0], "fraction": 0.5}, "expected": 2.1666666666666665, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "power 10, target 5: bins 0 and 1 hold 3, so 2 more of bin 2's density 3, at 1.5 + 2/3"},
    {"id": "spectral_rolloff.empty_before", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 0.0, 2.0, 2.0], "fraction": 0.25}, "expected": 2.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "power 4, target 1: bins 0 and 1 are empty, so 1/2 Hz into bin 2 (density 2), at 1.5 + 0.5"},
    {"id": "spectral_rolloff.tie_empty_after", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 0.0, 2.0], "fraction": 0.5}, "expected": 1.5, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "power 4, target 2: reached exactly at the top of bin 1, before the empty bin 2: 1.5"},
    {"id": "spectral_rolloff.all_stops_at_last_power", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 0.0, 0.0], "fraction": 1.0}, "expected": 1.5, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "fraction 1: the top edge of the last bin with power, 1.5, not the spectrum's 3.5"},
    {"id": "spectral_rolloff.cut_band", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0], "band": [0.0, 2.0], "fraction": 0.5}, "expected": 1.25, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "band [0, 2]: pieces [0, 0.5] at density 1, [0.5, 1.5] at 2, [1.5, 2] at 3; power 4, target 2: 0.5 before bin 1, 1.5 more at density 2 is 0.75 Hz, at 0.5 + 0.75 = 1.25"},
    {"id": "spectral_rolloff.span_clipped", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 1.0, 1.0, 2.0], "span": [0.0, 3.0], "fraction": 0.25}, "expected": 0.375, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "span (0, 3) halves bin 0, which keeps power 2 at density 4; power 6, target 1.5, reached 1.5 / 4 into [0, 0.5]: 0.375"},
    {"id": "spectral_rolloff.offset_axis", "op": "spectral_rolloff", "args": {"frequencies": [1000.0, 1001.0, 1002.0], "psd": [1.0, 4.0, 1.0], "fraction": 0.95}, "expected": 1002.2, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "power 6, target 5.7: bins 0 and 1 hold 5, then 0.7 of bin 2 (density 1): 1001.5 + 0.7 = 1002.2"},
    {"id": "spectral_rolloff.fraction_zero", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "fraction": 0.0}, "error": "invalid_argument", "source": "fraction must be in (0, 1]"},
    {"id": "spectral_rolloff.fraction_above_one", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "fraction": 1.5}, "error": "invalid_argument", "source": "fraction must be in (0, 1]"},
    {"id": "spectral_rolloff.fraction_nan", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "fraction": "nan"}, "error": "invalid_argument", "source": "fraction must be finite"},
    {"id": "spectral_rolloff.band_reversed", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "fraction": 0.5, "band": [2.0, 1.0]}, "error": "invalid_argument", "source": "band low must be below band high"},
    {"id": "spectral_rolloff.no_power", "op": "spectral_rolloff", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 0.0, 1.0, 0.0], "fraction": 0.5, "band": [-0.5, 1.5]}, "error": "invalid_argument", "source": "the band has no power"}
  ]
}
