{
  "schema": 1,
  "suite": "phaser",
  "description": "Phaser (conventions: Phaser; ADR 0274).",
  "cases": [
    {"id": "phaser.quarter_rate", "op": "phaser", "args": {"samples": [1.0, -0.5, 0.25, 2.0, -1.0, 0.75, 0.5, -0.25], "stages": 2, "low": 2.0, "high": 2.0, "rate": 1.0, "sample_rate": 8.0, "mix": 1.0}, "expected": [3.0814879110195774e-33, -1.1102230246251565e-16, 1.0, -0.4999999999999999, 0.24999999999999972, 2.0, -0.9999999999999998, 0.75], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "low = high = fs/4: c is about 0, so two stages are about x[n-2]"},
    {"id": "phaser.fixed", "op": "phaser", "args": {"samples": [1.0, -0.5, 0.25, 2.0, -1.0, 0.75, 0.5, -0.25], "stages": 1, "low": 0.5, "high": 0.5, "rate": 3.0, "sample_rate": 8.0, "mix": 1.0}, "expected": [-0.6681786379192989, 0.88762662678796, -0.07395150901174374, -1.1357700944021414, 1.9092813232522026, -0.22539298446406075, 0.2653079036845888, 0.8443177331930178], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "one fixed allpass at fs/16, wet only"},
    {"id": "phaser.swept", "op": "phaser", "args": {"samples": [0.3, -0.7, 1.1, 0.4, -0.9, 0.2, 0.8, -0.6, 0.5, 1.3, -0.1, 0.05], "stages": 4, "low": 0.2, "high": 3.5, "rate": 0.9, "sample_rate": 10.0, "mix": 0.5}, "expected": [0.24061794738949543, -0.5705775070748261, 0.85433641400607, -0.1595139658336195, -0.05109311871432831, -0.2913771314755951, 0.9763111169839928, -0.8802039609409997, 0.012714125443656049, 0.702860572133606, 0.0006124150114050209, 0.5197748618442088], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "4 stages swept 0.2 to 3.5 Hz at 0.9 Hz, fs 10 Hz, mix 1/2"},
    {"id": "phaser.dry", "op": "phaser", "args": {"samples": [1.0, -0.5, 0.25, 2.0, -1.0, 0.75, 0.5, -0.25], "stages": 3, "low": 1.0, "high": 3.0, "rate": 1.0, "sample_rate": 8.0, "mix": 0.0}, "expected": [1.0, -0.5, 0.25, 2.0, -1.0, 0.75, 0.5, -0.25], "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "mix 0: the dry signal"},
    {"id": "phaser.complex", "op": "phaser", "args": {"samples": {"re": [1.0, 0.0, -2.0, 0.5, 0.25], "im": [0.0, 1.0, 0.5, -1.0, 2.0]}, "stages": 2, "low": 0.5, "high": 1.5, "rate": 1.0, "sample_rate": 5.0, "mix": 0.5}, "expected": {"re": [0.6298080918412499, -0.33373789572490853, -0.5472787160971615, -0.027415163834254075, -0.9007061437290957], "im": [0.0, 0.5337423269244547, 0.1691211792883938, 0.059384284126760334, 1.4816439412247755]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "complex, part by part, 2 stages"},
    {"id": "phaser.stages_zero", "op": "phaser", "args": {"samples": [1.0, 2.0], "stages": 0, "low": 1.0, "high": 3.0, "rate": 1.0, "sample_rate": 8.0, "mix": 0.5}, "error": "invalid_argument", "source": "stages must be at least 1"},
    {"id": "phaser.low_zero", "op": "phaser", "args": {"samples": [1.0, 2.0], "stages": 2, "low": 0.0, "high": 3.0, "rate": 1.0, "sample_rate": 8.0, "mix": 0.5}, "error": "invalid_argument", "source": "low must be positive"},
    {"id": "phaser.high_below_low", "op": "phaser", "args": {"samples": [1.0, 2.0], "stages": 2, "low": 3.0, "high": 2.0, "rate": 1.0, "sample_rate": 8.0, "mix": 0.5}, "error": "invalid_argument", "source": "high must be at least low"},
    {"id": "phaser.high_nyquist", "op": "phaser", "args": {"samples": [1.0, 2.0], "stages": 2, "low": 1.0, "high": 4.0, "rate": 1.0, "sample_rate": 8.0, "mix": 0.5}, "error": "invalid_argument", "source": "high must be below fs/2"},
    {"id": "phaser.mix_negative", "op": "phaser", "args": {"samples": [1.0, 2.0], "stages": 2, "low": 1.0, "high": 3.0, "rate": 1.0, "sample_rate": 8.0, "mix": -0.5}, "error": "invalid_argument", "source": "mix must be at least 0"},
    {"id": "phaser.empty", "op": "phaser", "args": {"samples": [], "stages": 2, "low": 1.0, "high": 3.0, "rate": 1.0, "sample_rate": 8.0, "mix": 0.5}, "error": "invalid_argument", "source": "samples must not be empty"}
  ]
}
