    {"id": "welch_psd.median_of_two_is_the_mean", "op": "welch_psd", "args": {"samples": [1.0, 1.0, 3.0, 3.0], "sample_rate": 1.0, "nperseg": 2, "average": "median", "window": "rectangular", "noverlap": 0}, "expected": {"psd": [10, 0]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: two segments: the median is the mean of 2 and 18, and b(2) = 1/2 + 1/2 = 1"},
