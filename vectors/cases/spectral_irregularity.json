{
  "schema": 1,
  "suite": "spectral_irregularity",
  "description": "Spectral irregularity (conventions: Spectra, Spectral irregularity; ADR 0132).",
  "cases": [
    {"id": "spectral_irregularity.flat", "op": "spectral_irregularity", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 2.0, 2.0, 2.0]}, "expected": 0.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "flat: no jumps"},
    {"id": "spectral_irregularity.ramp", "op": "spectral_irregularity", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0]}, "expected": 0.1, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "three unit jumps over 1 + 4 + 9 + 16 = 30"},
    {"id": "spectral_irregularity.alternating", "op": "spectral_irregularity", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 0.0, 1.0, 0.0]}, "expected": 1.5, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "three unit jumps over 1 + 1 = 2"},
    {"id": "spectral_irregularity.single_bin", "op": "spectral_irregularity", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 1.0, 0.0, 0.0]}, "expected": 2.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "two unit jumps over 1"},
    {"id": "spectral_irregularity.spaced", "op": "spectral_irregularity", "args": {"frequencies": [10.0, 30.0, 50.0, 70.0], "psd": [1.0, 2.0, 3.0, 4.0]}, "expected": 0.1, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "the ramp on 20 Hz bins: still 1/10"},
    {"id": "spectral_irregularity.cut_band", "op": "spectral_irregularity", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0], "band": [0.25, 3.0]}, "expected": 0.11176470588235295, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "band [0.25, 3], widths 1/4, 1, 1, 1/2: jumps 5/8 + 1 + 3/4 = 19/8 over 1/4 + 4 + 9 + 8 = 85/4"},
    {"id": "spectral_irregularity.span_clipped", "op": "spectral_irregularity", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 1.0, 1.0, 2.0], "span": [0.0, 3.0]}, "expected": 0.75, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "span (0, 3): densities 4, 1, 1, 4 on widths 1/2, 1, 1, 1/2; jumps 9 x 3/4 twice = 27/2 over 8 + 1 + 1 + 8 = 18"},
    {"id": "spectral_irregularity.one_piece", "op": "spectral_irregularity", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [0.0, 0.4]}, "error": "invalid_argument", "source": "the band holds one bin"},
    {"id": "spectral_irregularity.no_power", "op": "spectral_irregularity", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the band has no power"},
    {"id": "spectral_irregularity.band_outside", "op": "spectral_irregularity", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [0.0, 4.0]}, "error": "invalid_argument", "source": "band [0, 4] leaves the spectrum [-0.5, 3.5]"}
  ]
}
