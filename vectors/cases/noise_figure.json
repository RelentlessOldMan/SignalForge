{
  "schema": 1,
  "suite": "noise_figure",
  "description": "Noise figure by the Y-factor method (conventions: Noise figure; ADR 0105).",
  "cases": [
    {"id": "noise_figure_y_factor.textbook_enr15_y10", "op": "noise_figure_y_factor", "args": {"hot_power": 10.0, "cold_power": 1.0, "enr_db": 15.0}, "expected": {"y_factor": 10.0, "noise_factor": 3.5136418446315334, "noise_figure_db": 5.457574905606752, "noise_temperature": 728.9561349431447}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "textbook: ENR 15 dB, Y 10 dB, T_c = T0: F = 10^1.5/9, NF about 5.46 dB"},
    {"id": "noise_figure_y_factor.ideal_y2_enr0", "op": "noise_figure_y_factor", "args": {"hot_power": 2.0, "cold_power": 1.0, "enr_db": 0.0}, "expected": {"y_factor": 2.0, "noise_factor": 1.0, "noise_figure_db": 0.0, "noise_temperature": 0.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: ENR 1, Y 2, T_c = T0: T_e = (580 - 580)/1 = 0, F = 1, NF 0 dB"},
    {"id": "noise_figure_y_factor.enr10_y3", "op": "noise_figure_y_factor", "args": {"hot_power": 6.0, "cold_power": 2.0, "enr_db": 10.0}, "expected": {"y_factor": 3.0, "noise_factor": 5.0, "noise_figure_db": 6.989700043360188, "noise_temperature": 1160.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: ENR 10, Y 3: T_e = (3190 - 870)/2 = 1160 K, F = 5"},
    {"id": "noise_figure_y_factor.cold_half_t0", "op": "noise_figure_y_factor", "args": {"hot_power": 8.0, "cold_power": 2.0, "enr_db": 10.0, "cold_temperature": 145.0}, "expected": {"y_factor": 4.0, "noise_factor": 4.0, "noise_figure_db": 6.020599913279624, "noise_temperature": 870.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: ENR 10, Y 4, T_c = 145 K: T_e = (3190 - 580)/3 = 870 K, F = 4"},
    {"id": "noise_figure_y_factor.cold_twice_t0", "op": "noise_figure_y_factor", "args": {"hot_power": 3.0, "cold_power": 1.5, "enr_db": 10.0, "cold_temperature": 580.0}, "expected": {"y_factor": 2.0, "noise_factor": 8.0, "noise_figure_db": 9.030899869919436, "noise_temperature": 2030.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: ENR 10, Y 2, T_c = 580 K: T_e = (3190 - 1160)/1 = 2030 K, F = 8"},
    {"id": "noise_figure_y_factor.liquid_nitrogen", "op": "noise_figure_y_factor", "args": {"hot_power": 3.2, "cold_power": 1.0, "enr_db": 5.0, "cold_temperature": 77.0}, "expected": {"y_factor": 3.2, "noise_factor": 2.5057374944339035, "noise_figure_db": 3.9893557157022785, "noise_temperature": 436.66387338583195}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: ENR 10^0.5, Y 3.2, T_c = 77 K, T_e = (290(1 + ENR) - 3.2*77)/2.2"},
    {"id": "noise_figure_y_factor.negative_enr_db", "op": "noise_figure_y_factor", "args": {"hot_power": 1.25, "cold_power": 1.0, "enr_db": -3.0}, "expected": {"y_factor": 1.25, "noise_factor": 2.0047489345090885, "noise_figure_db": 3.0205999132796224, "noise_temperature": 291.3771910076357}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: ENR 10^-0.3, Y 1.25, T_c = T0: F = ENR/0.25"},
    {"id": "noise_figure_y_factor.picowatts", "op": "noise_figure_y_factor", "args": {"hot_power": 4e-12, "cold_power": 1e-12, "enr_db": 10.0}, "expected": {"y_factor": 4.0, "noise_factor": 3.3333333333333335, "noise_figure_db": 5.228787452803376, "noise_temperature": 676.6666666666666}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: only the ratio counts, Y 4 (to rounding), ENR 10: F = 10/3"},
    {"id": "noise_figure_y_factor.below_one", "op": "noise_figure_y_factor", "args": {"hot_power": 12.0, "cold_power": 1.0, "enr_db": 10.0}, "expected": {"y_factor": 12.0, "noise_factor": 0.9090909090909091, "noise_figure_db": -0.41392685158225057, "noise_temperature": -26.363636363636363}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: ENR 10, Y 12: F = 10/11 < 1, a negative T_e = -290/11 K, returned as it is"},
    {"id": "noise_figure_y_factor.y_one", "op": "noise_figure_y_factor", "args": {"hot_power": 1.0, "cold_power": 1.0, "enr_db": 15.0}, "error": "invalid_argument", "source": "Y must be above 1"},
    {"id": "noise_figure_y_factor.hot_below_cold", "op": "noise_figure_y_factor", "args": {"hot_power": 0.5, "cold_power": 1.0, "enr_db": 15.0}, "error": "invalid_argument", "source": "Y must be above 1"},
    {"id": "noise_figure_y_factor.cold_zero", "op": "noise_figure_y_factor", "args": {"hot_power": 10.0, "cold_power": 0.0, "enr_db": 15.0}, "error": "invalid_argument", "source": "cold_power must be positive"},
    {"id": "noise_figure_y_factor.cold_negative", "op": "noise_figure_y_factor", "args": {"hot_power": 1.0, "cold_power": -1.0, "enr_db": 15.0}, "error": "invalid_argument", "source": "cold_power must be positive"},
    {"id": "noise_figure_y_factor.hot_nan", "op": "noise_figure_y_factor", "args": {"hot_power": "nan", "cold_power": 1.0, "enr_db": 15.0}, "error": "invalid_argument", "source": "hot_power must be finite"},
    {"id": "noise_figure_y_factor.hot_inf", "op": "noise_figure_y_factor", "args": {"hot_power": "inf", "cold_power": 1.0, "enr_db": 15.0}, "error": "invalid_argument", "source": "hot_power must be finite"},
    {"id": "noise_figure_y_factor.enr_inf", "op": "noise_figure_y_factor", "args": {"hot_power": 10.0, "cold_power": 1.0, "enr_db": "inf"}, "error": "invalid_argument", "source": "enr_db must be finite"},
    {"id": "noise_figure_y_factor.enr_overflows", "op": "noise_figure_y_factor", "args": {"hot_power": 10.0, "cold_power": 1.0, "enr_db": 4000.0}, "error": "invalid_argument", "source": "ENR = 10^400 overflows, so F is not finite"},
    {"id": "noise_figure_y_factor.y_overflows", "op": "noise_figure_y_factor", "args": {"hot_power": 1e+300, "cold_power": 1e-300, "enr_db": 15.0}, "error": "invalid_argument", "source": "Y overflows, so F is not finite"},
    {"id": "noise_figure_y_factor.cold_temperature_zero", "op": "noise_figure_y_factor", "args": {"hot_power": 10.0, "cold_power": 1.0, "enr_db": 15.0, "cold_temperature": 0.0}, "error": "invalid_argument", "source": "cold_temperature must be positive"},
    {"id": "noise_figure_y_factor.cold_temperature_nan", "op": "noise_figure_y_factor", "args": {"hot_power": 10.0, "cold_power": 1.0, "enr_db": 15.0, "cold_temperature": "nan"}, "error": "invalid_argument", "source": "cold_temperature must be finite"},
    {"id": "noise_figure_y_factor.negative_noise_factor", "op": "noise_figure_y_factor", "args": {"hot_power": 2.0, "cold_power": 1.0, "enr_db": 0.0, "cold_temperature": 580.0}, "error": "invalid_argument", "source": "by hand: ENR 1, Y 2, T_c = 2 T0: F = (1 - 2)/1 = -1"},
    {"id": "noise_figure_y_factor.zero_noise_factor", "op": "noise_figure_y_factor", "args": {"hot_power": 2.0, "cold_power": 1.0, "enr_db": 0.0, "cold_temperature": 435.0}, "error": "invalid_argument", "source": "by hand: ENR 1, Y 2, T_c = 1.5 T0: F = (1 - 1)/1 = 0"}
  ]
}
