{
  "schema": 1,
  "suite": "correlation_sum",
  "description": "Correlation sum (conventions: Correlation sum; ADR 0349).",
  "cases": [
    {"id": "correlation_sum.ramp_by_hand", "op": "correlation_sum", "args": {"samples": [0.0, 1.0, 2.0, 3.0], "m": 1, "radii": [1.5, 2.5]}, "expected": {"radii": [1.5, 2.5], "values": [0.5, 0.8333333333333334], "dimension": 1.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "0, 1, 2, 3: distances 1, 2, 3, 1, 2, 1, so C = 3/6 and 5/6; the slope is ln(5/3)/ln(5/3) = 1"},
    {"id": "correlation_sum.radius_on_a_distance", "op": "correlation_sum", "args": {"samples": [0.0, 1.0, 2.0, 3.0], "m": 1, "radii": [1.25, 2.0, 3.0]}, "expected": {"radii": [1.25, 2.0, 3.0], "values": [0.5, 0.5, 0.8333333333333334], "dimension": 0.5681209752392481}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "r = 2 and r = 3 sit on distances, which do not count: C = 3/6, 3/6, 5/6"},
    {"id": "correlation_sum.theiler", "op": "correlation_sum", "args": {"samples": [0.0, 1.0, 2.0, 3.0], "m": 1, "radii": [2.5, 3.5], "theiler": 1}, "expected": {"radii": [2.5, 3.5], "values": [0.6666666666666666, 1.0], "dimension": 1.205047739390816}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "a Theiler window of 1 drops the three neighbours: distances 2, 3, 2, so C = 2/3 and 1"},
    {"id": "correlation_sum.mixed_delay", "op": "correlation_sum", "args": {"samples": [0.25, -1.5, 3.0, 2.75, -0.5, 0.125, 1.0, -2.25, 0.375, 2.5, -1.25, 0.75, 0.0, 1.5, -0.75, 2.0, 0.5, -1.0], "m": 2, "radii": [1.0, 2.0, 3.0, 4.5], "delay": 2}, "expected": {"radii": [1.0, 2.0, 3.0, 4.5], "values": [0.058333333333333334, 0.3333333333333333, 0.6583333333333333, 0.9416666666666667], "dimension": 1.8876294513128946}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "eighteen arbitrary dyadic samples, m = 2, delay 2"},
