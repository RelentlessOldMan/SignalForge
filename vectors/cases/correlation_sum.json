    {"id": "correlation_sum.delay_zero", "op": "correlation_sum", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 2, "radii": [1.0, 2.0], "delay": 0}, "error": "invalid_argument", "source": "delay must be at least 1"},
    {"id": "correlation_sum.theiler_negative", "op": "correlation_sum", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 2, "radii": [1.0, 2.0], "theiler": -1}, "error": "invalid_argument", "source": "theiler must be at least 0"},
    {"id": "correlation_sum.one_radius", "op": "correlation_sum", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 2, "radii": [1.0]}, "error": "invalid_argument", "source": "two radii are needed"},
    {"id": "correlation_sum.radii_not_increasing", "op": "correlation_sum", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 2, "radii": [2.0, 2.0]}, "error": "invalid_argument", "source": "radii must be strictly increasing"},
    {"id": "correlation_sum.radius_zero", "op": "correlation_sum", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 2, "radii": [0.0, 1.0]}, "error": "invalid_argument", "source": "radii must be positive"},
    {"id": "correlation_sum.radius_too_small", "op": "correlation_sum", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 2, "radii": [0.25, 1.0]}, "error": "invalid_argument", "source": "no pair is closer than 0.25"},
    {"id": "correlation_sum.no_pair", "op": "correlation_sum", "args": {"samples": [0.0, 1.0, 0.5, 2.0, 1.5], "m": 2, "radii": [1.0, 2.0], "theiler": 3}, "error": "invalid_argument", "source": "the Theiler window leaves no pair"},
    {"id": "correlation_sum.nan", "op": "correlation_sum", "args": {"samples": [0.0, "nan", 1.0, 2.0], "m": 2, "radii": [1.0, 2.0]}, "error": "invalid_argument", "source": "samples must be finite"}
  ]
}
