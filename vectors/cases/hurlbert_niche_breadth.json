{
  "schema": 1,
  "suite": "hurlbert_niche_breadth",
  "description": "Hurlbert's niche breadth (conventions: Hurlbert's niche breadth; ADR 0601).",
  "cases": [
    {"id": "hurlbert_niche_breadth.as_available", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, 2.0, 3.0], "available": [1.0, 2.0, 3.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "use as availability: 1 / sum p = 1"},
    {"id": "hurlbert_niche_breadth.as_available_std", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, 2.0, 3.0], "available": [1.0, 2.0, 3.0], "standardized": true}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "use as availability, standardized: (1 - 1/6)/(1 - 1/6) = 1"},
    {"id": "hurlbert_niche_breadth.even_use", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, 1.0], "available": [1.0, 3.0]}, "expected": 0.75, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "halves on 1/4, 3/4: 1/(1 + 1/3) = 3/4"},
    {"id": "hurlbert_niche_breadth.even_use_std", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, 1.0], "available": [1.0, 3.0], "standardized": true}, "expected": 0.6666666666666666, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "halves on 1/4, 3/4, standardized: (3/4 - 1/4)/(3/4) = 2/3"},
    {"id": "hurlbert_niche_breadth.scarcest", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, 0.0], "available": [1.0, 3.0]}, "expected": 0.25, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "all on the kind with share 1/4: 1/4"},
    {"id": "hurlbert_niche_breadth.scarcest_std", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, 0.0], "available": [1.0, 3.0], "standardized": true}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "all on the scarcest kind, standardized: 0"},
    {"id": "hurlbert_niche_breadth.commonest", "op": "hurlbert_niche_breadth", "args": {"x": [0.0, 1.0], "available": [1.0, 3.0]}, "expected": 0.75, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "all on the kind with share 3/4: 3/4"},
    {"id": "hurlbert_niche_breadth.uneven", "op": "hurlbert_niche_breadth", "args": {"x": [2.0, 1.0, 1.0], "available": [1.0, 2.0, 1.0]}, "expected": 0.7272727272727273, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "1/2, 1/4, 1/4 on 1/4, 1/2, 1/4: 1/(1 + 1/8 + 1/4) = 8/11"},
    {"id": "hurlbert_niche_breadth.uneven_std", "op": "hurlbert_niche_breadth", "args": {"x": [2.0, 1.0, 1.0], "available": [1.0, 2.0, 1.0], "standardized": true}, "expected": 0.6363636363636364, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "standardized: (8/11 - 1/4)/(3/4) = 7/11"},
    {"id": "hurlbert_niche_breadth.one_kind", "op": "hurlbert_niche_breadth", "args": {"x": [2.0], "available": [5.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "one kind: 1"},
    {"id": "hurlbert_niche_breadth.huge", "op": "hurlbert_niche_breadth", "args": {"x": [1e+308, 1e+308], "available": [1e+308, 1e+308]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "the sums would overflow: halves on halves: 1"},
    {"id": "hurlbert_niche_breadth.tiny", "op": "hurlbert_niche_breadth", "args": {"x": [5e-324, 1.0], "available": [1.0, 1.0]}, "expected": 0.5, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "the smallest double counts: 1/(2 (1 + 2.5e-647)/(1 + 5e-324)^2), 1/2 to double precision"},
    {"id": "hurlbert_niche_breadth.random", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, 0.0, 0.0, 2.5, 2.5, 2.5, 0.0, 0.0, 1.0, 2.5, 1.0, 0.0, 0.0, 2.5, 1.0, 1.0, 2.5, 0.0, 0.0, 2.5, 0.0, 2.5, 0.0, 0.0, 0.0], "available": [2.5, 0.5, 1.0, 1.0, 2.5, 0.5, 2.5, 1.0, 1.0, 2.5, 0.5, 0.5, 2.5, 0.5, 0.5, 1.0, 2.5, 2.5, 1.0, 1.0, 0.5, 2.5, 0.5, 0.5, 2.5]}, "expected": 0.341045509112736, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "x then available, 25 values each from random.Random(601).choice([0, 0, 1, 2.5]) with x[0] = 1, and .choice([0.5, 1, 2.5])"},
    {"id": "hurlbert_niche_breadth.random_std", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, 0.0, 0.0, 2.5, 2.5, 2.5, 0.0, 0.0, 1.0, 2.5, 1.0, 0.0, 0.0, 2.5, 1.0, 1.0, 2.5, 0.0, 0.0, 2.5, 0.0, 2.5, 0.0, 0.0, 0.0], "available": [2.5, 0.5, 1.0, 1.0, 2.5, 0.5, 2.5, 1.0, 1.0, 2.5, 0.5, 0.5, 2.5, 0.5, 0.5, 1.0, 2.5, 2.5, 1.0, 1.0, 0.5, 2.5, 0.5, 0.5, 2.5], "standardized": true}, "expected": 0.3312103674577022, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "the random case, standardized"},
    {"id": "hurlbert_niche_breadth.empty", "op": "hurlbert_niche_breadth", "args": {"x": [], "available": []}, "error": "invalid_argument", "source": "a record needs a value"},
    {"id": "hurlbert_niche_breadth.negative", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, -0.5, 2.0], "available": [1.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "hurlbert_niche_breadth.all_zero", "op": "hurlbert_niche_breadth", "args": {"x": [0.0, 0.0, 0.0], "available": [1.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "a record needs a value above 0"},
    {"id": "hurlbert_niche_breadth.lengths", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, 2.0, 3.0], "available": [1.0, 2.0]}, "error": "invalid_argument", "source": "the records must have the same length"},
    {"id": "hurlbert_niche_breadth.unavailable", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, 2.0, 3.0], "available": [1.0, 0.0, 1.0]}, "error": "invalid_argument", "source": "available must be above 0 everywhere"},
    {"id": "hurlbert_niche_breadth.underflow", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, 2.0, 3.0], "available": [1e+300, 5e-324, 1.0]}, "error": "invalid_argument", "source": "the share 5e-324/1e300 underflows to 0"},
    {"id": "hurlbert_niche_breadth.overflow", "op": "hurlbert_niche_breadth", "args": {"x": [1.0, 1.0, 1.0], "available": [1.0, 1e-310, 1.0]}, "error": "invalid_argument", "source": "(1/3)^2/(1e-310/(2 + 1e-310)) is above the largest double"},
    {"id": "hurlbert_niche_breadth.one_kind_std", "op": "hurlbert_niche_breadth", "args": {"x": [2.0], "available": [5.0], "standardized": true}, "error": "invalid_argument", "source": "the standardized form needs at least two kinds"}
  ]
}
