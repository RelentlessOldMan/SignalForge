{
  "schema": 1,
  "suite": "moving_rms",
  "description": "Moving RMS (conventions: Moving RMS; ADR 0239).",
  "cases": [
    {"id": "moving_rms.constant", "op": "moving_rms", "args": {"samples": [-3.0, -3.0, -3.0, -3.0, -3.0, -3.0, -3.0], "length": 4}, "expected": [1.5, 2.1213203435596424, 2.598076211353316, 3.0, 3.0, 3.0, 3.0], "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "constant -3: 3 sqrt(min(n + 1, 4) / 4)"},
    {"id": "moving_rms.mixed", "op": "moving_rms", "args": {"samples": [0.5, 1.5, -1.0, 2.25, 0.0, -0.75, 1.0, 3.0, -2.0, 0.25], "length": 3}, "expected": [0.28867513459481287, 0.9128709291752769, 1.0801234497346435, 1.6645820296198484, 1.4215601757693317, 1.3693063937629153, 0.7216878364870323, 1.8763883748662837, 2.160246899469287, 2.0866640042581523], "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "mixed data, N = 3"},
    {"id": "moving_rms.length_one", "op": "moving_rms", "args": {"samples": [1.5, -2.0, 0.0], "length": 1}, "expected": [1.5, 2.0, 0.0], "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "N = 1: |x|"},
    {"id": "moving_rms.long_window", "op": "moving_rms", "args": {"samples": [1.0, 2.0, 3.0], "length": 8}, "expected": [0.3535533905932738, 0.7905694150420949, 1.3228756555322954], "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "window longer than the input"},
    {"id": "moving_rms.complex", "op": "moving_rms", "args": {"samples": {"re": [3.0, 0.0, -1.0, 2.0], "im": [4.0, 1.0, 1.0, -2.0]}, "length": 2}, "expected": [3.5355339059327378, 3.605551275463989, 1.224744871391589, 2.23606797749979], "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "complex samples"},
    {"id": "moving_rms.huge", "op": "moving_rms", "args": {"samples": [5.357543035931337e+300, 1.607262910779401e+301, -1.0715086071862673e+301, 2.4108943661691015e+301, 0.0, -8.036314553897005e+300, 1.0715086071862673e+301, 3.214525821558802e+301, -2.1430172143725346e+301, 2.6787715179656683e+300], "length": 3}, "expected": [3.093178913989962e+300, 9.781490578614346e+300, 1.157361573214394e+301, 1.7836139721052537e+301, 1.523213963970062e+301, 1.467223586792152e+301, 7.732947284974906e+300, 2.0105662940934753e+301, 2.314723146428788e+301, 2.235878440868372e+301], "tol": {"abs": 0.0, "rel": 1e-13}, "source": "mixed times 2^1000: the squares overflow a double, but an RMS scales with the samples and a power of 2 scales exactly, so mixed's values times 2^1000"},
    {"id": "moving_rms.tiny", "op": "moving_rms", "args": {"samples": [4.6663180925160944e-302, 1.3998954277548283e-301, -9.332636185032189e-302, 2.0998431416322425e-301, 0.0, -6.999477138774142e-302, 9.332636185032189e-302, 2.7997908555096566e-301, -1.8665272370064378e-301, 2.3331590462580472e-302], "length": 3}, "expected": [2.694100006838588e-302, 8.519492265885146e-302, 1.008039919129533e-301, 1.553493848258452e-301, 1.3266903935585583e-301, 1.2779238398827718e-301, 6.735250017096471e-302, 1.7511650044450823e-301, 2.016079838259066e-301, 1.9474075992143794e-301], "tol": {"abs": 0.0, "rel": 1e-13}, "source": "mixed times 2^-1000: the squares underflow to 0, but an RMS scales with the samples and a power of 2 scales exactly, so mixed's values times 2^-1000"},
    {"id": "moving_rms.wide", "op": "moving_rms", "args": {"samples": [1.0715086071862673e+301, 1.0715086071862673e+301, 2.7997908555096566e-301, 3.7330544740128755e-301], "length": 2}, "expected": [7.576710022411623e+300, 1.0715086071862673e+301, 7.576710022411623e+300, 3.299585166391606e-301], "tol": {"abs": 0.0, "rel": 1e-13}, "source": "N = 2 over 2^1000, 2^1000, 3 x 2^-1000, 4 x 2^-1000: windows 2^1000/sqrt 2, 2^1000, 2^1000/sqrt 2 (the 3 x 2^-1000 is below the last bit), and 5 x 2^-1000/sqrt 2; no one scale keeps both the first and last windows in range"},
    {"id": "moving_rms.length_zero", "op": "moving_rms", "args": {"samples": [1.0], "length": 0}, "error": "invalid_argument", "source": "length must be at least 1"},
    {"id": "moving_rms.empty", "op": "moving_rms", "args": {"samples": [], "length": 2}, "error": "invalid_argument", "source": "samples must not be empty"},
    {"id": "moving_rms.nan_sample", "op": "moving_rms", "args": {"samples": [1.0, "nan"], "length": 2}, "error": "invalid_argument", "source": "samples must be finite"}
  ]
