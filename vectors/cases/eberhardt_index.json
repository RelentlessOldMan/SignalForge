{
  "schema": 1,
  "suite": "eberhardt_index",
  "description": "Eberhardt's index (conventions: Eberhardt's index; ADR 0620).",
  "cases": [
    {"id": "eberhardt_index.single", "op": "eberhardt_index", "args": {"point_distances": [2.5]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "one distance: 1"},
    {"id": "eberhardt_index.equal", "op": "eberhardt_index", "args": {"point_distances": [3.0, 3.0, 3.0]}, "expected": 1.0, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "all equal, the least: 1"},
    {"id": "eberhardt_index.one_nonzero", "op": "eberhardt_index", "args": {"point_distances": [0.0, 0.0, 0.0, 4.0]}, "expected": 4.0, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "one above 0, the most: n = 4"},
    {"id": "eberhardt_index.two", "op": "eberhardt_index", "args": {"point_distances": [1.0, 3.0]}, "expected": 1.25, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "2 * 10/16 = 5/4"},
    {"id": "eberhardt_index.three", "op": "eberhardt_index", "args": {"point_distances": [1.0, 2.0, 3.0]}, "expected": 1.1666666666666667, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "3 * 14/36 = 7/6"},
    {"id": "eberhardt_index.huge", "op": "eberhardt_index", "args": {"point_distances": [1e+300, 3e+300]}, "expected": 1.25, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "the squares would overflow: 5/4"},
    {"id": "eberhardt_index.tiny", "op": "eberhardt_index", "args": {"point_distances": [5e-324, 1e-323]}, "expected": 1.1111111111111112, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "the smallest doubles, 1 and 2 of them: 2 * 5/9 = 10/9"},
    {"id": "eberhardt_index.random", "op": "eberhardt_index", "args": {"point_distances": [0.44683011523782623, 1.0152732799766129, 1.2160434810562768, 1.574557001489852, 0.17166223749969411, 1.4541837987349657, 0.9686039865225795, 0.5878156571713153, 0.10923850753904785, 0.4767758405431517, 0.22123627934534884, 0.4987935774764165, 0.09654657045387283, 0.17532019723025982, 1.359303709911923, 0.048089034875081094, 1.9191021748166182, 0.341382917931667, 1.740810328511675, 1.8149404150613884, 0.2488201355156665, 1.776495955930451, 0.1410104977137605, 1.4294927337442187, 0.14522863158571675]}, "expected": 1.6580649135161933, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "25 distances from random.Random(620).uniform(0, 2)"},
    {"id": "eberhardt_index.empty", "op": "eberhardt_index", "args": {"point_distances": []}, "error": "invalid_argument", "source": "there must be a distance above 0"},
    {"id": "eberhardt_index.all_zero", "op": "eberhardt_index", "args": {"point_distances": [0.0, 0.0]}, "error": "invalid_argument", "source": "there must be a distance above 0"},
    {"id": "eberhardt_index.negative", "op": "eberhardt_index", "args": {"point_distances": [1.0, -0.5]}, "error": "invalid_argument", "source": "distances must be at least 0"}
  ]
}
