{
  "schema": 1,
  "suite": "normalize_peak",
  "description": "Peak normalization (conventions: Peak normalization; ADR 0268).",
  "cases": [
    {"id": "normalize_peak.unit", "op": "normalize_peak", "args": {"samples": [0.5, -0.25, 0.125, 0.0]}, "expected": [1.0, -0.5, 0.25, 0.0], "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "peak 1: largest 0.5 scaled by 2"},
    {"id": "normalize_peak.negative_peak_sample", "op": "normalize_peak", "args": {"samples": [0.5, -4.0, 2.0], "peak": 1.0}, "expected": [0.125, -1.0, 0.5], "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "largest magnitude is negative: -1 after"},
    {"id": "normalize_peak.half", "op": "normalize_peak", "args": {"samples": [3.0, -1.5, 0.75], "peak": 0.5}, "expected": [0.5, -0.25, 0.125], "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "peak 1/2"},
    {"id": "normalize_peak.third", "op": "normalize_peak", "args": {"samples": [1.0, 2.0, -3.0], "peak": 1.0}, "expected": [0.3333333333333333, 0.6666666666666666, -1.0], "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "peak 1, gain 1/3: products round once"},
    {"id": "normalize_peak.up", "op": "normalize_peak", "args": {"samples": [0.001, -0.002], "peak": 8.0}, "expected": [4.0, -8.0], "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "small input scaled up to peak 8"},
    {"id": "normalize_peak.complex", "op": "normalize_peak", "args": {"samples": {"re": [0.375, 0.0, -0.1875], "im": [0.5, 0.25, 0.25]}}, "expected": {"re": [0.6, 0.0, -0.3], "im": [0.8, 0.4, 0.4]}, "tol": {"abs": 1e-15, "rel": 1e-15}, "source": "complex, largest |x| = 5/8 (3-4-5): first sample 0.6 + 0.8i"},
    {"id": "normalize_peak.peak_zero", "op": "normalize_peak", "args": {"samples": [1.0, -2.0], "peak": 0.0}, "error": "invalid_argument", "source": "peak must be positive"},
    {"id": "normalize_peak.peak_nan", "op": "normalize_peak", "args": {"samples": [1.0, -2.0], "peak": "nan"}, "error": "invalid_argument", "source": "peak must be finite"},
    {"id": "normalize_peak.all_zero", "op": "normalize_peak", "args": {"samples": [0.0, 0.0], "peak": 1.0}, "error": "invalid_argument", "source": "samples must not all be zero"},
    {"id": "normalize_peak.empty", "op": "normalize_peak", "args": {"samples": [], "peak": 1.0}, "error": "invalid_argument", "source": "samples must not be empty"},
    {"id": "normalize_peak.inf_sample", "op": "normalize_peak", "args": {"samples": [1.0, "inf"], "peak": 1.0}, "error": "invalid_argument", "source": "samples must be finite"}
  ]
}
