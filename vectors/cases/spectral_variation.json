{
  "schema": 1,
  "suite": "spectral_variation",
  "description": "Spectral variation (conventions: Spectra, Spectral variation; ADR 0131).",
  "cases": [
    {"id": "spectral_variation.identical", "op": "spectral_variation", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 2.0, 1.0, 1.0], "current": [1.0, 2.0, 1.0, 1.0]}, "expected": 0.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "identical frames: correlation 1, variation 0"},
    {"id": "spectral_variation.doubled", "op": "spectral_variation", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 2.0, 1.0, 1.0], "current": [2.0, 4.0, 2.0, 2.0]}, "expected": 0.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "a frame against its double: correlation 1, variation 0"},
    {"id": "spectral_variation.disjoint", "op": "spectral_variation", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 0.0, 0.0, 0.0], "current": [0.0, 0.0, 0.0, 1.0]}, "expected": 1.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "frames sharing no bin: correlation 0, variation 1"},
    {"id": "spectral_variation.overlap", "op": "spectral_variation", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 0.0, 0.0], "current": [0.0, 1.0, 1.0, 0.0]}, "expected": 0.5, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "one shared bin: correlation 1 / sqrt(2 x 2) = 1/2, variation 1/2"},
    {"id": "spectral_variation.uneven", "op": "spectral_variation", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 2.0, 1.0, 1.0], "current": [1.0, 1.0, 1.0, 1.0]}, "expected": 0.05508881747693195, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "cross 5, norms^2 7 and 4: correlation^2 25/28"},
    {"id": "spectral_variation.cut_band", "op": "spectral_variation", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0, 1.0], "current": [3.0, 1.0, 1.0, 1.0], "band": [0.25, 3.0]}, "expected": 0.10077119697410297, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "band [0.25, 3], widths 1/4, 1, 1, 1/2: cross 13/4, norms^2 11/4 and 19/4"},
    {"id": "spectral_variation.span_clipped", "op": "spectral_variation", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0, 1.0], "current": [2.0, 1.0, 1.0, 1.0], "span": [0.0, 3.0]}, "expected": 0.057190958417936644, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "span (0, 3), outer bins halved: densities 2, 1, 1, 2 and 4, 1, 1, 2; cross 8, norms^2 6 and 12"},
    {"id": "spectral_variation.no_power", "op": "spectral_variation", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0, 1.0], "current": [0.0, 0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "each frame needs power in the band"},
    {"id": "spectral_variation.length_mismatch", "op": "spectral_variation", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0], "current": [1.0, 1.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "frequencies and psd must be the same length"},
    {"id": "spectral_variation.band_outside", "op": "spectral_variation", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "previous": [1.0, 1.0, 1.0, 1.0], "current": [1.0, 1.0, 1.0, 1.0], "band": [-1.0, 3.0]}, "error": "invalid_argument", "source": "band [-1, 3] leaves the spectrum [-0.5, 3.5]"}
  ]
}
