{
  "schema": 1,
  "suite": "chao_shen_entropy",
  "description": "The Chao-Shen entropy (conventions: the Chao-Shen entropy; ADR 0554).",
  "cases": [
    {"id": "chao_shen_entropy.one_kind", "op": "chao_shen_entropy", "args": {"samples": [0.0, 4.0]}, "expected": 0.0, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "one kind: C = 1, a = 1: 0"},
    {"id": "chao_shen_entropy.two_twos", "op": "chao_shen_entropy", "args": {"samples": [2.0, 2.0]}, "expected": 0.7393569925972749, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "C = 1, a = 1/2: 2 (ln 2/2)/(15/16) = (16/15) ln 2"},
    {"id": "chao_shen_entropy.two_ones", "op": "chao_shen_entropy", "args": {"samples": [1.0, 1.0]}, "expected": 1.5843364127084465, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "F1 = N, taken as 1: C = 1/2, a = 1/4: (16/7) ln 2"},
    {"id": "chao_shen_entropy.single", "op": "chao_shen_entropy", "args": {"samples": [1.0]}, "expected": 0.0, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "N = 1, F1 taken as 0: a = 1: 0"},
    {"id": "chao_shen_entropy.ramp", "op": "chao_shen_entropy", "args": {"samples": [1.0, 1.0, 2.0, 3.0]}, "expected": 1.6795132679611797, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "N = 7, F1 = 2: C = 5/7"},
    {"id": "chao_shen_entropy.mixed", "op": "chao_shen_entropy", "args": {"samples": [5.0, 1.0, 1.0, 0.0, 2.0]}, "expected": 1.4956209927283917, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "N = 9, F1 = 2: C = 7/9"},
    {"id": "chao_shen_entropy.no_singletons", "op": "chao_shen_entropy", "args": {"samples": [10.0, 20.0, 30.0, 40.0]}, "expected": 1.2798603420498036, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "C = 1: the plug-in shares over 1 - (1 - p)^100"},
    {"id": "chao_shen_entropy.random", "op": "chao_shen_entropy", "args": {"samples": [4.0, 2.0, 1.0, 6.0, 2.0, 1.0, 3.0, 5.0, 1.0, 0.0, 2.0, 5.0, 2.0, 6.0, 2.0, 0.0, 6.0, 6.0, 1.0, 0.0, 2.0, 5.0, 0.0, 1.0, 4.0, 3.0, 0.0, 4.0, 1.0, 6.0, 1.0, 4.0, 3.0, 1.0, 4.0, 4.0, 6.0, 2.0, 2.0, 3.0]}, "expected": 3.570774166240333, "tol": {"abs": 1e-13, "rel": 1e-12}, "source": "40 whole values from random.Random(554).randint(0, 6)"},
    {"id": "chao_shen_entropy.empty", "op": "chao_shen_entropy", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "chao_shen_entropy.negative", "op": "chao_shen_entropy", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "chao_shen_entropy.all_zero", "op": "chao_shen_entropy", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"},
    {"id": "chao_shen_entropy.fraction", "op": "chao_shen_entropy", "args": {"samples": [1.5, 2.0]}, "error": "invalid_argument", "source": "values must be whole numbers"},
    {"id": "chao_shen_entropy.too_large", "op": "chao_shen_entropy", "args": {"samples": [10000000.0, 1.0]}, "error": "invalid_argument", "source": "the total must be at most 10 000 000"}
  ]
}
