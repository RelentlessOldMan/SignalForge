{
  "schema": 1,
  "suite": "spectral_flatness",
  "description": "Spectral flatness (conventions: Spectra, Spectral flatness; ADR 0120).",
  "cases": [
    {"id": "spectral_flatness.flat", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 2.0, 2.0, 2.0]}, "expected": {"geometric_mean": 2.0, "arithmetic_mean": 2.0, "flatness": 1.0, "flatness_db": 0.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: a constant density 2; both means 2, flatness 1, 0 dB"},
    {"id": "spectral_flatness.two_level", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0], "psd": [1.0, 4.0]}, "expected": {"geometric_mean": 2.0, "arithmetic_mean": 2.5, "flatness": 0.8, "flatness_db": -0.9691001300805641}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: G = sqrt(1 x 4) = 2, A = 5/2, flatness 0.8"},
    {"id": "spectral_flatness.three_level", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0, 2.0], "psd": [1.0, 4.0, 16.0]}, "expected": {"geometric_mean": 4.0, "arithmetic_mean": 7.0, "flatness": 0.5714285714285714, "flatness_db": -2.430380486862944}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: G = (1 x 4 x 16)^(1/3) = 4, A = 21/3 = 7"},
    {"id": "spectral_flatness.cut_bins", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 4.0, 4.0, 1.0], "band": [0.0, 2.0]}, "expected": {"geometric_mean": 2.8284271247461903, "arithmetic_mean": 3.25, "flatness": 0.8702852691526739, "flatness_db": -0.603383674829025}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: band [0, 2] overlaps bins 0, 1, 2 by 0.5, 1, 0.5 (W = 2); ln G = (0.5 ln 1 + 1.5 ln 4) / 2, G = 4^(3/4) = 2^1.5; A = (0.5 + 4 + 2) / 2 = 3.25"},
    {"id": "spectral_flatness.zero_bin", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0, 2.0], "psd": [0.0, 4.0, 4.0]}, "expected": {"geometric_mean": 0.0, "arithmetic_mean": 2.6666666666666665, "flatness": 0.0, "flatness_db": "-inf"}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: a zero bin inside makes G = 0, flatness 0, -inf dB; A = 8/3"},
    {"id": "spectral_flatness.zero_bin_outside_band", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 1.0, 4.0, 0.0], "band": [0.5, 2.5]}, "expected": {"geometric_mean": 2.0, "arithmetic_mean": 2.5, "flatness": 0.8, "flatness_db": -0.9691001300805641}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: band [0.5, 2.5] is exactly bins 1 and 2; the zero bins only touch its edges, weight 0, so G = sqrt(1 x 4) = 2, A = 5/2"},
    {"id": "spectral_flatness.span_clipped", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 1.0, 1.0, 2.0], "span": [0.0, 3.0]}, "expected": {"geometric_mean": 1.5874010519681994, "arithmetic_mean": 2.0, "flatness": 0.7937005259840997, "flatness_db": -1.0034333188799378}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: span (0, 3) halves bins 0 and 3, which keep their power 2, so density 4 over width 0.5; W = 3, ln G = (0.5 ln 4 + 0.5 ln 4) / 3, G = 4^(1/3); A = (2 + 1 + 1 + 2) / 3 = 2"},
    {"id": "spectral_flatness.band_reversed", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [2.0, 1.0]}, "error": "invalid_argument", "source": "band low must be below band high"},
    {"id": "spectral_flatness.band_empty", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [1.0, 1.0]}, "error": "invalid_argument", "source": "band low must be below band high"},
    {"id": "spectral_flatness.band_outside", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [0.0, 4.0]}, "error": "invalid_argument", "source": "band [0, 4] leaves the spectrum [-0.5, 3.5]"},
    {"id": "spectral_flatness.band_inf", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [0.0, "inf"]}, "error": "invalid_argument", "source": "band edges must be finite"},
    {"id": "spectral_flatness.no_power", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 0.0, 0.0, 1.0], "band": [-0.5, 1.5]}, "error": "invalid_argument", "source": "the band has no power"},
    {"id": "spectral_flatness.negative_psd", "op": "spectral_flatness", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, -1.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "psd must be non-negative"}
  ]
}
