{
  "schema": 1,
  "suite": "kwoka_dominance_index",
  "description": "The Kwoka dominance index (conventions: the Kwoka dominance index; ADR 0526).",
  "cases": [
    {"id": "kwoka_dominance_index.equal", "op": "kwoka_dominance_index", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "four equal shares: 0"},
    {"id": "kwoka_dominance_index.single", "op": "kwoka_dominance_index", "args": {"samples": [5.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "one value, no pairs: 0"},
    {"id": "kwoka_dominance_index.one_holds_all", "op": "kwoka_dominance_index", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "the largest holds the total: 1"},
    {"id": "kwoka_dominance_index.two", "op": "kwoka_dominance_index", "args": {"samples": [3.0, 1.0]}, "expected": 0.25, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 3/4, 1/4: (1/2)^2 = 1/4"},
    {"id": "kwoka_dominance_index.ramp", "op": "kwoka_dominance_index", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.03, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 4, 3, 2, 1 tenths: 3 (1/10)^2 = 3/100"},
    {"id": "kwoka_dominance_index.three", "op": "kwoka_dominance_index", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.3125, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 3/4, 1/4, 0: 1/4 + 1/16 = 5/16"},
    {"id": "kwoka_dominance_index.halves", "op": "kwoka_dominance_index", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.078125, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "shares 1/2, 1/4, 1/8, 1/8: 1/16 + 1/64 + 0 = 5/64"},
    {"id": "kwoka_dominance_index.random", "op": "kwoka_dominance_index", "args": {"samples": [2.375, 3.375, 2.875, 0.875, 4.625, 6.125, 6.375, 7.625, 0.5, 2.375, 7.625, 3.0, 4.125, 1.5, 7.5, 5.375, 0.25, 5.0, 6.625, 3.875, 2.625, 7.625, 4.625, 4.875, 7.0, 3.375, 7.625, 6.375, 3.625, 1.125]}, "expected": 0.0001870081343977289, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "30 values k/8, k from random.Random(526).randint(0, 64)"},
    {"id": "kwoka_dominance_index.huge", "op": "kwoka_dominance_index", "args": {"samples": [1e+308, 9e+307, 1e+300]}, "expected": 0.22714680702726356, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "values whose sum overflows a double: the result is that of the values scaled down"},
    {"id": "kwoka_dominance_index.empty", "op": "kwoka_dominance_index", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "kwoka_dominance_index.negative", "op": "kwoka_dominance_index", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "kwoka_dominance_index.all_zero", "op": "kwoka_dominance_index", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
