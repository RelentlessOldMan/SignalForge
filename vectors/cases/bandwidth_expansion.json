{
  "schema": 1,
  "suite": "bandwidth_expansion",
  "description": "Bandwidth expansion (conventions: Bandwidth expansion; ADR 0219).",
  "cases": [
    {"id": "bandwidth_expansion.order_three", "op": "bandwidth_expansion", "args": {"coefficients": [1.0, 0.5, -0.3333333333333333, 0.25], "factor": 0.9}, "expected": [1.0, 0.45, -0.27, 0.18225], "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "g = 9/10: [1, 9/20, -27/100, 729/4000]"},
    {"id": "bandwidth_expansion.order_one_pole", "op": "bandwidth_expansion", "args": {"coefficients": [1.0, -0.8], "factor": 0.5}, "expected": [1.0, -0.4], "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "pole 4/5 moves to 2/5: [1, -2/5]"},
    {"id": "bandwidth_expansion.identity", "op": "bandwidth_expansion", "args": {"coefficients": [1.0, -0.16666666666666666, -0.16666666666666666], "factor": 1.0}, "expected": [1.0, -0.16666666666666666, -0.16666666666666666], "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "g = 1 leaves the filter unchanged"},
    {"id": "bandwidth_expansion.any_a0", "op": "bandwidth_expansion", "args": {"coefficients": [2.0, 1.0, 0.5], "factor": 0.5}, "expected": [2.0, 0.5, 0.125], "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "a_0 = 2 is allowed: [2, 1/2, 1/8]"},
    {"id": "bandwidth_expansion.single_tap", "op": "bandwidth_expansion", "args": {"coefficients": [1.0], "factor": 0.75}, "expected": [1.0], "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "[1] stays [1]"},
    {"id": "bandwidth_expansion.complex", "op": "bandwidth_expansion", "args": {"coefficients": {"re": [1.0, 0.0, -0.25], "im": [0.0, 0.5, 0.0]}, "factor": 0.5}, "expected": {"re": [1.0, 0.0, -0.0625], "im": [0.0, 0.25, 0.0]}, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "complex: [1, 0.25j, -0.0625]"},
    {"id": "bandwidth_expansion.zero_factor", "op": "bandwidth_expansion", "args": {"coefficients": [1.0, 0.5], "factor": 0.0}, "error": "invalid_argument", "source": "factor must be in (0, 1]"},
    {"id": "bandwidth_expansion.factor_above_one", "op": "bandwidth_expansion", "args": {"coefficients": [1.0, 0.5], "factor": 1.5}, "error": "invalid_argument", "source": "factor must be in (0, 1]"},
    {"id": "bandwidth_expansion.nan_factor", "op": "bandwidth_expansion", "args": {"coefficients": [1.0, 0.5], "factor": "nan"}, "error": "invalid_argument", "source": "factor must be in (0, 1]"},
    {"id": "bandwidth_expansion.empty", "op": "bandwidth_expansion", "args": {"coefficients": [], "factor": 0.9}, "error": "invalid_argument", "source": "coefficients must not be empty"},
    {"id": "bandwidth_expansion.nan_coefficient", "op": "bandwidth_expansion", "args": {"coefficients": [1.0, "nan"], "factor": 0.9}, "error": "invalid_argument", "source": "coefficients must be finite"}
  ]
}
