{
  "schema": 1,
  "suite": "temporal_centroid",
  "description": "Temporal centroid and spread (conventions: Temporal centroid; ADR 0147).",
  "cases": [
    {"id": "temporal_centroid.impulse", "op": "temporal_centroid", "args": {"samples": [0.0, 0.0, 5.0, 0.0], "sample_rate": 1.0}, "expected": {"centroid": 2.0, "spread": 0.0}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "all energy at n = 2: centroid 2, spread 0"},
    {"id": "temporal_centroid.symmetric", "op": "temporal_centroid", "args": {"samples": [1.0, 2.0, 1.0], "sample_rate": 1.0}, "expected": {"centroid": 1.0, "spread": 0.5773502691896258}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "energies 1, 4, 1: centroid 1; variance (1 + 0 + 1)/6 = 1/3"},
    {"id": "temporal_centroid.ramp", "op": "temporal_centroid", "args": {"samples": [1.0, 2.0, 3.0], "sample_rate": 1.0}, "expected": {"centroid": 1.5714285714285714, "spread": 0.6226998490772392}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "energies 1, 4, 9 sum 14: centroid (0 + 4 + 18)/14 = 11/7; second moment (0 + 4 + 36)/14 = 20/7, less (11/7)^2, is 19/49"},
    {"id": "temporal_centroid.complex", "op": "temporal_centroid", "args": {"samples": {"re": [3.0, 0.0, 0.0], "im": [4.0, 0.0, 1.0]}, "sample_rate": 1.0}, "expected": {"centroid": 0.07692307692307693, "spread": 0.38461538461538464}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "energies |3+4i|^2 = 25, 0, |i|^2 = 1 sum 26: centroid 2/26 = 1/13; second moment 4/26 = 2/13, less 1/169, is 25/169"},
    {"id": "temporal_centroid.sample_rate", "op": "temporal_centroid", "args": {"samples": [1.0, 1.0, 1.0, 1.0], "sample_rate": 4.0}, "expected": {"centroid": 0.375, "spread": 0.2795084971874737}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "equal energies at t = 0, 1/4, 1/2, 3/4: mean 3/8; variance of n is 5/4, over 4^2 is 5/64"},
    {"id": "temporal_centroid.empty", "op": "temporal_centroid", "args": {"samples": [], "sample_rate": 1.0}, "error": "invalid_argument", "source": "needs at least one sample"},
    {"id": "temporal_centroid.silent", "op": "temporal_centroid", "args": {"samples": [0.0, 0.0], "sample_rate": 1.0}, "error": "invalid_argument", "source": "the energy is 0"},
    {"id": "temporal_centroid.nan", "op": "temporal_centroid", "args": {"samples": [1.0, "nan"], "sample_rate": 1.0}, "error": "invalid_argument", "source": "samples must be finite"},
    {"id": "temporal_centroid.zero_rate", "op": "temporal_centroid", "args": {"samples": [1.0, 1.0], "sample_rate": 0.0}, "error": "invalid_argument", "source": "sample_rate must be positive"},
    {"id": "temporal_centroid.negative_rate", "op": "temporal_centroid", "args": {"samples": [1.0, 1.0], "sample_rate": -2.0}, "error": "invalid_argument", "source": "sample_rate must be positive"},
    {"id": "temporal_centroid.infinite_rate", "op": "temporal_centroid", "args": {"samples": [1.0, 1.0], "sample_rate": "inf"}, "error": "invalid_argument", "source": "sample_rate must be finite"},
    {"id": "temporal_centroid.huge", "op": "temporal_centroid", "args": {"samples": [1.0715086071862673e+301, 2.1430172143725346e+301, 3.214525821558802e+301], "sample_rate": 1.0}, "expected": {"centroid": 1.5714285714285714, "spread": 0.6226998490772392}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "case ramp times 2^1000: squares of the samples overflow a double, but an energy-weighted time is unchanged by a scale, so the same value"},
    {"id": "temporal_centroid.tiny", "op": "temporal_centroid", "args": {"samples": [9.332636185032189e-302, 1.8665272370064378e-301, 2.7997908555096566e-301], "sample_rate": 1.0}, "expected": {"centroid": 1.5714285714285714, "spread": 0.6226998490772392}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "case ramp times 2^-1000: squares of the samples underflow to 0, but an energy-weighted time is unchanged by a scale, so the same value"},
    {"id": "temporal_centroid.huge_complex", "op": "temporal_centroid", "args": {"samples": {"re": [3.214525821558802e+301, 0.0, 0.0], "im": [4.2860344287450693e+301, 0.0, 1.0715086071862673e+301]}, "sample_rate": 1.0}, "expected": {"centroid": 0.07692307692307693, "spread": 0.38461538461538464}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "case complex times 2^1000: squares of the samples overflow a double, but an energy-weighted time is unchanged by a scale, so the same value"},
    {"id": "temporal_centroid.tiny_complex", "op": "temporal_centroid", "args": {"samples": {"re": [2.7997908555096566e-301, 0.0, 0.0], "im": [3.7330544740128755e-301, 0.0, 9.332636185032189e-302]}, "sample_rate": 1.0}, "expected": {"centroid": 0.07692307692307693, "spread": 0.38461538461538464}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "case complex times 2^-1000: squares of the samples underflow to 0, but an energy-weighted time is unchanged by a scale, so the same value"}
  ]
}
