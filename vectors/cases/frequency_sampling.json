{
  "schema": 1,
  "suite": "frequency_sampling",
  "description": "Frequency-sampling FIR design: a piecewise-linear gain sampled from 0 to fs/2, inverse DFT with linear phase, symmetric window (conventions: FIR filters, Frequency-sampling design).",
  "cases": [
    {"id": "fir_frequency_sampling.flat_is_impulse", "op": "fir_frequency_sampling", "args": {"num_taps": 7, "frequencies": [0, 0.5], "gains": [2, 2], "sample_rate": 1.0}, "expected": [0, 0, 0, 2, 0, 0, 0], "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: a flat gain 2 has sum_{k=0}^{L-1} e^{2 pi i k t/L} = L delta(t) at integer t, so d = 2 delta, and the symmetric Hamming window's centre is 1"},
    {"id": "fir_frequency_sampling.ramp_3", "op": "fir_frequency_sampling", "args": {"num_taps": 3, "frequencies": [0, 0.5], "gains": [1, 0], "sample_rate": 1.0, "window": "rectangular", "num_points": 3}, "expected": [0.25, 0.5, 0.25], "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: K = 3, L = 4: G = [1, 1/2, 0]; d(t) = (1/4)(1 + cos(pi t/2)) at t = -1, 0, 1"},
    {"id": "fir_frequency_sampling.even_2", "op": "fir_frequency_sampling", "args": {"num_taps": 2, "frequencies": [0, 0.25, 0.5], "gains": [1, 1, 0], "sample_rate": 1.0, "window": "rectangular", "num_points": 3}, "expected": [0.6035533905932737, 0.6035533905932737], "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: K = 3, L = 4: G = [1, 1, 0]; d(+-1/2) = (1/4)(1 + 2 cos(pi/4))"},
    {"id": "fir_frequency_sampling.one_tap_two_points", "op": "fir_frequency_sampling", "args": {"num_taps": 1, "frequencies": [0, 0.5], "gains": [1, 3], "sample_rate": 1.0, "num_points": 2}, "expected": [2.0], "tol": {"abs": 1e-12, "rel": 0}, "source": "by hand: K = 2, L = 2, N = 1: d(0) = (G_0 + G_1)/2"},
