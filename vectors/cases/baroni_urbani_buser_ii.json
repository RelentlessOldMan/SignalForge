    {"id": "baroni_urbani_buser_ii.independent", "op": "baroni_urbani_buser_ii", "args": {"truth": [1.0, 1.0, 0.0, 0.0], "decision": [1.0, 0.0, 1.0, 0.0]}, "expected": 0.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "one of each cell: r 1, (1 + 1 - 2)/(1 + 3) = 0"},
