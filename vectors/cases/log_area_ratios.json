{
  "schema": 1,
  "suite": "log_area_ratios",
  "description": "Log-area ratios (conventions: Log-area ratios; ADR 0215).",
  "cases": [
    {"id": "reflection_to_lar.closed_forms", "op": "reflection_to_lar", "args": {"reflection": [0.0, 0.3333333333333333, 0.6, -0.8, 0.9, -0.3333333333333333]}, "expected": [0.0, 0.6931471805599453, 1.3862943611198906, -2.1972245773362196, 2.9444389791664403, -0.6931471805599453], "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "ln((1 + k)/(1 - k)): 0 -> 0, 1/3 -> ln 2, 3/5 -> ln 4, -4/5 -> -ln 9, 9/10 -> ln 19, -1/3 -> -ln 2"},
    {"id": "lar_to_reflection.closed_forms", "op": "lar_to_reflection", "args": {"lar": [0.0, 0.6931471805599453, 1.3862943611198906, -2.1972245773362196, 2.9444389791664403, -0.6931471805599453]}, "expected": [0.0, 0.3333333333333333, 0.6, -0.8, 0.9, -0.3333333333333333], "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "the inverse: ln((1 + k)/(1 - k)): 0 -> 0, 1/3 -> ln 2, 3/5 -> ln 4, -4/5 -> -ln 9, 9/10 -> ln 19, -1/3 -> -ln 2"},
    {"id": "lar_to_reflection.large", "op": "lar_to_reflection", "args": {"lar": [30.0, -30.0]}, "expected": [0.9999999999998129, -0.9999999999998129], "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "tanh(15) = (1 - e^-30)/(1 + e^-30), odd"},
    {"id": "reflection_to_lar.near_one", "op": "reflection_to_lar", "args": {"reflection": [0.99]}, "expected": [5.293304824724492], "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "ln(1.99/0.01) = ln 199"},
    {"id": "reflection_to_lar.unit_k", "op": "reflection_to_lar", "args": {"reflection": [0.5, -1.0]}, "error": "invalid_argument", "source": "every |k| < 1"},
    {"id": "reflection_to_lar.empty", "op": "reflection_to_lar", "args": {"reflection": []}, "error": "invalid_argument", "source": "reflection must not be empty"},
    {"id": "reflection_to_lar.nan", "op": "reflection_to_lar", "args": {"reflection": ["nan"]}, "error": "invalid_argument", "source": "reflection must be finite"},
    {"id": "lar_to_reflection.empty", "op": "lar_to_reflection", "args": {"lar": []}, "error": "invalid_argument", "source": "lar must not be empty"},
    {"id": "lar_to_reflection.inf", "op": "lar_to_reflection", "args": {"lar": [1.0, "inf"]}, "error": "invalid_argument", "source": "lar must be finite"}
  ]
}
