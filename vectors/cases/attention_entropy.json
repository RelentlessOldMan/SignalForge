{
  "schema": 1,
  "suite": "attention_entropy",
  "description": "Attention entropy (conventions: Attention entropy; ADR 0346).",
  "cases": [
    {"id": "attention_entropy.zigzag", "op": "attention_entropy", "args": {"samples": [0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0, 0.0, 1.0]}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "0, 1 alternating: every interval is 2 or 1, one length per set, so 0"},
    {"id": "attention_entropy.two_lengths", "op": "attention_entropy", "args": {"samples": [0.0, 2.0, 1.0, 3.0, 0.0, 0.0, 4.0, 1.0, 5.0, 0.0]}, "expected": 0.3182570841474064, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "maxima at 1, 3, 6, 8 and minima at 2, 7 (the plateau at 4, 5 is neither)"},
    {"id": "attention_entropy.plateaus", "op": "attention_entropy", "args": {"samples": [1.0, 1.0, 3.0, 2.0, 2.0, 0.0, 4.0, 4.0, 1.0, 5.0, 0.5, 2.0, -1.0, 3.0]}, "expected": 0.6506724213610959, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "plateaus at peaks and troughs are not key points"},
