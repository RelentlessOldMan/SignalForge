{
  "schema": 1,
  "suite": "power_ccdf",
  "description": "Power CCDF and the level at a probability (conventions: Power CCDF; ADR 0119).",
  "cases": [
    {"id": "power_ccdf.real_counts", "op": "power_ccdf", "args": {"samples": [1.0, -1.0, 2.0, 0.0, 3.0, -1.0, 1.0, 1.0], "levels_db": [0.0, -3.0, -10.0, 3.0, 6.0, 7.0, -20.0]}, "expected": {"mean_power": 2.25, "levels_db": [0.0, -3.0, -10.0, 3.0, 6.0, 7.0, -20.0], "probabilities": [0.25, 0.25, 0.875, 0.125, 0.125, 0.0, 0.875]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: powers 1, 1, 4, 0, 9, 1, 1, 1, mean 2.25; above 2.25 (0 dB): 4 and 9; -3 dB (1.13): 4, 9; -10 dB (0.225): all but the 0; 3 dB (4.49): 9; 6 dB (8.96): 9; 7 dB (11.3): none; -20 dB (0.0225): all but the 0"},
    {"id": "power_ccdf.complex_counts", "op": "power_ccdf", "args": {"samples": {"re": [1.0, 2.0, 0.0, 0.0, -1.0, 0.0], "im": [1.0, 0.0, 0.0, -1.0, 2.0, 0.0]}, "levels_db": [0.0, 1.0, 4.0, -5.0]}, "expected": {"mean_power": 2.0, "levels_db": [0.0, 1.0, 4.0, -5.0], "probabilities": [0.3333333333333333, 0.3333333333333333, 0.0, 0.6666666666666666]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: powers 2, 4, 0, 1, 5, 0, mean 2; above 2 (0 dB, strict): 4 and 5; 1 dB (2.52): 4, 5; 4 dB (5.02): none; -5 dB (0.632): 2, 4, 1, 5"},
    {"id": "power_ccdf.constant_envelope_tie", "op": "power_ccdf", "args": {"samples": [1.0, -1.0, 1.0, -1.0], "levels_db": [0.0, -0.5, 0.5]}, "expected": {"mean_power": 1.0, "levels_db": [0.0, -0.5, 0.5], "probabilities": [0.0, 1.0, 0.0]}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: every power is 1, the mean; strict, so none above 0 dB, all above -0.5 dB"},
    {"id": "power_ccdf_level.real_peak", "op": "power_ccdf_level", "args": {"samples": [1.0, -1.0, 2.0, 0.0, 3.0, -1.0, 1.0, 1.0], "probability": 0.1}, "expected": 6.020599913279624, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: floor(0.1 x 8) = 0, the largest power 9; 10 log10(9 / 2.25) = 10 log10 4 (PAPR)"},
    {"id": "power_ccdf_level.real_second", "op": "power_ccdf_level", "args": {"samples": [1.0, -1.0, 2.0, 0.0, 3.0, -1.0, 1.0, 1.0], "probability": 0.125}, "expected": 2.498774732165999, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: floor(0.125 x 8) = 1, the second largest power 4; 10 log10(4 / 2.25)"},
    {"id": "power_ccdf_level.real_tie", "op": "power_ccdf_level", "args": {"samples": [1.0, -1.0, 2.0, 0.0, 3.0, -1.0, 1.0, 1.0], "probability": 0.3}, "expected": -3.521825181113625, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: floor(0.3 x 8) = 2, the third largest power 1 (a tie with four others); 10 log10(1 / 2.25)"},
    {"id": "power_ccdf_level.real_zero", "op": "power_ccdf_level", "args": {"samples": [1.0, -1.0, 2.0, 0.0, 3.0, -1.0, 1.0, 1.0], "probability": 0.9}, "expected": "-inf", "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: floor(0.9 x 8) = 7, the eighth largest power 0, so -inf"},
    {"id": "power_ccdf_level.complex_half", "op": "power_ccdf_level", "args": {"samples": {"re": [1.0, 2.0, 0.0, 0.0, -1.0, 0.0], "im": [1.0, 0.0, 0.0, -1.0, 2.0, 0.0]}, "probability": 0.5}, "expected": -3.010299956639812, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "by hand: sorted powers 5, 4, 2, 1, 0, 0; floor(0.5 x 6) = 3, the fourth, 1; 10 log10(1 / 2)"},
    {"id": "power_ccdf.empty", "op": "power_ccdf", "args": {"samples": [], "levels_db": [0.0]}, "error": "invalid_argument", "source": "at least one sample"},
    {"id": "power_ccdf.all_zero", "op": "power_ccdf", "args": {"samples": [0.0, 0.0], "levels_db": [0.0]}, "error": "invalid_argument", "source": "the mean power must be positive"},
    {"id": "power_ccdf.sample_nan", "op": "power_ccdf", "args": {"samples": [1.0, "nan"], "levels_db": [0.0]}, "error": "invalid_argument", "source": "samples must be finite"},
    {"id": "power_ccdf.no_levels", "op": "power_ccdf", "args": {"samples": [1.0, -1.0, 2.0, 0.0, 3.0, -1.0, 1.0, 1.0], "levels_db": []}, "error": "invalid_argument", "source": "at least one level"},
    {"id": "power_ccdf.level_inf", "op": "power_ccdf", "args": {"samples": [1.0, -1.0, 2.0, 0.0, 3.0, -1.0, 1.0, 1.0], "levels_db": [0.0, "inf"]}, "error": "invalid_argument", "source": "levels must be finite"},
    {"id": "power_ccdf_level.probability_zero", "op": "power_ccdf_level", "args": {"samples": [1.0, -1.0, 2.0, 0.0, 3.0, -1.0, 1.0, 1.0], "probability": 0.0}, "error": "invalid_argument", "source": "probability must be in (0, 1)"},
    {"id": "power_ccdf_level.probability_one", "op": "power_ccdf_level", "args": {"samples": [1.0, -1.0, 2.0, 0.0, 3.0, -1.0, 1.0, 1.0], "probability": 1.0}, "error": "invalid_argument", "source": "probability must be in (0, 1)"},
    {"id": "power_ccdf_level.all_zero", "op": "power_ccdf_level", "args": {"samples": [0.0, 0.0], "probability": 0.5}, "error": "invalid_argument", "source": "the mean power must be positive"}
  ]
}
