{
  "schema": 1,
  "suite": "herfindahl_index",
  "description": "The Herfindahl index (conventions: the Herfindahl index; ADR 0523).",
  "cases": [
    {"id": "herfindahl_index.equal", "op": "herfindahl_index", "args": {"samples": [2.0, 2.0, 2.0, 2.0]}, "expected": 0.25, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "four equal shares: 4 (1/4)^2 = 1/4"},
    {"id": "herfindahl_index.single", "op": "herfindahl_index", "args": {"samples": [5.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "one value: 1"},
    {"id": "herfindahl_index.one_holds_all", "op": "herfindahl_index", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 1.0, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "one of four holds the total: 1"},
    {"id": "herfindahl_index.ramp", "op": "herfindahl_index", "args": {"samples": [4.0, 1.0, 3.0, 2.0]}, "expected": 0.3, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "(1 + 4 + 9 + 16)/100 = 3/10"},
    {"id": "herfindahl_index.three", "op": "herfindahl_index", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.625, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "(9 + 0 + 1)/16 = 5/8"},
    {"id": "herfindahl_index.halves", "op": "herfindahl_index", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.34375, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "(1/4 + 1/16 + 1/16 + 1)/4 = 11/32"},
    {"id": "herfindahl_index.random", "op": "herfindahl_index", "args": {"samples": [4.5, 6.0, 2.5, 7.5, 2.625, 0.125, 6.625, 6.25, 7.625, 5.75, 6.25, 7.5, 8.0, 4.0, 3.25, 7.625, 4.125, 0.625, 2.5, 6.375, 4.75, 0.375, 3.375, 3.0, 3.875, 6.25, 0.75, 4.875, 1.5, 3.125]}, "expected": 0.04280719222156386, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "30 values k/8, k from random.Random(523).randint(0, 64)"},
    {"id": "herfindahl_index.huge", "op": "herfindahl_index", "args": {"samples": [1e+308, 9e+307, 1e+300]}, "expected": 0.5013850362735093, "tol": {"abs": 1e-15, "rel": 1e-14}, "source": "values whose sum overflows a double: the result is that of the values scaled down"},
    {"id": "herfindahl_index.empty", "op": "herfindahl_index", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "herfindahl_index.negative", "op": "herfindahl_index", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "herfindahl_index.all_zero", "op": "herfindahl_index", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
