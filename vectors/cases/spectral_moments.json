{
  "schema": 1,
  "suite": "spectral_moments",
  "description": "Spectral centroid and RMS bandwidth (conventions: Spectra, Spectral centroid and RMS bandwidth; ADR 0121).",
  "cases": [
    {"id": "spectral_moments.flat", "op": "spectral_moments", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0]}, "expected": {"power": 4.0, "centroid": 1.5, "rms_bandwidth": 1.1547005383792515}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "flat over [-0.5, 3.5]: power 4, centroid 1.5, RMS bandwidth 4/sqrt(12)"},
    {"id": "spectral_moments.single_bin", "op": "spectral_moments", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 1.0, 0.0, 0.0]}, "expected": {"power": 1.0, "centroid": 1.0, "rms_bandwidth": 0.28867513459481287}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "one bin of width 1 at 1 Hz: power 1, centroid 1, RMS bandwidth 1/sqrt(12)"},
    {"id": "spectral_moments.two_ends", "op": "spectral_moments", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 0.0, 0.0, 1.0]}, "expected": {"power": 2.0, "centroid": 1.5, "rms_bandwidth": 1.5275252316519468}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "bins at 0 and 3: centroid 1.5; each contributes the integral of (f - 1.5)^2 over its bin, 7/3, so the variance is 7/3"},
    {"id": "spectral_moments.asymmetric", "op": "spectral_moments", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 0.0, 0.0]}, "expected": {"power": 3.0, "centroid": 0.6666666666666666, "rms_bandwidth": 0.5527707983925667}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "power 3; centroid (0 + 2) / 3 = 2/3; variance (19/36 + 14/36) / 3 = 11/36"},
    {"id": "spectral_moments.cut_band", "op": "spectral_moments", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [0.0, 2.0]}, "expected": {"power": 2.0, "centroid": 1.0, "rms_bandwidth": 0.5773502691896257}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "flat, band [0, 2]: power 2, centroid 1, RMS bandwidth 2/sqrt(12)"},
    {"id": "spectral_moments.span_clipped", "op": "spectral_moments", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 1.0, 1.0, 2.0], "span": [0.0, 3.0]}, "expected": {"power": 6.0, "centroid": 1.5, "rms_bandwidth": 1.0801234497346435}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "span (0, 3) halves bins 0 and 3, which keep power 2 at density 4; power 6, centroid 1.5, variance (2 x 9.5/3 + 2 x 1/3) / 6 = 7/6"},
    {"id": "spectral_moments.offset_axis", "op": "spectral_moments", "args": {"frequencies": [1000.0, 1001.0, 1002.0], "psd": [1.0, 4.0, 1.0]}, "expected": {"power": 6.0, "centroid": 1001.0, "rms_bandwidth": 0.6454972243679028}, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "symmetric about 1001 Hz: power 6, centroid 1001, variance (4/12 + 2 x (1/12 + 1)) / 6 = 5/12"},
    {"id": "spectral_moments.band_reversed", "op": "spectral_moments", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [2.0, 1.0]}, "error": "invalid_argument", "source": "band low must be below band high"},
    {"id": "spectral_moments.band_outside", "op": "spectral_moments", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [-1.0, 3.0]}, "error": "invalid_argument", "source": "band [-1, 3] leaves the spectrum [-0.5, 3.5]"},
    {"id": "spectral_moments.band_nan", "op": "spectral_moments", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": ["nan", 1.0]}, "error": "invalid_argument", "source": "band edges must be finite"},
    {"id": "spectral_moments.no_power", "op": "spectral_moments", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [0.0, 0.0, 1.0, 0.0], "band": [-0.5, 1.5]}, "error": "invalid_argument", "source": "the band has no power"},
    {"id": "spectral_moments.one_bin", "op": "spectral_moments", "args": {"frequencies": [0.0], "psd": [1.0]}, "error": "invalid_argument", "source": "need at least two bins"}
  ]
}
