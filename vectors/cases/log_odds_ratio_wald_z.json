    {"id": "log_odds_ratio_wald_z.no_fn", "op": "log_odds_ratio_wald_z", "args": {"truth": [1.0, 0.0, 1.0, 0.0], "decision": [1.0, 1.0, 1.0, 0.0]}, "error": "invalid_argument", "source": "every truth 1 caught: FN = 0"},
    {"id": "log_odds_ratio_wald_z.decision_all_one", "op": "log_odds_ratio_wald_z", "args": {"truth": [1.0, 0.0, 1.0], "decision": [1.0, 1.0, 1.0]}, "error": "invalid_argument", "source": "the decision has no 0: TN = 0"}
