    {"id": "log_odds_ratio_wald_z.not_binary", "op": "log_odds_ratio_wald_z", "args": {"truth": [1.0, 0.0, 1.0], "decision": [1.0, 0.5, 0.0]}, "error": "invalid_argument", "source": "values must be 0 or 1"},
    {"id": "log_odds_ratio_wald_z.no_tp", "op": "log_odds_ratio_wald_z", "args": {"truth": [1.0, 0.0, 1.0, 0.0], "decision": [0.0, 1.0, 0.0, 1.0]}, "error": "invalid_argument", "source": "opposite records: TP = 0"},
