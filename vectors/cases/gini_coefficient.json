{
  "schema": 1,
  "suite": "gini_coefficient",
  "description": "The Gini coefficient (conventions: the Gini coefficient; ADR 0510).",
  "cases": [
    {"id": "gini_coefficient.equal", "op": "gini_coefficient", "args": {"samples": [2.0, 2.0, 2.0]}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "every value equal: 0"},
    {"id": "gini_coefficient.single", "op": "gini_coefficient", "args": {"samples": [5.0]}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "one value: 1 - 1/1 = 0"},
    {"id": "gini_coefficient.one_holds_all", "op": "gini_coefficient", "args": {"samples": [0.0, 0.0, 0.0, 4.0]}, "expected": 0.75, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "one of four holds the total: 1 - 1/4"},
    {"id": "gini_coefficient.two", "op": "gini_coefficient", "args": {"samples": [1.0, 3.0]}, "expected": 0.25, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "pair sum 2 2 = 4, over 2 4 2 = 16: 1/4"},
    {"id": "gini_coefficient.ramp", "op": "gini_coefficient", "args": {"samples": [1.0, 2.0, 3.0, 4.0]}, "expected": 0.25, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "pair sum 2 10 = 20, over 2 16 5/2 = 80: 1/4"},
    {"id": "gini_coefficient.unsorted", "op": "gini_coefficient", "args": {"samples": [3.0, 0.0, 1.0]}, "expected": 0.5, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "pair sum 2 6 = 12, over 2 9 4/3 = 24: 1/2"},
    {"id": "gini_coefficient.halves", "op": "gini_coefficient", "args": {"samples": [0.5, 0.25, 0.25, 1.0]}, "expected": 0.3125, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "pair sum 2 (1/4 + 1/4 + 1/2 + 0 + 3/4 + 3/4) = 5, over 2 4 2 = 16: 5/16"},
    {"id": "gini_coefficient.random", "op": "gini_coefficient", "args": {"samples": [4.5, 6.625, 6.5, 1.625, 1.125, 2.375, 5.25, 2.875, 2.5, 5.875, 4.375, 6.625, 3.75, 4.5, 5.25, 6.25, 6.875, 0.125, 4.0, 1.375, 1.25, 1.5, 6.5, 3.75, 3.375, 7.0, 2.5, 7.125, 5.0, 4.5]}, "expected": 0.2804471137804471, "tol": {"abs": 1e-14, "rel": 1e-14}, "source": "30 values k/8, k from random.Random(510).randint(0, 64)"},
    {"id": "gini_coefficient.empty", "op": "gini_coefficient", "args": {"samples": []}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "gini_coefficient.negative", "op": "gini_coefficient", "args": {"samples": [1.0, -0.5, 2.0]}, "error": "invalid_argument", "source": "values must be at least 0"},
    {"id": "gini_coefficient.all_zero", "op": "gini_coefficient", "args": {"samples": [0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "the total must be positive"}
  ]
}
