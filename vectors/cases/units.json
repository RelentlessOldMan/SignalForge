{
  "schema": 1,
  "suite": "units",
  "description": "dB, dBm and voltage/power conversions. Expected values are the closed forms in the source field, evaluated in double precision.",
  "cases": [
    {"id": "lin_to_db.1000", "op": "lin_to_db", "args": {"ratio": 1000}, "expected": 30.0, "source": "10*log10(1000) = 30"},
    {"id": "lin_to_db.2", "op": "lin_to_db", "args": {"ratio": 2}, "expected": 3.010299956639812, "source": "10*log10(2)"},
    {"id": "lin_to_db.1", "op": "lin_to_db", "args": {"ratio": 1}, "expected": 0.0, "source": "10*log10(1) = 0"},
    {"id": "lin_to_db.zero", "op": "lin_to_db", "args": {"ratio": 0}, "expected": "-inf", "source": "conventions: zero gives -inf"},
    {"id": "lin_to_db.negative", "op": "lin_to_db", "args": {"ratio": -1}, "error": "invalid_argument", "source": "conventions: negative ratio is an error"},
    {"id": "db_to_lin.30", "op": "db_to_lin", "args": {"db": 30}, "expected": 1000.0, "source": "10^(30/10)"},
    {"id": "db_to_lin.3", "op": "db_to_lin", "args": {"db": 3}, "expected": 1.9952623149688795, "source": "10^0.3"},
    {"id": "amp_to_db.2", "op": "amp_to_db", "args": {"ratio": 2}, "expected": 6.020599913279624, "source": "20*log10(2)"},
    {"id": "amp_to_db.10", "op": "amp_to_db", "args": {"ratio": 10}, "expected": 20.0, "source": "20*log10(10) = 20"},
    {"id": "amp_to_db.negative", "op": "amp_to_db", "args": {"ratio": -0.5}, "error": "invalid_argument", "source": "conventions"},
    {"id": "db_to_amp.minus3", "op": "db_to_amp", "args": {"db": -3}, "expected": 0.7079457843841379, "source": "10^(-3/20)"},
    {"id": "db_to_amp.20", "op": "db_to_amp", "args": {"db": 20}, "expected": 10.0, "source": "10^(20/20)"},
    {"id": "w_to_dbm.1W", "op": "w_to_dbm", "args": {"watts": 1}, "expected": 30.0, "source": "1 W = 1000 mW = 30 dBm"},
    {"id": "w_to_dbm.1mW", "op": "w_to_dbm", "args": {"watts": 0.001}, "expected": 0.0, "source": "1 mW = 0 dBm"},
    {"id": "w_to_dbm.zero", "op": "w_to_dbm", "args": {"watts": 0}, "expected": "-inf", "source": "conventions"},
    {"id": "dbm_to_w.30", "op": "dbm_to_w", "args": {"dbm": 30}, "expected": 1.0, "source": "30 dBm = 1 W"},
    {"id": "dbm_to_w.minus30", "op": "dbm_to_w", "args": {"dbm": -30}, "expected": 1e-6, "tol": {"abs": 0, "rel": 1e-12}, "source": "-30 dBm = 1 uW"},
    {"id": "vrms_to_dbm.1V.50ohm", "op": "vrms_to_dbm", "args": {"vrms": 1, "impedance": 50}, "expected": 13.010299956639813, "source": "10*log10(1^2/50/1e-3) = 10*log10(20)"},
    {"id": "vrms_to_dbm.default_impedance", "op": "vrms_to_dbm", "args": {"vrms": 0.7071067811865476}, "expected": 10.0, "source": "(1/sqrt 2)^2/50 = 10 mW; default impedance is 50 ohm"},
    {"id": "vrms_to_dbm.1V.600ohm", "op": "vrms_to_dbm", "args": {"vrms": 1, "impedance": 600}, "expected": 2.218487496163564, "source": "10*log10(1/600/1e-3)"},
    {"id": "vrms_to_dbm.zero_impedance", "op": "vrms_to_dbm", "args": {"vrms": 1, "impedance": 0}, "error": "invalid_argument", "source": "impedance must be positive"},
    {"id": "dbm_to_vrms.0dBm", "op": "dbm_to_vrms", "args": {"dbm": 0}, "expected": 0.22360679774997896, "source": "sqrt(1e-3 * 50)"},
    {"id": "dbm_to_vrms.13dBm", "op": "dbm_to_vrms", "args": {"dbm": 13.010299956639813, "impedance": 50}, "expected": 1.0, "source": "inverse of vrms_to_dbm.1V.50ohm"},
    {
      "id": "vrms_to_dbm.infinite_impedance", "op": "vrms_to_dbm",
      "args": {"vrms": 1, "impedance": "inf"},
      "error": "invalid_argument",
      "source": "impedance must be positive and finite"
    },
    {
      "id": "dbm_to_vrms.nan_impedance", "op": "dbm_to_vrms",
      "args": {"dbm": 0, "impedance": "nan"},
      "error": "invalid_argument",
      "source": "impedance must be positive and finite"
    }
  ]
}
