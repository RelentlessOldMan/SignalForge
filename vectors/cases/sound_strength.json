{
  "schema": 1,
  "suite": "sound_strength",
  "description": "Sound strength (conventions: Sound strength; ADR 0178).",
  "cases": [
    {"id": "sound_strength.itself", "op": "sound_strength", "args": {"impulse_response": [0.0, 0.5, 0.25], "reference": [0.0, 0.5, 0.25]}, "expected": 0.0, "tol": {"abs": 1e-13, "rel": 1e-13}, "source": "the reference against itself: 0 dB"},
    {"id": "sound_strength.doubled", "op": "sound_strength", "args": {"impulse_response": [0.0, 1.0, 0.5], "reference": [0.0, 0.5, 0.25]}, "expected": 6.020599913279624, "tol": {"abs": 1e-13, "rel": 1e-13}, "source": "twice the amplitude: 10 log10 4 = 20 log10 2"},
    {"id": "sound_strength.unequal_lengths", "op": "sound_strength", "args": {"impulse_response": [1.0, 0.5, 0.5, 0.25, 0.25, 0.25], "reference": [0.0, 0.5, 0.25]}, "expected": 7.323937598229685, "tol": {"abs": 1e-13, "rel": 1e-13}, "source": "6 samples against 3: 1 + 1/4 + 1/4 + 3/16 = 27/16 against 1/4 + 1/16 = 5/16, ratio 27/5"},
    {"id": "sound_strength.room", "op": "sound_strength", "args": {"impulse_response": [1.0, 0.8, 0.6, 0.4, 0.2], "reference": [0.3]}, "expected": 13.881801713828814, "tol": {"abs": 1e-13, "rel": 1e-13}, "source": "1 + 0.64 + 0.36 + 0.16 + 0.04 = 2.2 against 0.09: 10 log10(220/9)"},
    {"id": "sound_strength.complex", "op": "sound_strength", "args": {"impulse_response": {"re": [3.0, 0.0], "im": [4.0, 1.0]}, "reference": {"re": [1.0], "im": [0.0]}}, "expected": 14.14973347970818, "tol": {"abs": 1e-13, "rel": 1e-13}, "source": "|h|^2 = 25 + 1 against 1: 10 log10 26"},
    {"id": "sound_strength.silent", "op": "sound_strength", "args": {"impulse_response": [0.0, 0.0], "reference": [0.0, 0.5, 0.25]}, "expected": "-inf", "tol": {"abs": 1e-13, "rel": 1e-13}, "source": "no energy: -inf"},
    {"id": "sound_strength.empty", "op": "sound_strength", "args": {"impulse_response": [], "reference": [0.5]}, "error": "invalid_argument", "source": "impulse_response must not be empty"},
    {"id": "sound_strength.empty_reference", "op": "sound_strength", "args": {"impulse_response": [1.0, 0.5], "reference": []}, "error": "invalid_argument", "source": "reference must not be empty"},
    {"id": "sound_strength.silent_reference", "op": "sound_strength", "args": {"impulse_response": [1.0, 0.5], "reference": [0.0, 0.0]}, "error": "invalid_argument", "source": "reference must not be all zero"},
    {"id": "sound_strength.nan", "op": "sound_strength", "args": {"impulse_response": [1.0, "nan"], "reference": [0.5]}, "error": "invalid_argument", "source": "impulse_response must be finite"},
    {"id": "sound_strength.inf_reference", "op": "sound_strength", "args": {"impulse_response": [1.0, 0.5], "reference": ["inf"]}, "error": "invalid_argument", "source": "reference must be finite"}
  ]
}
