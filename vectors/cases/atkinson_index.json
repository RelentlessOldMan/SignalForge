{
  "schema": 1,
  "suite": "atkinson_index",
  "description": "The Atkinson index (conventions: the Atkinson index; ADR 0515).",
  "cases": [
    {"id": "atkinson_index.equal", "op": "atkinson_index", "args": {"samples": [2.0, 2.0, 2.0], "epsilon": 2.0}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "every value equal: 0"},
    {"id": "atkinson_index.no_aversion", "op": "atkinson_index", "args": {"samples": [1.0, 1.0, 4.0], "epsilon": 0.0}, "expected": 0.0, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "epsilon 0: one less the mean over the mean, 0"},
    {"id": "atkinson_index.geometric", "op": "atkinson_index", "args": {"samples": [1.0, 2.0, 4.0], "epsilon": 1.0}, "expected": 0.14285714285714285, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "geometric mean 2, mean 7/3: 1 - 6/7 = 1/7"},
    {"id": "atkinson_index.geometric_two", "op": "atkinson_index", "args": {"samples": [1.0, 3.0], "epsilon": 1.0}, "expected": 0.13397459621556135, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "geometric mean sqrt 3, mean 2: 1 - sqrt 3/2"},
    {"id": "atkinson_index.harmonic", "op": "atkinson_index", "args": {"samples": [1.0, 3.0], "epsilon": 2.0}, "expected": 0.25, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "harmonic mean 3/2, mean 2: 1 - 3/4 = 1/4"},
    {"id": "atkinson_index.half", "op": "atkinson_index", "args": {"samples": [1.0, 4.0], "epsilon": 0.5}, "expected": 0.1, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "ratios 2/5, 8/5: ((sqrt(2/5) + 2 sqrt(2/5))/2)^2 = 9/10, so 1/10"},
    {"id": "atkinson_index.three", "op": "atkinson_index", "args": {"samples": [1.0, 2.0, 4.0], "epsilon": 3.0}, "expected": 0.3520609034127533, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "mean of (7/3)^2/x^2 = (7/3)^2 7/16, to the -1/2: 12/(7 sqrt 7), so 1 - 12/(7 sqrt 7)"},
    {"id": "atkinson_index.random", "op": "atkinson_index", "args": {"samples": [2.75, 4.5, 4.625, 2.25, 1.625, 0.25, 7.5, 4.5, 0.5, 0.75, 2.75, 7.5, 3.875, 6.5, 5.375, 7.625, 1.125, 7.5, 0.625, 6.75, 6.75, 3.75, 2.375, 3.375, 8.0, 2.5, 4.5, 5.875, 5.75, 1.625], "epsilon": 1.5}, "expected": 0.40520876704433506, "tol": {"abs": 1e-14, "rel": 1e-13}, "source": "30 values k/8, k from random.Random(515).randint(1, 64); epsilon 3/2"},
    {"id": "atkinson_index.empty", "op": "atkinson_index", "args": {"samples": [], "epsilon": 1.0}, "error": "invalid_argument", "source": "the record needs a value"},
    {"id": "atkinson_index.zero", "op": "atkinson_index", "args": {"samples": [1.0, 0.0, 2.0], "epsilon": 1.0}, "error": "invalid_argument", "source": "values must be greater than 0"},
    {"id": "atkinson_index.negative", "op": "atkinson_index", "args": {"samples": [1.0, -0.5, 2.0], "epsilon": 1.0}, "error": "invalid_argument", "source": "values must be greater than 0"},
    {"id": "atkinson_index.negative_epsilon", "op": "atkinson_index", "args": {"samples": [1.0, 2.0, 3.0], "epsilon": -0.5}, "error": "invalid_argument", "source": "epsilon must be at least 0"}
  ]
}
