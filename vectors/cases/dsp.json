    {"id": "rrc_taps.b1.0_sps4_span4", "op": "rrc_taps", "args": {"beta": 1.0, "samples_per_symbol": 4, "span_symbols": 4}, "expected": [-0.010106003250812134, 2.1564727478266388e-16, 0.01819080585146224, -9.300597715713771e-17, -0.04244521365341178, -9.044431442284757e-17, 0.21222606826705792, 0.5000458927260264, 0.6366782048011737, 0.5000458927260264, 0.21222606826705792, -9.044431442284757e-17, -0.04244521365341178, -9.300597715713771e-17, 0.01819080585146224, 2.1564727478266388e-16, -0.010106003250812134], "tol": {"abs": 1e-12, "rel": 0}, "source": "inverse Fourier transform of sqrt(raised-cosine spectrum): flat part in closed form, transition by 256-point Gauss-Legendre (numpy.polynomial.legendre), scaled to unit energy; includes the t = +-1/(4 beta) taps"},
    {"id": "rrc_taps.b0.25_sps4_span4", "op": "rrc_taps", "args": {"beta": 0.25, "samples_per_symbol": 4, "span_symbols": 4}, "expected": [0.02664688013598432, -0.027623153573908755, -0.08553741181477328, -0.09981212978792366, -0.032265157908627995, 0.11947368139905223, 0.31231755818860324, 0.4737348290046154, 0.536592673759239, 0.4737348290046154, 0.31231755818860324, 0.11947368139905223, -0.032265157908627995, -0.09981212978792366, -0.08553741181477328, -0.027623153573908755, 0.02664688013598432], "tol": {"abs": 1e-12, "rel": 0}, "source": "inverse Fourier transform of sqrt(raised-cosine spectrum): flat part in closed form, transition by 256-point Gauss-Legendre (numpy.polynomial.legendre), scaled to unit energy; includes the t = +-1/(4 beta) taps"},
    {"id": "rrc_taps.beta0_is_sinc", "op": "rrc_taps", "args": {"beta": 0, "samples_per_symbol": 4, "span_symbols": 4}, "expected": [-1.9997651473974296e-17, -0.06598042320632498, -0.10886214424108481, -0.09237259248885496, 1.9997651473974296e-17, 0.15395432081475827, 0.32658643272325444, 0.4618629624442748, 0.5130007689027366, 0.4618629624442748, 0.32658643272325444, 0.15395432081475827, 1.9997651473974296e-17, -0.09237259248885496, -0.10886214424108481, -0.06598042320632498, -1.9997651473974296e-17], "tol": {"abs": 1e-14, "rel": 0}, "source": "beta = 0: h(t) = sinc(t), scaled to unit energy"},
    {"id": "rrc_taps.sps1_beta0", "op": "rrc_taps", "args": {"beta": 0, "samples_per_symbol": 1, "span_symbols": 2}, "expected": [0, 1, 0], "tol": {"abs": 1e-15, "rel": 0}, "source": "sinc at integer t: zero except t = 0"},
    {"id": "rrc_taps.reject_beta_lt_0", "op": "rrc_taps", "args": {"beta": -0.1, "samples_per_symbol": 4, "span_symbols": 4}, "error": "invalid_argument", "source": "conventions: beta < 0 is rejected"},
    {"id": "rrc_taps.reject_beta_gt_1", "op": "rrc_taps", "args": {"beta": 1.1, "samples_per_symbol": 4, "span_symbols": 4}, "error": "invalid_argument", "source": "conventions: beta > 1 is rejected"},
    {"id": "rrc_taps.reject_sps_0", "op": "rrc_taps", "args": {"beta": 0.35, "samples_per_symbol": 0, "span_symbols": 4}, "error": "invalid_argument", "source": "conventions: sps 0 is rejected"},
    {"id": "rrc_taps.reject_odd_span", "op": "rrc_taps", "args": {"beta": 0.35, "samples_per_symbol": 4, "span_symbols": 3}, "error": "invalid_argument", "source": "conventions: odd span is rejected"},
    {"id": "rrc_taps.reject_span_0", "op": "rrc_taps", "args": {"beta": 0.35, "samples_per_symbol": 4, "span_symbols": 0}, "error": "invalid_argument", "source": "conventions: span 0 is rejected"},
    {"id": "rrc_taps.reject_beta_NaN", "op": "rrc_taps", "args": {"beta": "nan", "samples_per_symbol": 4, "span_symbols": 4}, "error": "invalid_argument", "source": "conventions: beta NaN is rejected"},
    {"id": "pulse_shape.hand", "op": "pulse_shape", "args": {"symbols": [1, -1], "taps": [1, 2, 1], "samples_per_symbol": 2}, "expected": [1, 2, 0, -2, -1, 0], "source": "by hand: [1,0,-1,0] * [1,2,1]"},
    {"id": "pulse_shape.complex", "op": "pulse_shape", "args": {"symbols": {"re": [1, 0], "im": [0, 1]}, "taps": [0.5, 1], "samples_per_symbol": 3}, "expected": {"re": [0.5, 1, 0, 0, 0, 0, 0], "im": [0, 0, 0, 0.5, 1, 0, 0]}, "source": "by hand: [1,0,0,j,0,0] * [0.5,1]"}
