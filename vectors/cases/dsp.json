{
  "schema": 1,
  "suite": "dsp",
  "description": "Convolution, upsampling, RRC taps and pulse shaping (conventions: Pulse shaping).",
  "cases": [
    {"id": "convolve.real", "op": "convolve", "args": {"x": [1, 2, 3], "h": [1, -1]}, "expected": [1, 1, 1, -3], "source": "by hand: [1, 2-1, 3-2, -3]"},
    {"id": "convolve.impulse", "op": "convolve", "args": {"x": [0.5, -2, 4], "h": [1]}, "expected": [0.5, -2, 4], "source": "convolution with a unit impulse is the identity"},
    {"id": "convolve.complex", "op": "convolve", "args": {"x": {"re": [1, 0], "im": [0, 1]}, "h": [1, 1]}, "expected": {"re": [1, 1, 0], "im": [0, 1, 1]}, "source": "by hand: [1, 1+j, j]"},
    {"id": "convolve.complex_both", "op": "convolve", "args": {"x": {"re": [0, 1], "im": [1, 0]}, "h": {"re": [0, 1], "im": [1, 1]}}, "expected": {"re": [-1, -1, 1], "im": [0, 2, 1]}, "source": "by hand, x = [j, 1], h = [j, 1+j]: y0 = j*j = -1, y1 = j(1+j) + 1*j = -1+2j, y2 = 1+j"},
    {"id": "convolve.empty", "op": "convolve", "args": {"x": [], "h": [1]}, "error": "invalid_argument", "source": "both inputs must be non-empty"},
    {"id": "upsample.by3", "op": "upsample", "args": {"x": [1, -2], "factor": 3}, "expected": [1, 0, 0, -2, 0, 0], "source": "definition: each sample then factor-1 zeros"},
    {"id": "upsample.by1", "op": "upsample", "args": {"x": [4, 5], "factor": 1}, "expected": [4, 5], "source": "factor 1 is the identity"},
    {"id": "upsample.complex", "op": "upsample", "args": {"x": {"re": [1, 0], "im": [0, -1]}, "factor": 2}, "expected": {"re": [1, 0, 0, 0], "im": [0, 0, -1, 0]}, "source": "definition"},
    {"id": "upsample.factor0", "op": "upsample", "args": {"x": [1], "factor": 0}, "error": "invalid_argument", "source": "factor must be at least 1"},
