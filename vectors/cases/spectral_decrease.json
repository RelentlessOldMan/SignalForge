{
  "schema": 1,
  "suite": "spectral_decrease",
  "description": "Spectral decrease (conventions: Spectra, Spectral decrease; ADR 0130).",
  "cases": [
    {"id": "spectral_decrease.flat", "op": "spectral_decrease", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 2.0, 2.0, 2.0]}, "expected": 0.0, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "flat: every change is 0"},
    {"id": "spectral_decrease.falling", "op": "spectral_decrease", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [4.0, 3.0, 2.0, 1.0]}, "expected": -0.5, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "(-1/1 - 2/2 - 3/3) / (3 + 2 + 1) = -1/2"},
    {"id": "spectral_decrease.rising", "op": "spectral_decrease", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0]}, "expected": 0.3333333333333333, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "(1/1 + 2/2 + 3/3) / (2 + 3 + 4) = 1/3"},
    {"id": "spectral_decrease.spaced", "op": "spectral_decrease", "args": {"frequencies": [10.0, 30.0, 50.0, 70.0], "psd": [4.0, 3.0, 2.0, 1.0]}, "expected": -0.5, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "the falling ramp on 20 Hz bins: distances count in bins, still -1/2"},
    {"id": "spectral_decrease.cut_band", "op": "spectral_decrease", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 2.0, 3.0, 4.0], "band": [0.25, 3.0]}, "expected": 0.49462116830537883, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "band [0.25, 3]: piece 0 [1/4, 1/2] at m 3/8, piece 3 [5/2, 3] at m 11/4; terms 1/(5/8), 2/(13/8), (3/2)/(19/8) over power 2 + 3 + 2"},
    {"id": "spectral_decrease.span_clipped", "op": "spectral_decrease", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [2.0, 1.0, 1.0, 2.0], "span": [0.0, 3.0]}, "expected": -1.4285714285714286, "tol": {"abs": 1e-12, "rel": 1e-12}, "source": "span (0, 3): bin 0 [0, 1/2] at density 4, m 1/4; bins 1, 2 at 1; bin 3 [5/2, 3] at 4; terms -3/(3/4), -3/(7/4), 0 over power 1 + 1 + 2"},
    {"id": "spectral_decrease.one_piece", "op": "spectral_decrease", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [0.0, 0.4]}, "error": "invalid_argument", "source": "the band holds one bin"},
    {"id": "spectral_decrease.no_power_after_first", "op": "spectral_decrease", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 0.0, 0.0, 0.0]}, "error": "invalid_argument", "source": "no power after the first bin"},
    {"id": "spectral_decrease.band_outside", "op": "spectral_decrease", "args": {"frequencies": [0.0, 1.0, 2.0, 3.0], "psd": [1.0, 1.0, 1.0, 1.0], "band": [0.0, 4.0]}, "error": "invalid_argument", "source": "band [0, 4] leaves the spectrum [-0.5, 3.5]"}
  ]
}
